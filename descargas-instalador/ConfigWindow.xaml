<Window x:Class="BrosLMV.Descargas.Instalador.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrosLMV Descargas — Configuración" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9" FontFamily="Segoe UI"
        ResizeMode="NoResize" Icon="pack://application:,,,/assets/app_icon.png">
  <Window.Resources>
    <Style TargetType="Button" x:Key="Primary">
      <Setter Property="Background" Value="#2D6FE0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="22,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="Ghost">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Height="90">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#15324F" Offset="0"/>
          <GradientStop Color="#0B1E33" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Image Source="pack://application:,,,/assets/logo_blanco.png" Height="52" Stretch="Uniform"
             HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>

    <StackPanel Grid.Row="1" Margin="40,22,40,0">
      <TextBlock Text="Base de datos y automatización" FontSize="18" FontWeight="Bold" Foreground="#16263A"/>
      <TextBlock Foreground="#64748B" Margin="0,6,0,16" TextWrapping="Wrap"
                 Text="Si ya hay una instalación, se cargará aquí su configuración actual. La actualización conserva los XML y la base de datos; no toca la base de Comercial Pro."/>

      <TextBlock Text="Conexión a SQL Server" FontSize="11" FontWeight="Bold" Foreground="#16263A" Margin="0,0,0,6"/>
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Servidor / instancia" Foreground="#64748B" FontSize="11"/>
          <TextBox x:Name="TxtServidor" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0" Text="localhost\compac"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Base de datos" Foreground="#64748B" FontSize="11"/>
          <TextBox x:Name="TxtBaseDatos" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0" Text="BrosLMV_SAT"/>
        </StackPanel>
      </Grid>

      <CheckBox x:Name="ChkWindowsAuth" Content="Usar autenticación de Windows (sin usuario/contraseña)" Margin="0,0,0,8" IsChecked="True" Checked="ChkWindowsAuth_Changed" Unchecked="ChkWindowsAuth_Changed"/>

      <Grid x:Name="PanelSqlAuth" IsEnabled="False" Opacity="0.5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Usuario SQL" Foreground="#64748B" FontSize="11"/>
          <TextBox x:Name="TxtUsuario" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Contraseña SQL" Foreground="#64748B" FontSize="11"/>
          <PasswordBox x:Name="PwdContrasena" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
      </Grid>

      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button Content="Probar conexión" Style="{StaticResource Ghost}" Click="BtnProbar_Click"/>
        <TextBlock x:Name="LblEstadoConexion" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
      </StackPanel>

      <Border Height="1" Background="#E2E8F0" Margin="0,18,0,16"/>

      <TextBlock Text="Solicitar periodos nuevos cada" FontSize="11" FontWeight="Bold" Foreground="#16263A" Margin="0,0,0,6"/>
      <TextBlock Foreground="#64748B" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                 Text="Cada cuánto el servicio de Windows pide al SAT los periodos que falten. Puede cambiarse después desde &quot;Automatización&quot; dentro de la aplicación."/>
      <ComboBox x:Name="CmbIntervalo" HorizontalAlignment="Left" MinWidth="180">
        <ComboBoxItem Content="15 minutos" Tag="15"/>
        <ComboBoxItem Content="30 minutos" Tag="30"/>
        <ComboBoxItem Content="1 hora" Tag="60"/>
        <ComboBoxItem Content="2 horas" Tag="120" IsSelected="True"/>
        <ComboBoxItem Content="3 horas" Tag="180"/>
        <ComboBoxItem Content="4 horas" Tag="240"/>
        <ComboBoxItem Content="6 horas" Tag="360"/>
        <ComboBoxItem Content="8 horas" Tag="480"/>
        <ComboBoxItem Content="12 horas" Tag="720"/>
        <ComboBoxItem Content="24 horas" Tag="1440"/>
      </ComboBox>
    </StackPanel>

    <Border Grid.Row="2" Background="White" BorderBrush="#E6E9EF" BorderThickness="0,1,0,0" Padding="40,16" Margin="0,20,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancelar" Style="{StaticResource Ghost}" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
        <Button x:Name="BtnInstalar" Content="Instalar" Style="{StaticResource Primary}" Click="BtnInstalar_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
