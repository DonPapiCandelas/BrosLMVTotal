foreach (var m in monedas) {
    int cid = Convert.ToInt32(m["CurrencyID"]);
    curRate[cid] = Convert.ToDouble(m["Rate"] ?? 1);
    cboMoneda.Items.Add(new Opt(Convert.ToString(m["IntlSymbol"]) + " - " + Convert.ToString(m["Currency"]), cid));
    string cur = Convert.ToString(m["Currency"] ?? "").ToUpperInvariant();
    monedaPalabra[cid] = cur.Contains("PESO") ? "PESOS" : cur.Contains("DOLAR") || cur.Contains("DÓLAR") ? "DÓLARES"
        : cur.Contains("EURO") ? "EUROS" : (cur.Length > 0 ? cur + "S" : "PESOS");
}
SelectByVal(cboMoneda, 3); // MXN por defecto

Lbl("Cond. pago:", 440, 70, grpProv);
