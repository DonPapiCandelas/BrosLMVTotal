var grpProv = CreateGroup("1. Proveedor", 10, topY, 650, 100, frm);
Lbl("Buscar (RFC/Nombre):", 15, 40, grpProv);
var cboProv = new ComboBox { Location = new Point(150, 38), Size = new Size(280, 23), Font = F_BODY, DropDownStyle = ComboBoxStyle.DropDown, FlatStyle = FlatStyle.Flat, Parent = grpProv };
foreach (var p in proveedores)
    provAll.Add(new Opt(Convert.ToString(p["OfficialName"]), Convert.ToInt32(p["BusinessEntityID"]), Convert.ToString(p["RFC"])));
foreach (var o in provAll) cboProv.Items.Add(o);
if (cboProv.Items.Count > 0) cboProv.SelectedIndex = 0;

