// lang: csharp
using System;
using System.Drawing;
using System.Windows.Forms;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Globalization;

// PLANTILLA: Orden de Compra — Forms + SQL puro (WinForms nativo, SIN ctx.erp)
//
// Qué hace: EXACTAMENTE la misma ventana que PLANTILLA_ORDEN_COMPRA_FORMS_CSHARP.ctx
// (buscador de proveedor/producto, impuesto y descuento por partida, totales en vivo,
// detalle de producto al doble clic) -- pero al presionar "Guardar" NO llama
// ctx.erp.NuevoDocumento/AgregarArticulo/RecalcCompleto/AffectStockNEW/Save. En vez de eso
// ejecuta los mismos INSERT directos ya validados campo por campo en
// PLANTILLA_ORDEN_COMPRA_SQL_PURO.sql (docDocument, docDocumentExt, docDocumentExtra,
// docDocumentCFD, docDocumentPaymentAgenda, docDocumentItem, docDocumentTax/TaxDetail/
// TaxSum, docDocumentDeliveryAgenda, orgProductKardex, orgProductSupplier), generalizados
// para soportar VARIAS partidas con impuesto y descuento propios (el .sql original solo
// maneja una partida sin descuento).
//
// ⚠️ ADVERTENCIA REAL (parcialmente NUEVA, no solo heredada del .sql): el .sql validado NO
// modela descuento por partida en absoluto (siempre 0). Esta ventana SÍ permite capturar
// descuento (igual que la versión ctx.erp), y el cálculo del total con descuento aplicado
// (subtotal - descuento + impuestos sobre el neto) sigue la misma fórmula que ya usa
// RefreshGrid()/AgregarArticulo en el resto del catálogo (documentada en MANUAL.md, sección
// "Totales y total en letra") -- pero la combinación "SQL puro + descuento > 0" en
// específico NO se comparó campo por campo contra un documento nativo con descuento real
// (el caso base sin descuento SÍ está validado). Si vas a usar descuento en producción con
// esta variante, valida tú mismo un caso contra un documento nativo antes de confiar en él
// a ciegas -- exactamente la misma recomendación que ya hace PLANTILLA_ORDEN_COMPRA_SQL_
// PURO.sql sobre "úsala cuando sepas por qué la necesitas".
//
// Folio/Serie: a diferencia de la versión ctx.erp (que sí deja editar el folio y llama
// ctx.erp.GetFolioPrefix/GetNextFolio), aquí son de SOLO LECTURA -- el folio real se calcula
// igual que en el .sql validado (MAX(Folio)+1 para el módulo 183, con FolioPrefix='' fijo),
// calculado con SQL puro, no con ctx.erp.
//
// Ver MANUAL.md §10 "Ventanas WinForms: modeless" para las reglas de por qué esta ventana
// es Show() (modeless) y por qué cada manejador que hace SQL necesita su propio try/catch.
//
// Atomicidad: SÍ (desde esta versión). El batch generado en CrearOrdenCompraSqlPuro() corre
// dentro de BEGIN TRAN/COMMIT TRAN con TRY/CATCH + ROLLBACK -- antes, un fallo a mitad del
// batch dejaba un docDocument "fantasma".
//
// ⚠️ CAMBIO IMPORTANTE (docs/INVESTIGACION_XENGINE_SQL_PURO.md): este archivo es C# (no un
// .sql suelto) -- el addon corre embebido en el mismo proceso que XEngine, así que SÍ tiene
// acceso a ctx.erp aunque el documento se cree con INSERT directo. Antes, el batch calculaba a
// mano orgProductKardex, docDocumentTaxDetail/TaxSum y SubTotal/Total/TotalTax del encabezado.
// Eso se ELIMINÓ y se reemplazó por ctx.erp.RecalcCompleto(doc) + ctx.erp.AffectStockNEW(doc) +
// ctx.erp.UpdateStatusDelivery(doc) tras el COMMIT del batch -- la MISMA secuencia que ya usa
// PLANTILLA_ORDEN_COMPRA_FORMS_CSHARP.ctx (la variante ctx.erp, validada en producción).
// Verificado contra el sandbox (localhost\compac) antes de aplicarlo aquí:
//   - Un docDocumentItem insertado a mano por SQL puro, con SubTotal/Total=0 en el encabezado,
//     queda con SubTotal/Total/TotalTax/TotalLetter CORRECTOS después de RecalcDocument (no
//     hace falta calcularlos en C#).
//   - ctx.erp.AffectStockNEW(doc) genera la fila de orgProductKardex (Quantity=0,
//     QuantityToBeDelivered=cantidad, AmountPrice=precio) -- IDÉNTICA a la que este archivo
//     insertaba a mano -- y es idempotente (llamarlo 2 veces no duplica la fila).
//   - RecalcDocument genera también docDocumentTaxDetail/docDocumentTaxSum a partir del
//     docDocumentItem insertado -- el resumen manual de impuestos que tenía este archivo era
//     además una simplificación conocida (una sola fila agregada, incorrecta con más de un tipo
//     de impuesto distinto entre partidas); dejar que el motor lo calcule corrige ese caso, no
//     solo evita duplicar código.
// Si ctx.erp falla (motor no disponible, etc.), el documento YA EXISTE (INSERT ya comprometido)
// pero puede quedar con kardex/costos/totales sin calcular -- se avisa al usuario en vez de
// fallar en silencio; no hay cálculo manual de respaldo (se decidió eliminarlo, no dejarlo como
// fallback, porque es la fuente de los bugs reales que motivaron esta investigación).

// ═══════════════════ DATOS INICIALES ═══════════════════
var almacenes = ctx.Query("SELECT DepotID, DepotName FROM orgDepot WHERE DeletedOn IS NULL ORDER BY DepotName");
var proveedores = ctx.Query(@"
    SELECT be.BusinessEntityID, be.OfficialName,
           ISNULL(m.OfficialNumber,'') AS RFC
    FROM orgBusinessEntity be
    INNER JOIN orgSupplier s ON s.BusinessEntityID=be.BusinessEntityID
    LEFT JOIN orgBusinessEntityMainInfo m ON m.BusinessEntityID=be.BusinessEntityID
    WHERE be.DeletedOn IS NULL
    ORDER BY be.OfficialName");
var monedas = ctx.Query("SELECT CurrencyID, IntlSymbol, Currency, Rate FROM vwLBSCurrencyList ORDER BY CurrencyID");
var condiciones = ctx.Query("SELECT PaymentTermID, PaymentTermName FROM vwLBSPaymentTermList WHERE Buys=1 AND Deleted=0 ORDER BY PaymentTermID");
var impuestos = ctx.Query(@"
    SELECT t.TaxTypeID, t.TaxTypeName, ISNULL(tp.IVA_Perc,0) AS IVA_Perc
    FROM vwLBSTaxType t LEFT JOIN vwLBSTaxPerc tp ON tp.TaxTypeID = t.TaxTypeID
    ORDER BY t.TaxTypeName");

var partidas = new List<Item>();
var provAll = new List<Opt>();
var curRate = new Dictionary<int, double>();
var taxPercByType = new Dictionary<int, double>();
var monedaPalabra = new Dictionary<int, string>();
Prod productoSeleccionado = null;
bool suspenderBusqueda = false;
bool suspenderProv = false;

