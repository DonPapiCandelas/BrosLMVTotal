// lang: csharp
// AppKey recomendado: SALDOS_ESTADOS_CUENTA
// Plantilla: Saldos y estados de cuenta
// Categoria: Reportes
// Documentacion: SALDOS_ESTADOS_CUENTA.html
// job: safe-offline
// Cuentas por cobrar, cuentas por pagar y estados de cuenta de clientes y proveedores, con fecha de corte y antigüedad de saldos.
// Solo LEE: no cambia nada. Documentación completa: clic secundario sobre la plantilla → «Ver documentación».
//
// Cómo calcula (nada va escrito a mano; los módulos se clasifican por los parámetros del propio módulo, así los clones se comportan como el original):
//   · Qué es cliente y qué es proveedor:  DocRecipient 1 = cliente, 2 = proveedor (engModuleParameter, por ModuleIDBase).
//   · Qué suma y qué resta:               FinancialAffectation (±1; 0 = no afecta saldos). Para clientes una factura suma y una nota de crédito resta; para proveedores, al revés.
//   · Saldo a una fecha de corte:         Total − pagos vigentes con DateOperation ≤ corte − notas de crédito aplicadas (PaymentWithDocumentID). docDocument.Balance es solo la foto de hoy.
//   · Vencimiento:                        la última fecha de la agenda de pago (docDocumentPaymentAgenda); sin agenda, la fecha del documento. Las notas de crédito no vencen.
// Los números se calculan en la ventana (navegador): cambiar la fecha de corte o el lado (cobrar/pagar) es instantáneo y no vuelve a consultar.

using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Text;
using System.Web.Script.Serialization;
using System.Windows.Forms;

var ci = CultureInfo.InvariantCulture;
var ser = new JavaScriptSerializer { MaxJsonLength = 128 * 1024 * 1024 };

string S(object v) => v == null || v is DBNull ? "" : Convert.ToString(v, ci);
long L(object v) { try { return v == null || v is DBNull ? 0 : Convert.ToInt64(v, ci); } catch { return 0; } }
int I(object v) { try { return v == null || v is DBNull ? 0 : Convert.ToInt32(v, ci); } catch { return 0; } }
decimal M(object v) { try { return v == null || v is DBNull ? 0m : Convert.ToDecimal(v, ci); } catch { return 0m; } }
bool Nulo(object v) => v == null || v is DBNull;
string FechaTxt(object v) => Nulo(v) ? "" : Convert.ToDateTime(v, ci).ToString("yyyy-MM-dd");

int empresa = ctx.erp.OwnedBusinessEntityId;
int meses = 12;                                                    // cuánto historial se carga (el saldo de cualquier corte posterior es exacto)
string modoPrueba = Environment.GetEnvironmentVariable("BROSLMV_SALDOS_TEST");    // solo para pruebas automáticas (sin ventanas): JSON {"meses":12}
if (!string.IsNullOrEmpty(modoPrueba))
{
    try { var cfg = ser.Deserialize<Dictionary<string, object>>(modoPrueba); if (cfg.ContainsKey("meses")) meses = Math.Max(1, I(cfg["meses"])); } catch { }
}

// ---------- 1) Qué módulos son cuentas por cobrar y por pagar ----------
// Se pivotean los parámetros por ModuleIDBase y se unen con todos los módulos (clones incluidos).
var modulos = ctx.Query(
    "SELECT m.ModuleID, m.ModuleName, pv.Rec, pv.Tipo, pv.Af FROM engModule m JOIN (" +
    "  SELECT ModuleID, MAX(CASE WHEN ParameterKey='DocRecipient' THEN TRY_CONVERT(int, Value) END) AS Rec, " +
    "         MAX(CASE WHEN ParameterKey='DocumentTypeID' THEN TRY_CONVERT(int, Value) END) AS Tipo, " +
    "         MAX(CASE WHEN ParameterKey='FinancialAffectation' THEN TRY_CONVERT(int, Value) END) AS Af, " +
    "         MAX(CASE WHEN ParameterKey='TableName' THEN Value END) AS Tabla " +
    "  FROM engModuleParameter WHERE ParameterKey IN ('DocRecipient','DocumentTypeID','FinancialAffectation','TableName') GROUP BY ModuleID" +
    ") pv ON pv.ModuleID = ISNULL(NULLIF(m.ModuleIDBase,0), m.ModuleID) " +
    "WHERE pv.Tabla = 'docDocument' AND pv.Af IN (1,-1) AND pv.Rec IN (1,2) AND ISNULL(pv.Tipo,0) NOT IN (40,44)");    // 40 = pedido, 44 = carta porte: no son cuentas por cobrar/pagar
var signo = new Dictionary<int, int>();          // módulo → +1 suma saldo, −1 resta (nota de crédito)
var ladoMod = new Dictionary<int, string>();     // módulo → "C" (por cobrar) / "P" (por pagar)
var nombreMod = new Dictionary<int, string>();
foreach (var r in modulos)
{
    int mid = I(r["ModuleID"]), rec = I(r["Rec"]), af = I(r["Af"]);
    ladoMod[mid] = rec == 1 ? "C" : "P";
    signo[mid] = rec == 1 ? af : -af;          // cliente: factura (+1) suma, NC (−1) resta · proveedor: factura (−1 → +1) suma, NC (+1 → −1) resta
    nombreMod[mid] = S(r["ModuleName"]);
}
if (signo.Count == 0)
{
    ctx.Msg("No se encontraron módulos con afectación financiera en esta empresa.", "Saldos y estados de cuenta");
    return "SIN MODULOS";
}

// ---------- 2) Carga: documentos y pagos ----------
DateTime hoy = DateTime.Today;
DateTime desde = new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-meses);
string fDesde = desde.ToString("yyyy-MM-dd", ci);
string listaMod = string.Join(",", signo.Keys.Select(x => x.ToString(ci)));

// Documentos de la ventana de tiempo, más los que siguen con saldo o tuvieron pagos dentro de ella (un documento viejo pagado hoy tenía saldo en cortes recientes).
string filtroDocs =
    "SELECT d.DocumentID FROM docDocument d WHERE d.ModuleID IN (" + listaMod + ") AND d.OwnedBusinessEntityID = " + empresa +
    " AND d.DeletedOn IS NULL AND d.CancelledOn IS NULL AND (d.DateDocument >= '" + fDesde + "' OR ISNULL(d.Balance,0) <> 0 OR EXISTS " +
    "(SELECT 1 FROM docDocumentPayment p WHERE p.DocumentID = d.DocumentID AND p.DeletedOn IS NULL AND p.DateOperation >= '" + fDesde + "'))";

var docsSql = ctx.Query(
    "SELECT d.DocumentID, d.ModuleID, d.FolioPrefix, d.Folio, d.DateDocument, ISNULL(d.Total,0) AS Total, d.BusinessEntityID, " +
    "ISNULL(be.CommercialName, be.OfficialName) AS Entidad, ISNULL(d.Title,'') AS Titulo, " +
    "(SELECT MAX(a.DatePayment) FROM docDocumentPaymentAgenda a WHERE a.DocumentID = d.DocumentID AND a.DeletedOn IS NULL) AS Vence " +
    "FROM docDocument d LEFT JOIN orgBusinessEntity be ON be.BusinessEntityID = d.BusinessEntityID WHERE d.DocumentID IN (" + filtroDocs + ")");
var docs = new List<Dictionary<string, object>>();
foreach (var r in docsSql)
{
    int mid = I(r["ModuleID"]);
    string folio = (S(r["FolioPrefix"]) + S(r["Folio"])).Trim();
    docs.Add(new Dictionary<string, object>
    {
        ["id"] = L(r["DocumentID"]), ["mod"] = mid, ["lado"] = ladoMod[mid], ["s"] = signo[mid], ["tipo"] = nombreMod[mid], ["folio"] = folio,
        ["fecha"] = FechaTxt(r["DateDocument"]), ["venc"] = FechaTxt(r["Vence"]), ["total"] = M(r["Total"]),
        ["ent"] = L(r["BusinessEntityID"]), ["entNom"] = S(r["Entidad"]), ["titulo"] = S(r["Titulo"])
    });
}

var pagosSql = ctx.Query(
    "SELECT p.DocumentID, p.DateOperation, ISNULL(p.Amount,0) AS Monto, ISNULL(p.PaymentWithDocumentID,0) AS NC, " +
    "ISNULL(o.FolioPrefix,'') AS OpPref, ISNULL(o.Folio,'') AS OpFolio, ISNULL(o.ModuleID,0) AS OpMod " +
    "FROM docDocumentPayment p LEFT JOIN docFinancialOperation o ON o.FinancialOperationID = p.FinancialOperationID " +
    "WHERE p.DeletedOn IS NULL AND (p.DocumentID IN (" + filtroDocs + ") OR p.PaymentWithDocumentID IN (" + filtroDocs + "))");
var pagos = new List<Dictionary<string, object>>();
foreach (var r in pagosSql)
    pagos.Add(new Dictionary<string, object>
    {
        ["doc"] = L(r["DocumentID"]), ["fecha"] = FechaTxt(r["DateOperation"]), ["monto"] = M(r["Monto"]), ["nc"] = L(r["NC"]),
        ["op"] = (S(r["OpPref"]) + S(r["OpFolio"])).Trim()
    });

string nombreEmpresa = "";
try { nombreEmpresa = S(ctx.Scalar("SELECT TOP 1 ISNULL(CommercialName, OfficialName) FROM orgBusinessEntity WHERE BusinessEntityID = " + empresa)); } catch { }

var modelo = new Dictionary<string, object>
{
    ["docs"] = docs, ["pagos"] = pagos, ["hoy"] = hoy.ToString("yyyy-MM-dd", ci), ["desde"] = fDesde, ["empresa"] = nombreEmpresa, ["meses"] = meses
};

// ---------- 3) Ventana ----------
string Html(string json) => @"<!DOCTYPE html><html lang='es'><head><meta charset='utf-8'><title>Saldos y estados de cuenta</title><style>
:root{--fondo:#f4f6f9;--tarjeta:#fff;--texto:#16263a;--suave:#64748b;--linea:#d5dde8;--azul:#2d6fe0;--rojo:#c82828;--ambar:#b45309;--verde:#16803b;--zebra:#f8fafc}
*{box-sizing:border-box}body{margin:0;font:13px 'Segoe UI',Arial,sans-serif;background:var(--fondo);color:var(--texto)}
header{padding:14px 22px 6px;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:8px}h1{margin:0;font-size:20px}.sub{color:var(--suave);margin-top:2px}
.ctl{padding:6px 22px;display:flex;gap:14px;align-items:center;flex-wrap:wrap}.ctl label{color:var(--suave);font-size:12px}
input,select,button{font:inherit;border:1px solid var(--linea);border-radius:6px;padding:5px 9px;background:#fff;color:var(--texto)}button{cursor:pointer}button.p{background:var(--azul);color:#fff;border-color:var(--azul)}
.seg{display:inline-flex}.seg button{border-radius:0;margin-left:-1px}.seg button:first-child{border-radius:6px 0 0 6px;margin-left:0}.seg button:last-child{border-radius:0 6px 6px 0}.seg button.on{background:var(--azul);color:#fff;border-color:var(--azul)}
.tabs{padding:4px 22px 0;display:flex;gap:2px;border-bottom:1px solid var(--linea)}.tabs button{border:0;border-bottom:3px solid transparent;border-radius:0;background:none;padding:8px 14px}.tabs button.on{border-bottom-color:var(--azul);font-weight:600}
.cuerpo{padding:12px 22px 28px}.kpis{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:12px}.kpi{background:var(--tarjeta);border:1px solid var(--linea);border-radius:9px;padding:10px 14px;min-width:150px}
.kpi b{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--suave);font-weight:600}.kpi span{font-size:18px;font-variant-numeric:tabular-nums}
.tw{background:var(--tarjeta);border:1px solid var(--linea);border-radius:9px;overflow:auto;max-height:calc(100vh - 290px)}
table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}th,td{padding:6px 10px;text-align:right;white-space:nowrap}th:first-child,td:first-child,.l{text-align:left}
th{position:sticky;top:0;background:#eef2f7;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--suave);border-bottom:1px solid var(--linea);z-index:1}
tbody tr:nth-child(even){background:var(--zebra)}tbody tr.clic{cursor:pointer}tbody tr.clic:hover{background:#e8f0ff}tfoot td{font-weight:700;border-top:2px solid var(--linea);position:sticky;bottom:0;background:#eef2f7}
.venc{color:var(--rojo)}.favor{color:var(--verde)}.pill{display:inline-block;border-radius:10px;padding:1px 8px;font-size:11px;background:#e5eaf1;color:var(--suave)}.pill.r{background:#fde4e4;color:var(--rojo)}.pill.a{background:#fdf0dc;color:var(--ambar)}.pill.v{background:#e0f3e6;color:var(--verde)}
.vacio{padding:40px;text-align:center;color:var(--suave)}.nota{color:var(--suave);font-size:12px;margin-top:8px}
</style></head><body>
<header><div><h1 id='tit'></h1><div class='sub' id='sub'></div></div><div><button onclick='exportar()'>Exportar a CSV (Excel)</button></div></header>
<div class='ctl'>
 <div class='seg' id='segLado'><button data-l='C' class='on' onclick=""setLado('C')"">Por cobrar (clientes)</button><button data-l='P' onclick=""setLado('P')"">Por pagar (proveedores)</button></div>
 <label>Fecha de corte <input type='date' id='corte' onchange='cambio()'></label>
 <label>Buscar <input type='text' id='q' placeholder='nombre, folio o título' oninput='cambio()' style='width:210px'></label>
 <label><input type='checkbox' id='soloV' onchange='cambio()'> Solo vencidos</label>
</div>
<div class='tabs' id='tabs'><button data-t='aging' class='on' onclick=""setTab('aging')"">Antigüedad por cliente</button><button data-t='docs' onclick=""setTab('docs')"">Documentos con saldo</button><button data-t='edo' onclick=""setTab('edo')"">Estado de cuenta</button></div>
<div class='cuerpo' id='cuerpo'></div>
<script>
var D=" + json + @";
function enviar(o){window.chrome.webview.postMessage(JSON.stringify(o));}
function esc(s){return String(s==null?'':s).replace(/[&<>]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];});}
function f2(n){return (n||0).toLocaleString('es-MX',{minimumFractionDigits:2,maximumFractionDigits:2});}
function dias(a,b){return Math.round((Date.parse(b)-Date.parse(a))/864e5);}
function sumaDias(f,n){var d=new Date(Date.parse(f)+n*864e5);return d.toISOString().substr(0,10);}
var lado='C',tab='aging',entSel=0,pdesde='',phasta='';
var BUCKETS=['Vigente','1-30 días','31-60 días','61-90 días','Más de 90','A favor (NC)'];
var pp={},nc={};
D.pagos.forEach(function(p){(pp[p.doc]=pp[p.doc]||[]).push(p);if(p.nc>0)(nc[p.nc]=nc[p.nc]||[]).push(p);});
var docPorId={};D.docs.forEach(function(d){docPorId[d.id]=d;});
var corteEl=document.getElementById('corte');corteEl.value=D.hoy;corteEl.min=D.desde;corteEl.max=D.hoy;
function calc(){
  var corte=corteEl.value||D.hoy,q=document.getElementById('q').value.toLowerCase(),sv=document.getElementById('soloV').checked,filas=[];
  D.docs.forEach(function(d){
    if(d.lado!==lado||d.fecha>corte)return;
    var ap=0;(pp[d.id]||[]).forEach(function(p){if(p.fecha<=corte)ap+=p.monto;});
    (nc[d.id]||[]).forEach(function(p){if(p.fecha<=corte)ap+=p.monto;});
    var saldo=d.total-ap;if(Math.abs(saldo)<0.005)return;
    var venc=d.venc||d.fecha,dv=d.s<0?null:dias(venc,corte),b=d.s<0?5:(dv<=0?0:dv<=30?1:dv<=60?2:dv<=90?3:4);
    if(sv&&b===0||sv&&b===5)return;
    if(q&&(d.entNom+' '+d.folio+' '+d.titulo+' '+d.tipo).toLowerCase().indexOf(q)<0)return;
    filas.push({d:d,saldo:d.s*saldo,venc:venc,dv:dv,b:b});
  });
  return filas;
}
function porEntidad(filas){
  var m={};filas.forEach(function(f){var e=m[f.d.ent]=m[f.d.ent]||{id:f.d.ent,nom:f.d.entNom||('Entidad '+f.d.ent),b:[0,0,0,0,0,0],tot:0,n:0};e.b[f.b]+=f.saldo;e.tot+=f.saldo;e.n++;});
  return Object.keys(m).map(function(k){return m[k];}).sort(function(a,b){return b.tot-a.tot;});
}
function setLado(l){lado=l;entSel=0;[].forEach.call(document.querySelectorAll('#segLado button'),function(b){b.className=b.getAttribute('data-l')===l?'on':'';});cambio();}
function setTab(t){tab=t;[].forEach.call(document.querySelectorAll('#tabs button'),function(b){b.className=b.getAttribute('data-t')===t?'on':'';});cambio();}
var exp={nombre:'saldos',filas:[]};
function cambio(){
  var corte=corteEl.value||D.hoy,filas=calc(),ents=porEntidad(filas),pc=lado==='C'?'cliente':'proveedor',tot=0,venc=0,fav=0;
  filas.forEach(function(f){tot+=f.saldo;if(f.b>=1&&f.b<=4)venc+=f.saldo;if(f.b===5)fav+=f.saldo;});
  document.getElementById('tit').textContent=(lado==='C'?'Cuentas por cobrar':'Cuentas por pagar')+' al '+corte;
  document.getElementById('sub').textContent=(D.empresa||'')+' · '+ents.length+' '+pc+(ents.length===1?'':'s')+' con saldo · '+filas.length+' documentos';
  document.querySelector('[data-t=aging]').textContent='Antigüedad por '+pc;
  var h='<div class=kpis><div class=kpi><b>Saldo total</b><span>'+f2(tot)+'</span></div><div class=kpi><b>Vencido</b><span class=venc>'+f2(venc)+'</span></div><div class=kpi><b>Vigente</b><span>'+f2(tot-venc-fav)+'</span></div><div class=kpi><b>Notas de crédito a favor</b><span class=favor>'+f2(fav)+'</span></div></div>';
  if(tab==='aging')h+=vistaAging(ents,filas,pc);else if(tab==='docs')h+=vistaDocs(filas);else h+=vistaEdo(pc);
  document.getElementById('cuerpo').innerHTML=h;
  var s=document.getElementById('selEnt');if(s)s.value=entSel;
}
function vistaAging(ents,filas,pc){
  exp={nombre:(lado==='C'?'cuentas_por_cobrar_':'cuentas_por_pagar_')+(corteEl.value||D.hoy),filas:[]};
  var enc=['Nombre'].concat(BUCKETS,['Saldo total','Documentos']);exp.filas=[enc];
  if(!ents.length)return '<div class=vacio>No hay saldos a esta fecha con esos filtros.</div>';
  var tb=[0,0,0,0,0,0],tt=0,tn=0,h='<div class=tw><table><thead><tr><th>'+pc.charAt(0).toUpperCase()+pc.slice(1)+'</th>';
  BUCKETS.forEach(function(b){h+='<th>'+b+'</th>';});h+='<th>Saldo total</th><th>Docs</th></tr></thead><tbody>';
  ents.forEach(function(e){
    h+='<tr class=clic onclick=""verEdo('+e.id+')"" title=\'Ver estado de cuenta\'><td>'+esc(e.nom)+'</td>';
    e.b.forEach(function(v,i){tb[i]+=v;h+='<td class=\''+(i>=1&&i<=4&&v?'venc':(i===5&&v?'favor':''))+'\'>'+(v?f2(v):'')+'</td>';});
    tt+=e.tot;tn+=e.n;h+='<td><b>'+f2(e.tot)+'</b></td><td>'+e.n+'</td></tr>';
    exp.filas.push([e.nom].concat(e.b.map(function(v){return v.toFixed(2);}),[e.tot.toFixed(2),e.n]));
  });
  h+='</tbody><tfoot><tr><td>Total</td>';tb.forEach(function(v){h+='<td>'+(v?f2(v):'')+'</td>';});h+='<td>'+f2(tt)+'</td><td>'+tn+'</td></tr></tfoot></table></div>';
  exp.filas.push(['TOTAL'].concat(tb.map(function(v){return v.toFixed(2);}),[tt.toFixed(2),tn]));
  return h+'<div class=nota>Antigüedad contada desde el vencimiento (última fecha de la agenda de pago). Clic en una fila para ver su estado de cuenta.</div>';
}
function vistaDocs(filas){
  exp={nombre:'documentos_con_saldo_'+(corteEl.value||D.hoy),filas:[['Nombre','Tipo','Folio','Fecha','Vencimiento','Días vencido','Total','Saldo','Título']]};
  filas.sort(function(a,b){return a.d.entNom<b.d.entNom?-1:a.d.entNom>b.d.entNom?1:(a.venc<b.venc?-1:1);});
  if(!filas.length)return '<div class=vacio>No hay documentos con saldo a esta fecha con esos filtros.</div>';
  var h='<div class=tw><table><thead><tr><th>Nombre</th><th class=l>Tipo</th><th>Folio</th><th>Fecha</th><th>Vence</th><th>Días vencido</th><th>Total</th><th>Saldo</th><th class=l>Título</th></tr></thead><tbody>',t=0;
  filas.forEach(function(f){
    var d=f.d,pil=f.dv===null?'<span class=\'pill v\'>A favor</span>':f.dv<=0?'<span class=pill>Vigente</span>':'<span class=\'pill '+(f.dv>60?'r':'a')+'\'>'+f.dv+' d</span>';t+=f.saldo;
    h+='<tr class=clic ondblclick=\'enviar({accion:""abrir"",id:'+d.id+',modulo:'+d.mod+'})\' title=\'Doble clic: abrir el documento\'><td class=l>'+esc(d.entNom)+'</td><td class=l>'+esc(d.tipo)+'</td><td>'+esc(d.folio)+'</td><td>'+d.fecha+'</td><td>'+(f.dv===null?'':f.venc)+'</td><td>'+pil+'</td><td>'+f2(d.s*d.total)+'</td><td><b>'+f2(f.saldo)+'</b></td><td class=l>'+esc(d.titulo)+'</td></tr>';
    exp.filas.push([d.entNom,d.tipo,d.folio,d.fecha,f.dv===null?'':f.venc,f.dv===null?'':Math.max(0,f.dv),(d.s*d.total).toFixed(2),f.saldo.toFixed(2),d.titulo]);
  });
  return h+'</tbody><tfoot><tr><td colspan=7>Total</td><td>'+f2(t)+'</td><td></td></tr></tfoot></table></div><div class=nota>Doble clic en un documento para abrirlo en Comercial.</div>';
}
function verEdo(id){entSel=id;setTab('edo');}
function vistaEdo(pc){
  var corte=corteEl.value||D.hoy,lista={};
  D.docs.forEach(function(d){if(d.lado===lado)lista[d.ent]=d.entNom||('Entidad '+d.ent);});
  var ids=Object.keys(lista).sort(function(a,b){return lista[a]<lista[b]?-1:1;});
  if(!phasta||phasta>corte)phasta=corte;if(!pdesde)pdesde=sumaDias(phasta,-90);
  var h='<div class=ctl style=\'padding:0 0 10px\'><label>'+pc.charAt(0).toUpperCase()+pc.slice(1)+' <select id=selEnt onchange=\'entSel=+this.value;cambio()\'><option value=0>— elige —</option>';
  ids.forEach(function(i){h+='<option value='+i+'>'+esc(lista[i])+'</option>';});
  h+='</select></label><label>Del <input type=date id=pd value='+pdesde+' onchange=\'pdesde=this.value;cambio()\'></label><label>al <input type=date id=ph value='+phasta+' onchange=\'phasta=this.value;cambio()\'></label></div>';
  if(!entSel){exp={nombre:'estado_de_cuenta',filas:[]};return h+'<div class=vacio>Elige un '+pc+' (o haz clic en una fila de la antigüedad) para ver su estado de cuenta.</div>';}
  var ev=[];
  D.docs.forEach(function(d){
    if(d.lado!==lado||d.ent!==entSel)return;
    ev.push({f:d.fecha,t:d.tipo,r:d.folio,c:d.s>0?d.total:0,a:d.s<0?d.total:0,id:d.id,mod:d.mod,o:0,x:d.titulo});
    (pp[d.id]||[]).forEach(function(p){if(p.nc>0)return;var e=-d.s*p.monto;ev.push({f:p.fecha,t:d.s>0?(lado==='C'?'Cobro':'Pago'):'Devolución',r:p.op+' → '+d.folio,c:e>0?e:0,a:e<0?-e:0,id:d.id,mod:d.mod,o:1,x:''});});
  });
  ev.sort(function(a,b){return a.f<b.f?-1:a.f>b.f?1:a.o-b.o;});
  var ini=0;ev.forEach(function(e){if(e.f<pdesde)ini+=e.c-e.a;});
  exp={nombre:'estado_de_cuenta_'+(lista[entSel]||'').replace(/[^A-Za-z0-9]+/g,'_')+'_'+phasta,filas:[['Fecha','Movimiento','Referencia','Cargos','Abonos','Saldo']]};
  var sal=ini,tc=0,ta=0,rows='';
  exp.filas.push([pdesde,'Saldo inicial','','','',ini.toFixed(2)]);
  ev.forEach(function(e){
    if(e.f<pdesde||e.f>phasta)return;sal+=e.c-e.a;tc+=e.c;ta+=e.a;
    rows+='<tr class=clic ondblclick=\'enviar({accion:""abrir"",id:'+e.id+',modulo:'+e.mod+'})\'><td>'+e.f+'</td><td class=l>'+esc(e.t)+'</td><td class=l>'+esc(e.r)+(e.x?' <span class=nota>'+esc(e.x)+'</span>':'')+'</td><td>'+(e.c?f2(e.c):'')+'</td><td>'+(e.a?f2(e.a):'')+'</td><td>'+f2(sal)+'</td></tr>';
    exp.filas.push([e.f,e.t,e.r,e.c?e.c.toFixed(2):'',e.a?e.a.toFixed(2):'',sal.toFixed(2)]);
  });
  exp.filas.push(['','Totales del periodo','',tc.toFixed(2),ta.toFixed(2),sal.toFixed(2)]);
  return h+'<div class=tw><table><thead><tr><th>Fecha</th><th class=l>Movimiento</th><th class=l>Referencia</th><th>Cargos</th><th>Abonos</th><th>Saldo</th></tr></thead><tbody><tr><td>'+pdesde+'</td><td class=l><b>Saldo inicial</b></td><td></td><td></td><td></td><td><b>'+f2(ini)+'</b></td></tr>'+rows+'</tbody><tfoot><tr><td colspan=3>Totales del periodo</td><td>'+f2(tc)+'</td><td>'+f2(ta)+'</td><td>'+f2(sal)+'</td></tr></tfoot></table></div><div class=nota>Las notas de crédito aplicadas a una factura no se repiten como abono: la nota ya restó como documento. Doble clic en un movimiento para abrir su documento.</div>';
}
function exportar(){
  if(!exp.filas.length){return;}
  var csv=exp.filas.map(function(f){return f.map(function(c){c=String(c==null?'':c);return /[,""\n]/.test(c)?'""'+c.replace(/""/g,'""""')+'""':c;}).join(',');}).join('\r\n');
  enviar({accion:'csv',nombre:exp.nombre,contenido:csv});
}
cambio();
</script></body></html>";

// ---------- 4) Pruebas automáticas: escribe el modelo (y el HTML) en archivos, sin ventanas ----------
if (!string.IsNullOrEmpty(modoPrueba))
{
    string salidaPrueba = Environment.GetEnvironmentVariable("BROSLMV_SALDOS_OUT");
    string htmlPrueba = Environment.GetEnvironmentVariable("BROSLMV_SALDOS_HTML");
    string jsonPrueba = ser.Serialize(modelo);
    if (!string.IsNullOrEmpty(salidaPrueba)) File.WriteAllText(salidaPrueba, jsonPrueba, new UTF8Encoding(false));
    if (!string.IsNullOrEmpty(htmlPrueba)) File.WriteAllText(htmlPrueba, Html(jsonPrueba), new UTF8Encoding(false));
    return "OK " + docs.Count + " documentos, " + pagos.Count + " pagos";
}

// ---------- 5) Ventana: se queda abierta hasta que la cierren ----------
while (true)
{
    var r = ctx.ShowHtmlFormulario(Html(ser.Serialize(modelo)), "Saldos y estados de cuenta", 1280, 820, 0);
    if (!r.ContainsKey("submitted") || !(bool)r["submitted"]) return "OK";
    string accion = r.ContainsKey("accion") ? S(r["accion"]) : "";
    if (accion == "abrir")
    {
        try { ctx.erp.AbrirDocumento((int)L(r["id"]), I(r["modulo"])); } catch (Exception ex) { ctx.Msg("No se pudo abrir el documento: " + ex.Message, "Saldos y estados de cuenta"); }
        // Comercial carga el documento en este mismo hilo y le habla a XEngine: si aquí se vuelve a mostrar la ventana (que bloquea el hilo), XEngine contesta
        // «the other application is busy». Por eso, al abrir un documento, el script TERMINA (como todos los que abren documentos) y la ventana se cierra.
        return "OK";
    }
    if (accion == "csv")
    {
        string nombre = new string(S(r["nombre"]).Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c).ToArray());
        using (var dlg = new SaveFileDialog { Filter = "CSV para Excel (*.csv)|*.csv", FileName = nombre + ".csv" })
            if (dlg.ShowDialog() == DialogResult.OK) { File.WriteAllText(dlg.FileName, S(r["contenido"]), new UTF8Encoding(true)); ctx.Msg("Archivo guardado:\n" + dlg.FileName, "Saldos y estados de cuenta"); }
        continue;
    }
    return "OK";
}
