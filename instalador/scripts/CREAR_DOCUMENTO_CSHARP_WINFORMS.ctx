// ---------- distribución (todo a mano: nada se encima y se ajusta al tamaño de la ventana) ----------
int NumeroGrupo(Panel g) { int n = 0; foreach (var x in new[] { g1, g2, g3, g4, g5 }) { if ((x == g3 && !verG3) || (x == g4 && !verG4)) continue; n++; if (x == g) return n; } return n; }
void Distribuir()
{
    int W = frm.ClientSize.Width, H = frm.ClientSize.Height, m = 12, w = W - 2 * m;
    ribbon.SetBounds(m, 10, w, 100); info.Location = new Point(ribbon.Width - info.Width - 10, 6);
    pTipos.SetBounds(m, 118, w, 40);
    int y = 166; g1.SetBounds(m, y, 620, 132); g2.SetBounds(m + 632, y, w - 632, 132); y += 140;
    g3.Visible = verG3; g4.Visible = verG4;
    if (verG3) { g3.SetBounds(m, y, w, 80); y += 88; }
    if (verG4) { g4.SetBounds(m, y, w, 116); y += 124; }
    int yb = H - 40 - 112 - 8;
    g6.SetBounds(m, yb, 440, 112); g7.SetBounds(m + 452, yb, w - 452, 112);
    g5.SetBounds(m, y, w, Math.Max(170, yb - 8 - y));
    pPie.SetBounds(0, H - 40, W, 40);
    grid.SetBounds(14, 106, g5.Width - 28, g5.Height - 118); clbOrigen.SetBounds(14, 36, g4.Width - 28, g4.Height - 46);
    lblTotEt.SetBounds(g7.Width - 254, 32, 240, 16); lblTot.SetBounds(g7.Width - 254, 46, 240, 36); lblLetra.SetBounds(14, 86, g7.Width - 28, 20);
    lblAvisos.SetBounds(Math.Max(420, lblPie.Right + 20), 5, Math.Max(100, W - Math.Max(420, lblPie.Right + 20) - 14), 30);
    foreach (var g in new[] { g1, g2, g3, g4, g5, g6, g7 }) g.Invalidate();
}
frm.Resize += (s, e) => Distribuir();

// ---------- lógica ----------
Dictionary<string, object> ProdPor(int id) => productos.FirstOrDefault(x => I(x["id"]) == id);
double PrecioDe(int id) { var p = ProdPor(id); return p == null ? 0 : !EsVenta() ? D(p["costo"]) : D(p["venta"]); }
double ExistDe(int id) { object e; if (!existencias.TryGetValue(id.ToString(), out e)) return 0; var mm = (Dictionary<string, object>)e; object q; var a = cmbAlm.SelectedItem as Opcion; return a != null && mm.TryGetValue(a.Id.ToString(), out q) ? D(q) : 0; }
Dictionary<string, object> MonedaSel() { var o = cmbMon.SelectedItem as Opcion; return o == null ? null : monedas.FirstOrDefault(x => I(x["id"]) == o.Id); }

string[] UNI = { "", "UNO", "DOS", "TRES", "CUATRO", "CINCO", "SEIS", "SIETE", "OCHO", "NUEVE", "DIEZ", "ONCE", "DOCE", "TRECE", "CATORCE", "QUINCE", "DIECISÉIS", "DIECISIETE", "DIECIOCHO", "DIECINUEVE", "VEINTE" };
string[] DEC = { "", "", "VEINTE", "TREINTA", "CUARENTA", "CINCUENTA", "SESENTA", "SETENTA", "OCHENTA", "NOVENTA" };
string[] VEI = { "VEINTIUNO", "VEINTIDÓS", "VEINTITRÉS", "VEINTICUATRO", "VEINTICINCO", "VEINTISÉIS", "VEINTISIETE", "VEINTIOCHO", "VEINTINUEVE" };
string[] CEN = { "", "CIENTO", "DOSCIENTOS", "TRESCIENTOS", "CUATROCIENTOS", "QUINIENTOS", "SEISCIENTOS", "SETECIENTOS", "OCHOCIENTOS", "NOVECIENTOS" };
string Centenas(int n)
{
    if (n == 0) return ""; if (n == 100) return "CIEN"; string r = ""; int c = n / 100, d = n % 100;
    if (c > 0) r += CEN[c] + " ";
    if (d > 0) { if (d <= 20) r += UNI[d]; else { int a = d / 10, u = d % 10; if (a == 2 && u > 0) r += VEI[u - 1]; else { r += DEC[a]; if (u > 0) r += " Y " + UNI[u]; } } }
    return r.Trim();
}
string EnLetras(long n)
{
    if (n == 0) return "CERO"; string r = ""; long mill = n / 1000000; n %= 1000000; long mil = n / 1000; n %= 1000;
    if (mill > 0) r += mill == 1 ? "UN MILLÓN " : Centenas((int)mill) + " MILLONES ";
    if (mil > 0) r += mil == 1 ? "MIL " : Centenas((int)mil) + " MIL ";
    if (n > 0) r += Centenas((int)n);
    r = r.Trim(); if (r.EndsWith("UNO")) r = r.Substring(0, r.Length - 3) + "UN"; return r;
}
string ALetras(double v, string moneda, bool mn) { if (v < 0) v = 0; long e = (long)Math.Floor(v); int c = (int)Math.Round((v - e) * 100); if (c == 100) { e++; c = 0; } return EnLetras(e) + " " + moneda + " " + c.ToString("00") + "/100" + (mn ? " M.N." : ""); }

void Totales()
{
    double sub = 0, des = 0, imp = 0, pz = 0; int faltan = 0;
    for (int i = 0; i < filas.Count; i++)
    {
        var f = filas[i]; double bruto = f.Cant * f.Precio, d = bruto * f.Desc / 100.0, baseImp = bruto - d;
        sub += bruto; des += d; imp += baseImp * (percImp.ContainsKey(f.Imp) ? percImp[f.Imp] : 0); pz += f.Cant;
        if (i < grid.Rows.Count) grid.Rows[i].Cells["Importe"].Value = baseImp.ToString("N2");
        var pr = ProdPor(f.Id); if (EsVenta() && f.Origen == 0 && pr != null && !(bool)pr["servicio"] && f.Cant > ExistDe(f.Id)) faltan++;
    }
    double tot = sub - des + imp; var mon = MonedaSel(); string sim = mon == null ? "" : S(mon["simbolo"]);
    lblSub.Text = sub.ToString("N2"); lblDes.Text = "-" + des.ToString("N2"); lblDes.ForeColor = des > 0 ? C_ROJO : C_TXT; lblImp.Text = imp.ToString("N2"); lblTot.Text = tot.ToString("N2"); lblTot.ForeColor = Acento(); lblTotEt.Text = "TOTAL" + (sim != "" ? " (" + sim + ")" : "");
    lblNumPart.Text = filas.Count == 0 ? "Sin partidas" : filas.Count + " partida(s) · " + pz.ToString("0.####") + " pieza(s)";
    string palabra = mon == null ? "PESOS" : S(mon["nombre"]).ToUpperInvariant().Contains("PESO") ? "PESOS" : S(mon["nombre"]).ToUpperInvariant().Contains("EURO") ? "EUROS" : S(mon["nombre"]).ToUpperInvariant().Contains("LAR") ? "DÓLARES" : S(mon["nombre"]).ToUpperInvariant();
    lblLetra.Text = "SON: " + ALetras(tot, palabra, mon != null && S(mon["simbolo"]) == "MXN");
    var av = new List<string>();
    if (EsVenta() && entSel != null && D(entSel["credito"]) > 0 && D(entSel["saldo"]) + tot > D(entSel["credito"])) av.Add("⚠ El saldo con este documento (" + (D(entSel["saldo"]) + tot).ToString("N2") + ") excede el límite de crédito");
    if (faltan > 0) av.Add("⚠ " + faltan + " partida(s) piden más de la existencia del almacén");
    if (filas.Any(f => f.Precio <= 0)) av.Add("⚠ Hay partidas con precio en cero");
    if (ConCfdi() && ClaveDe(cmbMetodo) == "PPD" && ClaveDe(cmbForma) != "99") av.Add("⚠ Con método PPD la forma de pago debe ser 99 (por definir)");
    lblAvisos.Text = string.Join("     ", av);
    foreach (DataGridViewRow r in grid.Rows) if (r.Index < filas.Count) { var f = filas[r.Index]; var pr = ProdPor(f.Id); bool falta = EsVenta() && f.Origen == 0 && pr != null && !(bool)pr["servicio"] && f.Cant > ExistDe(f.Id); r.Cells["Exist"].Style.ForeColor = falta ? C_AMBAR : C_MUTED; }
}
void PintarGrid()
{
    grid.Rows.Clear();
    foreach (var f in filas)
    {
        var pr = ProdPor(f.Id); bool serv = pr != null && (bool)pr["servicio"];
        int r = grid.Rows.Add(f.Clave, f.Nombre + (f.Origen != 0 ? "   · de origen" : ""), serv ? "servicio" : ExistDe(f.Id).ToString("0.####"), f.Unidad, f.Cant, f.Precio, f.Desc, f.Imp, "");
        if (!impuestos.Any(o => o.Id == f.Imp)) grid.Rows[r].Cells["Imp"].Value = impuestos.FirstOrDefault()?.Id;
    }
    Totales();
}
void PintarEntidad()
{
    pastillas.Clear(); txtRfc.Text = entSel == null ? "" : S(entSel["rfc"]) == "" ? "(sin RFC)" : S(entSel["rfc"]); btnHist.Enabled = entSel != null;
    if (entSel != null)
    {
        double saldo = D(entSel["saldo"]), cred = D(entSel["credito"]);
        pastillas.Add(new Pastilla { Titulo = "Saldo abierto", Valor = saldo.ToString("N2"), Color = saldo > 0 ? C_AMBAR : C_TXT });
        if (cred > 0) { pastillas.Add(new Pastilla { Titulo = "Límite de crédito", Valor = cred.ToString("N2"), Color = C_TXT }); pastillas.Add(new Pastilla { Titulo = "Disponible", Valor = (cred - saldo).ToString("N2"), Color = cred - saldo < 0 ? C_ROJO : C_VERDE }); }
        pastillas.Add(new Pastilla { Titulo = "Último documento", Valor = S(entSel["ultimo"]) == "" ? "—" : S(entSel["ultimo"]), Color = C_TXT });
    }
    pChips.Invalidate();
}
List<Dictionary<string, object>> OrigenesVisibles()
{
    var t = TipoActual(); int mod = (int)t["origen"]; string clave = (string)t["clave"]; var vistos = new HashSet<long>(); var lista = new List<Dictionary<string, object>>();
    if (mod == 0) return lista;
    foreach (var o in origenes.Concat(pendientes))
    {
        if (I(o["modulo"]) != mod || !vistos.Add(L(o["id"]))) continue;
        var porTipo = (Dictionary<string, object>)o["partidasPor"]; if (!porTipo.ContainsKey(clave) || ((List<Dictionary<string, object>>)porTipo[clave]).Count == 0) continue;
        if (entSel != null && I(o["entidad"]) != I(entSel["id"])) continue;
        lista.Add(o);
    }
    return lista;
}
void PintarOrigenes()
{
    var t = TipoActual(); int mod = (int)t["origen"]; var os = OrigenesVisibles(); string clave = (string)t["clave"];
    bool ver = mod > 0; if (verG4 != ver) { verG4 = ver; Distribuir(); }
    lblOrigenEst.Text = ver ? (os.Count > 0 ? os.Count + " disponible(s): marca los que quieras surtir" : entSel == null ? "elige primero la persona" : "esta persona no tiene pendientes") : "";
    clbOrigen.Items.Clear();
    foreach (var o in os)
    {
        int n = ((List<Dictionary<string, object>>)((Dictionary<string, object>)o["partidasPor"])[clave]).Count;
        clbOrigen.Items.Add(new Opcion { Id = (int)L(o["id"]), Nombre = (S(o["folio"]) == "" ? "Documento " + L(o["id"]) : S(o["folio"])) + "  ·  " + S(o["entidadNombre"]) + "  ·  " + (S(o["fecha"]) != "" ? S(o["fecha"]) + "  ·  " : "") + n + " partida(s) pendiente(s)" + (D(o["total"]) > 0 ? "  ·  total " + D(o["total"]).ToString("N2") : "") }, origenSel.Contains(L(o["id"])));
    }
}
// El método de pago sigue a la condición (contado → una sola exhibición; crédito → parcialidades, forma 99) mientras la persona no lo cambie a mano
void AutoMetodo()
{
    if (!ConCfdi() || metodoManual) return; var c = cmbCond.SelectedItem as Opcion; bool contado = c != null && c.Nombre.ToUpperInvariant().Contains("CONTADO");
    suspender = true; PonerPorClave(cmbMetodo, contado ? "PUE" : "PPD"); PonerPorClave(cmbForma, contado ? "01" : "99"); suspender = false;
}
void ElegirEntidad(Dictionary<string, object> x)
{
    entSel = x; txtEnt.Text = S(x["nombre"]); lstEnt.Visible = false;
    int cond = I(x["cond"]); if ((bool)TipoActual()["condicion"] && cond > 0) PonerPorId(cmbCond, cond);
    if (I(x["moneda"]) > 0) PonerPorId(cmbMon, I(x["moneda"]));
    if (ConCfdi() && S(x["uso"]) != "") PonerPorClave(cmbUso, S(x["uso"]));
    AutoMetodo();
    pendientes = PendientesDe(L(x["id"]), (string)TipoActual()["clave"]);
    PintarEntidad(); PintarOrigenes(); PintarGrid(); txtProd.Focus();
}
void CambiarTipo(int idx)
{
    string ladoAntes = (string)TipoActual()["lado"]; tipoIdx = idx; var t = TipoActual();
    if ((string)t["lado"] != ladoAntes) { entSel = null; txtEnt.Text = ""; }
    origenSel.Clear(); pendientes.Clear(); filas.RemoveAll(f => f.Origen != 0);
    for (int i = 0; i < btnsTipo.Count; i++) { bool on = i == idx; btnsTipo[i].BackColor = on ? ((string)TIPOS[i]["lado"] == "C" ? C_VENTA : C_COMPRA) : Color.White; btnsTipo[i].ForeColor = on ? Color.White : C_TXT; btnsTipo[i].FlatAppearance.BorderColor = on ? btnsTipo[i].BackColor : C_LINE; btnsTipo[i].Font = on ? F_B : F_BASE; }
    lblRibTitulo.Text = "Nuevo documento  ·  " + (string)t["nombre"]; btnGuardar.Invalidate(); btnAgregar.BackColor = Acento();
    cmbCond.Enabled = (bool)t["condicion"]; lblEntregaEt.Visible = dtEntrega.Visible = (bool)t["entrega"];
    cmbCond.Items.Clear();
    foreach (var c in cat("condiciones").Where(c => (string)t["lado"] == "C" ? (bool)c["venta"] : (bool)c["compra"])) cmbCond.Items.Add(new Opcion { Id = I(c["id"]), Nombre = S(c["nombre"]) });
    if (cmbCond.Items.Count > 0) cmbCond.SelectedIndex = 0;
    verG3 = ConCfdi(); metodoManual = false; AutoMetodo();
    foreach (var f in filas) f.Precio = PrecioDe(f.Id);
    lblPie.Text = "Elaboró: " + (quienSoy == "" ? "—" : quienSoy) + "      Empresa: " + nombreEmpresa + "      Módulo " + (int)t["modulo"] + " · " + (string)t["nombre"];
    object fo; txtFolio.Text = folios.TryGetValue((string)t["clave"], out fo) ? "≈ " + fo : ""; txtSerie.Text = "";
    try { var a = cmbAlm.SelectedItem as Opcion; string pre = a == null ? "" : ctx.erp.GetFolioPrefix((int)t["modulo"], a.Id); txtSerie.Text = pre ?? ""; } catch { }
    PintarEntidad(); PintarOrigenes(); PintarGrid(); Distribuir();
    if (entSel != null) ElegirEntidad(entSel);
}

// ---------- búsqueda con lista desplegable (persona y producto) ----------
void Desplegar(TextBox txt, ListBox lst, IEnumerable<Dictionary<string, object>> fuente, Func<Dictionary<string, object>, string> linea1, Func<Dictionary<string, object>, string> linea2, Func<Dictionary<string, object>, string> buscar, int max)
{
    var q = txt.Text.ToLowerInvariant().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
    var vis = fuente.Where(x => { var h = buscar(x).ToLowerInvariant(); return q.All(w => h.Contains(w)); }).Take(max).ToList();
    lst.Items.Clear(); foreach (var x in vis) lst.Items.Add(new Opcion { Id = I(x["id"]), Nombre = linea1(x), Extra = linea2(x) });
    lst.Location = frm.PointToClient(txt.Parent.PointToScreen(new Point(txt.Left, txt.Bottom + 1))); lst.Height = Math.Min(280, lst.Items.Count * lst.ItemHeight + 4);
    lst.Visible = lst.Items.Count > 0; if (lst.Visible) { lst.BringToFront(); lst.SelectedIndex = 0; }
}
IEnumerable<Dictionary<string, object>> FuenteEntidad() => cat(EsVenta() ? "clientes" : "proveedores");
Action ElegirDeLista = () => { var o = lstEnt.SelectedItem as Opcion; if (o == null) return; ElegirEntidad(FuenteEntidad().First(e => I(e["id"]) == o.Id)); };
Action DespliegaEnt = () => Desplegar(txtEnt, lstEnt, FuenteEntidad(), x => S(x["nombre"]), x => (S(x["rfc"]) == "" ? "sin RFC" : S(x["rfc"])) + "   ·   saldo " + D(x["saldo"]).ToString("N2") + (D(x["credito"]) > 0 ? "   ·   crédito " + D(x["credito"]).ToString("N2") : ""), x => S(x["nombre"]) + " " + S(x["rfc"]) + " " + S(x["id"]), 60);
txtEnt.TextChanged += (_, __) => Seguro(() => { if (txtEnt.Focused) { if (entSel != null) { entSel = null; pendientes.Clear(); PintarEntidad(); PintarOrigenes(); } DespliegaEnt(); } });
txtEnt.Enter += (_, __) => Seguro(() => { txtEnt.SelectAll(); if (entSel == null) DespliegaEnt(); });
txtEnt.KeyDown += (_, ev) => { if (ev.KeyCode == Keys.Down && lstEnt.Visible) { lstEnt.Focus(); ev.Handled = true; } if (ev.KeyCode == Keys.Enter) { Seguro(ElegirDeLista); ev.SuppressKeyPress = true; } if (ev.KeyCode == Keys.Escape && lstEnt.Visible) { lstEnt.Visible = false; ev.SuppressKeyPress = true; ev.Handled = true; } };
lstEnt.Click += (_, __) => Seguro(ElegirDeLista);
lstEnt.KeyDown += (_, ev) => { if (ev.KeyCode == Keys.Enter) { Seguro(ElegirDeLista); ev.SuppressKeyPress = true; } };
txtEnt.Leave += (_, __) => { if (!lstEnt.Focused) lstEnt.Visible = false; };

void LimpiarCaptura() { prodSel = null; suspender = true; txtProd.Text = ""; suspender = false; nudCant.Value = 1; nudPrecio.Value = 0; nudDesc.Value = 0; }
void AgregarCaptura()
{
    if (prodSel == null) { txtProd.Focus(); throw new Exception("Busca y elige un producto."); }
    int id = I(prodSel["id"]); double cant = (double)nudCant.Value, precio = (double)nudPrecio.Value, desc = (double)nudDesc.Value; int imp = (cmbImp.SelectedItem as Opcion)?.Id ?? 0;
    if (cant <= 0) { nudCant.Focus(); throw new Exception("La cantidad debe ser mayor a cero."); }
    var ya = filas.FirstOrDefault(f => f.Id == id && f.Origen == 0);
    if (ya != null) { ya.Cant += cant; if (precio > 0) ya.Precio = precio; ya.Desc = desc; ya.Imp = imp; }
    else filas.Add(new Fila { Id = id, Clave = S(prodSel["clave"]), Nombre = S(prodSel["nombre"]), Unidad = S(prodSel["unidad"]), Cant = cant, Precio = precio, Desc = desc, Imp = imp });
    lstProd.Visible = false; LimpiarCaptura(); PintarGrid(); txtProd.Focus();
}
void ElegirProducto(Dictionary<string, object> p)
{
    prodSel = p; suspender = true; txtProd.Text = S(p["clave"]) + " — " + S(p["nombre"]); suspender = false; lstProd.Visible = false;
    nudCant.Value = 1; nudPrecio.Value = (decimal)PrecioDe(I(p["id"])); nudDesc.Value = (decimal)Math.Min(100, EsVenta() && entSel != null ? D(entSel["desc"]) : 0); PonerPorId(cmbImp, I(p["imp"]));
    nudCant.Focus(); nudCant.Select(0, 10);
}
Action ElegirDeListaProd = () =>
{
    string v = txtProd.Text.Trim(); Dictionary<string, object> p = null;
    if (v != "") p = productos.FirstOrDefault(x => (S(x["barras"]) != "" && S(x["barras"]) == v) || string.Equals(S(x["clave"]), v, StringComparison.OrdinalIgnoreCase));
    if (p != null) { ElegirProducto(p); AgregarCaptura(); return; }                      // código de barras o clave exacta: se agrega directo (flujo de lector)
    var o = lstProd.Visible ? lstProd.SelectedItem as Opcion : null;
    if (o != null) { ElegirProducto(productos.First(x => I(x["id"]) == o.Id)); return; }
    if (prodSel != null) AgregarCaptura();
};
Action DespliegaProd = () => Desplegar(txtProd, lstProd, productos, x => S(x["nombre"]), x => (S(x["clave"]) != "" ? S(x["clave"]) + "   ·   " : "") + ((bool)x["servicio"] ? "servicio" : "existencia " + ExistDe(I(x["id"])).ToString("0.####")) + "   ·   precio " + PrecioDe(I(x["id"])).ToString("N2"), x => S(x["nombre"]) + " " + S(x["clave"]) + " " + S(x["barras"]), 60);
txtProd.TextChanged += (_, __) => Seguro(() => { if (txtProd.Focused && !suspender) { prodSel = null; DespliegaProd(); } });
txtProd.KeyDown += (_, ev) => { if (ev.KeyCode == Keys.Down && lstProd.Visible) { lstProd.Focus(); ev.Handled = true; } if (ev.KeyCode == Keys.Enter) { Seguro(ElegirDeListaProd); ev.SuppressKeyPress = true; } if (ev.KeyCode == Keys.Escape && lstProd.Visible) { lstProd.Visible = false; ev.SuppressKeyPress = true; ev.Handled = true; } };
lstProd.Click += (_, __) => Seguro(ElegirDeListaProd);
lstProd.KeyDown += (_, ev) => { if (ev.KeyCode == Keys.Enter) { Seguro(ElegirDeListaProd); ev.SuppressKeyPress = true; } };
txtProd.Leave += (_, __) => { if (!lstProd.Focused) lstProd.Visible = false; };
btnBuscaProd.Click += (_, __) => Seguro(() => { txtProd.Text = ""; txtProd.Focus(); DespliegaProd(); });
foreach (Control c in new Control[] { nudCant, nudPrecio, nudDesc }) c.KeyDown += (_, ev) => { if (ev.KeyCode == Keys.Enter) { Seguro(AgregarCaptura); ev.SuppressKeyPress = true; } };
btnAgregar.Click += (_, __) => Seguro(AgregarCaptura);
btnQuitar.Click += (_, __) => Seguro(() => { if (grid.CurrentRow != null && grid.CurrentRow.Index >= 0 && grid.CurrentRow.Index < filas.Count) { filas.RemoveAt(grid.CurrentRow.Index); PintarGrid(); } });

grid.CellEndEdit += (_, ev) => Seguro(() =>
{
    if (ev.RowIndex < 0 || ev.RowIndex >= filas.Count) return;
    var f = filas[ev.RowIndex]; string col = grid.Columns[ev.ColumnIndex].Name; var v = grid.Rows[ev.RowIndex].Cells[col].Value;
    double n; double.TryParse(Convert.ToString(v, CultureInfo.CurrentCulture), NumberStyles.Any, CultureInfo.CurrentCulture, out n); if (n < 0) n = 0;
    if (col == "Cant") { f.Cant = f.Max > 0 && n > f.Max ? f.Max : n; grid.Rows[ev.RowIndex].Cells["Cant"].Value = f.Cant; }
    else if (col == "Precio") f.Precio = n;
    else if (col == "DescPerc") { f.Desc = Math.Min(100, n); grid.Rows[ev.RowIndex].Cells["DescPerc"].Value = f.Desc; }
    else if (col == "Imp" && v != null) f.Imp = Convert.ToInt32(v);
    Totales();
});
grid.CurrentCellDirtyStateChanged += (_, __) => { if (grid.IsCurrentCellDirty && grid.CurrentCell is DataGridViewComboBoxCell) grid.CommitEdit(DataGridViewDataErrorContexts.Commit); };
grid.DataError += (_, ev) => ev.ThrowException = false;
grid.KeyDown += (_, ev) => { if (ev.KeyCode == Keys.Delete && !grid.IsCurrentCellInEditMode) Seguro(() => { if (grid.CurrentRow != null && grid.CurrentRow.Index < filas.Count) { filas.RemoveAt(grid.CurrentRow.Index); PintarGrid(); } }); };
cmbAlm.SelectedIndexChanged += (_, __) => Seguro(() => { PintarGrid(); try { var a = cmbAlm.SelectedItem as Opcion; txtSerie.Text = a == null ? "" : ctx.erp.GetFolioPrefix((int)TipoActual()["modulo"], a.Id) ?? ""; } catch { } });
cmbMon.SelectedIndexChanged += (_, __) => Seguro(() => { var m = MonedaSel(); if (m != null) { nudTC.Value = (decimal)Math.Max(0.0001, D(m["tc"])); nudTC.Enabled = S(m["simbolo"]) != "MXN"; } Totales(); });
cmbCond.SelectedIndexChanged += (_, __) => Seguro(AutoMetodo);
cmbMetodo.SelectionChangeCommitted += (_, __) => Seguro(() => { metodoManual = true; if (ClaveDe(cmbMetodo) == "PPD") { suspender = true; PonerPorClave(cmbForma, "99"); suspender = false; } Totales(); });
cmbForma.SelectionChangeCommitted += (_, __) => Seguro(() => { metodoManual = true; Totales(); });

clbOrigen.ItemCheck += (_, ev) => frm.BeginInvoke(new Action(() => Seguro(() =>
{
    origenSel.Clear();
    foreach (var o in clbOrigen.CheckedItems.Cast<Opcion>()) origenSel.Add(o.Id);
    var t = TipoActual(); var os = OrigenesVisibles().Where(o => origenSel.Contains(L(o["id"]))).ToList();
    if (os.Select(o => I(o["entidad"])).Distinct().Count() > 1) throw new Exception("Los documentos de origen son de entidades distintas: quita alguno.");
    filas.RemoveAll(f => f.Origen != 0);
    foreach (var o in os)
    {
        var porTipo = (Dictionary<string, object>)o["partidasPor"]; if (!porTipo.ContainsKey((string)t["clave"])) continue;
        foreach (var p in (List<Dictionary<string, object>>)porTipo[(string)t["clave"]])
            filas.Add(new Fila { Id = I(p["id"]), Clave = S(p["clave"]), Nombre = S(p["nombre"]), Unidad = S(p["unidad"]), Cant = D(p["cant"]), Max = D(p["cant"]), Precio = D(p["precio"]), Desc = D(p["desc"]), Imp = I(p["imp"]), OrigenItem = L(p["origenItem"]), Origen = L(o["id"]) });
    }
    if (os.Count > 0)
    {
        var en = FuenteEntidad().FirstOrDefault(e => I(e["id"]) == I(os[0]["entidad"]));
        if (en != null && (entSel == null || I(entSel["id"]) != I(en["id"]))) { entSel = en; txtEnt.Text = S(en["nombre"]); PintarEntidad(); }
        for (int i = 0; i < cmbAlm.Items.Count; i++) if (((Opcion)cmbAlm.Items[i]).Id == I(os[0]["almacen"])) cmbAlm.SelectedIndex = i;
    }
    PintarGrid();
})));

// historial de la persona: ventana aparte, también sin bloquear
btnHist.Click += (_, __) => Seguro(() =>
{
    if (entSel == null) return; var ult = UltimosDe(L(entSel["id"]));
    var h = new Form { Text = "Últimos documentos · " + S(entSel["nombre"]), Size = new Size(640, 330), StartPosition = FormStartPosition.CenterParent, BackColor = Color.White, Font = F_BASE, MinimizeBox = true, MaximizeBox = false };
    var l = new ListBox { Dock = DockStyle.Fill, BorderStyle = BorderStyle.None, DrawMode = DrawMode.OwnerDrawFixed, ItemHeight = 42, IntegralHeight = false };
    l.DrawItem += (s, ev) => dibujaLista(l, ev);
    foreach (var d in ult) l.Items.Add(new Opcion { Id = I(d["id"]), Extra = S(d["fecha"]) + "   ·   total " + D(d["total"]).ToString("N2") + (D(d["saldo"]) > 0 ? "   ·   saldo " + D(d["saldo"]).ToString("N2") : ""), Nombre = S(d["tipo"]) + " " + S(d["folio"]) });
    var modulos = ult.ToDictionary(d => I(d["id"]), d => I(d["modulo"]));
    l.DoubleClick += (s, ev) => Seguro(() => { var o = l.SelectedItem as Opcion; if (o != null && modulos.ContainsKey(o.Id)) ctx.erp.AbrirDocumento(o.Id, modulos[o.Id]); });
    h.Controls.Add(l); h.Controls.Add(new Label { Text = "Doble clic para abrir el documento en Comercial", Dock = DockStyle.Bottom, Height = 26, ForeColor = C_MUTED, Font = F_SM, TextAlign = ContentAlignment.MiddleLeft, Padding = new Padding(10, 0, 0, 0) });
    h.Show(frm);
});

void Limpiar()
{
    entSel = null; txtEnt.Text = ""; filas.Clear(); origenSel.Clear(); pendientes.Clear(); txtTitulo.Text = ""; txtComent.Text = ""; LimpiarCaptura(); metodoManual = false; AutoMetodo();
    PintarEntidad(); PintarOrigenes(); PintarGrid(); txtEnt.Focus();
}
void Crear(bool otro)
{
    if (guardando) return; var t = TipoActual();
    if (entSel == null) { txtEnt.Focus(); throw new Exception("Elige el " + ((string)t["lado"] == "C" ? "cliente" : "proveedor") + " de la lista (escribe y selecciona)."); }
    if (filas.Count == 0) { txtProd.Focus(); throw new Exception("Agrega al menos una partida."); }
    if (filas.Any(f => f.Cant <= 0)) throw new Exception("Todas las partidas deben tener cantidad mayor a cero.");
    if (ConCfdi() && (ClaveDe(cmbUso) == "" || ClaveDe(cmbForma) == "" || ClaveDe(cmbMetodo) == "")) throw new Exception("Completa los datos fiscales: uso del CFDI, forma de pago y método de pago.");
    var spec = new Dictionary<string, object>
    {
        ["tipo"] = (string)t["clave"], ["almacen"] = ((Opcion)cmbAlm.SelectedItem)?.Id ?? 0, ["entidad"] = I(entSel["id"]),
        ["condicion"] = (bool)t["condicion"] ? ((Opcion)cmbCond.SelectedItem)?.Id ?? 0 : 0,
        ["fecha"] = dtFecha.Value.ToString("yyyy-MM-dd"), ["entrega"] = (bool)t["entrega"] ? dtEntrega.Value.ToString("yyyy-MM-dd") : "",
        ["titulo"] = txtTitulo.Text, ["comentarios"] = txtComent.Text, ["origenes"] = origenSel.Cast<object>().ToList(),
        ["moneda"] = ((Opcion)cmbMon.SelectedItem)?.Id ?? 0, ["tc"] = (double)nudTC.Value, ["centro"] = ((Opcion)cmbCC.SelectedItem)?.Id ?? 0,
        ["partidas"] = filas.Select(f => (object)new Dictionary<string, object> { ["id"] = f.Id, ["nombre"] = f.Nombre, ["cant"] = f.Cant, ["precio"] = f.Precio, ["desc"] = f.Desc, ["imp"] = f.Imp, ["origenItem"] = f.OrigenItem }).ToList()
    };
    if (ConCfdi()) { spec["uso"] = ClaveDe(cmbUso); spec["forma"] = ClaveDe(cmbForma); spec["metodo"] = ClaveDe(cmbMetodo); }
    guardando = true; Cursor.Current = Cursors.WaitCursor;
    long doc;
    try { doc = CrearDocumento(spec); }
    finally { guardando = false; Cursor.Current = Cursors.Default; }
    try { ctx.erp.RefreshGrid(); } catch { }
    string folio = ""; try { folio = S(ctx.Scalar("SELECT ISNULL(FolioPrefix,'') + CAST(ISNULL(Folio,'') AS NVARCHAR(30)) FROM docDocument WHERE DocumentID = " + doc)); } catch { }
    string abrirMal = null;
    try { ctx.erp.AbrirDocumento((int)doc, (int)t["modulo"]); } catch (Exception ex) { abrirMal = ex.Message; }          // SIEMPRE se abre el documento nativo del sistema
    if (abrirMal != null) MessageBox.Show("El documento " + (folio == "" ? doc.ToString() : folio) + " se creó, pero no se pudo abrir en Comercial:\n" + abrirMal + "\n\nBúscalo por su folio.", "Crear documento", MessageBoxButtons.OK, MessageBoxIcon.Information);
    if (otro) { Limpiar(); Aviso("Documento " + (folio == "" ? doc.ToString() : folio) + " creado" + (abrirMal == null ? " y abierto en Comercial." : ".")); }
    else frm.Close();
}
frm.KeyDown += (_, ev) =>
{
    if (ev.KeyCode == Keys.F5) { Seguro(() => Crear(false)); ev.Handled = true; }
    else if (ev.KeyCode == Keys.F6) { Seguro(() => Crear(true)); ev.Handled = true; }
    else if (ev.KeyCode == Keys.F2) { txtEnt.Focus(); ev.Handled = true; }
    else if (ev.KeyCode == Keys.F3) { txtProd.Focus(); ev.Handled = true; }
    else if (ev.KeyCode == Keys.Escape && !lstEnt.Visible && !lstProd.Visible) { frm.Close(); ev.Handled = true; }
};

// ---------- Arranque: modeless ----------
{ var m0 = MonedaSel(); if (m0 != null) { nudTC.Value = (decimal)Math.Max(0.0001, D(m0["tc"])); nudTC.Enabled = S(m0["simbolo"]) != "MXN"; } }
CambiarTipo(0);
if (origenes.Count > 0)                   // seleccionados en la lista de Comercial: se propone el tipo que parte de ellos y se marcan
{
    int ti = TIPOS.FindIndex(t => (int)t["origen"] == I(origenes[0]["modulo"]));
    if (ti >= 0) { CambiarTipo(ti); for (int i = 0; i < clbOrigen.Items.Count; i++) clbOrigen.SetItemChecked(i, true); }
}
Distribuir();
string capturaPrueba = Environment.GetEnvironmentVariable("BROSLMV_DOC_SHOT");        // pruebas: guarda una captura de la ventana (con datos de ejemplo) y no la deja abierta
if (!string.IsNullOrEmpty(capturaPrueba))
{
    int tipoShot = int.TryParse(Environment.GetEnvironmentVariable("BROSLMV_DOC_SHOT_TIPO"), out var ts) ? ts : 0; CambiarTipo(tipoShot);
    var lista = FuenteEntidad().ToList(); if (lista.Count > 0) ElegirEntidad(lista.OrderByDescending(e => D(e["saldo"])).First());
    foreach (var p in productos.Take(3)) { ElegirProducto(p); AgregarCaptura(); }
    frm.Show(); Application.DoEvents(); frm.PerformLayout(); Distribuir(); Application.DoEvents();
    using (var bmp = new Bitmap(frm.Width, frm.Height)) { frm.DrawToBitmap(bmp, new Rectangle(0, 0, frm.Width, frm.Height)); bmp.Save(capturaPrueba, System.Drawing.Imaging.ImageFormat.Png); }
    frm.Dispose(); return "CAPTURA";
}
frm.Show();
return "Ventana de creación de documentos abierta.";
