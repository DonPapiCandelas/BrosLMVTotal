// lang: csharp
// AppKey recomendado: CREAR_DOCUMENTO_WINFORMS
// Plantilla: Crear documento (C# · ventana Windows Forms)
// Categoria: Documentos
// Documentacion: CREAR_DOCUMENTO.html
// job: safe-offline
// Crea un documento de Comercial desde una ventana de Windows Forms: factura de cliente, pedido, remisión, factura de compra, orden de compra o recepción.
// Es una plantilla de EJEMPLO funcional: ábrela, pruébala, y copia lo que necesites. Documentación: clic secundario sobre la plantilla → «Ver documentación».
//
// Qué enseña:
//   · El patrón completo de creación: NuevoDocumento → perfil del módulo → AgregarArticulo × N → RecalcCompleto → AffectStockNEW (solo si el módulo lo pide) → Save → agenda de pago.
//   · Documentos DERIVADOS: selecciona antes una o varias órdenes de compra (o un pedido) en la lista y la ventana ofrece partir de ellas con lo que aún falta por surtir.
//   · Ventana modeless (Show, nunca ShowDialog) con try/catch en cada manejador, como exige MANUAL §10.2.
// Para un botón de un solo tipo (por ejemplo solo «Orden de compra») deja esa fila en la tabla TIPOS y borra las demás.

using System;
using System.Collections.Generic;
using System.Drawing;
using System.Globalization;
using System.Linq;
using System.Web.Script.Serialization;
using System.Windows.Forms;

var ci = CultureInfo.InvariantCulture;
var ser = new JavaScriptSerializer { MaxJsonLength = 128 * 1024 * 1024 };

string S(object v) => v == null || v is DBNull ? "" : Convert.ToString(v, ci);
long L(object v) { try { return v == null || v is DBNull ? 0 : Convert.ToInt64(v, ci); } catch { return 0; } }
int I(object v) { try { return v == null || v is DBNull ? 0 : Convert.ToInt32(v, ci); } catch { return 0; } }
double D(object v) { try { return v == null || v is DBNull ? 0.0 : Convert.ToDouble(v, ci); } catch { return 0.0; } }
bool Nulo(object v) => v == null || v is DBNull;
string Sq(string s) => (s ?? "").Replace("'", "''");                       // texto para un literal SQL
string Num(double d) => d.ToString("0.########", ci);                       // número para un literal SQL (siempre con punto)

int empresa = ctx.erp.OwnedBusinessEntityId;

// ---------- Borrador y preferencias (archivos en la carpeta local de datos de la persona) ----------
// El borrador guarda lo capturado cada vez que cambia algo: si la ventana se cierra sin querer (o Comercial se cae) se puede recuperar al abrirla de nuevo.
string CarpetaLocal() { string d = System.IO.Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "BrosLMV", "borradores"); System.IO.Directory.CreateDirectory(d); return d; }
string ArchivoBorrador(string que) { int u = 0; try { u = ctx.erp.UserId; } catch { } return System.IO.Path.Combine(CarpetaLocal(), que + "_" + empresa + "_" + u + ".json"); }
string LeerBorrador(string que, bool vence = true) { try { string a = ArchivoBorrador(que); if (!System.IO.File.Exists(a) || (vence && (DateTime.Now - System.IO.File.GetLastWriteTime(a)).TotalDays > 7)) return null; return System.IO.File.ReadAllText(a, System.Text.Encoding.UTF8); } catch { return null; } }
void GuardarBorrador(string que, string json) { try { System.IO.File.WriteAllText(ArchivoBorrador(que), json, new System.Text.UTF8Encoding(false)); } catch { } }
void BorrarBorrador(string que) { try { string a = ArchivoBorrador(que); if (System.IO.File.Exists(a)) System.IO.File.Delete(a); } catch { } }

// ===================================================================================================================================
// TIPOS DE DOCUMENTO. Cada fila es el «perfil» que Comercial espera de ese módulo (confirmado contra capturas del documento nativo).
// Para quitar un tipo del formulario borra su fila; para agregar otro, copia una fila y ajusta sus datos. Nada más depende de esta tabla.
//   clave · nombre · módulo · lado (C = cliente, P = proveedor) · de dónde sale el precio (venta/compra) · perfil SQL de encabezado ·
//   ¿lleva condición de pago? · ¿lleva fecha de entrega? · cómo se liga al origen (""/cabecera/partida/entrega) · módulo de origen
// ===================================================================================================================================
Dictionary<string, object> T(string clave, string nombre, int modulo, string lado, string precio, string perfil, bool condicion, bool entrega, string vinculo, int origen) =>
    new Dictionary<string, object> { ["clave"] = clave, ["nombre"] = nombre, ["modulo"] = modulo, ["lado"] = lado, ["precio"] = precio, ["perfil"] = perfil,
        ["condicion"] = condicion, ["entrega"] = entrega, ["vinculo"] = vinculo, ["origen"] = origen };
var TIPOS = new List<Dictionary<string, object>>
{
    T("factura_cliente", "Factura de cliente",   21,  "C", "venta",  "DepotIDFrom=0, StatusDeliveryID=0",                                  true,  false, "",         0),
    T("pedido",          "Pedido de cliente",    967, "C", "venta",  "DepotIDFrom=0, StatusDeliveryID=3, StatusPaidID=0",                  true,  true,  "",         0),
    T("remision",        "Remisión (entrega)",   157, "C", "venta",  "DepotIDFrom=0, PaymentTermID=0, StatusDeliveryID=0",                 false, true,  "cabecera", 967),
    T("factura_compra",  "Factura de compra",    152, "P", "compra", "DepotIDFrom=0, StatusPaidID=3",                                      true,  false, "partida",  183),
    T("orden_compra",    "Orden de compra",      183, "P", "compra", "DepotIDFrom=0, UserID=0",                                            true,  true,  "",         0),
    T("recepcion",       "Recepción de compra",  184, "P", "compra", "DepotIDFrom=0, UserID=0, PaymentTermID=0, StatusDeliveryID=0",        false, true,  "entrega",  183),
};
var tipoPor = TIPOS.ToDictionary(t => (string)t["clave"]);
bool LlevaCfdi(string clave) => clave == "factura_cliente";          // uso del CFDI, forma y método de pago: solo el comprobante fiscal

// ---------- Catálogos para el formulario ----------
Dictionary<string, object> Catalogos(IEnumerable<string> claves)
{
    var cat = new Dictionary<string, object>();
    cat["almacenes"] = ctx.Query("SELECT DepotID AS id, DepotName AS nombre FROM orgDepot WHERE DeletedOn IS NULL AND OwnedBusinessEntityID = " + empresa + " ORDER BY DepotName")
        .Select(r => new Dictionary<string, object> { ["id"] = I(r["id"]), ["nombre"] = S(r["nombre"]) }).ToList();
    // Cliente o proveedor con lo que ayuda a decidir al capturar: RFC, condición de pago y descuento habituales, límite de crédito, saldo abierto y fecha de su último documento.
    // Saldo = facturas, notas de cargo, recibos y gastos con saldo menos notas de crédito con saldo (docDocument.Balance; es la foto de hoy).
    string ent(string tabla) =>
        "SELECT be.BusinessEntityID AS id, ISNULL(be.CommercialName, be.OfficialName) AS nombre, ISNULL(mi.OfficialNumber,'') AS rfc, ISNULL(x.PaymentTermID,0) AS cond, ISNULL(x.Discount,0) AS descto, " +
        "ISNULL(x.CreditLimit,0) AS credito, ISNULL(sd.Saldo,0) AS saldo, sd.Ultimo AS ultimo, ISNULL(x.CurrencyID,0) AS moneda, " + (tabla == "orgCustomer" ? "ISNULL(x.ReceptorUsoCFDI,'')" : "''") + " AS uso FROM " + tabla + " x " +
        "JOIN orgBusinessEntity be ON be.BusinessEntityID = x.BusinessEntityID LEFT JOIN orgBusinessEntityMainInfo mi ON mi.BusinessEntityID = be.BusinessEntityID " +
        "LEFT JOIN (SELECT d.BusinessEntityID, SUM(CASE WHEN d.DocumentTypeID = 6 THEN -ISNULL(d.Balance,0) ELSE ISNULL(d.Balance,0) END) AS Saldo, MAX(d.DateDocument) AS Ultimo FROM docDocument d " +
        "  WHERE d.DeletedOn IS NULL AND d.CancelledOn IS NULL AND d.OwnedBusinessEntityID = " + empresa + " AND d.DocumentTypeID IN (5,6,7,8,9,13) GROUP BY d.BusinessEntityID) sd ON sd.BusinessEntityID = be.BusinessEntityID " +
        "WHERE be.DeletedOn IS NULL AND x.DeletedOn IS NULL ORDER BY nombre";
    Func<string, List<Dictionary<string, object>>> lista = tabla => ctx.Query(ent(tabla))
        .Select(r => new Dictionary<string, object> { ["id"] = I(r["id"]), ["nombre"] = S(r["nombre"]), ["rfc"] = S(r["rfc"]), ["cond"] = I(r["cond"]), ["desc"] = D(r["descto"]),
            ["credito"] = D(r["credito"]), ["saldo"] = D(r["saldo"]), ["moneda"] = I(r["moneda"]), ["uso"] = S(r["uso"]), ["ultimo"] = Nulo(r["ultimo"]) ? "" : Convert.ToDateTime(r["ultimo"], ci).ToString("yyyy-MM-dd") }).ToList();
    var lados = TIPOS.Where(t => claves.Contains((string)t["clave"])).Select(t => (string)t["lado"]).Distinct().ToList();
    cat["clientes"] = lados.Contains("C") ? lista("orgCustomer") : new List<Dictionary<string, object>>();
    cat["proveedores"] = lados.Contains("P") ? lista("orgSupplier") : new List<Dictionary<string, object>>();
    cat["condiciones"] = ctx.Query("SELECT PaymentTermID AS id, PaymentTermName AS nombre, Sales AS v, Buys AS c FROM engPaymentTerm WHERE DeletedOn IS NULL ORDER BY PaymentTermID")
        .Select(r => new Dictionary<string, object> { ["id"] = I(r["id"]), ["nombre"] = S(r["nombre"]), ["venta"] = I(r["v"]) == 1, ["compra"] = I(r["c"]) == 1 }).ToList();
    // Moneda con su tipo de cambio vigente; catálogos del SAT (forma de pago, método de pago, uso del CFDI) tal como los guarda Comercial; centros de costo de la empresa
    cat["monedas"] = ctx.Query("SELECT CurrencyID AS id, IntlSymbol AS simbolo, Currency AS nombre, Rate AS tc FROM vwLBSCurrencyList ORDER BY CurrencyID")
        .Select(r => new Dictionary<string, object> { ["id"] = I(r["id"]), ["simbolo"] = S(r["simbolo"]), ["nombre"] = S(r["nombre"]), ["tc"] = D(r["tc"]) }).ToList();
    Func<string, string, List<Dictionary<string, object>>> sat = (g1, g2) =>
    {
        var l = ctx.Query("SELECT ISNULL(Custom1,'') AS clave, ItemValue AS nombre FROM engRefCombo WHERE DeletedOn IS NULL AND CboGroupName = N'" + g1 + "' AND ISNULL(Custom1,'') <> '' ORDER BY CboOrder, ItemData");
        if (l.Count == 0 && g2 != null) l = ctx.Query("SELECT ISNULL(Custom1,'') AS clave, ItemValue AS nombre FROM engRefCombo WHERE DeletedOn IS NULL AND CboGroupName = N'" + g2 + "' AND ISNULL(Custom1,'') <> '' ORDER BY CboOrder, ItemData");
        return l.Select(r => new Dictionary<string, object> { ["clave"] = S(r["clave"]), ["nombre"] = S(r["nombre"]) }).ToList();
    };
    cat["formas"] = sat("Anexo20v33_FormaPago", null);
    cat["metodos"] = sat("Anexo20v33_MetodoDePago", null);
    cat["usos"] = sat("Anexo20v40_UsoCFDI", "Anexo20v33_UsoCFDI");
    cat["centros"] = ctx.Query("SELECT CostCenterID AS id, CostCenterName AS nombre FROM orgCostCenter WHERE DeletedOn IS NULL AND OwnedBusinessEntityID IN (0, " + empresa + ") ORDER BY CostCenterName")
        .Select(r => new Dictionary<string, object> { ["id"] = I(r["id"]), ["nombre"] = S(r["nombre"]) }).ToList();
    cat["impuestos"] = ctx.Query("SELECT t.TaxTypeID AS id, t.TaxTypeName AS nombre, ISNULL(tp.IVA_Perc,0) AS perc FROM vwLBSTaxType t LEFT JOIN vwLBSTaxPerc tp ON tp.TaxTypeID = t.TaxTypeID ORDER BY t.TaxTypeName")
        .Select(r => new Dictionary<string, object> { ["id"] = I(r["id"]), ["nombre"] = S(r["nombre"]), ["perc"] = D(r["perc"]) }).ToList();
    // Productos: lo mínimo para buscar y poner precio. Tope de seguridad: un catálogo enorme se carga por completo pero se avisa.
    cat["productos"] = ctx.Query("SELECT TOP 30000 ProductID AS id, ISNULL(ProductKey,'') AS clave, ProductName AS nombre, ISNULL(Unit,'') AS unidad, ISNULL(TaxTypeID,0) AS imp, " +
        "ISNULL(PriceList,0) AS venta, ISNULL(CostPrice,0) AS costo, ISNULL(BarCode,'') AS barras, ISNULL(UseLot,0) AS lote, ISNULL(UseSerialNumber,0) AS serie, ISNULL(ProductIsService,0) AS servicio " +
        "FROM orgProduct WHERE DeletedOn IS NULL ORDER BY ProductName")
        .Select(r => new Dictionary<string, object> { ["id"] = I(r["id"]), ["clave"] = S(r["clave"]), ["nombre"] = S(r["nombre"]), ["unidad"] = S(r["unidad"]), ["imp"] = I(r["imp"]),
            ["venta"] = D(r["venta"]), ["costo"] = D(r["costo"]), ["barras"] = S(r["barras"]), ["lote"] = I(r["lote"]) == 1, ["serie"] = I(r["serie"]) == 1, ["servicio"] = I(r["servicio"]) == 1 }).ToList();
    // Existencias por almacén (suma del kardex): {productoId: {almacenId: cantidad}}; un producto sin movimientos no aparece (existencia 0)
    var exist = new Dictionary<string, object>();
    try
    {
        foreach (var r in ctx.Query("SELECT ProductID, DepotID, SUM(Quantity) AS Q FROM orgProductKardex WHERE ISNULL(Cancelled,0) = 0 GROUP BY ProductID, DepotID HAVING ABS(SUM(Quantity)) > 0.00001"))
        {
            string pid = S(r["ProductID"]); if (!exist.ContainsKey(pid)) exist[pid] = new Dictionary<string, object>();
            ((Dictionary<string, object>)exist[pid])[S(r["DepotID"])] = Math.Round(D(r["Q"]), 4);
        }
    }
    catch { }
    cat["existencias"] = exist;
    // Siguiente folio probable de cada tipo (lo asigna Comercial al guardar; aquí solo se muestra)
    var folios = new Dictionary<string, object>();
    foreach (var t in TIPOS.Where(t => claves.Contains((string)t["clave"])))
        folios[(string)t["clave"]] = I(ctx.Scalar("SELECT ISNULL((SELECT TOP 1 ISNULL(TRY_CONVERT(int, Folio),0) + 1 FROM docDocument WHERE ModuleID = " + (int)t["modulo"] + " AND OwnedBusinessEntityID = " + empresa + " AND DeletedOn IS NULL ORDER BY DocumentID DESC), 1)"));          // el folio del último documento + 1
    cat["folios"] = folios;
    return cat;
}

// ---------- Documentos de origen (los que estaban seleccionados al lanzar el botón) ----------
// Para cada documento seleccionado cuyo módulo sirve de origen de algún tipo: sus partidas con lo que AÚN falta por surtir PARA CADA TIPO DERIVADO
// (una orden de compra puede estar toda recibida y aún sin facturar). «Lo ya surtido» se cuenta por la columna de vínculo propia de cada tipo:
//   Recepción → DeliverDocumentItemID · Factura de compra → SourceDocumentItemID · Remisión → por producto, dentro de las remisiones que apuntan al pedido (SourceDocumentID).
List<Dictionary<string, object>> Origenes(IList<long> ids)
{
    var res = new List<Dictionary<string, object>>();
    if (ids == null || ids.Count == 0) return res;
    var docs = ctx.Query("SELECT d.DocumentID, d.ModuleID, d.FolioPrefix, d.Folio, d.BusinessEntityID, d.DepotID, d.DateDocument, ISNULL(d.Total,0) AS Total, ISNULL(be.CommercialName, be.OfficialName) AS Entidad FROM docDocument d " +
        "LEFT JOIN orgBusinessEntity be ON be.BusinessEntityID = d.BusinessEntityID WHERE d.DocumentID IN (" + string.Join(",", ids.Select(x => x.ToString(ci))) + ") " +
        "AND d.DeletedOn IS NULL AND d.CancelledOn IS NULL AND d.OwnedBusinessEntityID = " + empresa);
    foreach (var d in docs)
    {
        int mod = I(d["ModuleID"]); long id = L(d["DocumentID"]);
        var derivados = TIPOS.Where(t => (int)t["origen"] == mod).ToList();
        if (derivados.Count == 0) continue;
        var porTipo = new Dictionary<string, object>();
        foreach (var t in derivados)
        {
            string v = (string)t["vinculo"]; int mDer = (int)t["modulo"];
            string sql;
            if (v == "cabecera")
                sql = "SELECT MIN(i.DocumentItemID) AS Item, i.ProductID, ISNULL(MAX(p.ProductKey),'') AS Clave, MAX(i.Description) AS Descr, ISNULL(MAX(i.Unit),'') AS Unidad, " +
                      "SUM(i.Quantity) - ISNULL((SELECT SUM(x.Quantity) FROM docDocumentItem x JOIN docDocument xd ON xd.DocumentID = x.DocumentID WHERE x.DeletedOn IS NULL AND xd.DeletedOn IS NULL AND xd.CancelledOn IS NULL " +
                      "  AND xd.SourceDocumentID = " + id + " AND xd.ModuleID = " + mDer + " AND x.ProductID = i.ProductID), 0) AS Pend, MAX(ISNULL(i.UnitPrice,0)) AS Precio, MAX(ISNULL(i.DiscountPerc,0)) AS Descuento, MAX(ISNULL(i.TaxTypeID,0)) AS Imp " +
                      "FROM docDocumentItem i LEFT JOIN orgProduct p ON p.ProductID = i.ProductID WHERE i.DocumentID = " + id + " AND i.DeletedOn IS NULL AND i.ProductID > 0 GROUP BY i.ProductID ORDER BY MIN(i.DocumentItemID)";
            else
            {
                string col = v == "entrega" ? "x.DeliverDocumentItemID" : "x.SourceDocumentItemID";
                sql = "SELECT i.DocumentItemID AS Item, i.ProductID, ISNULL(p.ProductKey,'') AS Clave, i.Description AS Descr, ISNULL(i.Unit,'') AS Unidad, " +
                      "i.Quantity - ISNULL((SELECT SUM(x.Quantity) FROM docDocumentItem x JOIN docDocument xd ON xd.DocumentID = x.DocumentID WHERE x.DeletedOn IS NULL AND xd.DeletedOn IS NULL AND xd.CancelledOn IS NULL " +
                      "  AND " + col + " = i.DocumentItemID AND xd.ModuleID = " + mDer + "), 0) AS Pend, ISNULL(i.UnitPrice,0) AS Precio, ISNULL(i.DiscountPerc,0) AS Descuento, ISNULL(i.TaxTypeID,0) AS Imp " +
                      "FROM docDocumentItem i LEFT JOIN orgProduct p ON p.ProductID = i.ProductID WHERE i.DocumentID = " + id + " AND i.DeletedOn IS NULL AND i.ProductID > 0 ORDER BY i.DocumentItemID";
            }
            var items = new List<Dictionary<string, object>>();
            foreach (var p in ctx.Query(sql))
            {
                double pend = D(p["Pend"]);
                if (pend <= 0.00001) continue;
                items.Add(new Dictionary<string, object> { ["origenItem"] = L(p["Item"]), ["id"] = I(p["ProductID"]), ["clave"] = S(p["Clave"]), ["nombre"] = S(p["Descr"]),
                    ["unidad"] = S(p["Unidad"]), ["cant"] = pend, ["precio"] = D(p["Precio"]), ["desc"] = Math.Round(D(p["Descuento"]) * 100.0, 4), ["imp"] = I(p["Imp"]) });
            }
            porTipo[(string)t["clave"]] = items;
        }
        res.Add(new Dictionary<string, object> { ["id"] = id, ["modulo"] = mod, ["folio"] = (S(d["FolioPrefix"]) + S(d["Folio"])).Trim(), ["entidad"] = I(d["BusinessEntityID"]),
            ["entidadNombre"] = S(d["Entidad"]), ["almacen"] = I(d["DepotID"]), ["fecha"] = Nulo(d["DateDocument"]) ? "" : Convert.ToDateTime(d["DateDocument"], ci).ToString("yyyy-MM-dd"), ["total"] = D(d["Total"]), ["partidasPor"] = porTipo });
    }
    return res;
}

// ---------- Consultas en vivo (las pide la ventana mientras se captura) ----------
// Documentos que sirven de origen para el tipo elegido y que pertenecen a esa persona: los 40 más recientes del módulo de origen con partidas que aún faltan por surtir.
List<Dictionary<string, object>> PendientesDe(long entidad, string claveTipo)
{
    if (!tipoPor.ContainsKey(claveTipo) || entidad <= 0) return new List<Dictionary<string, object>>();
    int mOrigen = (int)tipoPor[claveTipo]["origen"]; if (mOrigen == 0) return new List<Dictionary<string, object>>();
    var ids = ctx.Query("SELECT TOP 40 DocumentID FROM docDocument WHERE ModuleID = " + mOrigen + " AND BusinessEntityID = " + entidad + " AND OwnedBusinessEntityID = " + empresa +
        " AND DeletedOn IS NULL AND CancelledOn IS NULL ORDER BY DateDocument DESC, DocumentID DESC").Select(r => L(r["DocumentID"])).ToList();
    return Origenes(ids).Where(o => ((List<Dictionary<string, object>>)((Dictionary<string, object>)o["partidasPor"])[claveTipo]).Count > 0).ToList();
}
// Los últimos documentos de esa persona (cualquier módulo), para tener contexto antes de capturar
List<Dictionary<string, object>> UltimosDe(long entidad)
{
    return ctx.Query("SELECT TOP 6 d.DocumentID, d.ModuleID, ISNULL(m.ModuleName,'') AS Modulo, d.FolioPrefix, d.Folio, d.DateDocument, ISNULL(d.Total,0) AS Total, ISNULL(d.Balance,0) AS Saldo FROM docDocument d " +
        "LEFT JOIN engModule m ON m.ModuleID = d.ModuleID WHERE d.BusinessEntityID = " + entidad + " AND d.OwnedBusinessEntityID = " + empresa + " AND d.DeletedOn IS NULL AND d.CancelledOn IS NULL ORDER BY d.DateDocument DESC, d.DocumentID DESC")
        .Select(r => new Dictionary<string, object> { ["id"] = L(r["DocumentID"]), ["modulo"] = I(r["ModuleID"]), ["tipo"] = S(r["Modulo"]), ["folio"] = (S(r["FolioPrefix"]) + S(r["Folio"])).Trim(),
            ["fecha"] = Nulo(r["DateDocument"]) ? "" : Convert.ToDateTime(r["DateDocument"], ci).ToString("yyyy-MM-dd"), ["total"] = D(r["Total"]), ["saldo"] = D(r["Saldo"]) }).ToList();
}

// ---------- Inteligencia de una persona (la pide la ventana HTML al elegirla) ----------
// Facturado (o comprado) por mes en los últimos 12 meses, los productos que más maneja con su último precio, los días promedio que tarda en pagar y el último
// documento de ese tipo con sus partidas (para «Repetir último»). Todo sale de Comercial en ese momento; nada se guarda.
Dictionary<string, object> InteligenciaDe(long entidad, string claveTipo)
{
    var res = new Dictionary<string, object>();
    if (!tipoPor.ContainsKey(claveTipo) || entidad <= 0) return res;
    var t = tipoPor[claveTipo]; string lado = (string)t["lado"];
    int modFact = (int)TIPOS.First(x => (string)x["lado"] == lado && ((string)x["clave"] == "factura_cliente" || (string)x["clave"] == "factura_compra"))["modulo"];
    string quien = " d.BusinessEntityID = " + entidad + " AND d.OwnedBusinessEntityID = " + empresa + " AND d.DeletedOn IS NULL AND d.CancelledOn IS NULL";
    var porMes = new Dictionary<string, double[]>();
    foreach (var r in ctx.Query("SELECT CONVERT(CHAR(7), d.DateDocument, 120) AS mes, SUM(ISNULL(d.Total,0)) AS total, COUNT(*) AS n FROM docDocument d WHERE" + quien + " AND d.ModuleID = " + modFact +
        " AND d.DateDocument >= DATEADD(MONTH, -11, DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1)) GROUP BY CONVERT(CHAR(7), d.DateDocument, 120)"))
        porMes[S(r["mes"])] = new[] { D(r["total"]), D(r["n"]) };
    var meses = new List<Dictionary<string, object>>(); double total12 = 0; int docs12 = 0; var hoy = DateTime.Today;
    for (int i = 11; i >= 0; i--)
    {
        var m = new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-i); string k = m.ToString("yyyy-MM", ci); double[] v; if (!porMes.TryGetValue(k, out v)) v = new double[] { 0, 0 };
        meses.Add(new Dictionary<string, object> { ["mes"] = k, ["total"] = Math.Round(v[0], 2), ["n"] = (int)v[1] }); total12 += v[0]; docs12 += (int)v[1];
    }
    res["meses"] = meses; res["total12"] = Math.Round(total12, 2); res["docs12"] = docs12; res["ticket"] = docs12 > 0 ? Math.Round(total12 / docs12, 2) : 0.0;
    string ultimo = "SELECT TOP 1 i2.{0} FROM docDocumentItem i2 JOIN docDocument d2 ON d2.DocumentID = i2.DocumentID WHERE d2.BusinessEntityID = " + entidad + " AND d2.ModuleID = " + modFact +
        " AND i2.ProductID = i.ProductID AND i2.DeletedOn IS NULL AND d2.DeletedOn IS NULL AND d2.CancelledOn IS NULL ORDER BY d2.DateDocument DESC, i2.DocumentItemID DESC";
    var top = ctx.Query("SELECT TOP 10 i.ProductID AS id, MAX(ISNULL(p.ProductKey,'')) AS clave, MAX(ISNULL(p.ProductName, i.Description)) AS nombre, COUNT(DISTINCT d.DocumentID) AS veces, SUM(i.Quantity) AS cant, MAX(d.DateDocument) AS ult, (" +
        string.Format(ultimo, "UnitPrice") + ") AS precio, (" + string.Format(ultimo, "DiscountPerc") + ") AS descto FROM docDocumentItem i JOIN docDocument d ON d.DocumentID = i.DocumentID LEFT JOIN orgProduct p ON p.ProductID = i.ProductID WHERE" + quien +
        " AND d.ModuleID = " + modFact + " AND i.DeletedOn IS NULL AND i.ProductID > 0 GROUP BY i.ProductID ORDER BY COUNT(DISTINCT d.DocumentID) DESC, MAX(d.DateDocument) DESC")
        .Select(r => new Dictionary<string, object> { ["id"] = I(r["id"]), ["clave"] = S(r["clave"]), ["nombre"] = S(r["nombre"]), ["veces"] = I(r["veces"]), ["cant"] = D(r["cant"]), ["ult"] = Nulo(r["ult"]) ? "" : Convert.ToDateTime(r["ult"], ci).ToString("yyyy-MM-dd"),
            ["precio"] = D(r["precio"]), ["desc"] = Math.Round(D(r["descto"]) * 100.0, 4) }).ToList();
    res["top"] = top;
    object dias = ctx.Scalar("SELECT AVG(CAST(DATEDIFF(DAY, d.DateDocument, p.DateOperation) AS float)) FROM docDocumentPayment p JOIN docDocument d ON d.DocumentID = p.DocumentID WHERE" + quien + " AND d.ModuleID = " + modFact + " AND p.DeletedOn IS NULL");
    res["diasPago"] = Nulo(dias) ? (object)null : Math.Round(D(dias), 1);
    var ud = ctx.Query("SELECT TOP 1 d.DocumentID, d.FolioPrefix, d.Folio, d.DateDocument FROM docDocument d WHERE" + quien + " AND d.ModuleID = " + (int)t["modulo"] + " ORDER BY d.DateDocument DESC, d.DocumentID DESC");
    if (ud.Count > 0)
    {
        long idd = L(ud[0]["DocumentID"]);
        var ps = ctx.Query("SELECT ProductID, Quantity, UnitPrice, DiscountPerc, TaxTypeID FROM docDocumentItem WHERE DocumentID = " + idd + " AND DeletedOn IS NULL AND ProductID > 0 ORDER BY LineNumber")
            .Select(r => new Dictionary<string, object> { ["id"] = I(r["ProductID"]), ["cant"] = D(r["Quantity"]), ["precio"] = D(r["UnitPrice"]), ["desc"] = Math.Round(D(r["DiscountPerc"]) * 100.0, 4), ["imp"] = I(r["TaxTypeID"]) }).ToList();
        res["ultimo"] = new Dictionary<string, object> { ["id"] = idd, ["folio"] = (S(ud[0]["FolioPrefix"]) + S(ud[0]["Folio"])).Trim(), ["fecha"] = Nulo(ud[0]["DateDocument"]) ? "" : Convert.ToDateTime(ud[0]["DateDocument"], ci).ToString("yyyy-MM-dd"), ["partidas"] = ps };
    }
    else res["ultimo"] = null;
    return res;
}

// ---------- Agenda de pago ----------
// NuevoDocumento deja una parcialidad «de relleno» con importe 0; después de guardar hay que rehacerla con el total real y la condición de pago elegida.
// Cada renglón de engPaymentTermDetail vence en (fecha + PaymentUnit × días del periodo) y lleva su porcentaje; el último absorbe el redondeo.
void ArmarAgenda(int doc, int condicion, DateTime fecha)
{
    double total = D(ctx.Scalar("SELECT Total FROM docDocument WHERE DocumentID=" + doc));
    var det = ctx.Query("SELECT d.PaymentPerc, d.PaymentUnit, ISNULL(p.Dias,1) AS Dias, ISNULL(d.ForceEndOfMonth,0) AS FinMes FROM engPaymentTermDetail d " +
        "LEFT JOIN vwcboPaymentTermDays p ON p.PaymentPeriodID = d.PaymentPeriodID WHERE d.PaymentTermID = " + condicion + " ORDER BY d.PaymentTermDetailID");
    if (det.Count == 0) return;
    ctx.NonQuery("UPDATE docDocumentPaymentAgenda SET DeletedOn=GETDATE(), DeletedBy=" + ctx.erp.UserId + " WHERE DeletedOn IS NULL AND DocumentID=" + doc);
    double acumulado = 0; int n = 0;
    foreach (var d in det)
    {
        n++;
        DateTime vence = fecha.AddDays(D(d["PaymentUnit"]) * D(d["Dias"]));
        if (I(d["FinMes"]) == 1) vence = new DateTime(vence.Year, vence.Month, DateTime.DaysInMonth(vence.Year, vence.Month));
        double perc = D(d["PaymentPerc"]);
        double monto = n == det.Count ? Math.Round(total - acumulado, 2) : Math.Round(total * perc / 100.0, 2);
        acumulado += monto;
        ctx.NonQuery("INSERT INTO docDocumentPaymentAgenda (DocumentID, DatePayment, TotalPerc, Amount, PartialityNumber, CreatedOn, CreatedBy) VALUES (" + doc + ", '" +
            vence.ToString("yyyyMMdd") + "', " + Num(perc) + ", " + Num(monto) + ", " + n + ", GETDATE(), " + ctx.erp.UserId + ")");
    }
}

// ---------- Crear el documento ----------
// «spec»: tipo, almacen, entidad, condicion, fecha (yyyy-MM-dd), entrega (yyyy-MM-dd), titulo, comentarios, origenes [ids], partidas [{id, cant, precio, desc (0-100), imp, origenItem}]
//   y, opcionales: moneda (id), tc (tipo de cambio), centro (id del centro de costo), uso / forma / metodo (claves SAT; solo la factura de cliente)
// Regresa el DocumentID. Si algo no es válido lanza una excepción con un mensaje que se le puede mostrar a la persona.
long CrearDocumento(Dictionary<string, object> spec)
{
    string clave = S(spec["tipo"]);
    if (!tipoPor.ContainsKey(clave)) throw new Exception("Tipo de documento desconocido: " + clave);
    var t = tipoPor[clave];
    int modulo = (int)t["modulo"]; string vinculo = (string)t["vinculo"]; bool venta = (string)t["precio"] == "venta";
    int almacen = I(spec["almacen"]), entidad = I(spec["entidad"]);
    if (almacen <= 0) throw new Exception("Elige el almacén.");
    if (entidad <= 0) throw new Exception("Elige el " + ((string)t["lado"] == "C" ? "cliente" : "proveedor") + ".");
    var partidas = ((System.Collections.IEnumerable)spec["partidas"]).Cast<object>().Select(o => (Dictionary<string, object>)o).ToList();
    if (partidas.Count == 0) throw new Exception("Agrega al menos una partida.");
    int n = 0;
    foreach (var p in partidas)
    {
        n++;
        if (I(p["id"]) <= 0) throw new Exception("La partida " + n + " no tiene producto.");
        if (D(p["cant"]) <= 0) throw new Exception("La partida " + n + " debe tener cantidad mayor a cero.");
        if (D(p["precio"]) < 0) throw new Exception("La partida " + n + " tiene precio negativo.");
        double dsc = D(p["desc"]); if (dsc < 0 || dsc > 100) throw new Exception("El descuento de la partida " + n + " debe estar entre 0 y 100.");
    }
    var origenes = spec.ContainsKey("origenes") && spec["origenes"] != null ? ((System.Collections.IEnumerable)spec["origenes"]).Cast<object>().Select(o => L(o)).Where(x => x > 0).ToList() : new List<long>();
    if (vinculo == "" && origenes.Count > 0) origenes.Clear();

    int doc = ctx.erp.NuevoDocumento(modulo, almacen, entidad);
    if (doc <= 0 || !string.IsNullOrEmpty(ctx.erp.LastError)) throw new Exception("No se pudo crear el documento: " + ctx.erp.LastError);

    try
    {
    // Encabezado: perfil del módulo + lo que capturó la persona
    int centro = spec.ContainsKey("centro") ? I(spec["centro"]) : 0;
    var set = new List<string> { (string)t["perfil"], "CampaignID=NULL", "CostCenterID=" + (centro > 0 ? centro.ToString(ci) : "NULL"), "ProjectID=NULL" };
    int moneda = spec.ContainsKey("moneda") ? I(spec["moneda"]) : 0; double tc = spec.ContainsKey("tc") ? D(spec["tc"]) : 0;
    if (moneda > 0) set.Add("CurrencyID=" + moneda + ", Rate=" + Num(tc > 0 ? tc : 1));
    if ((bool)t["condicion"]) set.Add("PaymentTermID=" + I(spec["condicion"]));
    string fecha = S(spec.ContainsKey("fecha") ? spec["fecha"] : ""); if (fecha.Length >= 10) set.Add("DateDocument='" + Sq(fecha.Substring(0, 10).Replace("-", "")) + "'");
    string entrega = S(spec.ContainsKey("entrega") ? spec["entrega"] : ""); if ((bool)t["entrega"] && entrega.Length >= 10) set.Add("DateDelivery='" + Sq(entrega.Substring(0, 10).Replace("-", "")) + "', DateDocDelivery='" + Sq(entrega.Substring(0, 10).Replace("-", "")) + "'");
    string titulo = S(spec.ContainsKey("titulo") ? spec["titulo"] : ""); if (titulo != "") set.Add("Title=N'" + Sq(titulo) + "'");
    string coment = S(spec.ContainsKey("comentarios") ? spec["comentarios"] : ""); if (coment != "") set.Add("Comments=N'" + Sq(coment) + "'");
    if (origenes.Count > 0) set.Add("SourceDocumentID=" + origenes[0]);          // el sistema solo guarda UN origen en el encabezado; cada partida liga el suyo
    ctx.NonQuery("UPDATE docDocument SET " + string.Join(", ", set) + " WHERE DocumentID=" + doc);

    foreach (var p in partidas)
    {
        int pid = I(p["id"]); double cant = D(p["cant"]), precio = D(p["precio"]); int imp = I(p["imp"]); long origenItem = p.ContainsKey("origenItem") ? L(p["origenItem"]) : 0;
        // Costo: compra → el precio pactado; remisión → costo promedio del producto; el resto de ventas no lleva costo
        double costo = -1;
        if (!venta) costo = precio;
        else if (modulo == 157) costo = D(ctx.Scalar("SELECT ISNULL(MAX(TOT_Cost),0) FROM orgProductCostComercial WHERE ProductID=" + pid + " AND DepotID=" + almacen));
        int item = ctx.erp.AgregarArticulo(doc, pid, cant, precio, costo, imp > 0 ? imp : -1, D(p["desc"]) / 100.0, vinculo == "entrega" ? (int)origenItem : 0);
        if (!string.IsNullOrEmpty(ctx.erp.LastError)) throw new Exception("No se pudo agregar la partida de «" + S(p.ContainsKey("nombre") ? p["nombre"] : pid) + "»: " + ctx.erp.LastError);
        if (vinculo == "partida" && origenItem > 0) ctx.NonQuery("UPDATE docDocumentItem SET SourceDocumentItemID=" + origenItem + " WHERE DocumentItemID=" + item);
    }
    ctx.erp.RecalcCompleto(doc);
    // ¿Mueve o compromete inventario? Lo decide el módulo (StockAffectation ≠ 0), no el tipo de documento
    if (I(ctx.Scalar("SELECT ISNULL(MAX(TRY_CONVERT(int, Value)),0) FROM engModuleParameter WHERE ParameterKey='StockAffectation' AND ModuleID=" + modulo)) != 0)
    {
        ctx.erp.AffectStockNEW(doc);
        if (!string.IsNullOrEmpty(ctx.erp.LastError)) throw new Exception("AffectStockNEW: " + ctx.erp.LastError);
    }
    ctx.erp.Save(doc);
    if (!string.IsNullOrEmpty(ctx.erp.LastError)) throw new Exception("Save: " + ctx.erp.LastError);
    if (LlevaCfdi(clave))                                             // datos del comprobante: el motor deja la fila de docDocumentCFD con valores por omisión (G03 / PPD / 99)
    {
        var cf = new List<string>();
        string uso = S(spec.ContainsKey("uso") ? spec["uso"] : ""), forma = S(spec.ContainsKey("forma") ? spec["forma"] : ""), metodo = S(spec.ContainsKey("metodo") ? spec["metodo"] : "");
        if (uso != "") cf.Add("ReceptorUsoCFDI=N'" + Sq(uso) + "'");
        if (forma != "") cf.Add("FormaPago=N'" + Sq(forma) + "'");
        if (metodo != "") cf.Add("MetodoPago=N'" + Sq(metodo) + "'");
        if (cf.Count > 0) ctx.NonQuery("UPDATE docDocumentCFD SET " + string.Join(", ", cf) + " WHERE DocumentID=" + doc);
    }
    if ((bool)t["condicion"])
    {
        DateTime fechaBase = DateTime.Today; if (fecha.Length >= 10) DateTime.TryParse(fecha.Substring(0, 10), ci, DateTimeStyles.None, out fechaBase);
        ArmarAgenda(doc, I(spec["condicion"]), fechaBase);                                                   // agenda de pago con los montos reales
        try { ctx.erp.UpdateDocumentPaidInfo(doc); } catch { }                                                // saldo y balance
    }
    if (vinculo != "") { try { ctx.erp.UpdateStatusDelivery(doc); } catch { } }                       // estado de entrega del documento de origen
    return doc;
    }
    catch (Exception ex)
    {
        // El documento ya existe como borrador: se avisa su número para que no quede perdido
        throw new Exception(ex.Message + "\n\nQuedó un documento incompleto (id " + doc + "): elimínalo o cancélalo desde Comercial.");
    }
}

// ---------- Qué documentos seleccionados sirven de origen ----------
string[] CLAVES = TIPOS.Select(t => (string)t["clave"]).ToArray();
var seleccion = new List<long>();
try { var sel = ctx.GetSelectedIds(); if (sel != null) seleccion.AddRange(sel.Select(x => (long)x)); } catch { }

// ---------- Pruebas automáticas (sin ventanas): BROSLMV_DOC_TEST = JSON con el «spec» de un documento; el resultado va al archivo BROSLMV_DOC_OUT ----------
string modoPrueba = Environment.GetEnvironmentVariable("BROSLMV_DOC_TEST");
if (!string.IsNullOrEmpty(modoPrueba))
{
    var spec = ser.Deserialize<Dictionary<string, object>>(modoPrueba);
    if (spec.ContainsKey("seleccion")) seleccion = ((System.Collections.IEnumerable)spec["seleccion"]).Cast<object>().Select(o => L(o)).ToList();
    string resultado;
    if (spec.ContainsKey("pendientes") && (bool)spec["pendientes"]) resultado = ser.Serialize(Origenes(seleccion));
    else if (spec.ContainsKey("catalogo") && (bool)spec["catalogo"]) resultado = ser.Serialize(Catalogos(CLAVES));
    else if (spec.ContainsKey("pendientesDe")) resultado = ser.Serialize(PendientesDe(L(spec["entidad"]), S(spec["tipo"])));
    else if (spec.ContainsKey("ultimos")) resultado = ser.Serialize(UltimosDe(L(spec["entidad"])));
    else if (spec.ContainsKey("inteligencia")) resultado = ser.Serialize(InteligenciaDe(L(spec["entidad"]), S(spec["tipo"])));
    else
    {
        try { resultado = "DOC " + CrearDocumento(spec); }
        catch (Exception ex) { resultado = "ERROR " + ex.Message; }
    }
    string salidaPrueba = Environment.GetEnvironmentVariable("BROSLMV_DOC_OUT");
    if (!string.IsNullOrEmpty(salidaPrueba)) System.IO.File.WriteAllText(salidaPrueba, resultado, new System.Text.UTF8Encoding(false));
    return resultado;
}

// ===================================================================================================================================
// VENTANA (Windows Forms, NO modal: Show, nunca ShowDialog → se puede minimizar y seguir trabajando en Comercial).
// Diseño de «documento de Comercial»: cinta oscura con las acciones y la información del documento (fecha, serie, folio, entrega), grupos numerados
// con una etiqueta arriba de cada campo (nada se encima ni se corta), y las partidas con captura rápida + tabla editable.
//   1 · Cliente / proveedor (búsqueda por nombre o RFC, saldo, crédito) · 2 · Almacén, centro de costo y moneda con tipo de cambio ·
//   3 · Datos fiscales del CFDI (uso, forma y método de pago; solo la factura de cliente) · 4 · Documento de origen (si el tipo parte de otro) ·
//   Partidas · Comentarios · Totales con importe en letra.
// Los manejadores llevan try/catch porque, en modeless, el script «ya terminó» cuando se hace clic. Al guardar SIEMPRE se abre el documento nativo de Comercial.
// ===================================================================================================================================
class Opcion { public int Id { get; set; } public string Nombre { get; set; } public string Extra { get; set; } public override string ToString() => Nombre; }
class Fila { public int Id; public string Clave = "", Nombre = "", Unidad = ""; public double Cant = 1, Max = 0, Precio, Desc; public int Imp; public long OrigenItem; public long Origen; }
class Pastilla { public string Titulo, Valor; public Color Color; }

var catalogo = Catalogos(CLAVES);
var origenes = Origenes(seleccion);
Func<string, List<Dictionary<string, object>>> cat = k => (List<Dictionary<string, object>>)catalogo[k];
var impuestos = cat("impuestos").Select(i => new Opcion { Id = I(i["id"]), Nombre = S(i["nombre"]), Extra = S(i["perc"]) }).ToList();
var percImp = cat("impuestos").ToDictionary(i => I(i["id"]), i => D(i["perc"]));
var productos = cat("productos");
var monedas = cat("monedas");
var existencias = (Dictionary<string, object>)catalogo["existencias"];
var folios = (Dictionary<string, object>)catalogo["folios"];
var filas = new List<Fila>();
var origenSel = new List<long>();
var pendientes = new List<Dictionary<string, object>>();
var pastillas = new List<Pastilla>();
Dictionary<string, object> entSel = null, prodSel = null;
bool guardando = false, suspender = false, metodoManual = false, verG3 = true, verG4 = false;          // Control.Visible miente hasta que la ventana se muestra: se llevan banderas propias
int tipoIdx = 0;
string quienSoy = "", nombreEmpresa = "";
try { quienSoy = S(ctx.Scalar("SELECT TOP 1 ISNULL(UserName,'') FROM engUser WHERE UserID = " + ctx.erp.UserId)); } catch { }
try { nombreEmpresa = S(ctx.Scalar("SELECT TOP 1 ISNULL(CommercialName, OfficialName) FROM orgBusinessEntity WHERE BusinessEntityID = " + empresa)); } catch { }

// ---------- diseño ----------
var C_BG = Color.FromArgb(241, 245, 249); var C_LINE = Color.FromArgb(203, 213, 225); var C_TXT = Color.FromArgb(30, 41, 59); var C_MUTED = Color.FromArgb(100, 116, 139);
var C_HEAD = Color.FromArgb(248, 250, 252); var C_SEL = Color.FromArgb(238, 242, 255); var C_RIB = Color.FromArgb(51, 65, 85); var C_RIB_TX = Color.FromArgb(226, 232, 240); var C_RIB_MU = Color.FromArgb(148, 163, 184);
var C_VENTA = Color.FromArgb(37, 99, 235); var C_COMPRA = Color.FromArgb(15, 118, 110); var C_ROJO = Color.FromArgb(200, 40, 40); var C_AMBAR = Color.FromArgb(180, 83, 9); var C_VERDE = Color.FromArgb(22, 128, 59);
var F_BASE = new Font("Segoe UI", 9f); var F_B = new Font("Segoe UI", 9f, FontStyle.Bold); var F_H2 = new Font("Segoe UI", 9.5f, FontStyle.Bold); var F_SM = new Font("Segoe UI", 8.5f);
var F_ICON = new Font("Segoe UI Emoji", 20f); var F_TOT = new Font("Segoe UI Semibold", 18f); var F_VAL = new Font("Segoe UI Semibold", 11f); var F_ITAL = new Font("Segoe UI", 9f, FontStyle.Italic);

var frm = new Form { Text = "Crear documento · BrosLMV", ClientSize = new Size(1200, 900), MinimumSize = new Size(1160, 820), StartPosition = FormStartPosition.CenterScreen, BackColor = C_BG, Font = F_BASE, KeyPreview = true };
void Seguro(Action a) { try { a(); } catch (Exception ex) { guardando = false; MessageBox.Show(ex.Message, "Crear documento", MessageBoxButtons.OK, MessageBoxIcon.Warning); } }
Dictionary<string, object> TipoActual() => TIPOS[tipoIdx];
bool EsVenta() => (string)TipoActual()["lado"] == "C";
bool ConCfdi() => LlevaCfdi((string)TipoActual()["clave"]);
Color Acento() => EsVenta() ? C_VENTA : C_COMPRA;

// controles declarados de antemano (los manejadores de abajo los usan antes de que se construyan)
Panel ribbon = null, info = null, pTipos = null, pPie = null, g1 = null, g2 = null, g3 = null, g4 = null, g5 = null, g6 = null, g7 = null, pChips = null, btnGuardar = null;
Label lblRibTitulo = null, lblEntregaEt = null, lblOrigenEst = null, lblNumPart = null, lblSub = null, lblDes = null, lblImp = null, lblTot = null, lblTotEt = null, lblLetra = null, lblPie = null, lblAvisos = null, lblToast = null, lblHint = null;
DateTimePicker dtFecha = null, dtEntrega = null;
TextBox txtSerie = null, txtFolio = null, txtEnt = null, txtRfc = null, txtProd = null, txtTitulo = null, txtComent = null;
ComboBox cmbCond = null, cmbAlm = null, cmbCC = null, cmbMon = null, cmbUso = null, cmbForma = null, cmbMetodo = null, cmbImp = null;
NumericUpDown nudTC = null, nudCant = null, nudPrecio = null, nudDesc = null;
CheckedListBox clbOrigen = null; DataGridView grid = null; ListBox lstEnt = null, lstProd = null;
var btnsTipo = new List<Button>(); var botonesCinta = new List<Panel>();

// ---------- piezas de construcción ----------
Panel Grupo(Func<string> titulo)
{
    var p = new Panel { BackColor = Color.White, Size = new Size(600, 120) };
    p.Paint += (s, e) =>
    {
        var g = e.Graphics; using (var pen = new Pen(C_LINE)) g.DrawRectangle(pen, 0, 0, p.Width - 1, p.Height - 1);
        using (var b = new SolidBrush(C_HEAD)) g.FillRectangle(b, 1, 1, p.Width - 2, 27); using (var pen = new Pen(C_LINE)) g.DrawLine(pen, 0, 28, p.Width, 28);
        using (var b = new SolidBrush(Acento())) g.FillRectangle(b, 1, 1, 4, 27);
        using (var b = new SolidBrush(C_TXT)) g.DrawString(titulo(), F_H2, b, 14, 5);
    };
    return p;
}
Label Et(Control padre, string t, int x, int y) { var l = new Label { Text = t, Location = new Point(x, y), AutoSize = true, ForeColor = C_MUTED, Font = F_SM, BackColor = Color.Transparent }; padre.Controls.Add(l); return l; }
TextBox Cuadro(Control padre, string etiqueta, int x, int y, int w, bool soloLectura = false)
{
    if (etiqueta != "") Et(padre, etiqueta, x, y);
    var t = new TextBox { Location = new Point(x, y + 17), Size = new Size(w, 24), ReadOnly = soloLectura, BorderStyle = BorderStyle.FixedSingle, ForeColor = soloLectura ? C_MUTED : C_TXT }; padre.Controls.Add(t); return t;
}
ComboBox Lista(Control padre, string etiqueta, int x, int y, int w, int anchoMenu = 0)
{
    Et(padre, etiqueta, x, y);
    var c = new ComboBox { Location = new Point(x, y + 17), Size = new Size(w, 24), DropDownStyle = ComboBoxStyle.DropDownList, FlatStyle = FlatStyle.Flat }; if (anchoMenu > 0) c.DropDownWidth = anchoMenu; padre.Controls.Add(c); return c;
}
NumericUpDown Numero(Control padre, string etiqueta, int x, int y, int w, int dec, decimal max)
{
    Et(padre, etiqueta, x, y);
    var n = new NumericUpDown { Location = new Point(x, y + 17), Size = new Size(w, 24), DecimalPlaces = dec, Maximum = max, Minimum = 0, ThousandsSeparator = true, TextAlign = HorizontalAlignment.Right }; padre.Controls.Add(n); return n;
}
void PonerPorId(ComboBox c, int id) { for (int i = 0; i < c.Items.Count; i++) if (((Opcion)c.Items[i]).Id == id) { c.SelectedIndex = i; return; } if (c.Items.Count > 0) c.SelectedIndex = 0; }
void PonerPorClave(ComboBox c, string clave) { for (int i = 0; i < c.Items.Count; i++) if (string.Equals(((Opcion)c.Items[i]).Extra, clave, StringComparison.OrdinalIgnoreCase)) { c.SelectedIndex = i; return; } }
string ClaveDe(ComboBox c) { var o = c.SelectedItem as Opcion; return o == null ? "" : o.Extra ?? ""; }
void LlenarSat(ComboBox c, string grupo) { c.Items.Clear(); foreach (var x in cat(grupo)) c.Items.Add(new Opcion { Id = c.Items.Count, Extra = S(x["clave"]), Nombre = S(x["clave"]) + "  ·  " + S(x["nombre"]) }); }

// ---------- cinta superior ----------
ribbon = new Panel { BackColor = C_RIB, Size = new Size(1176, 100) };
lblRibTitulo = new Label { Text = "Nuevo documento", Font = F_H2, ForeColor = C_RIB_TX, BackColor = C_RIB, Location = new Point(12, 5), AutoSize = true }; ribbon.Controls.Add(lblRibTitulo);
int bx = 12;
Panel Boton(string icono, string texto, string tecla, Color? colorIcono, Action alClic)
{
    var p = new Panel { Location = new Point(bx, 26), Size = new Size(84, 68), BackColor = C_RIB, Cursor = Cursors.Hand }; bx += 88;
    var li = new Label { Text = icono, Font = F_ICON, ForeColor = colorIcono ?? C_RIB_TX, BackColor = C_RIB, AutoSize = false, Size = new Size(84, 34), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 0) };
    var lt = new Label { Text = texto, Font = F_SM, ForeColor = C_RIB_TX, BackColor = C_RIB, AutoSize = false, Size = new Size(84, 18), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 35) };
    var lk = new Label { Text = tecla, Font = F_SM, ForeColor = C_RIB_MU, BackColor = C_RIB, AutoSize = false, Size = new Size(84, 15), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 52) };
    p.Controls.AddRange(new Control[] { li, lt, lk });
    Action<bool> hover = on => { var c = on ? Color.FromArgb(71, 85, 105) : C_RIB; p.BackColor = c; li.BackColor = c; lt.BackColor = c; lk.BackColor = c; };
    foreach (Control c in new Control[] { p, li, lt, lk }) { c.MouseEnter += (s, e) => hover(true); c.MouseLeave += (s, e) => hover(false); c.Click += (s, e) => Seguro(alClic); }
    ribbon.Controls.Add(p); botonesCinta.Add(p); return p;
}
void Separador() { ribbon.Controls.Add(new Panel { Location = new Point(bx, 30), Size = new Size(1, 60), BackColor = C_RIB_MU }); bx += 12; }
