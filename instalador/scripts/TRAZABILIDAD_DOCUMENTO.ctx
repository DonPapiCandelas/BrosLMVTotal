// lang: csharp
// AppKey recomendado: TRAZABILIDAD_DOCUMENTO
// Plantilla: Trazabilidad del documento
// Categoria: Documentos
// Documentacion: TRAZABILIDAD_DOCUMENTO.html
// job: safe-offline
// Trazabilidad del documento: de dónde viene y a dónde fue, en las dos direcciones, para CUALQUIER módulo (incluidos los clones).

using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Text;
using System.Web.Script.Serialization;
using System.Windows.Forms;

var ci = CultureInfo.InvariantCulture;
var ser = new JavaScriptSerializer { MaxJsonLength = 64 * 1024 * 1024 };

string S(object v) => v == null || v is DBNull ? "" : Convert.ToString(v, ci);
long L(object v) { try { return v == null || v is DBNull ? 0 : Convert.ToInt64(v, ci); } catch { return 0; } }
int I(object v) { try { return v == null || v is DBNull ? 0 : Convert.ToInt32(v, ci); } catch { return 0; } }
decimal M(object v) { try { return v == null || v is DBNull ? 0m : Convert.ToDecimal(v, ci); } catch { return 0m; } }
double D(object v) { try { return v == null || v is DBNull ? 0.0 : Convert.ToDouble(v, ci); } catch { return 0.0; } }
bool Nulo(object v) => v == null || v is DBNull;
string FechaTxt(object v) => Nulo(v) ? "" : Convert.ToDateTime(v, ci).ToString("yyyy-MM-dd");

long raiz = 0;
string modoPrueba = Environment.GetEnvironmentVariable("BROSLMV_TRAZA_DOC");
if (!string.IsNullOrEmpty(modoPrueba)) long.TryParse(modoPrueba, out raiz);
if (raiz == 0) { try { raiz = ctx.ObtenerIdDeVentanaActiva() ?? 0; } catch { } }
if (raiz == 0)
{
    var sel = ctx.GetSelectedIds();
    if (sel != null && sel.Count > 0) raiz = sel[0];
}
if (raiz == 0)
{
    ctx.Msg("Selecciona un documento en la lista (o ábrelo ya guardado) antes de ejecutar la trazabilidad.", "Trazabilidad del documento");
    return "SIN DOCUMENTO";
}

int empresa = ctx.erp.OwnedBusinessEntityId;
const int MaxNodos = 300;
const int MaxNiveles = 25;

string Lista(IEnumerable<long> ids) => string.Join(",", ids.Select(x => x.ToString(ci)));
IEnumerable<List<long>> Lotes(IEnumerable<long> ids, int n)
{
    var lote = new List<long>();
    foreach (var id in ids) { lote.Add(id); if (lote.Count >= n) { yield return lote; lote = new List<long>(); } }
    if (lote.Count > 0) yield return lote;
}

var nodos = new Dictionary<long, Dictionary<string, object>>();
var aristas = new Dictionary<string, Dictionary<string, object>>();
var avisos = new List<string>();

Dictionary<string, object> Arista(long desde, long hasta)
{
    string k = desde + ">" + hasta;
    if (!aristas.TryGetValue(k, out var a))
        aristas[k] = a = new Dictionary<string, object> { ["desde"] = desde, ["hasta"] = hasta, ["tipos"] = new List<string>(), ["partidas"] = new List<Dictionary<string, object>>() };
    return a;
}
void Evidencia(long desde, long hasta, string tipo)
{
    if (desde <= 0 || hasta <= 0 || desde == hasta) return;
    var t = (List<string>)Arista(desde, hasta)["tipos"];
    if (!t.Contains(tipo)) t.Add(tipo);
}

var vistos = new HashSet<long> { raiz };
var frontera = new List<long> { raiz };
for (int nivel = 0; nivel < MaxNiveles && frontera.Count > 0 && vistos.Count < MaxNodos; nivel++)
{
    var nuevos = new HashSet<long>();
    foreach (var lote in Lotes(frontera, 400))
    {
        string ids = Lista(lote);

        var enc = ctx.Query(
            "SELECT DocumentID, ISNULL(SourceDocumentID,0) AS Src, ISNULL(DestinationDocumentID,0) AS Dst FROM docDocument " +
            "WHERE OwnedBusinessEntityID=" + empresa + " AND DeletedOn IS NULL AND " +
            "(DocumentID IN (" + ids + ") OR SourceDocumentID IN (" + ids + ") OR DestinationDocumentID IN (" + ids + "))");
        foreach (var r in enc)
        {
            long id = L(r["DocumentID"]), src = L(r["Src"]), dst = L(r["Dst"]);
            Evidencia(src, id, "S");
            Evidencia(id, dst, "D");
            foreach (var x in new[] { id, src, dst }) if (x > 0) nuevos.Add(x);
        }

        foreach (var par in new[] { new[] { "SourceDocumentItemID", "P" }, new[] { "DeliverDocumentItemID", "E" } })
        {
            var pr = ctx.Query(
                "SELECT d.DocumentID AS DocDest, o.DocumentID AS DocOrig, i.ProductID AS Prod, o.Quantity AS QOrig, i.Quantity AS QDest, " +
                "ISNULL(p.ProductKey,'') AS Clave, ISNULL(p.ProductName, i.Description) AS Producto " +
                "FROM docDocumentItem i " +
                "JOIN docDocument d ON d.DocumentID = i.DocumentID " +
                "JOIN docDocumentItem o ON o.DocumentItemID = i." + par[0] + " " +
                "JOIN docDocument od ON od.DocumentID = o.DocumentID " +
                "LEFT JOIN orgProduct p ON p.ProductID = i.ProductID " +
                "WHERE i." + par[0] + " > 0 AND i.DeletedOn IS NULL AND o.DeletedOn IS NULL AND d.DeletedOn IS NULL AND od.DeletedOn IS NULL " +
                "AND d.OwnedBusinessEntityID=" + empresa + " AND (i.DocumentID IN (" + ids + ") OR o.DocumentID IN (" + ids + "))");
            foreach (var r in pr)
            {
                long dd = L(r["DocDest"]), oo = L(r["DocOrig"]);
                Evidencia(oo, dd, par[1]);
                ((List<Dictionary<string, object>>)Arista(oo, dd)["partidas"]).Add(new Dictionary<string, object>
                {
                    ["via"] = par[1], ["clave"] = S(r["Clave"]), ["producto"] = S(r["Producto"]), ["origen"] = M(r["QOrig"]), ["destino"] = M(r["QDest"])
                });
                nuevos.Add(dd); nuevos.Add(oo);
            }
        }
        var ps = ctx.Query(
            "SELECT i.DocumentID AS DocDest, i.SourceDocumentID AS DocOrig FROM docDocumentItem i JOIN docDocument d ON d.DocumentID=i.DocumentID " +
            "WHERE i.DeletedOn IS NULL AND d.DeletedOn IS NULL AND d.OwnedBusinessEntityID=" + empresa + " AND ISNULL(i.SourceDocumentID,0) > 0 AND " +
            "(i.DocumentID IN (" + ids + ") OR i.SourceDocumentID IN (" + ids + ")) GROUP BY i.DocumentID, i.SourceDocumentID");
        foreach (var r in ps) { Evidencia(L(r["DocOrig"]), L(r["DocDest"]), "P"); nuevos.Add(L(r["DocDest"])); nuevos.Add(L(r["DocOrig"])); }
    }

    frontera = nuevos.Where(x => !vistos.Contains(x)).Take(Math.Max(0, MaxNodos - vistos.Count)).ToList();
    foreach (var x in frontera) vistos.Add(x);
    if (nuevos.Any(x => !vistos.Contains(x))) avisos.Add("La cadena es muy grande: se muestran los primeros " + MaxNodos + " documentos.");
}

string[] ETAPAS = { "", "Solicitud / Cotización", "Pedido / Orden", "Entrega / Recepción", "Factura", "Nota de crédito / Devolución" };
int Etapa(int tipo)
{
    switch (tipo)
    {
        case 49: case 1: return 1;
        case 40: case 21: return 2;
        case 3: case 22: case 16: case 17: case 18: case 20: case 24: case 25: return 3;
        case 6: case 4: case 23: return 5;
        default: return 4;
    }
}
string Carril(int rec) => rec == 1 ? "Venta" : rec == 2 ? "Compra" : "Inventario y otros";

foreach (var lote in Lotes(vistos, 400))
{
    var docs = ctx.Query(
        "SELECT d.DocumentID, d.ModuleID, ISNULL(m.ModuleIDBase, d.ModuleID) AS ModuloBase, ISNULL(m.ModuleName,'Módulo '+CAST(d.ModuleID AS NVARCHAR(10))) AS ModuloNombre, " +
        "ISNULL(d.FolioPrefix,'') AS Serie, ISNULL(CAST(d.Folio AS NVARCHAR(30)),'') AS Folio, ISNULL(d.Title,'') AS Titulo, d.DateDocument, ISNULL(d.Total,0) AS Total, " +
        "ISNULL(d.TotalPaid,0) AS Pagado, ISNULL(d.Balance,0) AS Saldo, d.CancelledOn, d.DeletedOn, ISNULL(d.SourceDocumentID,0) AS Src, ISNULL(d.DestinationDocumentID,0) AS Dst, " +
        "ISNULL(be.CommercialName, be.OfficialName) AS Entidad, ISNULL(pv.Tipo,0) AS Tipo, ISNULL(pv.Rec,0) AS Rec, ISNULL(pv.Stock,0) AS Stock " +
        "FROM docDocument d LEFT JOIN engModule m ON m.ModuleID=d.ModuleID " +
        "LEFT JOIN (SELECT ModuleID, MAX(CASE WHEN ParameterKey='DocumentTypeID' THEN TRY_CONVERT(int,Value) END) AS Tipo, MAX(CASE WHEN ParameterKey='DocRecipient' THEN TRY_CONVERT(int,Value) END) AS Rec, " +
        "          MAX(CASE WHEN ParameterKey='StockAffectation' THEN TRY_CONVERT(int,Value) END) AS Stock FROM engModuleParameter " +
        "          WHERE ParameterKey IN ('DocumentTypeID','DocRecipient','StockAffectation') GROUP BY ModuleID) pv ON pv.ModuleID = ISNULL(NULLIF(m.ModuleIDBase,0), d.ModuleID) " +
        "LEFT JOIN orgBusinessEntity be ON be.BusinessEntityID=d.BusinessEntityID " +
        "WHERE d.DocumentID IN (" + Lista(lote) + ") AND d.OwnedBusinessEntityID=" + empresa);
    foreach (var r in docs)
    {
        long id = L(r["DocumentID"]); int tipo = I(r["Tipo"]), rec = I(r["Rec"]);
        nodos[id] = new Dictionary<string, object>
        {
            ["id"] = id, ["modulo"] = I(r["ModuleID"]), ["base"] = I(r["ModuloBase"]), ["tipoNombre"] = S(r["ModuloNombre"]),
            ["folio"] = (S(r["Serie"]) + S(r["Folio"])).Trim(), ["titulo"] = S(r["Titulo"]), ["fecha"] = FechaTxt(r["DateDocument"]),
            ["total"] = M(r["Total"]), ["pagado"] = M(r["Pagado"]), ["saldo"] = M(r["Saldo"]), ["entidad"] = S(r["Entidad"]),
            ["cancelado"] = !Nulo(r["CancelledOn"]), ["src"] = L(r["Src"]), ["dst"] = L(r["Dst"]), ["raiz"] = id == raiz,
            ["etapa"] = Etapa(tipo), ["carril"] = Carril(rec), ["inventario"] = I(r["Stock"]),
            ["pagos"] = new List<Dictionary<string, object>>(), ["partidas"] = new List<Dictionary<string, object>>(), ["detalle"] = false
        };
    }
}
if (!nodos.ContainsKey(raiz))
{
    ctx.Msg("El documento " + raiz + " no existe, está eliminado o es de otra empresa.", "Trazabilidad del documento");
    return "NO EXISTE";
}

foreach (var k in aristas.Keys.ToList())
{
    var a = aristas[k];
    if (!nodos.ContainsKey((long)a["desde"]) || !nodos.ContainsKey((long)a["hasta"]))
    {
        avisos.Add("Un vínculo apunta a un documento eliminado o que no es de esta empresa (" + a["desde"] + " → " + a["hasta"] + "); se omitió.");
        aristas.Remove(k);
    }
}

foreach (var lote in Lotes(nodos.Keys, 400))
{
    var pagos = ctx.Query(
        "SELECT p.DocumentID, p.FinancialOperationID, p.DateOperation, p.Amount, ISNULL(p.PaymentWithDocumentID,0) AS NC, ISNULL(f.FolioPrefix,'') AS Serie, ISNULL(CAST(f.Folio AS NVARCHAR(30)),'') AS Folio, " +
        "f.DocRecipientID, ISNULL(pm.Value,'') AS Forma, ISNULL(fe.FinancialEntityName,'') AS Cuenta " +
        "FROM docDocumentPayment p LEFT JOIN docFinancialOperation f ON f.FinancialOperationID=p.FinancialOperationID " +
        "LEFT JOIN vwcboCFDPaymentmethod pm ON pm.ID = f.PaymentMethodID LEFT JOIN orgFinancialEntity fe ON fe.FinancialEntityID = f.FinancialEntityID " +
        "WHERE p.DeletedOn IS NULL AND p.DocumentID IN (" + Lista(lote) + ") ORDER BY p.DateOperation, p.DocumentPaymentID");
    foreach (var r in pagos)
    {
        long id = L(r["DocumentID"]);
        if (nodos.TryGetValue(id, out var n))
            ((List<Dictionary<string, object>>)n["pagos"]).Add(new Dictionary<string, object>
            {
                ["operacion"] = L(r["FinancialOperationID"]), ["fecha"] = FechaTxt(r["DateOperation"]), ["monto"] = M(r["Amount"]), ["nc"] = L(r["NC"]),
                ["folio"] = (S(r["Serie"]) + S(r["Folio"])).Trim(), ["clase"] = L(r["NC"]) > 0 ? "Nota de crédito" : I(r["DocRecipientID"]) == 2 ? "Pago" : "Cobro",
                ["forma"] = S(r["Forma"]), ["cuenta"] = S(r["Cuenta"])
            });
    }
}

const int MaxPartidas = 3000;
var conDetalle = new List<long>(); int acumuladas = 0;
foreach (var lote in Lotes(nodos.Keys.OrderBy(k => k == raiz ? 0 : 1), 400))
{
    var cuenta = ctx.Query("SELECT DocumentID, COUNT(*) AS N FROM docDocumentItem WHERE DeletedOn IS NULL AND DocumentID IN (" + Lista(lote) + ") GROUP BY DocumentID");
    var porDoc = cuenta.ToDictionary(r => L(r["DocumentID"]), r => I(r["N"]));
    foreach (var id in lote)
    {
        int n = porDoc.ContainsKey(id) ? porDoc[id] : 0;
        if (acumuladas + n <= MaxPartidas || id == raiz) { conDetalle.Add(id); acumuladas += n; } else avisos.Add("El detalle de partidas del documento " + id + " no se cargó (la cadena es muy grande); selecciónalo como punto de partida para verlo.");
    }
}
var partidaPor = new Dictionary<long, Dictionary<string, object>>();
foreach (var lote in Lotes(conDetalle, 300))
{
    string ids = Lista(lote);
    var its = ctx.Query(
        "SELECT i.DocumentItemID, i.DocumentID, i.ProductID, ISNULL(p.ProductKey,'') AS Clave, ISNULL(NULLIF(i.Description,''), p.ProductName) AS Descr, ISNULL(i.Unit,'') AS Unidad, ISNULL(p.Unit,'') AS UnidadBase, " +
        "i.Quantity, ISNULL(i.CoefUnit,1) AS Coef, ISNULL(i.QuantityInventory,0) AS QInv, ISNULL(i.UnitPrice,0) AS Precio, ISNULL(i.DiscountPerc,0) AS Dsc, ISNULL(i.Total,0) AS Total, " +
        "ISNULL(i.SourceDocumentItemID,0) AS SrcItem, ISNULL(i.DeliverDocumentItemID,0) AS DelItem, ISNULL(i.Lot,'') AS LoteSimple, ISNULL(i.SerialNumber,'') AS Serie, ISNULL(i.SerialNumberTo,'') AS SerieA " +
        "FROM docDocumentItem i LEFT JOIN orgProduct p ON p.ProductID = i.ProductID WHERE i.DeletedOn IS NULL AND i.DocumentID IN (" + ids + ") ORDER BY i.DocumentID, i.DocumentItemID");
    foreach (var r in its)
    {
        long did = L(r["DocumentID"]); if (!nodos.ContainsKey(did)) continue;
        double coef = D(r["Coef"]); string uni = S(r["Unidad"]), uniBase = S(r["UnidadBase"]);
        decimal cant = M(r["Quantity"]), qInv = M(r["QInv"]);
        bool conversion = uni != "" && uniBase != "" && !string.Equals(uni, uniBase, StringComparison.OrdinalIgnoreCase) && coef > 0 && Math.Abs(coef - 1) > 0.000001;
        var p = new Dictionary<string, object>
        {
            ["item"] = L(r["DocumentItemID"]), ["doc"] = did, ["producto"] = I(r["ProductID"]), ["clave"] = S(r["Clave"]), ["desc"] = S(r["Descr"]), ["uni"] = uni, ["uniBase"] = uniBase,
            ["cant"] = cant, ["coef"] = coef, ["cantBase"] = conversion ? (qInv != 0 ? qInv : cant * (decimal)coef) : cant, ["conversion"] = conversion,
            ["precio"] = M(r["Precio"]), ["dsc"] = M(r["Dsc"]), ["total"] = M(r["Total"]),
            ["lotes"] = new List<Dictionary<string, object>>(), ["series"] = new List<string>(), ["nSeries"] = 0, ["peds"] = new List<Dictionary<string, object>>(),
            ["orig"] = new List<Dictionary<string, object>>(), ["dest"] = new List<Dictionary<string, object>>(),
            ["_src"] = L(r["SrcItem"]), ["_del"] = L(r["DelItem"])
        };
        if (S(r["LoteSimple"]) != "") ((List<Dictionary<string, object>>)p["lotes"]).Add(new Dictionary<string, object> { ["lote"] = S(r["LoteSimple"]), ["cant"] = cant, ["cad"] = "", ["uni"] = uni });
        if (S(r["Serie"]) != "") { ((List<string>)p["series"]).Add(S(r["Serie"]) + (S(r["SerieA"]) != "" && S(r["SerieA"]) != S(r["Serie"]) ? " … " + S(r["SerieA"]) : "")); p["nSeries"] = 1; }
        partidaPor[(long)p["item"]] = p;
        ((List<Dictionary<string, object>>)nodos[did]["partidas"]).Add(p);
    }
    foreach (var id in lote) if (nodos.ContainsKey(id)) nodos[id]["detalle"] = true;

    foreach (var r in ctx.Query("SELECT DocumentItemID, Lot, Quantity, ExpirationDate, ISNULL(Unit,'') AS Unidad FROM docDocumentLot WHERE DeletedOn IS NULL AND CancelledOn IS NULL AND DocumentID IN (" + ids + ") " +
                                "UNION ALL SELECT DocumentItemID, Lot, Quantity, ExpirationDate, '' FROM docDocumentItemLot WHERE DocumentID IN (" + ids + ")"))
    {
        if (!partidaPor.TryGetValue(L(r["DocumentItemID"]), out var p)) continue;
        var lst = (List<Dictionary<string, object>>)p["lotes"]; string lote1 = S(r["Lot"]);
        if (lote1 == "" || lst.Any(x => S(x["lote"]) == lote1 && M(x["cant"]) == M(r["Quantity"]))) continue;
        lst.Add(new Dictionary<string, object> { ["lote"] = lote1, ["cant"] = M(r["Quantity"]), ["cad"] = FechaTxt(r["ExpirationDate"]), ["uni"] = S(r["Unidad"]) });
    }

    foreach (var r in ctx.Query("SELECT DocumentItemID, SerialNumber FROM docDocumentSerialNumber WHERE DeletedOn IS NULL AND CancelledOn IS NULL AND DocumentID IN (" + ids + ") " +
                                "UNION ALL SELECT DocumentItemID, SerialNumberFrom + CASE WHEN ISNULL(SerialNumberTo,'') IN ('', SerialNumberFrom) THEN '' ELSE ' … ' + SerialNumberTo END FROM docDocumentItemSerialNumber WHERE DocumentID IN (" + ids + ")"))
    {
        if (!partidaPor.TryGetValue(L(r["DocumentItemID"]), out var p)) continue;
        var lst = (List<string>)p["series"]; p["nSeries"] = I(p["nSeries"]) + 1;
        if (lst.Count < 40 && !lst.Contains(S(r["SerialNumber"]))) lst.Add(S(r["SerialNumber"]));
    }

    foreach (var r in ctx.Query("SELECT x.DocumentItemID, x.Quantity, ISNULL(x.Unit,'') AS Unidad, pi.ProductImportNumber AS Numero, ISNULL(pi.Customs,'') AS Aduana, pi.DateImport AS Fecha, ISNULL(pi.ClavePedimento,'') AS Clave " +
                                "FROM docDocumentProductImport x LEFT JOIN docProductImport pi ON pi.ProductImportID = x.ProductImportID WHERE x.DeletedOn IS NULL AND x.DocumentID IN (" + ids + ")"))
    {
        if (!partidaPor.TryGetValue(L(r["DocumentItemID"]), out var p)) continue;
        ((List<Dictionary<string, object>>)p["peds"]).Add(new Dictionary<string, object> { ["num"] = S(r["Numero"]), ["aduana"] = S(r["Aduana"]), ["fecha"] = FechaTxt(r["Fecha"]), ["cant"] = M(r["Quantity"]), ["uni"] = S(r["Unidad"]) });
    }
}

foreach (var n in nodos.Values)
    foreach (var p in (List<Dictionary<string, object>>)n["partidas"])
        foreach (var par in new[] { new object[] { p["_src"], "factura" }, new object[] { p["_del"], "entrega" } })
        {
            long oi = (long)par[0]; if (oi <= 0 || !partidaPor.TryGetValue(oi, out var po)) continue;
            long od = (long)po["doc"];
            ((List<Dictionary<string, object>>)p["orig"]).Add(new Dictionary<string, object> { ["item"] = oi, ["doc"] = od, ["cant"] = po["cant"] });
            ((List<Dictionary<string, object>>)po["dest"]).Add(new Dictionary<string, object> { ["item"] = p["item"], ["doc"] = n["id"], ["cant"] = p["cant"] });
        }

foreach (var n in nodos.Values)
{
    long src = (long)n["src"]; if (src <= 0 || !nodos.ContainsKey(src)) continue;
    var mias = (List<Dictionary<string, object>>)n["partidas"];
    if (mias.Count == 0 || mias.Any(p => ((List<Dictionary<string, object>>)p["orig"]).Count > 0)) continue;
    var deOrigen = (List<Dictionary<string, object>>)nodos[src]["partidas"];
    foreach (var p in mias)
    {
        var po = deOrigen.FirstOrDefault(x => I(x["producto"]) == I(p["producto"])); if (po == null) continue;
        ((List<Dictionary<string, object>>)p["orig"]).Add(new Dictionary<string, object> { ["item"] = po["item"], ["doc"] = src, ["cant"] = po["cant"], ["aprox"] = true });
        ((List<Dictionary<string, object>>)po["dest"]).Add(new Dictionary<string, object> { ["item"] = p["item"], ["doc"] = n["id"], ["cant"] = p["cant"], ["aprox"] = true });
    }
}
foreach (var n in nodos.Values) foreach (var p in (List<Dictionary<string, object>>)n["partidas"]) { p.Remove("_src"); p.Remove("_del"); }

foreach (var a in aristas.Values)
{
    var tipos = (List<string>)a["tipos"];
    long d = (long)a["desde"], h = (long)a["hasta"];
    string nd = S(nodos[d]["tipoNombre"]) + " " + S(nodos[d]["folio"]), nh = S(nodos[h]["tipoNombre"]) + " " + S(nodos[h]["folio"]);
    a["manual"] = tipos.Count == 1 && tipos[0] == "D";
    if ((bool)a["manual"])
        avisos.Add("Vínculo manual: " + nd + " → " + nh + " existe solo por DestinationDocumentID (el documento destino no lo reconoce como su origen). Es normal cuando de varios orígenes sale un solo documento.");
    else if (tipos.Contains("D") && (long)nodos[h]["src"] > 0 && (long)nodos[h]["src"] != d)
        avisos.Add(nh + " tiene como origen principal (SourceDocumentID) a otro documento; " + nd + " lo ligó además por DestinationDocumentID: varios orígenes para un solo destino.");
}
foreach (var n in nodos.Values)
    if ((bool)n["cancelado"]) avisos.Add(S(n["tipoNombre"]) + " " + S(n["folio"]) + " está CANCELADO y sigue ligado en la cadena.");

var modelo = new Dictionary<string, object>
{
    ["raiz"] = raiz, ["etapas"] = ETAPAS, ["avisos"] = avisos.Distinct().ToList(),
    ["nodos"] = nodos.Values.OrderBy(n => (int)n["etapa"]).ThenBy(n => S(n["fecha"])).ThenBy(n => (long)n["id"]).ToList(),
    ["aristas"] = aristas.Values.Select(a => new Dictionary<string, object> { ["d"] = a["desde"], ["h"] = a["hasta"], ["manual"] = a["manual"], ["desde"] = a["desde"], ["hasta"] = a["hasta"], ["tipos"] = a["tipos"] }).ToList()
};
string pruebaHtml = Environment.GetEnvironmentVariable("BROSLMV_TRAZA_HTML");
if (!string.IsNullOrEmpty(modoPrueba) || !string.IsNullOrEmpty(pruebaHtml))
{
    string salidaPrueba = Environment.GetEnvironmentVariable("BROSLMV_TRAZA_OUT");
    string jsonPrueba = ser.Serialize(modelo);
    if (!string.IsNullOrEmpty(salidaPrueba)) File.WriteAllText(salidaPrueba, jsonPrueba, new UTF8Encoding(false));
    if (!string.IsNullOrEmpty(pruebaHtml)) File.WriteAllText(pruebaHtml, Html(jsonPrueba), new UTF8Encoding(false));
    return jsonPrueba;
}

string Html(string json) => @"<!DOCTYPE html><html lang='es'><head><meta charset='utf-8'><title>Trazabilidad</title><style>
:root{--fondo:#eef1f5;--panel:#ffffff;--texto:#14202e;--suave:#5f6f82;--linea:#d6dde6;--linea2:#e8edf3;--azul:#1f5fd1;--azul-s:#e6efff;--rojo:#c0392b;--ambar:#a8650b;--verde:#17803d;
 --venta:#0e8f87;--compra:#4a58c9;--inv:#6b7280;--sombra:0 1px 2px rgba(15,30,50,.08),0 4px 14px rgba(15,30,50,.06)}
@media (prefers-color-scheme:dark){:root{--fondo:#10161e;--panel:#18212c;--texto:#e6ebf2;--suave:#93a1b3;--linea:#2b3847;--linea2:#223040;--azul:#6fa0ff;--azul-s:#1d2f4d;--rojo:#ff7b6b;--ambar:#e6a04a;--verde:#4cc77e;--venta:#34c4ba;--compra:#8e9bff;--inv:#9aa5b4;--sombra:0 1px 2px rgba(0,0,0,.4)}}
*{box-sizing:border-box}html,body{height:100%}body{margin:0;font:13px 'Segoe UI Variable','Segoe UI',Arial,sans-serif;background:var(--fondo);color:var(--texto);display:flex;flex-direction:column;overflow:hidden}
button{font:inherit;border:1px solid var(--linea);background:var(--panel);color:var(--texto);border-radius:6px;padding:5px 12px;cursor:pointer}button:hover{border-color:var(--azul)}button.p{background:var(--azul);color:#fff;border-color:var(--azul)}
header{display:flex;align-items:center;gap:14px;padding:10px 18px;background:var(--panel);border-bottom:1px solid var(--linea);flex-wrap:wrap}
header h1{margin:0;font-size:16px;font-weight:650;letter-spacing:.01em}header .sub{color:var(--suave)}header .esp{flex:1}
#avisos{display:none;margin:0;padding:6px 18px;background:#fff7e6;color:#7a4b06;border-bottom:1px solid #f0d9ad;font-size:12px}#avisos.on{display:block}#avisos summary{cursor:pointer}#avisos ul{margin:4px 0 2px 18px;padding:0}
@media (prefers-color-scheme:dark){#avisos{background:#2b2312;color:#e6c48a;border-color:#4a3a1a}}
#flujo{position:relative;overflow:auto;flex:0 0 var(--alto,320px);min-height:150px;padding:12px 18px 14px;background:var(--fondo)}
#malla{position:relative;display:grid;column-gap:46px;row-gap:12px;min-width:max-content;align-items:start}
.encab{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--suave);padding:0 2px 2px;border-bottom:1px solid var(--linea);position:sticky;top:-12px;background:var(--fondo);z-index:3}
.carril{display:flex;align-items:center;justify-content:center;writing-mode:vertical-rl;transform:rotate(180deg);font-size:11px;letter-spacing:.12em;text-transform:uppercase;font-weight:650;border-radius:6px;padding:8px 3px;min-height:80px;align-self:stretch}
.carril.Venta{background:color-mix(in srgb,var(--venta) 14%,transparent);color:var(--venta)}.carril.Compra{background:color-mix(in srgb,var(--compra) 14%,transparent);color:var(--compra)}.carril.Inv{background:color-mix(in srgb,var(--inv) 14%,transparent);color:var(--inv)}
.celda{display:flex;flex-direction:column;gap:9px;min-width:236px;position:relative;z-index:2}
.card{background:var(--panel);border:1px solid var(--linea);border-left:4px solid var(--c,var(--inv));border-radius:8px;padding:7px 10px 8px;cursor:pointer;box-shadow:var(--sombra);transition:border-color .12s,box-shadow .12s}
.card:hover{border-color:var(--azul);border-left-color:var(--c)}.card.sel{outline:2px solid var(--azul);outline-offset:1px;background:var(--azul-s)}.card.raiz .tipo::after{content:' ★';color:var(--ambar)}.card.canc{opacity:.6}.card.canc .folio{text-decoration:line-through}
.card.Venta{--c:var(--venta)}.card.Compra{--c:var(--compra)}.card.Inv{--c:var(--inv)}
.card .fila{display:flex;justify-content:space-between;gap:8px;align-items:baseline}.card .tipo{font-size:11px;color:var(--suave);text-transform:uppercase;letter-spacing:.04em}
.card .folio{font-weight:650;font-size:14px}.card .id{color:var(--suave);font-variant-numeric:tabular-nums;font-size:11px}.card .ent{color:var(--suave);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:215px}
.card .monto{font-variant-numeric:tabular-nums;font-weight:600}.pill{display:inline-block;border-radius:9px;padding:0 7px;font-size:11px;line-height:17px;background:var(--linea2);color:var(--suave);margin-left:4px}
.pill.ok{background:color-mix(in srgb,var(--verde) 16%,transparent);color:var(--verde)}.pill.par{background:color-mix(in srgb,var(--ambar) 18%,transparent);color:var(--ambar)}.pill.mal{background:color-mix(in srgb,var(--rojo) 16%,transparent);color:var(--rojo)}
svg#lineas{position:absolute;left:0;top:0;pointer-events:none;z-index:1;overflow:visible}svg#lineas path{fill:none;stroke:var(--suave);stroke-width:1.6;opacity:.55}svg#lineas path.man{stroke-dasharray:6 4}
svg#lineas path.act{stroke:var(--azul);stroke-width:2.4;opacity:1}
#divisor{flex:0 0 7px;cursor:row-resize;background:var(--linea2);border-top:1px solid var(--linea);border-bottom:1px solid var(--linea)}#divisor:hover{background:var(--azul-s)}
#detalle{flex:1;overflow:auto;background:var(--panel);padding:12px 18px 18px;min-height:140px}
.cab{display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap}.cab .tit{font-size:17px;font-weight:650}.cab .tit small{font-weight:400;color:var(--suave);margin-left:8px}
.datos{display:flex;gap:26px;flex-wrap:wrap;margin:8px 0 10px}.datos div{min-width:90px}.datos b{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--suave);font-weight:600}.datos span{font-variant-numeric:tabular-nums}
.rel{font-size:12px;color:var(--suave);margin:2px 0 8px}.rel a{color:var(--azul);cursor:pointer;text-decoration:none;margin-right:10px}.rel a:hover{text-decoration:underline}
.tabs{display:flex;gap:2px;border-bottom:1px solid var(--linea);margin-top:6px}.tabs button{border:0;border-bottom:3px solid transparent;border-radius:0;background:none;padding:7px 14px}.tabs button.on{border-bottom-color:var(--azul);font-weight:650}
table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums;margin-top:8px}th{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--suave);text-align:right;padding:5px 8px;border-bottom:1px solid var(--linea);white-space:nowrap}
td{padding:5px 8px;text-align:right;border-bottom:1px solid var(--linea2);vertical-align:top}th.l,td.l{text-align:left}tr.extra td{border-bottom:1px solid var(--linea);padding-top:0;text-align:left;color:var(--suave);font-size:12px}
td a{color:var(--azul);cursor:pointer}td a:hover{text-decoration:underline}.chip{display:inline-block;border:1px solid var(--linea);border-radius:5px;padding:0 6px;margin:2px 4px 0 0;font-size:11.5px;color:var(--texto);background:var(--fondo)}.chip em{font-style:normal;color:var(--suave)}
.conv{display:block;color:var(--suave);font-size:11.5px}.pend{color:var(--ambar);font-weight:600}.hecho{color:var(--verde)}.vacio{padding:28px;text-align:center;color:var(--suave)}.aprox{color:var(--ambar)}
</style></head><body>
<header><h1 id='tit'></h1><span class='sub' id='sub'></span><span class='esp'></span><button onclick='exportar(false)'>Exportar partidas del documento</button><button onclick='exportar(true)'>Exportar toda la cadena</button><button class='p' onclick='abrirSel()'>Abrir en Comercial</button></header>
<details id='avisos'><summary id='avSum'></summary><ul id='avLista'></ul></details>
<div id='flujo'><div id='malla'></div><svg id='lineas'><defs><marker id='flecha' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto-start-reverse'><path d='M0,0 L10,5 L0,10 z' fill='context-stroke' style='fill:var(--suave);stroke:none'/></marker><marker id='flechaA' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto-start-reverse'><path d='M0,0 L10,5 L0,10 z' style='fill:var(--azul);stroke:none'/></marker></defs></svg></div>
<div id='divisor' title='Arrastra para cambiar el tamaño'></div>
<div id='detalle'></div>
<script>
var M=__MODELO__;
function enviar(o){window.chrome.webview.postMessage(JSON.stringify(o));}
function esc(s){return String(s==null?'':s).replace(/[&<>']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;',""'"":'&#39;'}[c];});}
function din(n){return (n||0).toLocaleString('es-MX',{style:'currency',currency:'MXN'});}
function num(n){return (+n||0).toLocaleString('es-MX',{maximumFractionDigits:4});}
var N={};M.nodos.forEach(function(n){N[n.id]=n;});
var sel=M.raiz,tab='partidas';
function claseCarril(n){return n.carril==='Venta'?'Venta':n.carril==='Compra'?'Compra':'Inv';}
function estadoPago(n){if(n.cancelado)return ['Cancelado','mal'];if(!(n.total>0.004))return null;if(n.saldo<=0.004)return ['Pagado','ok'];if(n.pagado>0.004)return ['Parcial','par'];return ['Sin pago','mal'];}
// ---- el mapa: columnas por etapa del flujo, filas por carril ----
function pintarMapa(){
  var etapas=[],carriles=[];M.nodos.forEach(function(n){if(etapas.indexOf(n.etapa)<0)etapas.push(n.etapa);if(carriles.indexOf(n.carril)<0)carriles.push(n.carril);});
  etapas.sort();var orden=['Venta','Compra','Inventario y otros'];carriles.sort(function(a,b){return orden.indexOf(a)-orden.indexOf(b);});
  var m=document.getElementById('malla');m.style.gridTemplateColumns='34px '+etapas.map(function(){return 'minmax(236px,auto)';}).join(' ');
  var h='<div></div>'+etapas.map(function(e){return '<div class=encab>'+esc(M.etapas[e])+'</div>';}).join('');
  carriles.forEach(function(c){
    h+='<div class=\'carril '+(c==='Venta'?'Venta':c==='Compra'?'Compra':'Inv')+'\'>'+esc(c)+'</div>';
    etapas.forEach(function(e){
      h+='<div class=celda>'+M.nodos.filter(function(n){return n.etapa===e&&n.carril===c;}).map(tarjeta).join('')+'</div>';
    });
  });
  m.innerHTML=h;
}
function tarjeta(n){var ep=estadoPago(n);
  return '<div class=\'card '+claseCarril(n)+(n.raiz?' raiz':'')+(n.cancelado?' canc':'')+(n.id===sel?' sel':'')+'\' data-id='+n.id+' title=\'Clic: ver el detalle · Doble clic: abrir en Comercial\'>'
   +'<div class=fila><span class=tipo>'+esc(n.tipoNombre)+'</span><span class=id>#'+n.id+'</span></div>'
   +'<div class=folio>'+esc(n.folio||('Documento '+n.id))+'</div>'
   +'<div class=ent>'+esc(n.fecha)+' · '+esc(n.entidad)+'</div>'
   +'<div class=fila><span class=monto>'+din(n.total)+'</span><span>'+(ep?'<span class=\'pill '+ep[1]+'\'>'+ep[0]+'</span>':'')+'</span></div></div>';}
function lineas(){
  var svg=document.getElementById('lineas'),malla=document.getElementById('malla'),base=malla.getBoundingClientRect();
  svg.setAttribute('width',malla.scrollWidth);svg.setAttribute('height',malla.scrollHeight);
  var defs=svg.querySelector('defs').outerHTML,p='';
  M.aristas.forEach(function(a){
    var d=document.querySelector('.card[data-id=\''+a.d+'\']'),h=document.querySelector('.card[data-id=\''+a.h+'\']');if(!d||!h)return;
    var r1=d.getBoundingClientRect(),r2=h.getBoundingClientRect();
    var x1=r1.right-base.left,y1=r1.top-base.top+r1.height/2,x2=r2.left-base.left,y2=r2.top-base.top+r2.height/2,dx=Math.max(40,Math.abs(x2-x1)/2);
    var act=(a.d===sel||a.h===sel);
    p+='<path class=\''+(a.manual?'man ':'')+(act?'act':'')+'\' marker-end=\'url(#'+(act?'flechaA':'flecha')+')\' d=\'M'+x1+','+y1+' C'+(x1+dx)+','+y1+' '+(x2-dx)+','+y2+' '+x2+','+y2+'\'><title>'+(a.manual?'Vínculo manual (DestinationDocumentID)':'Vínculo del sistema')+'</title></path>';
  });
  svg.innerHTML=defs+p;
}
// ---- el detalle del documento elegido ----
function lnk(id,txt){return N[id]?'<a onclick=\'elegir('+id+')\'>'+esc(txt||((N[id].tipoNombre)+' '+(N[id].folio||'')))+' <small>#'+id+'</small></a>':'#'+id;}
function pintarDetalle(){
  var n=N[sel];if(!n)return;var ep=estadoPago(n);
  var orig=M.aristas.filter(function(a){return a.h===n.id;}),dest=M.aristas.filter(function(a){return a.d===n.id;});
  var h='<div class=cab><div class=tit>'+esc(n.tipoNombre)+' · '+esc(n.folio||'sin folio')+'<small>ID '+n.id+(n.titulo?' · '+esc(n.titulo):'')+'</small></div>'+(ep?'<span class=\'pill '+ep[1]+'\'>'+ep[0]+'</span>':'')+(n.cancelado?'':'')+'</div>';
  h+='<div class=datos><div><b>Fecha</b><span>'+esc(n.fecha)+'</span></div><div><b>'+(n.carril==='Compra'?'Proveedor':n.carril==='Venta'?'Cliente':'Entidad')+'</b><span>'+esc(n.entidad||'—')+'</span></div><div><b>Total</b><span>'+din(n.total)+'</span></div>'
    +(n.total>0?'<div><b>Pagado</b><span>'+din(n.pagado)+'</span></div><div><b>Saldo</b><span>'+din(n.saldo)+'</span></div>':'')+'<div><b>Partidas</b><span>'+n.partidas.length+'</span></div></div>';
  h+='<div class=rel>Viene de: '+(orig.length?orig.map(function(a){return lnk(a.d)+(a.manual?' <span class=aprox>(vínculo manual)</span>':'');}).join(' '):'<i>nada (es un documento de origen)</i>')
    +' &nbsp;·&nbsp; Va hacia: '+(dest.length?dest.map(function(a){return lnk(a.h)+(a.manual?' <span class=aprox>(vínculo manual)</span>':'');}).join(' '):'<i>nada todavía</i>')+'</div>';
  h+='<div class=tabs><button class=\''+(tab==='partidas'?'on':'')+'\' onclick=\'setTab(&quot;partidas&quot;)\'>Partidas ('+n.partidas.length+')</button><button class=\''+(tab==='pagos'?'on':'')+'\' onclick=\'setTab(&quot;pagos&quot;)\'>Pagos y cobros ('+n.pagos.length+')</button></div>';
  h+=tab==='partidas'?tablaPartidas(n):tablaPagos(n);
  document.getElementById('detalle').innerHTML=h;
}
function setTab(t){tab=t;pintarDetalle();}
function tablaPartidas(n){
  if(!n.detalle)return '<div class=vacio>El detalle de partidas de este documento no se cargó porque la cadena es muy grande. Ejecuta la trazabilidad desde este documento para verlo.</div>';
  if(!n.partidas.length)return '<div class=vacio>Este documento no tiene partidas.</div>';
  var h='<table><thead><tr><th class=l>#</th><th class=l>Clave</th><th class=l>Descripción</th><th>Cantidad</th><th>Precio</th><th>Desc. %</th><th>Importe</th><th class=l>Viene de</th><th class=l>Va hacia</th></tr></thead><tbody>';
  n.partidas.forEach(function(p,i){
    var ori=p.orig.map(function(o){return lnk(o.doc)+' ('+num(o.cant)+')'+(o.aprox?' <span class=aprox title=\'Ligado por el encabezado y el producto, no por partida\'>≈</span>':'');}).join('<br>');
    var des=p.dest.map(function(o){return lnk(o.doc)+': '+num(o.cant)+(o.aprox?' <span class=aprox>≈</span>':'');}).join('<br>');
    var grupos={};p.dest.forEach(function(d){var e=N[d.doc]?N[d.doc].etapa:0;if(e>=3&&e<=4)grupos[e]=(grupos[e]||0)+d.cant;});
    Object.keys(grupos).sort().forEach(function(e){var f=p.cant-grupos[e],rot=e==3?'Entrega':'Factura';des+='<br>'+(f>0.00001?'<span class=pend>'+rot+': falta '+num(f)+'</span>':'<span class=hecho>'+rot+' completa</span>');});
    h+='<tr><td class=l>'+(i+1)+'</td><td class=l>'+esc(p.clave)+'</td><td class=l>'+esc(p.desc)+'</td><td>'+num(p.cant)+' '+esc(p.uni)+(p.conversion?'<span class=conv>= '+num(p.cantBase)+' '+esc(p.uniBase)+' (×'+num(p.coef)+')</span>':'')+'</td><td>'+din(p.precio)+'</td><td>'+(p.dsc?num(p.dsc*(p.dsc<=1?100:1)):'')+'</td><td>'+din(p.total)+'</td><td class=l>'+(ori||'—')+'</td><td class=l>'+(des||'—')+'</td></tr>';
    var ex='';
    p.lotes.forEach(function(l){ex+='<span class=chip><em>Lote</em> '+esc(l.lote)+' · '+num(l.cant)+(l.cad?' · <em>cad.</em> '+esc(l.cad):'')+'</span>';});
    if(p.series.length){ex+='<span class=chip><em>Series ('+p.nSeries+')</em> '+esc(p.series.slice(0,6).join(', '))+(p.nSeries>6?' …':'')+'</span>';}
    p.peds.forEach(function(d){ex+='<span class=chip><em>Pedimento</em> '+esc(d.num)+(d.aduana?' · aduana '+esc(d.aduana):'')+(d.fecha?' · '+esc(d.fecha):'')+' · '+num(d.cant)+'</span>';});
    if(ex)h+='<tr class=extra><td></td><td colspan=8>'+ex+'</td></tr>';
  });
  return h+'</tbody></table>';
}
function tablaPagos(n){
  if(!n.pagos.length)return '<div class=vacio>'+(n.total>0?'Este documento no tiene pagos ni cobros aplicados.':'Este documento no maneja pagos.')+'</div>';
  var h='<table><thead><tr><th class=l>Fecha</th><th class=l>Tipo</th><th class=l>Operación</th><th class=l>Forma de pago</th><th class=l>Cuenta</th><th>Monto aplicado</th></tr></thead><tbody>',t=0;
  n.pagos.forEach(function(p){t+=p.monto;h+='<tr><td class=l>'+esc(p.fecha)+'</td><td class=l>'+esc(p.clase)+'</td><td class=l>'+esc(p.nc?('Nota de crédito '+(N[p.nc]?N[p.nc].folio:'#'+p.nc)):(p.folio||('#'+p.operacion)))+'</td><td class=l>'+esc(p.forma)+'</td><td class=l>'+esc(p.cuenta)+'</td><td>'+din(p.monto)+'</td></tr>';});
  return h+'</tbody><tfoot><tr><td class=l colspan=5><b>Total aplicado</b></td><td><b>'+din(t)+'</b></td></tr></tfoot></table>';
}
function elegir(id){if(!N[id])return;sel=id;document.querySelectorAll('.card').forEach(function(c){c.classList.toggle('sel',+c.getAttribute('data-id')===id);});lineas();pintarDetalle();}
function abrirSel(){enviar({accion:'abrir',id:sel});}
// ---- exportar ----
function csvCelda(c){c=String(c==null?'':c);return /[,\""\n]/.test(c)?'\""'+c.replace(/\""/g,'\""\""')+'\""':c;}
function exportar(todo){
  var ns=todo?M.nodos:[N[sel]],f=[['ID documento','Tipo','Folio','Fecha','Entidad','Partida','Clave','Descripción','Cantidad','Unidad','Cantidad en unidad base','Unidad base','Precio','Importe','Viene de (ID)','Va hacia (ID: cantidad)','Lotes','Series','Pedimentos']];
  ns.forEach(function(n){n.partidas.forEach(function(p,i){f.push([n.id,n.tipoNombre,n.folio,n.fecha,n.entidad,i+1,p.clave,p.desc,p.cant,p.uni,p.cantBase,p.uniBase,p.precio,p.total,
    p.orig.map(function(o){return o.doc;}).join(' '),p.dest.map(function(o){return o.doc+': '+o.cant;}).join(' | '),
    p.lotes.map(function(l){return l.lote+' ('+l.cant+(l.cad?', cad. '+l.cad:'')+')';}).join(' | '),(p.series||[]).join(' '),p.peds.map(function(d){return d.num+' ('+d.cant+')';}).join(' | ')]);});});
  enviar({accion:'csv',nombre:todo?('trazabilidad_cadena_'+M.raiz):('partidas_'+sel),contenido:f.map(function(r){return r.map(csvCelda).join(',');}).join('\r\n')});
}
// ---- arranque ----
(function(){
  var r=N[M.raiz];document.getElementById('tit').textContent='Trazabilidad · '+r.tipoNombre+' '+(r.folio||'')+' (ID '+r.id+')';
  document.getElementById('sub').textContent=M.nodos.length+' documento(s) · '+M.aristas.length+' vínculo(s)';
  if(M.avisos.length){var a=document.getElementById('avisos');a.className='on';document.getElementById('avSum').textContent=M.avisos.length+' aviso(s) sobre los vínculos';document.getElementById('avLista').innerHTML=M.avisos.map(function(x){return '<li>'+esc(x)+'</li>';}).join('');}
  pintarMapa();pintarDetalle();setTimeout(lineas,30);window.addEventListener('resize',lineas);
  document.getElementById('flujo').addEventListener('scroll',function(){});
  var mapa=document.getElementById('malla');
  mapa.addEventListener('click',function(e){var c=e.target.closest('.card');if(c)elegir(+c.getAttribute('data-id'));});
  mapa.addEventListener('dblclick',function(e){var c=e.target.closest('.card');if(c)enviar({accion:'abrir',id:+c.getAttribute('data-id')});});
  var div=document.getElementById('divisor'),fl=document.getElementById('flujo');
  div.addEventListener('mousedown',function(e){var y0=e.clientY,h0=fl.getBoundingClientRect().height;function mv(ev){fl.style.flexBasis=Math.max(140,Math.min(window.innerHeight-220,h0+ev.clientY-y0))+'px';lineas();}function up(){document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);}document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);e.preventDefault();});
})();
</script></body></html>".Replace("__MODELO__", json);

Func<Dictionary<string, object>, string> alMensaje = r =>
{
    string accion = r.ContainsKey("accion") ? S(r["accion"]) : "";
    if (accion == "abrir")
    {
        long id = r.ContainsKey("id") ? L(r["id"]) : raiz;
        int modulo = nodos.ContainsKey(id) ? (int)nodos[id]["modulo"] : 0;
        try { ctx.erp.AbrirDocumento((int)id, modulo); } catch (Exception ex) { ctx.Msg("No se pudo abrir el documento: " + ex.Message, "Trazabilidad"); }
    }
    else if (accion == "csv")
    {
        string nombre = new string(S(r["nombre"]).Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c).ToArray());
        using (var dlg = new SaveFileDialog { Filter = "CSV para Excel (*.csv)|*.csv", FileName = nombre + ".csv" })
            if (dlg.ShowDialog() == DialogResult.OK) { File.WriteAllText(dlg.FileName, S(r["contenido"]), new UTF8Encoding(true)); ctx.Msg("Archivo guardado:\n" + dlg.FileName, "Trazabilidad"); }
    }
    return null;
};
ctx.ShowHtmlModeless(Html(ser.Serialize(modelo)), "Trazabilidad del documento", 1360, 880, alMensaje);
return "OK";
