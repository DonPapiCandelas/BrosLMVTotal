pEdad.Paint += (s, e) =>
{
    var g = e.Graphics; g.TextRenderingHint = System.Drawing.Text.TextRenderingHint.ClearTypeGridFit;
    if (entSel == null || !ES.ContainsKey(I(entSel["id"]))) { using (var b = new SolidBrush(C_MUTED)) g.DrawString(entSel == null ? "Elige una persona para ver cuánto debe y desde cuándo." : "Esta persona no tiene saldo pendiente.", F_BASE, b, 0, 10); return; }
    var a = ES[I(entSel["id"])]; double total = Math.Max(0.01, a[0]); string[] nom = { "Vigente", "1-30 días", "31-60 días", "61-90 días", "Más de 90" };
    Color[] col = { C_VERDE, Color.FromArgb(101, 163, 13), Color.FromArgb(217, 119, 6), Color.FromArgb(234, 88, 12), C_ROJO };
    int w = (pEdad.Width - 4 * 10) / 5;
    for (int i = 0; i < 5; i++)
    {
        int x = i * (w + 10); using (var b = new SolidBrush(C_MUTED)) g.DrawString(nom[i], F_SM, b, x, 0); using (var b = new SolidBrush(col[i])) g.DrawString(a[3 + i].ToString("N2"), F_B, b, x, 14);
        using (var b = new SolidBrush(Color.FromArgb(229, 234, 241))) g.FillRectangle(b, x, 34, w, 5); using (var b = new SolidBrush(col[i])) g.FillRectangle(b, x, 34, (int)(w * a[3 + i] / total), 5);
    }
};

