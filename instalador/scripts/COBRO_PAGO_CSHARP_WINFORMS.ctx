// ---------- piezas de construcción ----------
Panel Grupo(Func<string> titulo)
{
    var p = new Panel { BackColor = Color.White, Size = new Size(600, 120) };
    p.Paint += (s, e) =>
    {
        var g = e.Graphics; using (var pen = new Pen(C_LINE)) g.DrawRectangle(pen, 0, 0, p.Width - 1, p.Height - 1);
        using (var b = new SolidBrush(C_HEAD)) g.FillRectangle(b, 1, 1, p.Width - 2, 27); using (var pen = new Pen(C_LINE)) g.DrawLine(pen, 0, 28, p.Width, 28);
        using (var b = new SolidBrush(Acento())) g.FillRectangle(b, 1, 1, 4, 27);
        using (var b = new SolidBrush(C_TXT)) g.DrawString(titulo(), F_H2, b, 14, 5);
    };
    return p;
}
Label Et(Control padre, string t, int x, int y) { var l = new Label { Text = t, Location = new Point(x, y), AutoSize = true, ForeColor = C_MUTED, Font = F_SM, BackColor = Color.Transparent }; padre.Controls.Add(l); return l; }
TextBox Cuadro(Control padre, string etiqueta, int x, int y, int w, bool soloLectura = false)
{
    if (etiqueta != "") Et(padre, etiqueta, x, y);
    var t = new TextBox { Location = new Point(x, y + 17), Size = new Size(w, 24), ReadOnly = soloLectura, BorderStyle = BorderStyle.FixedSingle, ForeColor = soloLectura ? C_MUTED : C_TXT }; padre.Controls.Add(t); return t;
}
ComboBox Lista(Control padre, string etiqueta, int x, int y, int w, int anchoMenu = 0)
{
    Et(padre, etiqueta, x, y);
    var c = new ComboBox { Location = new Point(x, y + 17), Size = new Size(w, 24), DropDownStyle = ComboBoxStyle.DropDownList, FlatStyle = FlatStyle.Flat }; if (anchoMenu > 0) c.DropDownWidth = anchoMenu; padre.Controls.Add(c); return c;
}
Label Dato(Control padre, string etiqueta, int x, int y)
{
    Et(padre, etiqueta, x, y);
    var v = new Label { Text = "0.00", Font = F_VAL, ForeColor = C_TXT, Location = new Point(x, y + 16), Size = new Size(140, 24), TextAlign = ContentAlignment.MiddleLeft, BackColor = Color.Transparent }; padre.Controls.Add(v); return v;
}
void PonerPorId(ComboBox c, int id) { for (int i = 0; i < c.Items.Count; i++) if (((Opcion)c.Items[i]).Id == id) { c.SelectedIndex = i; return; } if (c.Items.Count > 0) c.SelectedIndex = 0; }

