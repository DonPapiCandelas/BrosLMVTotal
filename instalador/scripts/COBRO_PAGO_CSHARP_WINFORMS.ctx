var C_HEAD = Color.FromArgb(248, 250, 252); var C_SEL = Color.FromArgb(238, 242, 255); var C_RIB = Color.FromArgb(51, 65, 85); var C_RIB_TX = Color.FromArgb(226, 232, 240); var C_RIB_MU = Color.FromArgb(148, 163, 184);
var C_COBRO = Color.FromArgb(37, 99, 235); var C_PAGO = Color.FromArgb(15, 118, 110); var C_ROJO = Color.FromArgb(200, 40, 40); var C_AMBAR = Color.FromArgb(180, 83, 9); var C_VERDE = Color.FromArgb(22, 128, 59);
var F_BASE = new Font("Segoe UI", 9f); var F_B = new Font("Segoe UI", 9f, FontStyle.Bold); var F_H2 = new Font("Segoe UI", 9.5f, FontStyle.Bold); var F_SM = new Font("Segoe UI", 8.5f);
var F_ICON = new Font("Segoe UI Emoji", 20f); var F_TOT = new Font("Segoe UI Semibold", 18f); var F_VAL = new Font("Segoe UI Semibold", 11f);

