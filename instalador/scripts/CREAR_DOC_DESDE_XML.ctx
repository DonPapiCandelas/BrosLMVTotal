#r "C:\BrosLMV\bin\Microsoft.Web.WebView2.Core.dll"
#r "C:\BrosLMV\bin\Microsoft.Web.WebView2.WinForms.dll"
// lang: csharp
// AppKey recomendado: CREAR_DOC_DESDE_XML
// Plantilla: Crear documentos desde XML
// Categoria: Documentos
// Documentacion: CREAR_DOC_DESDE_XML.html
// Crear documentos desde XML: convierte los CFDI recibidos seleccionados en Facturas de Compra, Gastos y demás módulos que reciben XML.
// Selecciona los XML en la lista de Comercial y ejecuta. Documentación completa: clic secundario sobre la plantilla → «Ver documentación».

using System;
using System.Collections.Generic;
using System.Drawing;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Text;
using System.Web.Script.Serialization;
using System.Windows.Forms;
using Microsoft.Web.WebView2.Core;
using Microsoft.Web.WebView2.WinForms;

var ids = ctx.GetSelectedIds();
if (ids == null || ids.Count == 0)
{
    ctx.Msg("Selecciona uno o más XML de la lista de Comercial antes de abrir el importador.", "Crear documentos desde XML");
    return;
}

// Todo se descubre de la empresa activa (ownEntityId): módulos por su naturaleza, catálogos, valores fiscales y rutas; nada va escrito a mano.
// Lo que no se pueda descubrir en una empresa nueva se fija en la tabla zzBrosCfdiConfig (Clave, Valor).
var ci = CultureInfo.InvariantCulture;
var ser = new JavaScriptSerializer { MaxJsonLength = 128 * 1024 * 1024 };

string S(object v) => v == null || v is DBNull ? "" : Convert.ToString(v);
int I(object v) { try { return Convert.ToInt32(v ?? 0); } catch { return 0; } }
long L(object v) { try { return Convert.ToInt64(v ?? 0); } catch { return 0; } }
double D(object v) { try { return Convert.ToDouble(v ?? 0, ci); } catch { return 0; } }
bool B(object v) { try { return Convert.ToBoolean(v); } catch { return false; } }
string Q(string s) => "N'" + (s ?? "").Replace("'", "''") + "'";
string Norm(string s) => new string((s ?? "").Trim().ToUpperInvariant().Where(char.IsLetterOrDigit).ToArray());
string Num(double n) => n.ToString("0.############", ci);
double N01(double x) => x > 1.0 ? x / 100.0 : x;
string Cortar(string s, int n) { s = s ?? ""; return s.Length > n ? s.Substring(0, n) : s; }
string ClaveDe(string s, int max)
{
    if (string.IsNullOrWhiteSpace(s)) return "";
    var p = s.Split(new[] { " - " }, StringSplitOptions.None)[0].Trim();
    return Cortar(p, max);
}
string PctTxt(double r) => (Math.Round(r * 100.0, 4)).ToString("0.####", ci) + "%";
string FechaSql(DateTime d) => "'" + d.ToString("yyyy-MM-dd HH:mm:ss", ci) + "'";

int ownEntityId = ctx.erp.OwnedBusinessEntityId;
string idsJoined = ctx.JoinIds(ids);

// ── 1. Tablas propias (memoria por empresa) ─────────────────────────────────────────────────────────────
ctx.NonQuery(@"
IF OBJECT_ID('zzBrosCfdiProductoMapa', 'U') IS NULL
    CREATE TABLE zzBrosCfdiProductoMapa (
        OwnedBusinessEntityID INT NOT NULL, RFCEmisor NVARCHAR(20) NOT NULL, ClaveProveedor NVARCHAR(100) NOT NULL,
        DescripcionNormalizada NVARCHAR(300) NOT NULL, ProductID INT NOT NULL, CreatedBy INT NULL, CreatedOn DATETIME DEFAULT GETDATE(),
        PRIMARY KEY (OwnedBusinessEntityID, RFCEmisor, ClaveProveedor, DescripcionNormalizada));
IF OBJECT_ID('zzBrosCfdiGastoMapa', 'U') IS NULL
    CREATE TABLE zzBrosCfdiGastoMapa (
        OwnedBusinessEntityID INT NOT NULL, RFCEmisor NVARCHAR(20) NOT NULL, ClaveProveedor NVARCHAR(100) NOT NULL,
        DescripcionNormalizada NVARCHAR(300) NOT NULL, ExpenseTypeID INT NOT NULL, CreatedBy INT NULL, CreatedOn DATETIME DEFAULT GETDATE(),
        PRIMARY KEY (OwnedBusinessEntityID, RFCEmisor, ClaveProveedor, DescripcionNormalizada));
IF COL_LENGTH('zzBrosCfdiGastoMapa', 'ClaveProdServ') IS NULL ALTER TABLE zzBrosCfdiGastoMapa ADD ClaveProdServ NVARCHAR(20) NULL;
IF OBJECT_ID('zzBrosCfdiConfig', 'U') IS NULL CREATE TABLE zzBrosCfdiConfig (Clave NVARCHAR(60) NOT NULL PRIMARY KEY, Valor NVARCHAR(200) NULL);");

// ── 2. Modelos ───────────────────────────────────────────────────────────────────────────────────────────
class TaxRow
{
    public int Id; public string Nombre; public double Iva, Ieps, RetIva, RetIsr;
    public bool EsExento { get { return Nombre != null && Nombre.ToUpperInvariant().Contains("EXENTO"); } }
    public bool EsNA { get { return Nombre != null && Nombre.ToUpperInvariant().Contains("N/A"); } }
}

class ItemXml
{
    public long ItemId { get; set; }
    public long SatId { get; set; }
