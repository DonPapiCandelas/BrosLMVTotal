// lang: csharp
using System;
using System.Drawing;
using System.Windows.Forms;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Globalization;

// PLANTILLA: Recepción de Compra — Forms + SQL puro (WinForms nativo, SIN ctx.erp)
//
// Qué hace: EXACTAMENTE la misma ventana que PLANTILLA_RECEPCION_COMPRA_FORMS_CSHARP.ctx
// (consolida N Órdenes de Compra por producto, captura lote/número de serie), pero al
// presionar "Guardar" NO llama ctx.erp.NuevoDocumento/AgregarArticulo/AffectStockNEW/Save.
// En vez de eso, ejecuta los mismos INSERT directos ya validados en
// PLANTILLA_RECEPCION_COMPRA_SQL_PURO.sql -- generalizados aquí para soportar VARIAS
// partidas, cada una repartida entre sus OC de origen (el .sql original solo maneja una).
//
// Misma regla real que el resto del catálogo "Forms + SQL puro": costo = precio unitario,
// QuantityToBeDelivered queda NEGATIVO en el kardex, StatusPaidID/StatusDeliveryID=3 tras
// simular UpdateStatusDelivery (aquí como parte del INSERT del encabezado, ya que no hay
// ctx.erp.UpdateStatusDelivery que llamar).

// ═══════════════════ DATOS INICIALES ═══════════════════
var almacenes = ctx.Query("SELECT DepotID, DepotName FROM orgDepot WHERE DeletedOn IS NULL ORDER BY DepotName");
var proveedoresConOC = ctx.Query(@"
    SELECT DISTINCT be.BusinessEntityID, be.OfficialName, ISNULL(m.OfficialNumber,'') AS RFC
    FROM docDocument d
    INNER JOIN docDocumentItem i ON i.DocumentID = d.DocumentID AND i.DeletedOn IS NULL AND i.MustBeDelivered <> 0
    INNER JOIN orgBusinessEntity be ON be.BusinessEntityID = d.BusinessEntityID
    LEFT JOIN orgBusinessEntityMainInfo m ON m.BusinessEntityID = be.BusinessEntityID
    WHERE d.ModuleID = 183 AND d.DeletedOn IS NULL AND d.CancelledOn IS NULL
    ORDER BY be.OfficialName");

var ocsPendientes = new List<OcPendiente>();
var partidasARecibir = new List<PartidaConsolidada>();
var provAll = new List<Opt>();

