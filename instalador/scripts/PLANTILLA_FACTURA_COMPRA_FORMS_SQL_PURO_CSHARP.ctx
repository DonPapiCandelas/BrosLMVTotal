// PLANTILLA: Factura de Compra — Forms + SQL puro (WinForms nativo, SIN ctx.erp)
//
// Qué hace: EXACTAMENTE la misma ventana que PLANTILLA_FACTURA_COMPRA_FORMS_CSHARP.ctx
// (transforma 1+ Órdenes de Compra seleccionadas en una Factura), pero al presionar
// "Guardar" NO llama ctx.erp.NuevoDocumento/AgregarArticulo/RecalcCompleto/Save. En vez de
// eso, ejecuta los mismos INSERT directos ya validados en
// PLANTILLA_FACTURA_COMPRA_SQL_PURO.sql -- generalizados aquí para soportar VARIAS partidas,
// cada una repartida entre sus OC de origen (el .sql original solo maneja una).
//
// Misma corrección que las demás variantes de Factura: el vínculo con la partida de la OC
// origen va en docDocumentItem.SourceDocumentItemID (columna propia de Factura, distinta de
// DeliverDocumentItemID que usa Recepción de Compra) -- MANUAL.md §10.4.
//
// ⚠️ ADVERTENCIA REAL: hereda las 2 advertencias de PLANTILLA_FACTURA_COMPRA_SQL_PURO.sql --
// (1) no genera póliza contable (en este sandbox, ni siquiera el camino 100% ctx.erp la
// generó -- limitación de configuración contable, no de esta plantilla); (2) el reparto de
// PaymentAgenda usa engPaymentTermDetail, igual que la versión ctx.erp.

// ═══════════════════ VALIDACIÓN TEMPRANA DE LA SELECCIÓN ═══════════════════
var idsSeleccionados = ctx.GetSelectedIds();
if (idsSeleccionados == null || idsSeleccionados.Count == 0) {
    ctx.Msg("Selecciona una o varias Órdenes de Compra en la lista (Ctrl+clic) antes de usar este botón.", "Sin selección");
    return;
}

List<Dictionary<string, object>> ocsSeleccionadas;
try {
    ocsSeleccionadas = ctx.Query(
        "SELECT d.DocumentID, d.BusinessEntityID, d.DepotID, d.FolioPrefix, d.Folio, be.OfficialName, " +
        "ISNULL(m.OfficialNumber,'') AS RFC " +
        "FROM docDocument d " +
        "INNER JOIN orgBusinessEntity be ON be.BusinessEntityID = d.BusinessEntityID " +
        "LEFT JOIN orgBusinessEntityMainInfo m ON m.BusinessEntityID = be.BusinessEntityID " +
        "WHERE d.DocumentID IN (" + ctx.JoinIds(idsSeleccionados) + ") AND d.ModuleID = 183 " +
        "  AND d.DeletedOn IS NULL AND d.CancelledOn IS NULL");
} catch (Exception ex) {
    ctx.Msg("Error al leer la selección: " + ex.Message, "Error");
    return;
}
if (ocsSeleccionadas.Count == 0) {
    ctx.Msg("Ninguna de las filas seleccionadas es una Orden de Compra activa (módulo 183).", "Selección inválida");
    return;
}
var proveedoresDistintos = ocsSeleccionadas.Select(r => Convert.ToInt32(r["BusinessEntityID"])).Distinct().ToList();
if (proveedoresDistintos.Count > 1) {
    ctx.Msg("Las Órdenes de Compra seleccionadas son de proveedores distintos. Selecciona Órdenes de Compra de UN SOLO proveedor a la vez.", "Selección inválida");
    return;
}
int proveedorBE = proveedoresDistintos[0];
string proveedorNombre = Convert.ToString(ocsSeleccionadas[0]["OfficialName"]);
string proveedorRfc = Convert.ToString(ocsSeleccionadas[0]["RFC"]);
int depotOrigen = Convert.ToInt32(ocsSeleccionadas[0]["DepotID"] ?? 1);
string ocsResumenTexto = string.Join(", ", ocsSeleccionadas.Select(r => Convert.ToString(r["FolioPrefix"]) + Convert.ToString(r["Folio"])));

