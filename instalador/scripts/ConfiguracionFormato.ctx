                    using (var dlg = new OpenFileDialog { Filter = "Imágenes (*.png;*.jpg;*.jpeg;*.gif;*.svg;*.bmp)|*.png;*.jpg;*.jpeg;*.gif;*.svg;*.bmp", Title = "Elige el logo o la imagen" })
                    {
