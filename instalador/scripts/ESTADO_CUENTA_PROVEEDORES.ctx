#r "C:\BrosLMV\lib\ClosedXML.dll"
// lang: csharp
// AppKey recomendado: ESTADO_CUENTA_PROVEEDORES
// Plantilla: Estado de cuenta de proveedores (cuentas por pagar)
// Categoria: Cuentas por pagar
// Documentacion: ESTADO_CUENTA_PROVEEDORES.html
// job: safe-offline
// Cuentas por pagar y estado de cuenta de cada proveedor, con fecha de corte, antigüedad de saldos, calendario de vencimientos y detalle de cada documento.

using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Text;
using System.Web.Script.Serialization;
using System.Windows.Forms;
using ClosedXML.Excel;

var ci = CultureInfo.InvariantCulture;
var ser = new JavaScriptSerializer { MaxJsonLength = 128 * 1024 * 1024 };

string S(object v) => v == null || v is DBNull ? "" : Convert.ToString(v, ci);
long L(object v) { try { return v == null || v is DBNull ? 0 : Convert.ToInt64(v, ci); } catch { return 0; } }
int I(object v) { try { return v == null || v is DBNull ? 0 : Convert.ToInt32(v, ci); } catch { return 0; } }
decimal M(object v) { try { return v == null || v is DBNull ? 0m : Convert.ToDecimal(v, ci); } catch { return 0m; } }
bool Nulo(object v) => v == null || v is DBNull;
string FechaTxt(object v) => Nulo(v) ? "" : Convert.ToDateTime(v, ci).ToString("yyyy-MM-dd");

int empresa = ctx.erp.OwnedBusinessEntityId;
int meses = 12;
string modoPrueba = Environment.GetEnvironmentVariable("BROSLMV_SALDOS_TEST");
if (!string.IsNullOrEmpty(modoPrueba))
{
    try { var cfg = ser.Deserialize<Dictionary<string, object>>(modoPrueba); if (cfg.ContainsKey("meses")) meses = Math.Max(1, I(cfg["meses"])); } catch { }
}

const string FMT_MON = "\"$\"#,##0.00;[Red]-\"$\"#,##0.00;\"-\"";
const string FMT_MON0 = "\"$\"#,##0.00;[Red]-\"$\"#,##0.00";
const string FMT_PCT = "0.0%;-0.0%;\"-\"";
XLColor Col(string h) { return XLColor.FromHtml(h); }
System.Collections.IList Lst(object o) { return o as System.Collections.IList ?? new List<object>(); }
double Nu(object v) { try { return v == null || v is DBNull ? 0 : Convert.ToDouble(v, ci); } catch { return 0; } }
DateTime? Fe(object v) { DateTime d; return DateTime.TryParseExact(S(v), "yyyy-MM-dd", ci, DateTimeStyles.None, out d) ? (DateTime?)d : null; }
string FechaCorta(object v) { var d = Fe(v); return d.HasValue ? d.Value.ToString("dd/MM/yyyy", ci) : ""; }
void Pon(IXLCell c, DateTime? d) { if (d.HasValue) c.Value = d.Value; }
byte[] Png(object b64) { string t = S(b64); return t.Length == 0 ? null : Convert.FromBase64String(t); }
void Imagen(IXLWorksheet ws, object b64, string celda, int ancho, int alto)
{
    var b = Png(b64); if (b == null) return;
    var pic = ws.AddPicture(new MemoryStream(b)); pic.MoveTo(ws.Cell(celda)); pic.WithSize(ancho, alto);
}
void Banda(IXLWorksheet ws, int ultimaCol, string empresa, string titulo, string sub)
{
    ws.Range(1, 1, 3, ultimaCol).Style.Fill.BackgroundColor = Col("#15324F");
    ws.Cell(1, 2).Value = (empresa ?? "").ToUpperInvariant(); ws.Cell(1, 2).Style.Font.SetFontSize(10); ws.Cell(1, 2).Style.Font.SetBold(); ws.Cell(1, 2).Style.Font.SetFontColor(Col("#93C5FD"));
    ws.Cell(2, 2).Value = titulo; ws.Cell(2, 2).Style.Font.SetFontSize(20); ws.Cell(2, 2).Style.Font.SetBold(); ws.Cell(2, 2).Style.Font.SetFontColor(XLColor.White);
    ws.Cell(3, 2).Value = sub; ws.Cell(3, 2).Style.Font.SetFontSize(10); ws.Cell(3, 2).Style.Font.SetFontColor(Col("#CBD5E1"));
    ws.Row(1).Height = 22; ws.Row(2).Height = 32; ws.Row(3).Height = 20;
    ws.Range(1, 1, 3, ultimaCol).Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
}
void Seccion(IXLWorksheet ws, int fila, int c1, int c2, string texto)
{
    var r = ws.Range(fila, c1, fila, c2); r.Merge(); r.FirstCell().Value = texto;
    r.Style.Font.SetBold(); r.Style.Font.SetFontSize(11); r.Style.Font.SetFontColor(Col("#15324F")); r.Style.Border.BottomBorder = XLBorderStyleValues.Medium; r.Style.Border.BottomBorderColor = Col("#2D6FE0");
    ws.Row(fila).Height = 22; r.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
}
void Encabezado(IXLRange r)
{
    r.Style.Font.SetBold(); r.Style.Font.SetFontColor(XLColor.White); r.Style.Font.SetFontSize(10); r.Style.Fill.BackgroundColor = Col("#15324F");
    r.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center; r.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center; r.Style.Alignment.WrapText = true;
    r.Style.Border.OutsideBorder = XLBorderStyleValues.Thin; r.Style.Border.OutsideBorderColor = Col("#15324F"); r.Style.Border.InsideBorder = XLBorderStyleValues.Thin; r.Style.Border.InsideBorderColor = Col("#3B5B7E");
}
void Cuerpo(IXLRange r)
{
    r.Style.Font.SetFontSize(10); r.Style.Border.InsideBorder = XLBorderStyleValues.Hair; r.Style.Border.InsideBorderColor = Col("#CBD5E1");
    r.Style.Border.OutsideBorder = XLBorderStyleValues.Thin; r.Style.Border.OutsideBorderColor = Col("#CBD5E1");
}
void Impresion(IXLWorksheet ws, string empresa, string titulo, int filaEnc)
{
    ws.PageSetup.PageOrientation = XLPageOrientation.Landscape; ws.PageSetup.PaperSize = XLPaperSize.LetterPaper;
    ws.PageSetup.PagesWide = 1; ws.PageSetup.PagesTall = 0;
    ws.PageSetup.Margins.Left = 0.4; ws.PageSetup.Margins.Right = 0.4; ws.PageSetup.Margins.Top = 0.6; ws.PageSetup.Margins.Bottom = 0.6;
    ws.PageSetup.Header.Left.AddText(empresa ?? ""); ws.PageSetup.Header.Right.AddText(titulo);
    ws.PageSetup.Footer.Left.AddText("Generado con BrosLMV"); ws.PageSetup.Footer.Right.AddText(XLHFPredefinedText.PageNumber, XLHFOccurrence.AllPages); ws.PageSetup.Footer.Right.AddText(" de "); ws.PageSetup.Footer.Right.AddText(XLHFPredefinedText.NumberOfPages, XLHFOccurrence.AllPages);
    if (filaEnc > 0) ws.PageSetup.SetRowsToRepeatAtTop(filaEnc, filaEnc);
}

void Tarjeta(IXLWorksheet ws, int fila, int c1, int c2, string etiqueta, double valor, string apoyo, string color)
{
    IXLRange F(int f) { var r = ws.Range(f, c1, f, c2); if (c2 > c1) r.Merge(); return r; }
    var l = F(fila); l.FirstCell().Value = etiqueta;
    l.Style.Font.SetFontSize(9); l.Style.Font.SetBold(); l.Style.Font.SetFontColor(Col("#64748B"));
    var v = F(fila + 1); v.FirstCell().Value = valor; v.Style.NumberFormat.Format = FMT_MON0;
    v.Style.Font.SetFontSize(17); v.Style.Font.SetBold(); v.Style.Font.SetFontColor(Col(color)); v.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Left; v.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
    var a = F(fila + 2); a.FirstCell().Value = apoyo; a.Style.Font.SetFontSize(9); a.Style.Font.SetFontColor(Col("#64748B"));
    var t = ws.Range(fila, c1, fila + 2, c2); t.Style.Fill.BackgroundColor = Col("#F8FAFC"); t.Style.Alignment.Indent = 1;
    t.Style.Border.LeftBorder = XLBorderStyleValues.Thin; t.Style.Border.RightBorder = XLBorderStyleValues.Thin; t.Style.Border.BottomBorder = XLBorderStyleValues.Thin;
    t.Style.Border.LeftBorderColor = Col("#E2E8F0"); t.Style.Border.RightBorderColor = Col("#E2E8F0"); t.Style.Border.BottomBorderColor = Col("#E2E8F0");
    t.Style.Border.TopBorder = XLBorderStyleValues.Thick; t.Style.Border.TopBorderColor = Col(color);
}

string ConstruirExcel(Dictionary<string, object> p, string ruta)
{
    string tipoLibro = S(p["tipo"]), empresa = S(p["empresa"]), titulo = S(p["titulo"]), ent = S(p["ent"]);
    string Ent1 = ent.Substring(0, 1).ToUpperInvariant() + ent.Substring(1);
    using (var wb = new XLWorkbook())
    {
        wb.Properties.Title = titulo; wb.Properties.Author = "BrosLMV"; wb.Properties.Company = empresa; wb.Properties.Subject = titulo + " — " + empresa;
        wb.Style.Font.FontName = "Calibri"; wb.Style.Font.FontSize = 10;
        if (tipoLibro == "edo") { ConstruirEdo(wb, p, empresa, titulo, Ent1); wb.SaveAs(ruta); return ruta; }

        var kpi = (Dictionary<string, object>)p["kpi"];
        double kV = Nu(Lst(kpi["vencido"])[1]), kA = Nu(Lst(kpi["siete"])[1]), kS = Nu(Lst(kpi["semana"])[1]), kG = Nu(Lst(kpi["vigente"])[1]), kM = Nu(Lst(kpi["favor"])[1]), kT = Nu(kpi["total"]);
        int nV = (int)Nu(Lst(kpi["vencido"])[0]), nA = (int)Nu(Lst(kpi["siete"])[0]), nS = (int)Nu(Lst(kpi["semana"])[0]), nG = (int)Nu(Lst(kpi["vigente"])[0]), nM = (int)Nu(Lst(kpi["favor"])[0]);
        string corteTxt = FechaCorta(p["corte"]), sub = "Al " + corteTxt + "  ·  Generado " + S(p["generado"]);
        var gr = (Dictionary<string, object>)p["graficas"];
        var ents = Lst(p["ents"]); var docs = Lst(p["docs"]);
        Func<double, double> Pc = x => kT > 0 ? x / kT : 0;

        var wr = wb.Worksheets.Add("Resumen"); wr.TabColor = Col("#2D6FE0"); wr.ShowGridLines = false;
        wr.Column(1).Width = 2; for (int c = 2; c <= 13; c++) wr.Column(c).Width = 13; wr.Column(14).Width = 2;
        Banda(wr, 14, empresa, titulo, sub);
        wr.Row(4).Height = 10;
        wr.Row(5).Height = 18; wr.Row(6).Height = 34; wr.Row(7).Height = 18;
        Tarjeta(wr, 5, 2, 3, "VENCIDO", kV, nV + " documento(s) · " + Pc(kV).ToString("0.0%", ci) + " del saldo", "#DC2626");
        Tarjeta(wr, 5, 4, 5, "VENCE EN 7 DÍAS", kA, nA + " documento(s)", "#D97706");
        Tarjeta(wr, 5, 6, 7, "VENCE LA SEMANA QUE SIGUE", kS, nS + " documento(s)", "#7E22CE");
        Tarjeta(wr, 5, 8, 9, "VIGENTE (MÁS ADELANTE)", kG, nG + " documento(s)", "#16A34A");
        Tarjeta(wr, 5, 10, 11, "NOTAS DE CRÉDITO A FAVOR", kM, nM + " documento(s)", "#0E7490");
        Tarjeta(wr, 5, 12, 13, "SALDO NETO", kT + kM, "facturas menos notas de crédito", "#15324F");
        wr.Row(8).Height = 10;

        double topSaldo = ents.Count > 0 ? Nu(((System.Collections.IList)ents[0])[7]) : 0; string topNom = ents.Count > 0 ? S(((System.Collections.IList)ents[0])[0]) : "";
        var frases = new List<string>();
        frases.Add("• " + nV + " documento(s) vencido(s) por " + kV.ToString("$#,##0.00", ci) + ", el " + Pc(kV).ToString("0.0%", ci) + " del saldo de " + (kT).ToString("$#,##0.00", ci) + ".");
        if (ents.Count > 0) frases.Add("• El mayor saldo es de " + topNom + ": " + topSaldo.ToString("$#,##0.00", ci) + " (" + Pc(topSaldo).ToString("0.0%", ci) + " del total; " + ents.Count + " " + S(p["entPl"]) + " con saldo).");
        frases.Add("• En los próximos 7 días vencen " + kA.ToString("$#,##0.00", ci) + " y la semana siguiente " + kS.ToString("$#,##0.00", ci) + ".");
        Seccion(wr, 9, 2, 13, "LECTURA RÁPIDA");
        for (int i = 0; i < frases.Count; i++) { var rg = wr.Range(10 + i, 2, 10 + i, 13); rg.Merge(); rg.FirstCell().Value = frases[i]; rg.Style.Font.SetFontSize(11); rg.Style.Font.SetFontColor(Col("#16263A")); wr.Row(10 + i).Height = 20; rg.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center; }
        int f0 = 10 + frases.Count + 1;
        Seccion(wr, f0, 2, 13, "GRÁFICAS");
        int g1 = f0 + 1;
        Imagen(wr, gr["aging"], "B" + g1, 576, 300); Imagen(wr, gr["top"], "H" + g1, 576, 300);
        int g2 = g1 + 16;
        Imagen(wr, gr["sem"], "B" + g2, 576, 300); Imagen(wr, gr["estado"], "H" + g2, 576, 300);
        int t0 = g2 + 16;
        Seccion(wr, t0, 2, 13, "PRINCIPALES " + S(p["entPl"]).ToUpperInvariant() + " POR SALDO");
        var hdr = wr.Range(t0 + 1, 2, t0 + 1, 13);
        wr.Cell(t0 + 1, 2).Value = "#"; wr.Range(t0 + 1, 3, t0 + 1, 6).Merge().FirstCell().Value = Ent1;
        wr.Range(t0 + 1, 7, t0 + 1, 8).Merge().FirstCell().Value = "Saldo total"; wr.Range(t0 + 1, 9, t0 + 1, 10).Merge().FirstCell().Value = "Vencido";
        wr.Cell(t0 + 1, 11).Value = "% del saldo"; wr.Cell(t0 + 1, 12).Value = "% vencido"; wr.Cell(t0 + 1, 13).Value = "Docs.";
        Encabezado(hdr); wr.Row(t0 + 1).Height = 22;
        int nTop = Math.Min(10, ents.Count); double sumTop = 0, sumTopV = 0;
        for (int i = 0; i < nTop; i++)
        {
            var e = (System.Collections.IList)ents[i]; int r = t0 + 2 + i; double tot = Nu(e[7]), ven = Nu(e[2]) + Nu(e[3]) + Nu(e[4]) + Nu(e[5]); sumTop += tot; sumTopV += ven;
            wr.Cell(r, 2).Value = i + 1; wr.Range(r, 3, r, 6).Merge().FirstCell().Value = S(e[0]);
            wr.Range(r, 7, r, 8).Merge().FirstCell().Value = tot; wr.Range(r, 9, r, 10).Merge().FirstCell().Value = ven;
            wr.Cell(r, 11).Value = Pc(tot); wr.Cell(r, 12).Value = tot > 0 ? ven / tot : 0; wr.Cell(r, 13).Value = (int)Nu(e[8]);
        }
        if (nTop > 0)
        {
            var cuerpo = wr.Range(t0 + 2, 2, t0 + 1 + nTop, 13); Cuerpo(cuerpo);
            wr.Range(t0 + 2, 7, t0 + 1 + nTop, 10).Style.NumberFormat.Format = FMT_MON; wr.Range(t0 + 2, 11, t0 + 1 + nTop, 12).Style.NumberFormat.Format = FMT_PCT;
            wr.Range(t0 + 2, 2, t0 + 1 + nTop, 2).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center; wr.Range(t0 + 2, 13, t0 + 1 + nTop, 13).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            wr.Range(t0 + 2, 9, t0 + 1 + nTop, 10).Style.Font.SetFontColor(Col("#B91C1C"));
            for (int i = 0; i < nTop; i += 2) wr.Range(t0 + 2 + i, 2, t0 + 2 + i, 13).Style.Fill.BackgroundColor = Col("#F8FAFC");
            int rt = t0 + 2 + nTop; var tr = wr.Range(rt, 2, rt, 13); tr.Style.Font.SetBold(); tr.Style.Fill.BackgroundColor = Col("#E8EEF6");
            wr.Range(rt, 2, rt, 6).Merge().FirstCell().Value = "Suma de los " + nTop + " principales"; wr.Range(rt, 7, rt, 8).Merge().FirstCell().Value = sumTop; wr.Range(rt, 9, rt, 10).Merge().FirstCell().Value = sumTopV;
            wr.Cell(rt, 11).Value = Pc(sumTop); wr.Cell(rt, 12).Value = sumTop > 0 ? sumTopV / sumTop : 0;
            wr.Range(rt, 7, rt, 10).Style.NumberFormat.Format = FMT_MON; wr.Range(rt, 11, rt, 12).Style.NumberFormat.Format = FMT_PCT;
            tr.Style.Border.TopBorder = XLBorderStyleValues.Thin; tr.Style.Border.TopBorderColor = Col("#15324F");
            t0 = rt + 1;
        }
        else t0 += 2;
        var nota = wr.Range(t0 + 1, 2, t0 + 3, 13); nota.Merge();
        nota.FirstCell().Value = "Cómo se calcula: saldo = total del documento − pagos con fecha hasta el corte − notas de crédito aplicadas. Vencimiento = última fecha de la agenda de pago (si no hay agenda, la fecha del documento); las notas de crédito no vencen. Moneda: la de cada documento, sin convertir.";
        nota.Style.Font.SetFontSize(9); nota.Style.Font.SetFontColor(Col("#64748B")); nota.Style.Font.Italic = true; nota.Style.Alignment.WrapText = true; nota.Style.Alignment.Vertical = XLAlignmentVerticalValues.Top;
        Impresion(wr, empresa, titulo, 0); wr.PageSetup.PagesTall = 0; wr.SheetView.ZoomScale = 100;

        var wa = wb.Worksheets.Add("Antigüedad"); wa.TabColor = Col("#D97706"); wa.ShowGridLines = false;
        wa.Column(1).Width = 2; wa.Column(2).Width = 46; for (int c = 3; c <= 8; c++) wa.Column(c).Width = 15; wa.Column(9).Width = 17; wa.Column(10).Width = 12; wa.Column(11).Width = 9;
        Banda(wa, 11, empresa, "Antigüedad de saldos por " + ent, sub);
        string[] ench = { Ent1, "Vigente", "1-30 días", "31-60 días", "61-90 días", "Más de 90", "A favor (NC)", "Saldo total", "% vencido", "Docs." };
        for (int c = 0; c < ench.Length; c++) wa.Cell(5, 2 + c).Value = ench[c];
        Encabezado(wa.Range(5, 2, 5, 11)); wa.Row(5).Height = 24;
        double[] sumB = new double[7]; int sumN = 0; int ra = 6;
        foreach (System.Collections.IList e in ents)
        {
            wa.Cell(ra, 2).Value = S(e[0]);
            for (int b = 0; b < 6; b++) { double v = Nu(e[1 + b]); wa.Cell(ra, 3 + b).Value = v; sumB[b] += v; }
            double tot = Nu(e[7]), ven = Nu(e[2]) + Nu(e[3]) + Nu(e[4]) + Nu(e[5]);
            wa.Cell(ra, 9).Value = tot; wa.Cell(ra, 10).Value = tot > 0 ? ven / tot : 0; wa.Cell(ra, 11).Value = (int)Nu(e[8]); sumB[6] += tot; sumN += (int)Nu(e[8]); ra++;
        }
        int ultA = ra - 1;
        if (ultA >= 6)
        {
            Cuerpo(wa.Range(6, 2, ultA, 11)); wa.Range(6, 3, ultA, 9).Style.NumberFormat.Format = FMT_MON; wa.Range(6, 10, ultA, 10).Style.NumberFormat.Format = FMT_PCT;
            wa.Range(6, 4, ultA, 7).Style.Font.SetFontColor(Col("#B91C1C")); wa.Range(6, 8, ultA, 8).Style.Font.SetFontColor(Col("#0E7490")); wa.Range(6, 9, ultA, 9).Style.Font.SetBold();
            wa.Range(6, 11, ultA, 11).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            wa.Range(6, 9, ultA, 9).AddConditionalFormat().DataBar(Col("#93C5FD"));
            wa.Range(6, 10, ultA, 10).AddConditionalFormat().ColorScale().LowestValue(Col("#DCFCE7")).HighestValue(Col("#FCA5A5"));
            int rt = ultA + 1; var tr = wa.Range(rt, 2, rt, 11); tr.Style.Font.SetBold(); tr.Style.Fill.BackgroundColor = Col("#E8EEF6"); tr.Style.Border.TopBorder = XLBorderStyleValues.Medium; tr.Style.Border.TopBorderColor = Col("#15324F");
            wa.Cell(rt, 2).Value = "TOTAL";
            for (int b = 0; b < 6; b++) wa.Cell(rt, 3 + b).Value = sumB[b];
            wa.Cell(rt, 9).Value = sumB[6]; double venT = sumB[1] + sumB[2] + sumB[3] + sumB[4]; wa.Cell(rt, 10).Value = sumB[6] > 0 ? venT / sumB[6] : 0; wa.Cell(rt, 11).Value = sumN;
            wa.Range(rt, 3, rt, 9).Style.NumberFormat.Format = FMT_MON; wa.Cell(rt, 10).Style.NumberFormat.Format = FMT_PCT; wa.Cell(rt, 11).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            wa.Range(5, 2, ultA, 11).SetAutoFilter();
        }
        wa.SheetView.Freeze(5, 2); Impresion(wa, empresa, titulo, 5);

        var wd = wb.Worksheets.Add("Documentos"); wd.TabColor = Col("#15324F"); wd.ShowGridLines = false;
        double[] ancho = { 2, 40, 22, 14, 12, 12, 11, 16, 16, 16, 16, 40 };
        for (int c = 0; c < ancho.Length; c++) wd.Column(c + 1).Width = ancho[c];
        Banda(wd, 12, empresa, "Documentos con saldo", sub);
        string[] encd = { Ent1, "Tipo", "Folio", "Fecha", "Vencimiento", "Días vencido", "Total", "Pagado / aplicado", "Saldo", "Estatus", "Título" };
        for (int c = 0; c < encd.Length; c++) wd.Cell(5, 2 + c).Value = encd[c];
        Encabezado(wd.Range(5, 2, 5, 12)); wd.Row(5).Height = 26;
        int nD = docs.Count;
        if (nD > 0)
        {
            var filasD = new List<object[]>(nD);
            foreach (System.Collections.IList d in docs)
            {
                var fe = Fe(d[3]); var fv = Fe(d[4]); object dv = d[5] == null ? (object)"" : (object)(int)Math.Max(0, Nu(d[5]));
                filasD.Add(new object[] { S(d[0]), S(d[1]), S(d[2]), fe.HasValue ? (object)fe.Value : "", fv.HasValue ? (object)fv.Value : "", dv, Nu(d[6]), Nu(d[7]), Nu(d[8]), S(d[9]), S(d[10]) });
            }
            wd.Cell(6, 2).InsertData(filasD);
            int ultD = 5 + nD;
            Cuerpo(wd.Range(6, 2, ultD, 12));
            wd.Range(6, 5, ultD, 6).Style.DateFormat.Format = "dd/mm/yyyy"; wd.Range(6, 5, ultD, 7).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            wd.Range(6, 8, ultD, 10).Style.NumberFormat.Format = FMT_MON; wd.Range(6, 10, ultD, 10).Style.Font.SetBold(); wd.Range(6, 11, ultD, 11).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            wd.Range(6, 7, ultD, 7).Style.NumberFormat.Format = "#,##0";
            var rngFila = wd.Range(6, 2, ultD, 12);
            rngFila.AddConditionalFormat().WhenIsTrue("=$K6=\"Vencido\"").Fill.SetBackgroundColor(Col("#FEF2F2"));
            rngFila.AddConditionalFormat().WhenIsTrue("=$K6=\"Vence en 7 días\"").Fill.SetBackgroundColor(Col("#FFFBEB"));
            rngFila.AddConditionalFormat().WhenIsTrue("=$K6=\"A favor\"").Fill.SetBackgroundColor(Col("#F3E8FF"));
            wd.Range(6, 11, ultD, 11).AddConditionalFormat().WhenIsTrue("=$K6=\"Vencido\"").Font.SetFontColor(Col("#B91C1C"));

            wd.Cell(4, 2).Value = "Total de lo que ves (se ajusta al filtro)"; wd.Cell(4, 2).Style.Font.SetBold(); wd.Cell(4, 2).Style.Font.SetFontColor(Col("#15324F"));
            wd.Cell(4, 4).FormulaA1 = "=SUBTOTAL(103,D6:D" + ultD + ")"; wd.Cell(4, 4).Style.NumberFormat.Format = "#,##0\" docs.\"";
            foreach (int cc in new[] { 8, 9, 10 }) { string L = XLHelper.GetColumnLetterFromNumber(cc); wd.Cell(4, cc).FormulaA1 = "=SUBTOTAL(109," + L + "6:" + L + ultD + ")"; wd.Cell(4, cc).Style.NumberFormat.Format = FMT_MON; }
            wd.Range(4, 2, 4, 12).Style.Fill.BackgroundColor = Col("#E8EEF6"); wd.Range(4, 2, 4, 12).Style.Font.SetBold(); wd.Row(4).Height = 20; wd.Range(4, 2, 4, 12).Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
            wd.Range(5, 2, ultD, 12).SetAutoFilter();
        }
        wd.SheetView.Freeze(5, 3); Impresion(wd, empresa, titulo, 5);

        var wv = wb.Worksheets.Add("Vencimientos"); wv.TabColor = Col("#7E22CE"); wv.ShowGridLines = false;
        wv.Column(1).Width = 2; wv.Column(2).Width = 22; wv.Column(3).Width = 13; wv.Column(4).Width = 13; wv.Column(5).Width = 11; wv.Column(6).Width = 18; wv.Column(7).Width = 3;
        Banda(wv, 14, empresa, "Vencimientos por semana", sub);
        string[] encv = { "Semana", "Del", "Al", "Docs.", "Saldo que vence" };
        for (int c = 0; c < encv.Length; c++) wv.Cell(5, 2 + c).Value = encv[c];
        Encabezado(wv.Range(5, 2, 5, 6)); wv.Row(5).Height = 24;
        int rv = 6; double sumV = 0; int sumVn = 0;
        foreach (Dictionary<string, object> s in Lst(p["semanas"]))
        {
            bool venc = S(s.ContainsKey("nom") ? s["nom"] : "") == "Vencido";
            wv.Cell(rv, 2).Value = venc ? "Ya vencido" : "Semana " + (rv - 6);
            if (!venc) { var a = Fe(s["ini"]); var b = Fe(s["fin"]); if (a.HasValue) wv.Cell(rv, 3).Value = a.Value; if (b.HasValue) wv.Cell(rv, 4).Value = b.Value; }
            wv.Cell(rv, 5).Value = (int)Nu(s["n"]); wv.Cell(rv, 6).Value = Nu(s["monto"]); sumV += Nu(s["monto"]); sumVn += (int)Nu(s["n"]);
            if (venc) wv.Range(rv, 2, rv, 6).Style.Font.SetFontColor(Col("#B91C1C")); if (venc) wv.Range(rv, 2, rv, 6).Style.Font.SetBold();
            rv++;
        }
        Cuerpo(wv.Range(6, 2, rv - 1, 6)); wv.Range(6, 3, rv - 1, 4).Style.DateFormat.Format = "dd/mm/yyyy"; wv.Range(6, 3, rv - 1, 5).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center; wv.Range(6, 6, rv - 1, 6).Style.NumberFormat.Format = FMT_MON;
        wv.Range(6, 6, rv - 1, 6).AddConditionalFormat().DataBar(Col("#C4B5FD"));
        var tv = wv.Range(rv, 2, rv, 6); tv.Style.Font.SetBold(); tv.Style.Fill.BackgroundColor = Col("#E8EEF6"); wv.Cell(rv, 2).Value = "Total 8 semanas + vencido"; wv.Cell(rv, 5).Value = sumVn; wv.Cell(rv, 6).Value = sumV; wv.Cell(rv, 6).Style.NumberFormat.Format = FMT_MON; wv.Cell(rv, 5).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
        Imagen(wv, gr["sem"], "H5", 576, 300); Imagen(wv, gr["aging"], "H21", 576, 300);
        Impresion(wv, empresa, titulo, 0);

        wb.Worksheet(1).SetTabActive(); wb.SaveAs(ruta);
    }
    return ruta;
}

void ConstruirEdo(XLWorkbook wb, Dictionary<string, object> p, string empresa, string titulo, string Ent1)
{
    var ws = wb.Worksheets.Add("Estado de cuenta"); ws.TabColor = Col("#2D6FE0"); ws.ShowGridLines = false;
    double[] ancho = { 2, 13, 20, 46, 17, 17, 24, 2 };
    for (int c = 0; c < ancho.Length; c++) ws.Column(c + 1).Width = ancho[c];
    string nombre = S(p["nombreEnt"]), periodo = FechaCorta(p["desde"]) + " al " + FechaCorta(p["hasta"]);
    Banda(ws, 8, empresa, "Estado de cuenta", Ent1 + ": " + nombre + "  ·  Periodo " + periodo + "  ·  Generado " + S(p["generado"]));
    ws.Row(4).Height = 10;
    double ini = Nu(p["ini"]), carg = Nu(p["cargos"]), abon = Nu(p["abonos"]), fin = Nu(p["final"]);
    Tarjeta(ws, 5, 2, 3, "SALDO INICIAL", ini, "al " + FechaCorta(p["desde"]), "#64748B");
    Tarjeta(ws, 5, 4, 4, "CARGOS DEL PERIODO", carg, "facturas y documentos", "#15324F");
    Tarjeta(ws, 5, 5, 6, "ABONOS DEL PERIODO", abon, "pagos y notas de crédito", "#16A34A");
    Tarjeta(ws, 5, 7, 7, "SALDO AL " + FechaCorta(p["hasta"]), fin, fin > 0.004 ? "por " + (S(p["lado"]) == "C" ? "cobrar" : "pagar") : "sin adeudo", fin > 0.004 ? "#DC2626" : "#16A34A");
    ws.Row(5).Height = 18; ws.Row(6).Height = 34; ws.Row(7).Height = 18; ws.Row(8).Height = 10;
    string[] enc = { "Fecha", "Movimiento", "Referencia", "Cargos", "Abonos", "Saldo" };
    for (int c = 0; c < enc.Length; c++) ws.Cell(10, 2 + c).Value = enc[c];
    Encabezado(ws.Range(10, 2, 10, 7)); ws.Row(10).Height = 24;
    Pon(ws.Cell(11, 2), Fe(p["desde"])); ws.Cell(11, 3).Value = "Saldo inicial"; ws.Cell(11, 7).Value = ini;
    ws.Range(11, 2, 11, 7).Style.Font.SetBold(); ws.Range(11, 2, 11, 7).Style.Fill.BackgroundColor = Col("#E8EEF6");
    int r = 12;
    foreach (System.Collections.IList m in Lst(p["movs"]))
    {
        var fe = Fe(m[0]); Pon(ws.Cell(r, 2), fe); ws.Cell(r, 3).Value = S(m[1]); ws.Cell(r, 4).Value = S(m[2]);
        double c1 = Nu(m[3]), a1 = Nu(m[4]); if (c1 != 0) ws.Cell(r, 5).Value = c1; if (a1 != 0) ws.Cell(r, 6).Value = a1; ws.Cell(r, 7).Value = Nu(m[5]);
        r++;
    }
    int ult = r - 1;
    Cuerpo(ws.Range(11, 2, ult, 7)); ws.Range(11, 2, ult, 2).Style.DateFormat.Format = "dd/mm/yyyy"; ws.Range(11, 2, ult, 2).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
    ws.Range(11, 5, ult, 7).Style.NumberFormat.Format = FMT_MON; ws.Range(11, 7, ult, 7).Style.Font.SetBold(); ws.Range(11, 4, ult, 4).Style.Alignment.WrapText = true;
    for (int i = 12; i <= ult; i += 2) ws.Range(i, 2, i, 7).Style.Fill.BackgroundColor = Col("#F8FAFC");
    var tt = ws.Range(r, 2, r, 7); tt.Style.Font.SetBold(); tt.Style.Fill.BackgroundColor = Col("#E8EEF6"); tt.Style.Border.TopBorder = XLBorderStyleValues.Medium; tt.Style.Border.TopBorderColor = Col("#15324F");
    ws.Cell(r, 3).Value = "Totales del periodo"; ws.Cell(r, 5).Value = carg; ws.Cell(r, 6).Value = abon; ws.Cell(r, 7).Value = fin; ws.Range(r, 5, r, 7).Style.NumberFormat.Format = FMT_MON;
    var nota = ws.Range(r + 2, 2, r + 3, 7); nota.Merge(); nota.FirstCell().Value = "Las notas de crédito aplicadas a una factura se muestran como abono en el momento de su aplicación. Importes en la moneda de cada documento.";
    nota.Style.Font.SetFontSize(9); nota.Style.Font.SetFontColor(Col("#64748B")); nota.Style.Font.Italic = true; nota.Style.Alignment.WrapText = true;
    ws.SheetView.Freeze(10, 0); Impresion(ws, empresa, titulo + " — " + nombre, 10); ws.PageSetup.PageOrientation = XLPageOrientation.Portrait;
}

string xlsxPrueba = Environment.GetEnvironmentVariable("BROSLMV_SALDOS_XLSX_TEST");
if (!string.IsNullOrEmpty(xlsxPrueba))
    return ConstruirExcel(ser.Deserialize<Dictionary<string, object>>(File.ReadAllText(xlsxPrueba, Encoding.UTF8)), Environment.GetEnvironmentVariable("BROSLMV_SALDOS_XLSX_OUT"));

var modulos = ctx.Query(
    "SELECT m.ModuleID, m.ModuleName, pv.Rec, pv.Tipo, pv.Af FROM engModule m JOIN (" +
    "  SELECT ModuleID, MAX(CASE WHEN ParameterKey='DocRecipient' THEN TRY_CONVERT(int, Value) END) AS Rec, " +
    "         MAX(CASE WHEN ParameterKey='DocumentTypeID' THEN TRY_CONVERT(int, Value) END) AS Tipo, " +
    "         MAX(CASE WHEN ParameterKey='FinancialAffectation' THEN TRY_CONVERT(int, Value) END) AS Af, " +
    "         MAX(CASE WHEN ParameterKey='TableName' THEN Value END) AS Tabla " +
    "  FROM engModuleParameter WHERE ParameterKey IN ('DocRecipient','DocumentTypeID','FinancialAffectation','TableName') GROUP BY ModuleID" +
    ") pv ON pv.ModuleID = ISNULL(NULLIF(m.ModuleIDBase,0), m.ModuleID) " +
    "WHERE pv.Tabla = 'docDocument' AND pv.Af IN (1,-1) AND pv.Rec = 2 AND ISNULL(pv.Tipo,0) NOT IN (40,44)");
var signo = new Dictionary<int, int>();
var nombreMod = new Dictionary<int, string>();
foreach (var r in modulos)
{
    int mid = I(r["ModuleID"]), af = I(r["Af"]);
    signo[mid] = 2 == 1 ? af : -af;
    nombreMod[mid] = S(r["ModuleName"]);
}
if (signo.Count == 0)
{
    ctx.Msg("No se encontraron módulos de proveedores con afectación financiera en esta empresa.", "Estado de cuenta de proveedores (cuentas por pagar)");
    return "SIN MODULOS";
}

DateTime hoy = DateTime.Today;
DateTime desde = new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-meses);
string fDesde = desde.ToString("yyyy-MM-dd", ci);
string listaMod = string.Join(",", signo.Keys.Select(x => x.ToString(ci)));

string filtroDocs =
    "SELECT d.DocumentID FROM docDocument d WHERE d.ModuleID IN (" + listaMod + ") AND d.OwnedBusinessEntityID = " + empresa +
    " AND d.DeletedOn IS NULL AND d.CancelledOn IS NULL AND (d.DateDocument >= '" + fDesde + "' OR ISNULL(d.Balance,0) <> 0 OR EXISTS " +
    "(SELECT 1 FROM docDocumentPayment p WHERE p.DocumentID = d.DocumentID AND p.DeletedOn IS NULL AND p.DateOperation >= '" + fDesde + "'))";

string filtroConSaldo =
    "SELECT d.DocumentID FROM docDocument d WHERE d.ModuleID IN (" + listaMod + ") AND d.OwnedBusinessEntityID = " + empresa +
    " AND d.DeletedOn IS NULL AND d.CancelledOn IS NULL AND ISNULL(d.Balance,0) <> 0";

var docsSql = ctx.Query(
    "SELECT d.DocumentID, d.ModuleID, d.FolioPrefix, d.Folio, d.DateDocument, ISNULL(d.Total,0) AS Total, d.BusinessEntityID, " +

    "CASE WHEN ISNULL(d.DocumentTypeID,0) IN (5,6) THEN 0 ELSE ISNULL((SELECT SUM(f.Total) FROM docDocument f WHERE f.SourceDocumentID = d.DocumentID AND f.DocumentTypeID = 5 " +
    "AND f.DeletedOn IS NULL AND f.CancelledOn IS NULL AND f.DocRecipientID = d.DocRecipientID), 0) END AS Facturado, " +
    "ISNULL(be.CommercialName, be.OfficialName) AS Entidad, ISNULL(d.Title,'') AS Titulo, " +
    "(SELECT MAX(a.DatePayment) FROM docDocumentPaymentAgenda a WHERE a.DocumentID = d.DocumentID AND a.DeletedOn IS NULL) AS Vence " +
    "FROM docDocument d LEFT JOIN orgBusinessEntity be ON be.BusinessEntityID = d.BusinessEntityID WHERE d.DocumentID IN (" + filtroDocs + ")");
var docs = new List<Dictionary<string, object>>();
var docPorId = new Dictionary<long, Dictionary<string, object>>();
foreach (var r in docsSql)
{
    int mid = I(r["ModuleID"]);
    string folio = (S(r["FolioPrefix"]) + S(r["Folio"])).Trim();
    var d = new Dictionary<string, object>
    {
        ["id"] = L(r["DocumentID"]), ["mod"] = mid, ["lado"] = "P", ["s"] = signo[mid], ["tipo"] = nombreMod[mid], ["folio"] = folio,
        ["fecha"] = FechaTxt(r["DateDocument"]), ["venc"] = FechaTxt(r["Vence"]), ["total"] = Math.Max(0m, M(r["Total"]) - M(r["Facturado"])), ["totalOrig"] = M(r["Total"]), ["fact"] = M(r["Facturado"]),
        ["ent"] = L(r["BusinessEntityID"]), ["entNom"] = S(r["Entidad"]), ["titulo"] = S(r["Titulo"])
    };
    docs.Add(d); docPorId[(long)d["id"]] = d;
}

var pagosSql = ctx.Query(
    "SELECT p.DocumentID, p.DateOperation, ISNULL(p.Amount,0) AS Monto, ISNULL(p.PaymentWithDocumentID,0) AS NC, " +
    "ISNULL(o.FolioPrefix,'') AS OpPref, ISNULL(o.Folio,'') AS OpFolio, ISNULL(o.ModuleID,0) AS OpMod " +
    "FROM docDocumentPayment p LEFT JOIN docFinancialOperation o ON o.FinancialOperationID = p.FinancialOperationID " +
    "WHERE p.DeletedOn IS NULL AND (p.DocumentID IN (" + filtroDocs + ") OR p.PaymentWithDocumentID IN (" + filtroDocs + "))");
var pagos = new List<Dictionary<string, object>>();
foreach (var r in pagosSql)
    pagos.Add(new Dictionary<string, object>
    {
        ["doc"] = L(r["DocumentID"]), ["fecha"] = FechaTxt(r["DateOperation"]), ["monto"] = M(r["Monto"]), ["nc"] = L(r["NC"]),
        ["op"] = (S(r["OpPref"]) + S(r["OpFolio"])).Trim()
    });

foreach (var r in ctx.Query(
    "SELECT i.DocumentID, ISNULL(i.LineNumber,0) AS Linea, ISNULL(i.Description,'') AS Concepto, ISNULL(i.Quantity,0) AS Cantidad, ISNULL(i.UnitPrice,0) AS Precio, ISNULL(i.Total,0) AS Total " +
    "FROM docDocumentItem i WHERE i.DeletedOn IS NULL AND i.DocumentID IN (" + filtroConSaldo + ") ORDER BY i.DocumentID, i.LineNumber"))
{
    Dictionary<string, object> d; if (!docPorId.TryGetValue(L(r["DocumentID"]), out d)) continue;
    if (!d.ContainsKey("p")) d["p"] = new List<object>();
    ((List<object>)d["p"]).Add(new object[] { I(r["Linea"]), S(r["Concepto"]), M(r["Cantidad"]), M(r["Precio"]), M(r["Total"]) });
}
foreach (var r in ctx.Query(
    "SELECT a.DocumentID, ISNULL(a.PartialityNumber,0) AS Parcialidad, a.DatePayment, ISNULL(a.Amount,0) AS Monto, ISNULL(a.StatusID,0) AS Estatus " +
    "FROM docDocumentPaymentAgenda a WHERE a.DeletedOn IS NULL AND a.DocumentID IN (" + filtroConSaldo + ") ORDER BY a.DocumentID, a.PartialityNumber"))
{
    Dictionary<string, object> d; if (!docPorId.TryGetValue(L(r["DocumentID"]), out d)) continue;
    if (!d.ContainsKey("a")) d["a"] = new List<object>();
    ((List<object>)d["a"]).Add(new object[] { I(r["Parcialidad"]), FechaTxt(r["DatePayment"]), M(r["Monto"]), I(r["Estatus"]) });
}

string nombreEmpresa = "";
try { nombreEmpresa = S(ctx.Scalar("SELECT TOP 1 ISNULL(CommercialName, OfficialName) FROM orgBusinessEntity WHERE BusinessEntityID = " + empresa)); } catch { }

var modelo = new Dictionary<string, object>
{
    ["docs"] = docs, ["pagos"] = pagos, ["hoy"] = hoy.ToString("yyyy-MM-dd", ci), ["desde"] = fDesde, ["empresa"] = nombreEmpresa, ["meses"] = meses, ["lado"] = "P"
};

string Html(string json) => @"<!DOCTYPE html><html lang='es'><head><meta charset='utf-8'><title>Estado de cuenta de proveedores (cuentas por pagar)</title><style>
:root{--fondo:#f4f6f9;--tarjeta:#fff;--texto:#16263a;--suave:#64748b;--linea:#d5dde8;--azul:#2d6fe0;--rojo:#c82828;--ambar:#b45309;--verde:#16803b;--morado:#7e22ce;--zebra:#f8fafc}
*{box-sizing:border-box}body{margin:0;font:13px 'Segoe UI',Arial,sans-serif;background:var(--fondo);color:var(--texto)}
header{padding:14px 22px 6px;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:8px}h1{margin:0;font-size:20px}.sub{color:var(--suave);margin-top:2px}
.ctl{padding:6px 22px;display:flex;gap:14px;align-items:center;flex-wrap:wrap}.ctl label{color:var(--suave);font-size:12px}
input,select,button{font:inherit;border:1px solid var(--linea);border-radius:6px;padding:5px 9px;background:#fff;color:var(--texto)}button{cursor:pointer}button:hover{background:#f1f5f9}button.p{background:var(--azul);color:#fff;border-color:var(--azul)}button.on{background:var(--azul);color:#fff;border-color:var(--azul)}
.tabs{padding:4px 22px 0;display:flex;gap:2px;border-bottom:1px solid var(--linea)}.tabs button{border:0;border-bottom:3px solid transparent;border-radius:0;background:none;padding:8px 14px;color:var(--texto)}.tabs button.on{border-bottom-color:var(--azul);font-weight:600;color:var(--texto);background:none}
.cuerpo{padding:12px 22px 28px}.kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:12px}.kpi{background:var(--tarjeta);border:1px solid var(--linea);border-left:4px solid var(--linea);border-radius:9px;padding:9px 12px;min-width:0}
.kpi b{display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--suave);font-weight:600}.kpi span{font-size:17px;font-variant-numeric:tabular-nums}.kpi small{display:block;color:var(--suave);font-size:11px}
.kpi.r{border-left-color:var(--rojo)}.kpi.r span{color:var(--rojo)}.kpi.a{border-left-color:var(--ambar)}.kpi.a span{color:var(--ambar)}.kpi.m{border-left-color:var(--morado)}.kpi.m span{color:var(--morado)}.kpi.v{border-left-color:var(--verde)}.kpi.v span{color:var(--verde)}.kpi.t{border-left-color:#0a3d6e}.kpi.t span{color:#0a3d6e}
.tw{background:var(--tarjeta);border:1px solid var(--linea);border-radius:9px;overflow:auto;max-height:calc(100vh - 330px)}
table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}th,td{padding:6px 10px;text-align:right;white-space:nowrap}th:first-child,td:first-child,.l{text-align:left}
th{position:sticky;top:0;background:#eef2f7;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--suave);border-bottom:1px solid var(--linea);z-index:1}
tbody tr:nth-child(even){background:var(--zebra)}tbody tr.clic{cursor:pointer}tbody tr.clic:hover{background:#e8f0ff}tfoot td{font-weight:700;border-top:2px solid var(--linea);position:sticky;bottom:0;background:#eef2f7}
.venc{color:var(--rojo)}.favor{color:var(--verde)}.pill{display:inline-block;border-radius:10px;padding:1px 8px;font-size:11px;background:#e5eaf1;color:var(--suave)}.pill.r{background:#fde4e4;color:var(--rojo)}.pill.a{background:#fdf0dc;color:var(--ambar)}.pill.v{background:#e0f3e6;color:var(--verde)}.pill.m{background:#f3e8ff;color:var(--morado)}
.btnv{border:1px solid #93c5fd;background:#eff6ff;color:#1d4ed8;border-radius:6px;padding:2px 8px;font-size:11px}.btnv:hover{background:#dbeafe}
.vacio{padding:40px;text-align:center;color:var(--suave)}.nota{color:var(--suave);font-size:12px;margin-top:8px}
.calh{display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:10px}.calh .mes{font-weight:700;font-size:17px;min-width:190px;text-align:center;color:#0a3d6e}
.leyenda{display:flex;gap:16px;justify-content:center;margin-bottom:10px;font-size:11.5px;color:var(--suave)}.leyenda i{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px}
.cg{display:grid;grid-template-columns:repeat(7,1fr);gap:7px}.dow{text-align:center;font-size:11px;font-weight:700;color:var(--suave);text-transform:uppercase;letter-spacing:.04em}
.cc{background:#fff;border-radius:9px;min-height:84px;padding:7px 8px;border:1px solid transparent;box-shadow:0 1px 3px rgba(0,0,0,.06);text-align:left}.cc.otro{opacity:.45;background:#f8fafc}.cc.hoy{border-color:#0a3d6e}
.cc.con{cursor:pointer}.cc.con:hover{box-shadow:0 5px 12px rgba(0,0,0,.14)}.cc.pr{background:#fef2f2}.cc.pa{background:#fffbeb}.cc.pv{background:#f0fdf4}
.cc .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:3px}.cc .n{font-weight:700;color:#475569}.cc .c{color:#fff;border-radius:10px;padding:0 7px;font-size:10.5px;font-weight:700}.cc .c.r{background:var(--rojo)}.cc .c.a{background:var(--ambar)}.cc .c.v{background:var(--verde)}.cc .mo{font-size:11px;font-weight:700;color:#334155}
.mf{display:none;position:fixed;inset:0;background:rgba(15,23,42,.5);z-index:50;align-items:center;justify-content:center}.mf.on{display:flex}
.mc{background:#fff;border-radius:11px;width:92vw;max-width:940px;max-height:88vh;display:flex;flex-direction:column;box-shadow:0 10px 40px rgba(0,0,0,.28)}
.mh{display:flex;justify-content:space-between;align-items:flex-start;padding:14px 20px;border-bottom:1px solid var(--linea);gap:10px}.mt{font-size:17px;font-weight:700;color:#0a3d6e}.ms{font-size:12px;color:var(--suave);margin-top:2px}.mb{padding:14px 20px;overflow:auto}
.dc{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin-bottom:14px}.dc div{background:#f8fafc;border-radius:8px;padding:7px 10px}.dc b{display:block;font-size:10.5px;text-transform:uppercase;color:var(--suave);font-weight:600}.dc span{font-size:14px;font-weight:700}
.sec{margin-bottom:16px}.sec h3{font-size:12.5px;color:#0a3d6e;margin:0 0 6px;text-transform:uppercase;letter-spacing:.03em}.sec table th{position:static}.sec table td,.sec table th{padding:5px 8px;border-bottom:1px solid #eef1f5}
.comp{border-radius:8px;padding:9px 12px;margin-bottom:8px;border-left:4px solid var(--linea);background:#f8fafc;display:flex;justify-content:space-between;align-items:center;gap:10px}.comp.r{border-left-color:var(--rojo);background:#fef2f2}.comp.a{border-left-color:var(--ambar);background:#fffbeb}.comp.v{border-left-color:var(--verde);background:#f0fdf4}
</style></head><body>
<header><div><h1 id='tit'></h1><div class='sub' id='sub'></div></div><div style='display:flex;gap:8px'><button class='p' data-a='xlsx'>Exportar a Excel</button><button data-a='csv'>Exportar a CSV</button></div></header>
<div class='ctl'>
 <label>Fecha de corte <input type='date' id='corte' onchange='cambio()'></label>
 <label>Buscar <input type='text' id='q' placeholder='nombre, folio o título' oninput='cambio()' style='width:210px'></label>
 <label><input type='checkbox' id='soloV' onchange='cambio()'> Solo vencidos</label>
 <span><button data-a='rango' data-v='s1' id='bs1'>Vence esta semana</button> <button data-a='rango' data-v='s2' id='bs2'>Vence la semana que sigue</button></span>
</div>
<div class='tabs' id='tabs'><button data-a='tab' data-v='aging' class='on'>Antigüedad por proveedor</button><button data-a='tab' data-v='docs'>Documentos con saldo</button><button data-a='tab' data-v='cal'>Calendario</button><button data-a='tab' data-v='edo'>Estado de cuenta</button></div>
<div class='cuerpo' id='cuerpo'></div>
<div class='mf' id='mf'><div class='mc'><div class='mh'><div><div class='mt' id='mt'></div><div class='ms' id='ms'></div></div><div style='display:flex;gap:6px'><button id='mv' data-a='volver' style='display:none'>← Volver</button><button data-a='cerrar'>Cerrar ✕</button></div></div><div class='mb' id='mb'></div></div></div>
<script>
var D=" + json + @";
var PC='proveedor',TITULO='Cuentas por pagar',LADO='P';
function enviar(o){window.chrome.webview.postMessage(JSON.stringify(o));}
function esc(s){return String(s==null?'':s).replace(/[&<>]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];});}
function f2(n){return (n||0).toLocaleString('es-MX',{minimumFractionDigits:2,maximumFractionDigits:2});}
function dias(a,b){return Math.round((Date.parse(b)-Date.parse(a))/864e5);}
function sumaDias(f,n){var d=new Date(Date.parse(f)+n*864e5);return d.toISOString().substr(0,10);}
function fmtF(s){if(!s)return '—';var p=s.split('-');return p[2]+'/'+p[1]+'/'+p[0];}
var tab='aging',entSel=0,pdesde='',phasta='',rango='',volverA=null,calMes=null;
var BUCKETS=['Vigente','1-30 días','31-60 días','61-90 días','Más de 90','A favor (NC)'];
var MESES=['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'],DOW=['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
var AGENDA=['Pendiente','Aviso enviado','Liquidada','Cancelada'];
var pp={},nc={};
D.pagos.forEach(function(p){(pp[p.doc]=pp[p.doc]||[]).push(p);if(p.nc>0)(nc[p.nc]=nc[p.nc]||[]).push(p);});
var docPorId={};D.docs.forEach(function(d){docPorId[d.id]=d;});
var corteEl=document.getElementById('corte');corteEl.value=D.hoy;corteEl.min=D.desde;corteEl.max=D.hoy;
calMes=new Date(Date.parse(D.hoy));calMes.setUTCDate(1);
// estado de un documento a la fecha de corte: r vencido, a por vencer (próximos 7 días), v vigente, m a favor (nota de crédito)
function estadoDe(f){if(f.dv===null)return 'm';if(f.dv>0)return 'r';if(f.dv>=-7)return 'a';return 'v';}
function calc(sinFiltros){
  var corte=corteEl.value||D.hoy,q=document.getElementById('q').value.toLowerCase(),sv=document.getElementById('soloV').checked,filas=[];
  D.docs.forEach(function(d){
    if(d.fecha>corte)return;
    var ap=0;(pp[d.id]||[]).forEach(function(p){if(p.fecha<=corte)ap+=p.monto;});
    (nc[d.id]||[]).forEach(function(p){if(p.fecha<=corte)ap+=p.monto;});
    var saldo=d.total-ap;if(Math.abs(saldo)<0.005)return;if(d.fact>0&&saldo<0)return;
    var venc=d.venc||d.fecha,dv=d.s<0?null:dias(venc,corte),b=d.s<0?5:(dv<=0?0:dv<=30?1:dv<=60?2:dv<=90?3:4);
    var fila={d:d,saldo:d.s*saldo,venc:venc,dv:dv,b:b,pagado:ap};
    if(!sinFiltros){
      if(sv&&(b===0||b===5))return;
      if(q&&(d.entNom+' '+d.folio+' '+d.titulo+' '+d.tipo).toLowerCase().indexOf(q)<0)return;
      if(rango){if(dv===null)return;var ini=rango==='s1'?0:7;if(!(venc>=sumaDias(corte,ini)&&venc<=sumaDias(corte,ini+6)))return;}
    }
    filas.push(fila);
  });
  return filas;
}
function porEntidad(filas){
  var m={};filas.forEach(function(f){var e=m[f.d.ent]=m[f.d.ent]||{id:f.d.ent,nom:f.d.entNom||('Entidad '+f.d.ent),b:[0,0,0,0,0,0],tot:0,n:0};e.b[f.b]+=f.saldo;e.tot+=f.saldo;e.n++;});
  return Object.keys(m).map(function(k){return m[k];}).sort(function(a,b){return b.tot-a.tot;});
}
var exp={nombre:'saldos',titulo:'',filas:[]};
function cambio(){
  var corte=corteEl.value||D.hoy,todas=calc(true),filas=calc(false),ents=porEntidad(filas);
  var k={r:[0,0],a:[0,0],s:[0,0],v:[0,0],m:[0,0],t:0};
  todas.forEach(function(f){
    if(f.dv===null){k.m[0]++;k.m[1]+=f.saldo;return;}
    k.t+=f.saldo;
    if(f.dv>0){k.r[0]++;k.r[1]+=f.saldo;}
    else if(f.dv>=-7){k.a[0]++;k.a[1]+=f.saldo;}
    else{k.v[0]++;k.v[1]+=f.saldo;}
    var v=f.venc;if(v>=sumaDias(corte,7)&&v<=sumaDias(corte,13)){k.s[0]++;k.s[1]+=f.saldo;}
  });
  document.getElementById('tit').textContent=TITULO+' al '+fmtF(corte);
  document.getElementById('sub').textContent=(D.empresa||'')+' · '+ents.length+' '+PC+(ents.length===1?'':'s')+' con saldo · '+filas.length+' documentos';
  document.getElementById('bs1').className=rango==='s1'?'on':'';document.getElementById('bs2').className=rango==='s2'?'on':'';
  var h='<div class=kpis>'+
   '<div class=\'kpi r\'><b>Vencido</b><span>'+f2(k.r[1])+'</span><small>'+k.r[0]+' documento(s)</small></div>'+
   '<div class=\'kpi a\'><b>Vence en 7 días</b><span>'+f2(k.a[1])+'</span><small>'+k.a[0]+' documento(s)</small></div>'+
   '<div class=\'kpi m\'><b>Vence la semana que sigue</b><span>'+f2(k.s[1])+'</span><small>'+k.s[0]+' documento(s)</small></div>'+
   '<div class=\'kpi v\'><b>Vigente (más adelante)</b><span>'+f2(k.v[1])+'</span><small>'+k.v[0]+' documento(s)</small></div>'+
   '<div class=\'kpi m\'><b>Notas de crédito a favor</b><span>'+f2(k.m[1])+'</span><small>'+k.m[0]+' documento(s)</small></div>'+
   '<div class=\'kpi t\'><b>Saldo total</b><span>'+f2(k.t+k.m[1])+'</span><small>facturas menos notas de crédito</small></div></div>';
  if(tab==='aging')h+=vistaAging(ents,filas);else if(tab==='docs')h+=vistaDocs(filas);else if(tab==='cal')h+=vistaCal(todas);else h+=vistaEdo();
  document.getElementById('cuerpo').innerHTML=h;
  var s=document.getElementById('selEnt');if(s)s.value=entSel;
}
function vistaAging(ents,filas){
  exp={nombre:TITULO.toLowerCase().replace(/ /g,'_')+'_'+(corteEl.value||D.hoy),titulo:TITULO+' al '+fmtF(corteEl.value||D.hoy),filas:[]};
  var enc=[PC.charAt(0).toUpperCase()+PC.slice(1)].concat(BUCKETS,['Saldo total','Documentos']);exp.filas=[enc];
  if(!ents.length)return '<div class=vacio>No hay saldos a esta fecha con esos filtros.</div>';
  var tb=[0,0,0,0,0,0],tt=0,tn=0,h='<div class=tw><table><thead><tr><th>'+enc[0]+'</th>';
  BUCKETS.forEach(function(b){h+='<th>'+b+'</th>';});h+='<th>Saldo total</th><th>Docs</th></tr></thead><tbody>';
  ents.forEach(function(e){
    h+='<tr class=clic data-a=edo data-v='+e.id+' title=\'Ver estado de cuenta\'><td>'+esc(e.nom)+'</td>';
    e.b.forEach(function(v,i){tb[i]+=v;h+='<td class=\''+(i>=1&&i<=4&&v?'venc':(i===5&&v?'favor':''))+'\'>'+(v?f2(v):'')+'</td>';});
    tt+=e.tot;tn+=e.n;h+='<td><b>'+f2(e.tot)+'</b></td><td>'+e.n+'</td></tr>';
    exp.filas.push([e.nom].concat(e.b.map(function(v){return v.toFixed(2);}),[e.tot.toFixed(2),e.n]));
  });
  h+='</tbody><tfoot><tr><td>Total</td>';tb.forEach(function(v){h+='<td>'+(v?f2(v):'')+'</td>';});h+='<td>'+f2(tt)+'</td><td>'+tn+'</td></tr></tfoot></table></div>';
  exp.filas.push(['TOTAL'].concat(tb.map(function(v){return v.toFixed(2);}),[tt.toFixed(2),tn]));
  return h+'<div class=nota>Antigüedad contada desde el vencimiento (última fecha de la agenda de pago). Clic en una fila para ver su estado de cuenta.</div>';
}
function vistaDocs(filas){
  exp={nombre:'documentos_con_saldo_'+(corteEl.value||D.hoy),titulo:'Documentos con saldo al '+fmtF(corteEl.value||D.hoy),filas:[[PC.charAt(0).toUpperCase()+PC.slice(1),'Tipo','Folio','Fecha','Vencimiento','Días vencido','Total','Saldo','Título']]};
  filas.sort(function(a,b){return a.d.entNom<b.d.entNom?-1:a.d.entNom>b.d.entNom?1:(a.venc<b.venc?-1:1);});
  if(!filas.length)return '<div class=vacio>No hay documentos con saldo a esta fecha con esos filtros.</div>';
  var h='<div class=tw><table><thead><tr><th></th><th>'+exp.filas[0][0]+'</th><th class=l>Tipo</th><th>Folio</th><th>Fecha</th><th>Vence</th><th>Días vencido</th><th>Total</th><th>Saldo</th><th class=l>Título</th></tr></thead><tbody>',t=0;
  var TOPE=1000,total=filas.length;
  filas.forEach(function(f,idx){
    var d=f.d,pil=f.dv===null?'<span class=\'pill m\'>A favor</span>':f.dv<=0?'<span class=\'pill '+(f.dv>=-7?'a':'')+'\'>'+(f.dv>=-7?'Por vencer':'Vigente')+'</span>':'<span class=\'pill '+(f.dv>60?'r':'a')+'\'>'+f.dv+' d</span>';t+=f.saldo;
    if(idx<TOPE)h+='<tr class=clic data-a=ver data-v='+d.id+' title=\'Clic: ver el documento\'><td><button class=btnv data-a=ver data-v='+d.id+'>🔍 Ver</button></td><td class=l>'+esc(d.entNom)+'</td><td class=l>'+esc(d.tipo)+'</td><td>'+esc(d.folio)+'</td><td>'+d.fecha+'</td><td>'+(f.dv===null?'':f.venc)+'</td><td>'+pil+'</td><td>'+f2(d.s*d.total)+'</td><td><b>'+f2(f.saldo)+'</b></td><td class=l>'+esc(d.titulo)+'</td></tr>';
    exp.filas.push([d.entNom,d.tipo,d.folio,d.fecha,f.dv===null?'':f.venc,f.dv===null?'':Math.max(0,f.dv),(d.s*d.total).toFixed(2),f.saldo.toFixed(2),d.titulo]);
  });
  return h+'</tbody><tfoot><tr><td colspan=8>Total</td><td>'+f2(t)+'</td><td></td></tr></tfoot></table></div>'+(total>TOPE?'<div class=nota style=\'color:var(--ambar)\'>Se muestran los primeros '+TOPE.toLocaleString('es-MX')+' de '+total.toLocaleString('es-MX')+' documentos; filtra o exporta a Excel para verlos todos.</div>':'')+'<div class=nota>Clic en «Ver» o en una fila: partidas, agenda de pago y pagos aplicados; ahí mismo el botón «Abrir en Comercial» abre el documento y esta ventana sigue abierta.</div>';
}
// Calendario de vencimientos: solo documentos que suman (las notas de crédito no vencen)
function vistaCal(todas){
  exp={nombre:'calendario_vencimientos',titulo:'',filas:[]};
  var y=calMes.getUTCFullYear(),m=calMes.getUTCMonth(),porDia={};
  todas.forEach(function(f){if(f.dv===null)return;(porDia[f.venc]=porDia[f.venc]||[]).push(f);});
  var primero=new Date(Date.UTC(y,m,1)),ini=new Date(primero.getTime()-primero.getUTCDay()*864e5),hoy=D.hoy;
  var h='<div class=calh><button data-a=calmes data-v=-1>‹ Anterior</button><div class=mes>'+MESES[m]+' '+y+'</div><button data-a=calmes data-v=1>Siguiente ›</button><button data-a=calmes data-v=0>Hoy</button></div>'+
   '<div class=leyenda><span><i style=\'background:var(--rojo)\'></i>Vencido</span><span><i style=\'background:var(--ambar)\'></i>Vence en 7 días</span><span><i style=\'background:var(--verde)\'></i>Vigente</span></div><div class=cg>';
  DOW.forEach(function(x){h+='<div class=dow>'+x+'</div>';});
  for(var i=0;i<42;i++){
    var d=new Date(ini.getTime()+i*864e5),iso=d.toISOString().substr(0,10),its=porDia[iso]||[],cls='cc'+(d.getUTCMonth()!==m?' otro':'')+(iso===hoy?' hoy':'');
    if(its.length){var peor=its.some(function(f){return f.dv>0;})?'r':its.some(function(f){return f.dv>=-7;})?'a':'v';var mo=0;its.forEach(function(f){mo+=f.saldo;});
      h+='<div class=\''+cls+' con p'+peor+'\' data-a=dia data-v='+iso+'><div class=top><span class=n>'+d.getUTCDate()+'</span><span class=\'c '+peor+'\'>'+its.length+'</span></div><div class=mo>'+f2(mo)+'</div></div>';}
    else h+='<div class=\''+cls+'\'><div class=top><span class=n>'+d.getUTCDate()+'</span></div></div>';
  }
  return h+'</div><div class=nota>Cada día suma el saldo de los documentos que vencen ese día. Clic en un día con vencimientos para ver cuáles son.</div>';
}
function vistaEdo(){
  var corte=corteEl.value||D.hoy,lista={},Pc=PC.charAt(0).toUpperCase()+PC.slice(1);
  D.docs.forEach(function(d){lista[d.ent]=d.entNom||('Entidad '+d.ent);});
  var ids=Object.keys(lista).sort(function(a,b){return lista[a]<lista[b]?-1:1;});
  if(!phasta||phasta>corte)phasta=corte;if(!pdesde)pdesde=sumaDias(phasta,-90);
  var h='<div class=ctl style=\'padding:0 0 10px\'><label>'+Pc+' <select id=selEnt onchange=\'entSel=+this.value;cambio()\'><option value=0>— elige —</option>';
  ids.forEach(function(i){h+='<option value='+i+'>'+esc(lista[i])+'</option>';});
  h+='</select></label><label>Del <input type=date id=pd value='+pdesde+' onchange=\'pdesde=this.value;cambio()\'></label><label>al <input type=date id=ph value='+phasta+' onchange=\'phasta=this.value;cambio()\'></label> <button class=p data-a=xlsxedo>Excel de este estado de cuenta</button></div>';
  if(!entSel){exp={nombre:'estado_de_cuenta',titulo:'',filas:[]};return h+'<div class=vacio>Elige un '+PC+' (o haz clic en una fila de la antigüedad) para ver su estado de cuenta.</div>';}
  var ev=[];
  D.docs.forEach(function(d){
    if(d.ent!==entSel)return;
    ev.push({f:d.fecha,t:d.tipo,r:d.folio,c:d.s>0?d.total:0,a:d.s<0?d.total:0,id:d.id,mod:d.mod,o:0,x:d.titulo});
    (pp[d.id]||[]).forEach(function(p){if(p.nc>0)return;var e=-d.s*p.monto;ev.push({f:p.fecha,t:d.s>0?(LADO==='C'?'Cobro':'Pago'):'Devolución',r:p.op+' → '+d.folio,c:e>0?e:0,a:e<0?-e:0,id:d.id,mod:d.mod,o:1,x:''});});
  });
  ev.sort(function(a,b){return a.f<b.f?-1:a.f>b.f?1:a.o-b.o;});
  var ini=0;ev.forEach(function(e){if(e.f<pdesde)ini+=e.c-e.a;});
  exp={nombre:'estado_de_cuenta_'+(lista[entSel]||'').replace(/[^A-Za-z0-9]+/g,'_')+'_'+phasta,titulo:'Estado de cuenta — '+lista[entSel]+' ('+fmtF(pdesde)+' al '+fmtF(phasta)+')',filas:[['Fecha','Movimiento','Referencia','Cargos','Abonos','Saldo']]};
  var sal=ini,tc=0,ta=0,rows='',movs=[];
  exp.filas.push([pdesde,'Saldo inicial','','','',ini.toFixed(2)]);
  ev.forEach(function(e){
    if(e.f<pdesde||e.f>phasta)return;sal+=e.c-e.a;tc+=e.c;ta+=e.a;
    rows+='<tr class=clic data-a=ver data-v='+e.id+'><td>'+e.f+'</td><td class=l>'+esc(e.t)+'</td><td class=l>'+esc(e.r)+(e.x?' <span class=nota>'+esc(e.x)+'</span>':'')+'</td><td>'+(e.c?f2(e.c):'')+'</td><td>'+(e.a?f2(e.a):'')+'</td><td>'+f2(sal)+'</td></tr>';
    exp.filas.push([e.f,e.t,e.r,e.c?e.c.toFixed(2):'',e.a?e.a.toFixed(2):'',sal.toFixed(2)]);
    movs.push([e.f,e.t,e.r+(e.x?' · '+e.x:''),e.c,e.a,sal]);
  });
  exp.edo={nombre:lista[entSel],ini:ini,movs:movs,cargos:tc,abonos:ta,fin:sal};
  exp.filas.push(['','Totales del periodo','',tc.toFixed(2),ta.toFixed(2),sal.toFixed(2)]);
  return h+'<div class=tw><table><thead><tr><th>Fecha</th><th class=l>Movimiento</th><th class=l>Referencia</th><th>Cargos</th><th>Abonos</th><th>Saldo</th></tr></thead><tbody><tr><td>'+pdesde+'</td><td class=l><b>Saldo inicial</b></td><td></td><td></td><td></td><td><b>'+f2(ini)+'</b></td></tr>'+rows+'</tbody><tfoot><tr><td colspan=3>Totales del periodo</td><td>'+f2(tc)+'</td><td>'+f2(ta)+'</td><td>'+f2(sal)+'</td></tr></tfoot></table></div><div class=nota>Las notas de crédito aplicadas a una factura no se repiten como abono: la nota ya restó como documento. Clic en un movimiento para ver su documento.</div>';
}
// ---- ventana de detalle de un documento ----
function modal(t,s,html,vol){document.getElementById('mt').textContent=t;document.getElementById('ms').textContent=s;document.getElementById('mb').innerHTML=html;volverA=vol||null;document.getElementById('mv').style.display=vol?'inline-block':'none';document.getElementById('mf').className='mf on';}
function verDoc(id,vol){
  var d=docPorId[id];if(!d)return;var corte=corteEl.value||D.hoy,ap=0,pg=[];
  (pp[d.id]||[]).forEach(function(p){if(p.nc>0)return;pg.push(p);});
  (pp[d.id]||[]).forEach(function(p){if(p.fecha<=corte)ap+=p.monto;});(nc[d.id]||[]).forEach(function(p){if(p.fecha<=corte)ap+=p.monto;});
  var saldo=d.total-ap,venc=d.venc||d.fecha,dv=d.s<0?null:dias(venc,corte);
  var est=dv===null?'<span class=\'pill m\'>A favor</span>':Math.abs(saldo)<0.005?'<span class=\'pill v\'>Liquidado</span>':dv>0?'<span class=\'pill r\'>Vencido '+dv+' d</span>':dv>=-7?'<span class=\'pill a\'>Vence en 7 días</span>':'<span class=\'pill v\'>Vigente</span>';
  var h=(d.fact>0?'<div class=nota style=\'margin:0 0 8px;color:var(--ambar)\'>Este documento ya se facturó por '+f2(d.fact)+'; aquí solo cuenta lo que falta por facturar (la factura lleva la deuda).</div>':'')+'<div class=dc><div><b>Total</b><span>'+f2(d.total)+'</span></div><div><b>'+(LADO==='C'?'Cobrado':'Pagado')+'</b><span>'+f2(ap)+'</span></div><div><b>Saldo al corte</b><span>'+f2(saldo)+'</span></div><div><b>Vencimiento</b><span>'+(dv===null?'—':fmtF(venc))+'</span></div><div><b>Estatus</b><span>'+est+'</span></div></div>';
  h+='<div class=sec><h3>Partidas</h3>'+(d.p&&d.p.length?'<table><thead><tr><th>#</th><th class=l>Concepto</th><th>Cantidad</th><th>Precio</th><th>Total</th></tr></thead><tbody>'+d.p.map(function(p){return '<tr><td>'+p[0]+'</td><td class=l style=\'white-space:normal\'>'+esc(p[1])+'</td><td>'+f2(p[2])+'</td><td>'+f2(p[3])+'</td><td>'+f2(p[4])+'</td></tr>';}).join('')+'</tbody></table>':'<div class=nota>El detalle de partidas se carga solo de los documentos que hoy tienen saldo.</div>')+'</div>';
  h+='<div class=sec><h3>Agenda de '+(LADO==='C'?'cobro':'pago')+'</h3>'+(d.a&&d.a.length?'<table><thead><tr><th>Parcialidad</th><th>Fecha</th><th>Monto</th><th class=l>Estatus</th></tr></thead><tbody>'+d.a.map(function(a){return '<tr><td>'+a[0]+'</td><td>'+fmtF(a[1])+'</td><td>'+f2(a[2])+'</td><td class=l>'+(AGENDA[a[3]]||a[3])+'</td></tr>';}).join('')+'</tbody></table>':'<div class=nota>Sin agenda de pago capturada.</div>')+'</div>';
  var ncs=nc[d.id]||[];
  h+='<div class=sec><h3>Pagos aplicados</h3>'+(pg.length||ncs.length?'<table><thead><tr><th>Fecha</th><th>Monto</th><th class=l>Operación</th></tr></thead><tbody>'+pg.map(function(p){return '<tr><td>'+fmtF(p.fecha)+'</td><td>'+f2(p.monto)+'</td><td class=l>'+esc(p.op)+'</td></tr>';}).join('')+ncs.map(function(p){var n=docPorId[p.doc];return '<tr><td>'+fmtF(p.fecha)+'</td><td>'+f2(p.monto)+'</td><td class=l>Nota de crédito '+esc(n?n.folio:p.doc)+'</td></tr>';}).join('')+'</tbody></table>':'<div class=nota>Sin pagos aplicados todavía.</div>')+'</div>';
  h+='<div style=\'text-align:right\'><button class=p data-a=abrir data-v='+d.id+'>Abrir en Comercial</button></div>';
  modal(d.tipo+' '+(d.folio||'(sin folio)')+' — '+(d.entNom||''),'Fecha '+fmtF(d.fecha)+(d.titulo?' · '+d.titulo:''),h,vol);
}
function verDia(iso){
  var its=calc(true).filter(function(f){return f.dv!==null&&f.venc===iso;}),tot=0;its.forEach(function(f){tot+=f.saldo;});
  var h='<div class=dc style=\'grid-template-columns:1fr\'><div><b>Total que vence este día</b><span>'+f2(tot)+'</span></div></div>'+its.map(function(f){var c=f.dv>0?'r':f.dv>=-7?'a':'v';return '<div class=\'comp '+c+'\'><div><b>'+esc(f.d.folio||'(sin folio)')+'</b> — '+esc(f.d.entNom)+'<br><span class=nota>Saldo '+f2(f.saldo)+'</span></div><button class=btnv data-a=verdia data-v='+f.d.id+' data-i='+iso+'>Ver documento →</button></div>';}).join('');
  modal('Vencimientos del '+fmtF(iso),its.length+' documento(s)',h,null);
}
// ---- gráficas para el Excel ejecutivo: se dibujan en un canvas (2x para que se vean nítidas) y viajan como PNG; los números van además en tablas del libro ----
var PAL={azul:'#2D6FE0',marino:'#15324F',rojo:'#DC2626',ambar:'#D97706',verde:'#16A34A',morado:'#7E22CE',gris:'#64748B',linea:'#E2E8F0',texto:'#16263A'};
var FUENTE='Segoe UI, Calibri, Arial';
function abrev(n){var a=Math.abs(n),s=n<0?'-':'';return a>=1e6?s+'$'+(a/1e6).toFixed(2)+' M':a>=1e3?s+'$'+(a/1e3).toFixed(1)+' k':s+'$'+a.toFixed(0);}
function lienzo(w,h){var c=document.createElement('canvas');c.width=w*2;c.height=h*2;var g=c.getContext('2d');g.scale(2,2);g.fillStyle='#FFFFFF';g.fillRect(0,0,w,h);return {c:c,g:g,w:w,h:h};}
function recorta(g,t,max){t=String(t||'');if(g.measureText(t).width<=max)return t;while(t.length>1&&g.measureText(t+'…').width>max)t=t.slice(0,-1);return t+'…';}
function titulo(L,t,sub){L.g.fillStyle=PAL.marino;L.g.font='bold 15px '+FUENTE;L.g.textAlign='left';L.g.textBaseline='alphabetic';L.g.fillText(t,16,26);if(sub){L.g.fillStyle=PAL.gris;L.g.font='11px '+FUENTE;L.g.fillText(sub,16,43);}}
function vacioGraf(L,t){titulo(L,t);L.g.fillStyle=PAL.gris;L.g.font='13px '+FUENTE;L.g.textAlign='center';L.g.fillText('Sin datos para graficar',L.w/2,L.h/2);return L.c.toDataURL('image/png').split(',')[1];}
function barrasV(t,sub,etiq,vals,cols,nota){
  var L=lienzo(570,300),g=L.g,mx=Math.max.apply(null,vals.concat([1])),x0=26,x1=L.w-20,y0=64,y1=L.h-46,n=vals.length;
  if(!vals.some(function(v){return v>0;}))return vacioGraf(L,t);
  titulo(L,t,sub);if(nota){g.fillStyle=PAL.rojo;g.font='bold 11px '+FUENTE;g.textAlign='right';g.fillText(nota,L.w-16,26);}g.strokeStyle=PAL.linea;g.lineWidth=1;
  for(var i=0;i<=3;i++){var y=y1-(y1-y0)*i/3;g.beginPath();g.moveTo(x0,y);g.lineTo(x1,y);g.stroke();}
  var ancho=(x1-x0)/n,bw=Math.min(62,ancho*0.62);
  vals.forEach(function(v,i){
    var h=(y1-y0)*v/mx,x=x0+ancho*i+(ancho-bw)/2,y=y1-h;
    g.fillStyle=cols[i%cols.length];if(v>0){g.beginPath();g.moveTo(x,y1);g.lineTo(x,y+4);g.quadraticCurveTo(x,y,x+4,y);g.lineTo(x+bw-4,y);g.quadraticCurveTo(x+bw,y,x+bw,y+4);g.lineTo(x+bw,y1);g.closePath();g.fill();}
    g.fillStyle=PAL.texto;g.font='bold 11px '+FUENTE;g.textAlign='center';g.fillText(v?abrev(v):'',x+bw/2,y-6);
    g.fillStyle=PAL.gris;g.font='11px '+FUENTE;g.fillText(recorta(g,etiq[i],ancho-4),x+bw/2,y1+17);
  });
  return L.c.toDataURL('image/png').split(',')[1];
}
function barrasH(t,sub,filas,nomA,nomB){      // filas: [{nom, a (parte roja), b (parte azul)}] ya ordenadas de mayor a menor
  var L=lienzo(570,300),g=L.g;
  if(!filas.length)return vacioGraf(L,t);
  titulo(L,t,sub);var mx=Math.max.apply(null,filas.map(function(f){return f.a+f.b;}).concat([1])),izq=170,der=70,y0=56,alto=Math.min(22,(L.h-y0-34)/filas.length),sep=alto*0.28;
  filas.forEach(function(f,i){
    var y=y0+i*alto*1.0,w1=(L.w-izq-der)*f.a/mx,w2=(L.w-izq-der)*f.b/mx;
    g.fillStyle=PAL.texto;g.font='11px '+FUENTE;g.textAlign='right';g.textBaseline='middle';g.fillText(recorta(g,f.nom,izq-14),izq-8,y+(alto-sep)/2);
    g.fillStyle=PAL.rojo;g.fillRect(izq,y,w1,alto-sep);g.fillStyle=PAL.azul;g.fillRect(izq+w1,y,w2,alto-sep);
    g.fillStyle=PAL.texto;g.font='bold 10.5px '+FUENTE;g.textAlign='left';g.fillText(abrev(f.a+f.b),izq+w1+w2+6,y+(alto-sep)/2);
  });
  g.textBaseline='alphabetic';var yl=L.h-14;g.fillStyle=PAL.rojo;g.fillRect(16,yl-8,10,10);g.fillStyle=PAL.gris;g.font='11px '+FUENTE;g.textAlign='left';g.fillText(nomA,31,yl+1);
  g.fillStyle=PAL.azul;g.fillRect(120,yl-8,10,10);g.fillStyle=PAL.gris;g.fillText(nomB,135,yl+1);
  return L.c.toDataURL('image/png').split(',')[1];
}
function dona(t,sub,partes,centro){          // partes: [{nom,v,col}]
  var L=lienzo(570,300),g=L.g,tot=partes.reduce(function(s,p){return s+Math.max(0,p.v);},0);
  if(tot<=0)return vacioGraf(L,t);
  titulo(L,t,sub);var cx=150,cy=172,R=100,r=62,ang=-Math.PI/2;
  partes.forEach(function(p){if(p.v<=0)return;var a=2*Math.PI*p.v/tot;g.beginPath();g.arc(cx,cy,R,ang,ang+a);g.arc(cx,cy,r,ang+a,ang,true);g.closePath();g.fillStyle=p.col;g.fill();ang+=a;});
  g.fillStyle=PAL.marino;g.font='bold 15px '+FUENTE;g.textAlign='center';g.textBaseline='alphabetic';g.fillText(abrev(centro),cx,cy+2);g.fillStyle=PAL.gris;g.font='10.5px '+FUENTE;g.fillText('saldo total',cx,cy+18);
  partes.forEach(function(p,i){var y=100+i*48;g.fillStyle=p.col;g.fillRect(300,y-10,12,12);g.fillStyle=PAL.texto;g.font='bold 12px '+FUENTE;g.textAlign='left';g.fillText(p.nom,320,y);g.fillStyle=PAL.gris;g.font='11px '+FUENTE;g.fillText(f2(p.v)+'  ·  '+(tot?Math.round(100*Math.max(0,p.v)/tot):0)+'%',320,y+16);});
  return L.c.toDataURL('image/png').split(',')[1];
}
// Arma todo lo que lleva el libro ejecutivo a partir de las filas del corte (sin filtros de pantalla)
function cargaExcel(){
  var corte=corteEl.value||D.hoy,todas=calc(true),ents=porEntidad(todas),pcMay=PC.charAt(0).toUpperCase()+PC.slice(1);
  var k={r:[0,0],a:[0,0],s:[0,0],v:[0,0],m:[0,0],t:0},sem=[],i;
  for(i=0;i<8;i++)sem.push({ini:sumaDias(corte,i*7),fin:sumaDias(corte,i*7+6),n:0,monto:0});
  var docs=[];
  todas.sort(function(a,b){return a.d.entNom<b.d.entNom?-1:a.d.entNom>b.d.entNom?1:(a.venc<b.venc?-1:1);});
  todas.forEach(function(f){
    var d=f.d,est;
    if(f.dv===null){k.m[0]++;k.m[1]+=f.saldo;est='A favor';}
    else{k.t+=f.saldo;
      if(f.dv>0){k.r[0]++;k.r[1]+=f.saldo;est='Vencido';}else if(f.dv>=-7){k.a[0]++;k.a[1]+=f.saldo;est='Vence en 7 días';}else{k.v[0]++;k.v[1]+=f.saldo;est='Vigente';}
      for(var j=0;j<8;j++){if(f.venc>=sem[j].ini&&f.venc<=sem[j].fin){sem[j].n++;sem[j].monto+=f.saldo;break;}}
      if(f.venc>=sumaDias(corte,7)&&f.venc<=sumaDias(corte,13)){k.s[0]++;k.s[1]+=f.saldo;}
    }
    docs.push([d.entNom||('Entidad '+d.ent),d.tipo,d.folio,d.fecha,f.dv===null?'':f.venc,f.dv===null?null:f.dv,d.s*d.total,d.s*f.pagado,f.saldo,est,d.titulo]);
  });
  var agg=[0,0,0,0,0,0];ents.forEach(function(e){e.b.forEach(function(v,j){agg[j]+=v;});});
  var top=ents.slice(0,10).map(function(e){var ven=e.b[1]+e.b[2]+e.b[3]+e.b[4];return {nom:e.nom,a:Math.max(0,ven),b:Math.max(0,e.tot-ven)};});
  var gr={
    aging:barrasV('Antigüedad de saldos','Saldo por días de vencido al '+fmtF(corte),BUCKETS.slice(0,5),agg.slice(0,5),[PAL.verde,'#EAB308','#F97316','#EA580C',PAL.rojo]),
    top:barrasH('Principales '+PC+'s por saldo','Los 10 con mayor saldo; en rojo lo ya vencido',top,'Vencido','Por vencer / vigente'),
    sem:barrasV('Vencimientos próximas 8 semanas','Saldo que vence cada semana a partir del '+fmtF(corte),sem.map(function(s){return s.ini.slice(8)+'/'+s.ini.slice(5,7);}),sem.map(function(s){return s.monto;}),[PAL.azul],'Ya vencido (aparte): '+abrev(k.r[1])),
    estado:dona('Situación del saldo','Facturas pendientes de '+(LADO==='C'?'cobro':'pago'),[{nom:'Vencido',v:k.r[1],col:PAL.rojo},{nom:'Vence en 7 días',v:k.a[1],col:PAL.ambar},{nom:'Vigente',v:k.v[1],col:PAL.verde}],k.t)
  };
  return {tipo:'general',empresa:D.empresa||'',titulo:TITULO,ent:PC,entPl:PC+'s',lado:LADO,corte:corte,generado:new Date().toLocaleString('es-MX'),
    kpi:{vencido:k.r,siete:k.a,semana:k.s,vigente:k.v,favor:k.m,total:k.t},buckets:BUCKETS,agg:agg,
    ents:ents.map(function(e){return [e.nom,e.b[0],e.b[1],e.b[2],e.b[3],e.b[4],e.b[5],e.tot,e.n];}),docs:docs,
    semanas:[{ini:corte,fin:corte,n:k.r[0],monto:k.r[1],nom:'Vencido'}].concat(sem),graficas:gr,meses:D.meses};
}
// Estado de cuenta de un solo cliente/proveedor (para mandarlo): tabla de movimientos con saldo corriente
function cargaEdo(){
  if(!entSel||!exp.edo)return null;var e=exp.edo;
  return {tipo:'edo',empresa:D.empresa||'',titulo:TITULO,ent:PC,lado:LADO,nombreEnt:e.nombre,desde:pdesde,hasta:phasta,generado:new Date().toLocaleString('es-MX'),ini:e.ini,movs:e.movs,cargos:e.cargos,abonos:e.abonos,final:e.fin};
}
// ---- acciones (un solo manejador de clics) ----
var acc={
  tab:function(v){tab=v;[].forEach.call(document.querySelectorAll('#tabs button'),function(b){b.className=b.getAttribute('data-v')===v?'on':'';});cambio();},
  edo:function(v){entSel=+v;acc.tab('edo');},
  rango:function(v){rango=rango===v?'':v;cambio();},
  ver:function(v){verDoc(+v,null);},
  verdia:function(v,el){var iso=el.getAttribute('data-i');verDoc(+v,function(){verDia(iso);});},
  dia:function(v){verDia(v);},
  calmes:function(v){if(v==='0'){calMes=new Date(Date.parse(D.hoy));calMes.setUTCDate(1);}else{calMes.setUTCMonth(calMes.getUTCMonth()+(+v));}cambio();},
  volver:function(){if(volverA)volverA();},
  cerrar:function(){document.getElementById('mf').className='mf';volverA=null;},
  abrir:function(v){var d=docPorId[+v];if(d)enviar({accion:'abrir',id:d.id,modulo:d.mod});},
  csv:function(){
    if(!exp.filas.length)return;
    var Q=String.fromCharCode(34);
    var csv=exp.filas.map(function(f){return f.map(function(c){c=String(c==null?'':c);return /[,\n]/.test(c)||c.indexOf(Q)>=0?Q+c.split(Q).join(Q+Q)+Q:c;}).join(',');}).join('\r\n');
    enviar({accion:'csv',nombre:exp.nombre,contenido:csv});
  },
  xlsx:function(){
    if(!D.docs.length)return;
    var btn=document.querySelector('[data-a=xlsx]');btn.textContent='Preparando Excel…';btn.disabled=true;
    setTimeout(function(){try{enviar(Object.assign({accion:'xlsx',nombre:(TITULO+' '+(corteEl.value||D.hoy)).replace(/ /g,'_')},{carga:cargaExcel()}));}finally{btn.textContent='Exportar a Excel';btn.disabled=false;}},30);
  },
  xlsxedo:function(){var c=cargaEdo();if(!c)return;enviar({accion:'xlsx',nombre:'estado_de_cuenta_'+String(c.nombreEnt).replace(/[^A-Za-z0-9]+/g,'_')+'_'+c.hasta,carga:c});}
};
document.addEventListener('click',function(e){
  var t=e.target.closest('[data-a]');
  if(!t){if(e.target.id==='mf')acc.cerrar();return;}
  if(e.target.closest('button')&&e.target.closest('button')!==t)return;
  var a=t.getAttribute('data-a');if(acc[a]){e.stopPropagation();acc[a](t.getAttribute('data-v'),t);}
});
cambio();
</script></body></html>";

if (!string.IsNullOrEmpty(modoPrueba))
{
    string salidaPrueba = Environment.GetEnvironmentVariable("BROSLMV_SALDOS_OUT");
    string htmlPrueba = Environment.GetEnvironmentVariable("BROSLMV_SALDOS_HTML");
    string jsonPrueba = ser.Serialize(modelo);
    if (!string.IsNullOrEmpty(salidaPrueba)) File.WriteAllText(salidaPrueba, jsonPrueba, new UTF8Encoding(false));
    if (!string.IsNullOrEmpty(htmlPrueba)) File.WriteAllText(htmlPrueba, Html(jsonPrueba), new UTF8Encoding(false));
    return "OK " + docs.Count + " documentos, " + pagos.Count + " pagos";
}

Func<Dictionary<string, object>, string> alMensaje = r =>
{
    string accion = r.ContainsKey("accion") ? S(r["accion"]) : "";
    if (accion == "abrir")
    {
        try { ctx.erp.AbrirDocumento((int)L(r["id"]), I(r["modulo"])); } catch (Exception ex) { ctx.Msg("No se pudo abrir el documento: " + ex.Message, "Estado de cuenta de proveedores (cuentas por pagar)"); }
        return null;
    }
    if (accion == "csv")
    {
        string nombre = new string(S(r["nombre"]).Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c).ToArray());
        using (var dlg = new SaveFileDialog { Filter = "CSV para Excel (*.csv)|*.csv", FileName = nombre + ".csv" })
            if (dlg.ShowDialog() == DialogResult.OK) { File.WriteAllText(dlg.FileName, S(r["contenido"]), new UTF8Encoding(true)); ctx.Msg("Archivo guardado:\n" + dlg.FileName, "Estado de cuenta de proveedores (cuentas por pagar)"); }
        return null;
    }
    if (accion == "xlsx")
    {
        string nombre = new string(S(r["nombre"]).Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c).ToArray());
        using (var dlg = new SaveFileDialog { Filter = "Libro de Excel (*.xlsx)|*.xlsx", FileName = nombre + ".xlsx" })
            if (dlg.ShowDialog() == DialogResult.OK)
            {
                try
                {
                    ConstruirExcel((Dictionary<string, object>)r["carga"], dlg.FileName);
                    if (MessageBox.Show("Se guardó el libro de Excel:\n" + dlg.FileName + "\n\n¿Abrirlo ahora?", "Estado de cuenta de proveedores (cuentas por pagar)", MessageBoxButtons.YesNo, MessageBoxIcon.Information) == DialogResult.Yes)
                        System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo { FileName = dlg.FileName, UseShellExecute = true });
                }
                catch (Exception ex) { ctx.Msg("No se pudo generar el Excel:\n" + ex.Message, "Estado de cuenta de proveedores (cuentas por pagar)"); }
            }
        return null;
    }
    return null;
};
ctx.ShowHtmlModeless(Html(ser.Serialize(modelo)), "Estado de cuenta de proveedores (cuentas por pagar)", 1360, 860, alMensaje);
return "OK";
