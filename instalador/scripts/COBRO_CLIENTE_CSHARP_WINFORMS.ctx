void Acomodar()
{
    int W = frm.ClientSize.Width, H = frm.ClientSize.Height, m = 12, w = W - 2 * m;
    ribbon.SetBounds(m, 10, w, 100); info.Location = new Point(ribbon.Width - info.Width - 10, 6);
    bool verTipos = TIPOS.Count > 1; pTipos.Visible = verTipos;
    pTipos.SetBounds(m, 118, w, 40);
    int y = verTipos ? 166 : 118; g1.SetBounds(m, y, 620, 132); g2.SetBounds(m + 632, y, w - 632, 132); y += 140;
    g3.SetBounds(m, y, w, 84); pEdad.SetBounds(14, 36, g3.Width - 28, 40); y += 92;
    int yb = H - 40 - 108 - 8;
    g5.SetBounds(m, yb, w, 108); lblTotEt.Location = new Point(g5.Width - 254, 32); lblTot.Location = new Point(g5.Width - 254, 46);
    g4.SetBounds(m, y, w, Math.Max(170, yb - 8 - y)); grid.SetBounds(14, 70, g4.Width - 28, g4.Height - 82);
    pPie.SetBounds(0, H - 40, W, 40); lblAvisos.SetBounds(Math.Max(420, lblPie.Right + 20), 5, Math.Max(100, W - Math.Max(420, lblPie.Right + 20) - 14), 30);
    foreach (var g in new[] { g1, g2, g3, g4, g5 }) g.Invalidate(); pEdad.Invalidate();
}
frm.Resize += (s, e) => Acomodar();

string Hoy() => dtFecha.Value.ToString("yyyy-MM-dd");
int DiasVencido(Dictionary<string, object> d) { var v = Fe(S(d["vence"])); return v == null ? int.MinValue : (int)(dtFecha.Value.Date - v.Value.Date).TotalDays; }
List<Dictionary<string, object>> DocsDeEnt() => entSel == null ? new List<Dictionary<string, object>>() : DocsLado().Where(d => I(d["ent"]) == I(entSel["id"])).ToList();

int MCta() { var o = cmbCta.SelectedItem as Opcion; return o == null ? 3 : o.Moneda; }
double Tc() => (double)nudTc.Value;
bool Compat(Dictionary<string, object> d) { int mc = MCta(), md = I(d["moneda"]); return md == mc || mc == 3 || md == 3; }
double ADoc(Dictionary<string, object> d, double m) { int mc = MCta(), md = I(d["moneda"]); if (md == mc) return m; if (mc == 3) return Tc() > 0 ? m / Tc() : 0; return m * Tc(); }
double A2(Dictionary<string, object> d, double sa) { int mc = MCta(), md = I(d["moneda"]); if (md == mc) return Math.Round(sa, 2); if (mc == 3) return Math.Round(sa * Tc(), 2); double v = Tc() > 0 ? sa / Tc() : 0; return Math.Floor(v * 100 + 1e-9) / 100; }
double Sc(Dictionary<string, object> d) => A2(d, D(d["saldo"]));
double ValMx(Dictionary<string, object> d, double da) => I(d["moneda"]) == 3 ? da : da * D(d["tcDoc"]);
int MonedaFx()
{
    int mc = MCta(); if (mc != 3) return mc;
    var ds = DocsDeEnt(); foreach (var k in seleccion.Keys) { var d = ds.FirstOrDefault(x => L(x["id"]) == k); if (d != null && I(d["moneda"]) != 3) return I(d["moneda"]); }
    var l = ds.FirstOrDefault(x => I(x["moneda"]) != 3); return l == null ? 0 : I(l["moneda"]);
}
void PintarMon()
{
    int mc = MCta(), fx = MonedaFx(); string sy = SimboloDe(mc); bool ver = fx != 0;
    lblTcEt.Visible = ver; nudTc.Visible = ver;
    lblMontoEt.Text = (EsCobro() ? "Monto recibido" : "Monto a pagar") + (mc != 3 ? " (" + sy + ")" : "") + " (opcional)";
    grid.Columns["Aplicar"].HeaderText = "APLICAR " + sy;
    lblInfoPie.Text = mc != 3 && monedaPor.ContainsKey(mc) ? "Cuenta en " + sy + " · " + S(monedaPor[mc]["nombre"]) : "(lo asigna el sistema al registrar)";
    if (ver)
    {
        lblTcEt.Text = "Tipo de cambio " + SimboloDe(fx) + " → MXN";
        if (tcMon != fx) { tcMon = fx; ajustandoTc = true; nudTc.Value = monedaPor.ContainsKey(fx) ? (decimal)Math.Round(D(monedaPor[fx]["tc"]), 4) : 1M; ajustandoTc = false; }
    }
}
string Leyenda(Dictionary<string, object> d)
{
    long id = L(d["id"]); double m = seleccion.ContainsKey(id) ? seleccion[id] : 0, sal = D(d["saldo"]), da = Math.Round(ADoc(d, m), 2); if (Math.Abs(da - sal) <= 0.011) da = sal;
    double q = Math.Round(sal - da, 2); string sy = S(d["simbolo"]);
    return (I(d["moneda"]) != MCta() ? "= " + da.ToString("N2") + " " + sy + " · " : "") + (q <= 0.004 ? "liquida" : "queda " + q.ToString("N2") + " " + sy);
}
string PagoTexto(Dictionary<string, object> d)
{
    int na = I(d["nAplic"]), nn = I(d["nNotas"]); double pg = D(d["pagado"]), tot = D(d["total"]);
    if (na + nn == 0 && pg <= 0.004) return "sin pagos aplicados";
    var p = new List<string> { "pagado " + pg.ToString("N2") + " (" + Math.Round(pg / (tot == 0 ? 1 : tot) * 100) + " %)" };
    if (na > 0) p.Add(na + (EsCobro() ? " cobro" : " pago") + (na > 1 ? "s" : "")); if (nn > 0) p.Add(nn + " nota" + (nn > 1 ? "s" : "") + " de crédito");
    return string.Join(" · ", p);
}
void CambioCuenta()
{
    int mc = MCta(); if (mc != mcPrev) { mcPrev = mc; tcMon = -1; }
    PintarMon(); var ds = DocsDeEnt();
    foreach (var k in seleccion.Keys.ToList())
    {
        var d = ds.FirstOrDefault(x => L(x["id"]) == k);
        if (d == null || !Compat(d)) { seleccion.Remove(k); parcSel.Remove(k); } else if (seleccion[k] > Sc(d) || mc != mcPrevDocs) seleccion[k] = Sc(d);
    }
    mcPrevDocs = mc; PintarDocs();
}
Dictionary<int, double[]> Stats()
{
    var m = new Dictionary<int, double[]>();
    foreach (var d in DocsLado()) { int e = I(d["ent"]); if (!m.ContainsKey(e)) m[e] = new double[8]; var a = m[e]; double s = D(d["saldoMx"]); a[0] += s; a[2]++; int dv = DiasVencido(d); if (dv > 0 && dv != int.MinValue) a[1] += s; int b = dv == int.MinValue || dv <= 0 ? 0 : dv <= 30 ? 1 : dv <= 60 ? 2 : dv <= 90 ? 3 : 4; a[3 + b] += s; }
    return m;
}
var ES = Stats();
void Totales()
{
    double t = Math.Round(seleccion.Values.Sum(), 2); double pend = entSel != null && ES.ContainsKey(I(entSel["id"])) ? ES[I(entSel["id"])][0] : 0; double mon = (double)nudMonto.Value; int mc = MCta(); string sy = SimboloDe(mc);
    double pm = 0; var dsel = DocsDeEnt(); foreach (var kv in seleccion) { var d = dsel.FirstOrDefault(x => L(x["id"]) == kv.Key); if (d == null) continue; double da = ADoc(d, kv.Value); if (Math.Abs(da - D(d["saldo"])) <= 0.011) da = D(d["saldo"]); pm += ValMx(d, da); }
    lblN.Text = seleccion.Count.ToString(); lblSal.Text = pend.ToString("N2"); lblQ.Text = Math.Max(0, pend - Math.Round(pm, 2)).ToString("N2"); lblMon.Text = mon > 0 ? mon.ToString("N2") + " " + sy : "—"; lblTot.Text = t.ToString("N2") + " " + sy; lblTot.ForeColor = Acento();
    lblTotEt.Text = mc != 3 ? "A APLICAR  ·  ≈ " + (t * Tc()).ToString("N2") + " MXN" : "A APLICAR";
    var av = new List<string>();
    if (mon > 0 && t > 0 && Math.Abs(mon - t) > 0.005) av.Add(mon > t ? "⚠ Sobran " + (mon - t).ToString("N2") + " " + sy + " del monto: no se aplican (los anticipos no se manejan aquí)" : "⚠ Faltan " + (t - mon).ToString("N2") + " " + sy + " para cubrir lo marcado");
    if (dtFecha.Value.Date > DateTime.Today) av.Add("⚠ La fecha es posterior a hoy");
    lblAvisos.Text = string.Join("     ", av);
}
void PintarDocs()
{
    pintando = true; PintarMon(); grid.Rows.Clear();
    var ds = DocsDeEnt();
    foreach (var d in ds)
    {
        long id = L(d["id"]); bool on = seleccion.ContainsKey(id), ok = Compat(d); int dv = DiasVencido(d); bool ext = I(d["moneda"]) != 3; int np = I(d["nParc"]);
        string estado = dv == int.MinValue ? "sin vencimiento" : dv > 0 ? "vencido " + dv + " d" : dv >= -7 ? "vence en " + (-dv) + " d" : "vigente";
        int r = grid.Rows.Add(on, S(d["tipo"]) + " " + S(d["folio"]) + (ext ? "  [" + S(d["simbolo"]) + "]" : ""), S(d["fecha"]) == "" ? "" : Fe(S(d["fecha"])).Value.ToString("dd/MM/yyyy"), S(d["vence"]) == "" ? "—" : Fe(S(d["vence"])).Value.ToString("dd/MM/yyyy"), estado, PagoTexto(d), D(d["total"]).ToString("N2"), D(d["saldo"]).ToString("N2") + (ext ? " " + S(d["simbolo"]) : ""),
            np < 2 ? (np == 1 ? "1 de 1" : "—") : parcSel.ContainsKey(id) ? parcSel[id].ToString() : "auto", ok ? (on ? seleccion[id].ToString("0.00") : "") : "—", ok ? (on ? Leyenda(d) : "") : "no aplica con una cuenta en " + SimboloDe(MCta()));
        grid.Rows[r].Tag = id; grid.Rows[r].Cells["Estado"].Style.ForeColor = dv > 0 && dv != int.MinValue ? C_ROJO : dv >= -7 && dv != int.MinValue ? C_AMBAR : C_VERDE;
        grid.Rows[r].Cells["Parc"].ReadOnly = np < 2 || !on; grid.Rows[r].Cells["Aplicar"].ReadOnly = !ok || !on;
        if (!ok) grid.Rows[r].DefaultCellStyle.ForeColor = C_MUTED; if (I(d["nAplic"]) + I(d["nNotas"]) > 0) grid.Rows[r].Cells["Pagos"].Style.ForeColor = C_VERDE;
    }
    lblDocsEst.Text = entSel == null ? "elige primero la persona" : ds.Count + " documento(s) con saldo · captura el monto y usa «Distribuir», o marca y ajusta «Aplicar»";
    pintando = false; Totales();
}
void PintarEnt()
{
    pastillas.Clear(); txtRfc.Text = entSel == null ? "" : S(entSel["rfc"]) == "" ? "(sin RFC)" : S(entSel["rfc"]); btnMov.Enabled = entSel != null;
    if (entSel != null)
    {
        var e = ES.ContainsKey(I(entSel["id"])) ? ES[I(entSel["id"])] : new double[8];
        pastillas.Add(new Pastilla { Titulo = "Saldo pendiente (MXN)", Valor = e[0].ToString("N2"), Color = e[0] > 0 ? C_AMBAR : C_TXT });
        pastillas.Add(new Pastilla { Titulo = "Vencido", Valor = e[1].ToString("N2"), Color = e[1] > 0 ? C_ROJO : C_TXT });
        pastillas.Add(new Pastilla { Titulo = "Documentos", Valor = e[2].ToString("0"), Color = C_TXT });
        if (D(entSel["credito"]) > 0) pastillas.Add(new Pastilla { Titulo = "Límite de crédito", Valor = D(entSel["credito"]).ToString("N2"), Color = C_TXT });
        pastillas.Add(new Pastilla { Titulo = EsCobro() ? "Último cobro" : "Último pago", Valor = S(entSel["ultFecha"]) == "" ? "—" : Fe(S(entSel["ultFecha"])).Value.ToString("dd/MM/yy") + " · " + D(entSel["ultMonto"]).ToString("N2"), Color = C_TXT });
    }
    pChips.Invalidate(); pEdad.Invalidate();
}
void ElegirEnt(Dictionary<string, object> x) { entSel = x; txtEnt.Text = S(x["nombre"]); lstEnt.Visible = false; seleccion.Clear(); parcSel.Clear(); PintarEnt(); PintarDocs(); nudMonto.Focus(); }
void CambiarTipo(int idx)
{
    string antes = (string)TipoActual()["lado"]; tipoIdx = idx; var t = TipoActual();
    if ((string)t["lado"] != antes) { entSel = null; txtEnt.Text = ""; }
    seleccion.Clear(); parcSel.Clear(); ES = Stats();
    for (int i = 0; i < btnsTipo.Count; i++) { bool on = i == idx; var col = (string)TIPOS[i]["lado"] == "C" ? C_COBRO : C_PAGO; btnsTipo[i].BackColor = on ? col : Color.White; btnsTipo[i].ForeColor = on ? Color.White : C_TXT; btnsTipo[i].FlatAppearance.BorderColor = on ? col : C_LINE; btnsTipo[i].Font = on ? F_B : F_BASE; }
    lblRibTitulo.Text = (string)t["nombre"] + (EsCobro() ? "  ·  cuentas por cobrar, entra dinero" : "  ·  cuentas por pagar, sale dinero");
    lblMontoEt.Text = EsCobro() ? "Monto recibido (opcional)" : "Monto a pagar (opcional)"; lblBtnReg.Text = EsCobro() ? "Registrar cobro" : "Registrar pago"; btnMov.Text = "Movimientos";
    object fo; txtFolio.Text = folios.TryGetValue((string)t["clave"], out fo) ? (string)t["prefijo"] + "-" + fo : "";
    lblPie.Text = "Elaboró: " + (quienSoy == "" ? "—" : quienSoy) + "      Empresa: " + nombreEmpresa + "      Operación " + (int)t["modOp"] + " · folio " + (string)t["prefijo"] + "-n";
    PintarEnt(); PintarDocs(); Acomodar();
}
void MarcarTodos() { foreach (var d in DocsDeEnt().Where(Compat)) seleccion[L(d["id"])] = Sc(d); PintarDocs(); }
void MarcarVencidos() { seleccion.Clear(); parcSel.Clear(); foreach (var d in DocsDeEnt().Where(Compat)) { int dv = DiasVencido(d); if (dv > 0 && dv != int.MinValue) seleccion[L(d["id"])] = Sc(d); } PintarDocs(); if (seleccion.Count == 0) Aviso("No hay documentos vencidos."); }
void Repartir()
{
    if (entSel == null) throw new Exception("Elige primero la persona.");
    double m = (double)nudMonto.Value; if (m <= 0) { nudMonto.Focus(); throw new Exception("Captura el monto que se va a repartir."); }
    seleccion.Clear(); parcSel.Clear(); double resto = Math.Round(m, 2);
    foreach (var d in DocsDeEnt().Where(Compat).OrderBy(x => S(x["vence"]) != "" ? S(x["vence"]) : S(x["fecha"])).ThenBy(x => L(x["id"]))) { if (resto <= 0) break; double ap = Math.Min(Sc(d), resto); if (ap <= 0) continue; seleccion[L(d["id"])] = Math.Round(ap, 2); resto = Math.Round(resto - ap, 2); }
    PintarDocs();
}

IEnumerable<Dictionary<string, object>> FuenteEnt() => cat(EsCobro() ? "clientes" : "proveedores").OrderByDescending(x => ES.ContainsKey(I(x["id"])) ? ES[I(x["id"])][0] : 0).ThenBy(x => S(x["nombre"]));
void Desplegar()
{
    var q = txtEnt.Text.ToLowerInvariant().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
    var vis = FuenteEnt().Where(x => { var h = (S(x["nombre"]) + " " + S(x["rfc"]) + " " + S(x["id"])).ToLowerInvariant(); return q.All(w => h.Contains(w)); }).Take(60).ToList();
    lstEnt.Items.Clear();
    foreach (var x in vis) lstEnt.Items.Add(new Opcion { Id = I(x["id"]), Nombre = S(x["nombre"]), Extra = (S(x["rfc"]) == "" ? "sin RFC" : S(x["rfc"])) + "   ·   " + (ES.ContainsKey(I(x["id"])) ? "debe " + ES[I(x["id"])][0].ToString("N2") + " en " + ES[I(x["id"])][2] + " documento(s)" : "sin saldo") });
    var cj = Caja(txtEnt); lstEnt.Location = frm.PointToClient(cj.Parent.PointToScreen(new Point(cj.Left, cj.Bottom + 1))); lstEnt.Height = Math.Min(280, lstEnt.Items.Count * lstEnt.ItemHeight + 4);
    lstEnt.Visible = lstEnt.Items.Count > 0; if (lstEnt.Visible) { lstEnt.BringToFront(); lstEnt.SelectedIndex = 0; }
}
Action ElegirDeLista = () => { var o = lstEnt.SelectedItem as Opcion; if (o == null) return; ElegirEnt(FuenteEnt().First(e => I(e["id"]) == o.Id)); };
txtEnt.TextChanged += (_, __) => Seguro(() => { if (txtEnt.Focused) { if (entSel != null) { entSel = null; seleccion.Clear(); parcSel.Clear(); PintarEnt(); PintarDocs(); } Desplegar(); } });
txtEnt.Enter += (_, __) => Seguro(() => { txtEnt.SelectAll(); if (entSel == null) Desplegar(); });
txtEnt.KeyDown += (_, ev) => { if (ev.KeyCode == Keys.Down && lstEnt.Visible) { lstEnt.Focus(); ev.Handled = true; } if (ev.KeyCode == Keys.Enter) { Seguro(ElegirDeLista); ev.SuppressKeyPress = true; } if (ev.KeyCode == Keys.Escape && lstEnt.Visible) { lstEnt.Visible = false; ev.SuppressKeyPress = true; ev.Handled = true; } };
lstEnt.Click += (_, __) => Seguro(ElegirDeLista);
lstEnt.KeyDown += (_, ev) => { if (ev.KeyCode == Keys.Enter) { Seguro(ElegirDeLista); ev.SuppressKeyPress = true; } };
txtEnt.Leave += (_, __) => { if (!lstEnt.Focused) lstEnt.Visible = false; };
nudMonto.ValueChanged += (_, __) => Totales();
nudMonto.KeyDown += (_, ev) => { if (ev.KeyCode == Keys.Enter) { Seguro(Repartir); ev.SuppressKeyPress = true; } };
btnDist.Click += (_, __) => Seguro(Repartir);
dtFecha.ValueChanged += (_, __) => Seguro(() => { ES = Stats(); PintarEnt(); PintarDocs(); });
cmbCta.SelectedIndexChanged += (_, __) => Seguro(() => { if (cmbCta.Focused || mcPrev != MCta()) CambioCuenta(); });
nudTc.ValueChanged += (_, __) => Seguro(() => { if (!ajustandoTc) PintarDocs(); });
pEdad.Resize += (_, __) => pEdad.Invalidate();

grid.CellContentClick += (_, ev) => grid.BeginInvoke(new Action(() => Seguro(() =>
{
    if (pintando || ev.RowIndex < 0 || grid.Columns[ev.ColumnIndex].Name != "Marca") return;
    grid.EndEdit(); long id = (long)grid.Rows[ev.RowIndex].Tag; var d = DocsDeEnt().First(x => L(x["id"]) == id); bool on = Convert.ToBoolean(grid.Rows[ev.RowIndex].Cells["Marca"].EditedFormattedValue);
    if (on && !Compat(d)) { PintarDocs(); Aviso("Ese documento está en " + S(d["simbolo"]) + " y la cuenta en " + SimboloDe(MCta()) + ": no se puede aplicar aquí.", true); return; }
    if (on && !(Sc(d) > 0)) Aviso("Captura primero el tipo de cambio.", true);
    if (on) seleccion[id] = Sc(d); else { seleccion.Remove(id); parcSel.Remove(id); }
    PintarDocs();
})));
grid.CellEndEdit += (_, ev) => grid.BeginInvoke(new Action(() => Seguro(() =>
{
    string col = ev.ColumnIndex < 0 ? "" : grid.Columns[ev.ColumnIndex].Name;
    if (pintando || ev.RowIndex < 0 || (col != "Aplicar" && col != "Parc")) return;
    long id = (long)grid.Rows[ev.RowIndex].Tag; var d = DocsDeEnt().First(x => L(x["id"]) == id);
    if (col == "Parc")
    {
        int pn; int.TryParse(Convert.ToString(grid.Rows[ev.RowIndex].Cells["Parc"].Value), out pn);
        if (pn < 1 || pn > I(d["nParc"])) parcSel.Remove(id);
        else { parcSel[id] = pn; var p = ParcialidadesDe(id, D(d["saldo"])).FirstOrDefault(x => I(x["n"]) == pn); if (p != null && seleccion.ContainsKey(id)) seleccion[id] = Math.Min(Sc(d), A2(d, D(p["saldo"]))); }
        PintarDocs(); return;
    }
    double n; double.TryParse(Convert.ToString(grid.Rows[ev.RowIndex].Cells["Aplicar"].Value, CultureInfo.CurrentCulture), NumberStyles.Any, CultureInfo.CurrentCulture, out n); double tope = Sc(d); if (n > tope) { n = tope; Aviso("El importe se ajustó al saldo del documento."); } n = Math.Max(0, n);
    if (n > 0) seleccion[id] = n; else { seleccion.Remove(id); parcSel.Remove(id); } PintarDocs();
})));
grid.DataError += (_, ev) => ev.ThrowException = false;
grid.CellDoubleClick += (_, ev) => Seguro(() => { if (ev.RowIndex >= 0 && grid.Columns[ev.ColumnIndex].Name != "Marca" && grid.Columns[ev.ColumnIndex].Name != "Aplicar" && grid.Columns[ev.ColumnIndex].Name != "Parc") AbrirDetalle((long)grid.Rows[ev.RowIndex].Tag); });
void DetalleSel() { if (grid.CurrentRow == null || grid.CurrentRow.Tag == null) { Aviso("Elige un documento de la lista (clic en su renglón).", true); return; } AbrirDetalle((long)grid.CurrentRow.Tag); }

void AbrirDetalle(long id)
{
    var d = DocsDeEnt().FirstOrDefault(x => L(x["id"]) == id); if (d == null) return; var r = DetalleDoc(id); string sy = S(r["simbolo"]); bool ext = I(r["moneda"]) != 3;
    var h = new Form { Text = "Detalle · " + S(d["tipo"]) + " " + S(d["folio"]), Size = new Size(780, 540), StartPosition = FormStartPosition.CenterParent, BackColor = Color.White, Font = F_BASE, MinimumSize = new Size(640, 420) };
    var lt = new Label { Dock = DockStyle.Top, Height = 56, Padding = new Padding(12, 8, 12, 0), ForeColor = C_TXT, Font = F_B, Text = "Total " + D(r["total"]).ToString("N2") + " " + sy + "     Pagado " + D(r["pagado"]).ToString("N2") + "     Saldo " + D(r["saldo"]).ToString("N2") + (ext ? "\nDocumento en " + sy + " · tipo de cambio del documento " + D(r["tcDoc"]).ToString("0.####") + " · saldo ≈ " + D(d["saldoMx"]).ToString("N2") + " MXN" : "") };
    Func<string[][], DockStyle, int, DataGridView> Rejilla = (cols, dock, alto) =>
    {
        var g = new DataGridView { Dock = dock, Height = alto, AllowUserToAddRows = false, AllowUserToDeleteRows = false, ReadOnly = true, RowHeadersVisible = false, SelectionMode = DataGridViewSelectionMode.FullRowSelect, BackgroundColor = Color.White, BorderStyle = BorderStyle.None, EnableHeadersVisualStyles = false, CellBorderStyle = DataGridViewCellBorderStyle.SingleHorizontal, GridColor = Color.FromArgb(230, 235, 242), AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill, RowTemplate = { Height = 26 } };
        g.ColumnHeadersDefaultCellStyle.BackColor = C_HEAD; g.ColumnHeadersDefaultCellStyle.ForeColor = C_TXT; g.ColumnHeadersDefaultCellStyle.Font = F_B; g.ColumnHeadersDefaultCellStyle.SelectionBackColor = C_HEAD; g.ColumnHeadersDefaultCellStyle.SelectionForeColor = C_TXT; g.DefaultCellStyle.SelectionBackColor = C_SEL; g.DefaultCellStyle.SelectionForeColor = C_TXT;
        foreach (var c in cols) g.Columns.Add(new DataGridViewTextBoxColumn { Name = c[0], HeaderText = c[1], FillWeight = float.Parse(c[2]) });
        return g;
    };
    var gAp = Rejilla(new[] { new[] { "Fecha", "FECHA", "12" }, new[] { "Tipo", "TIPO", "14" }, new[] { "Folio", "FOLIO", "28" }, new[] { "Parc", "PARC.", "8" }, new[] { "TC", "TIPO DE CAMBIO", "14" }, new[] { "Monto", "MONTO (" + sy + ")", "16" } }, DockStyle.Fill, 100);
    foreach (var a in (List<Dictionary<string, object>>)r["aplic"])
    {
        string tp = S(a["tipo"]) == "cobro" ? "Cobro" : S(a["tipo"]) == "pago" ? "Pago" : S(a["tipo"]) == "nota" ? "Nota de crédito" : "Otro";
        int fila = gAp.Rows.Add(S(a["fecha"]) == "" ? "" : Fe(S(a["fecha"])).Value.ToString("dd/MM/yyyy"), tp, S(a["folio"]), I(a["parc"]).ToString(), ext && D(a["tc"]) > 0 && S(a["tipo"]) != "nota" ? D(a["tc"]).ToString("0.####") : "", D(a["monto"]).ToString("N2"));
        gAp.Rows[fila].Cells["Tipo"].Style.ForeColor = S(a["tipo"]) == "nota" ? C_AMBAR : C_VERDE;
    }
    if (gAp.Rows.Count == 0) gAp.Rows.Add("", "Sin cobros, pagos ni notas de crédito aplicados todavía", "", "", "", "");
    var gPa = Rejilla(new[] { new[] { "N", "N.º", "8" }, new[] { "Vence", "VENCE", "18" }, new[] { "Importe", "IMPORTE", "18" }, new[] { "Pagado", "PAGADO", "18" }, new[] { "Saldo", "SALDO", "18" } }, DockStyle.Top, 30 + 26 * Math.Max(1, ((List<Dictionary<string, object>>)r["parc"]).Count));
    foreach (var p in (List<Dictionary<string, object>>)r["parc"])
    {
        int fila = gPa.Rows.Add(I(p["n"]).ToString(), S(p["vence"]) == "" ? "—" : Fe(S(p["vence"])).Value.ToString("dd/MM/yyyy"), D(p["importe"]).ToString("N2"), D(p["pagado"]).ToString("N2"), D(p["saldo"]) <= 0.004 ? "liquidada" : D(p["saldo"]).ToString("N2"));
        gPa.Rows[fila].Cells["Saldo"].Style.ForeColor = D(p["saldo"]) <= 0.004 ? C_VERDE : S(p["vence"]) != "" && string.CompareOrdinal(S(p["vence"]), Hoy()) < 0 ? C_ROJO : C_TXT;
    }
    foreach (var gx in new[] { gPa, gAp }) foreach (DataGridViewColumn c in gx.Columns) if (c.Name != "Tipo" && c.Name != "Folio" && c.Name != "Fecha") { c.DefaultCellStyle.Alignment = DataGridViewContentAlignment.MiddleRight; c.HeaderCell.Style.Alignment = DataGridViewContentAlignment.MiddleRight; }
    var lp = new Label { Text = "Parcialidades", Dock = DockStyle.Top, Height = 24, Padding = new Padding(12, 4, 0, 0), ForeColor = C_MUTED, Font = F_B }; var la = new Label { Text = "Aplicaciones: cobros, pagos y notas de crédito", Dock = DockStyle.Top, Height = 28, Padding = new Padding(12, 10, 0, 0), ForeColor = C_MUTED, Font = F_B };
    h.Controls.Add(gAp); h.Controls.Add(la); h.Controls.Add(gPa); h.Controls.Add(lp); h.Controls.Add(lt); h.Show(frm);
}

btnMov.Click += (_, __) => Seguro(() =>
{
    if (entSel == null) return; var mv = MovimientosDe(L(entSel["id"]), (string)TipoActual()["clave"]);
    var h = new Form { Text = (EsCobro() ? "Últimos cobros · " : "Últimos pagos · ") + S(entSel["nombre"]), Size = new Size(640, 330), StartPosition = FormStartPosition.CenterParent, BackColor = Color.White, Font = F_BASE, MaximizeBox = false };
    var l = new ListBox { Dock = DockStyle.Fill, BorderStyle = BorderStyle.None, DrawMode = DrawMode.OwnerDrawFixed, ItemHeight = 42, IntegralHeight = false };
    l.DrawItem += (s, ev) => dibujaLista(l, ev);
    foreach (var m in mv) l.Items.Add(new Opcion { Id = I(m["id"]), Nombre = S(m["folio"]) + "   ·   " + D(m["monto"]).ToString("N2"), Extra = Fe(S(m["fecha"])).Value.ToString("dd/MM/yyyy") + "   ·   " + S(m["cuenta"]) + "   ·   " + I(m["docs"]) + " documento(s)" });
    if (mv.Count == 0) l.Items.Add(new Opcion { Nombre = "Sin movimientos registrados", Extra = "" });
    h.Controls.Add(l); h.Show(frm);
});

void Limpiar() { entSel = null; txtEnt.Text = ""; seleccion.Clear(); parcSel.Clear(); txtRef.Text = ""; nudMonto.Value = 0; PintarEnt(); PintarDocs(); txtEnt.Focus(); }
void Registrar(bool otro)
{
    if (guardando) return; var t = TipoActual();
    if (entSel == null) { txtEnt.Focus(); throw new Exception("Elige " + (EsCobro() ? "el cliente" : "el proveedor") + " de la lista (escribe y selecciona)."); }
    if (cmbCta.SelectedItem == null) throw new Exception("Elige la cuenta.");
    var aps = seleccion.Where(k => k.Value > 0).Select(k => (object)new Dictionary<string, object> { ["doc"] = k.Key, ["monto"] = k.Value, ["parcialidad"] = parcSel.ContainsKey(k.Key) ? parcSel[k.Key] : 0 }).ToList();
    if (aps.Count == 0) throw new Exception("Marca al menos un documento y captura cuánto aplicar.");
    int mcR = MCta(), fxR = MonedaFx(); var dsR = DocsDeEnt(); var fxs = new HashSet<int>(); foreach (var k in seleccion.Keys) { var dd = dsR.FirstOrDefault(x => L(x["id"]) == k); if (dd != null && I(dd["moneda"]) != 3 && I(dd["moneda"]) != mcR) fxs.Add(I(dd["moneda"])); }
    if (fxs.Count > 1) throw new Exception("Hay documentos en monedas extranjeras distintas: regístralos por separado.");
    if (fxR != 0 && !(Tc() > 0)) throw new Exception("Captura el tipo de cambio.");
    var spec = new Dictionary<string, object> { ["tipo"] = (string)t["clave"], ["entidad"] = I(entSel["id"]), ["cuenta"] = ((Opcion)cmbCta.SelectedItem).Id, ["forma"] = ((Opcion)cmbForma.SelectedItem)?.Id ?? 0, ["fecha"] = Hoy(), ["referencia"] = txtRef.Text, ["tc"] = fxR != 0 ? Tc() : 0.0, ["aplicaciones"] = aps };
    guardando = true; Cursor.Current = Cursors.WaitCursor; string resumen;
    try { resumen = Aplicar(spec); }
    finally { guardando = false; Cursor.Current = Cursors.Default; RefrescarDocs(); }
    try { ctx.erp.RefreshGrid(); } catch { }
    if (otro) { var titulo = resumen.Split('\n')[0]; Limpiar(); Aviso(titulo); }
    else { MessageBox.Show(resumen, "Cobro o pago registrado", MessageBoxButtons.OK, MessageBoxIcon.Information); frm.Close(); }
}
void RefrescarDocs()
{
    try { catalogo["docsC"] = DocsConSaldo("C"); catalogo["docsP"] = DocsConSaldo("P"); } catch { }
    seleccion.Clear(); parcSel.Clear(); ES = Stats(); PintarEnt(); PintarDocs();
}
frm.KeyDown += (_, ev) =>
{
    if (ev.KeyCode == Keys.F5) { Seguro(() => Registrar(false)); ev.Handled = true; }
    else if (ev.KeyCode == Keys.F6) { Seguro(() => Registrar(true)); ev.Handled = true; }
    else if (ev.KeyCode == Keys.F2) { txtEnt.Focus(); ev.Handled = true; }
    else if (ev.KeyCode == Keys.Escape && !lstEnt.Visible) { frm.Close(); ev.Handled = true; }
};

mcPrev = MCta(); mcPrevDocs = mcPrev;
CambiarTipo(0);
Acomodar();
string capturaPrueba = Environment.GetEnvironmentVariable("BROSLMV_PAGO_SHOT");
if (!string.IsNullOrEmpty(capturaPrueba))
{
    int tipoShot = int.TryParse(Environment.GetEnvironmentVariable("BROSLMV_PAGO_SHOT_TIPO"), out var ts) ? ts : 0; CambiarTipo(tipoShot);
    var mas = FuenteEnt().FirstOrDefault(); if (mas != null) { ElegirEnt(mas); nudMonto.Value = 500000; Repartir(); }
    frm.Show(); Application.DoEvents(); frm.PerformLayout(); Acomodar(); Application.DoEvents();
    using (var bmp = new Bitmap(frm.Width, frm.Height)) { frm.DrawToBitmap(bmp, new Rectangle(0, 0, frm.Width, frm.Height)); bmp.Save(capturaPrueba, System.Drawing.Imaging.ImageFormat.Png); }
    frm.Dispose(); return "CAPTURA";
}
frm.Show();
return "Ventana de cobros y pagos abierta.";
