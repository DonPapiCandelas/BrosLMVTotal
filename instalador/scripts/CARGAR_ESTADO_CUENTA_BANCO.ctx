var cboHoja = new ComboBox { Left = 840, Top = 26, Width = 270, DropDownStyle = ComboBoxStyle.DropDownList };
var lblBanco = new Label { Text = "Banco:", Left = 12, Top = 66, AutoSize = true };
var cboBanco = new ComboBox { Left = 62, Top = 62, Width = 170, DropDownStyle = ComboBoxStyle.DropDownList };
var lblCuenta = new Label { Text = "Cuenta donde se cargan:", Left = 250, Top = 66, AutoSize = true };
var cboCuenta = new ComboBox { Left = 396, Top = 62, Width = 440, DropDownStyle = ComboBoxStyle.DropDownList };
