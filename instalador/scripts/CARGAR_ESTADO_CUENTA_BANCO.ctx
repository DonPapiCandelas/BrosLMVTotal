AsegurarTablas();
var cuentas = LeerCuentas();
if (cuentas.Count == 0) { ctx.Msg("No hay cuentas de banco dadas de alta. Crea la cuenta en Tesorería › Cuentas Bancarias y vuelve a intentar.", "Cargar estado de cuenta"); return "Sin cuentas."; }

long cuentaSeleccionada = 0;
try { var sel = ctx.GetSelectedIds(); if (sel != null && sel.Count > 0 && cuentas.Any(c => c.Id == sel[0])) cuentaSeleccionada = sel[0]; } catch { }

List<HojaArchivo> hojas = null; HojaArchivo hoja = null; string rutaArchivo = "";
BancoDeteccion deteccion = null; BancoMapa mapaActual = null; BancoResultado res = null;
var duplicados = new HashSet<BancoMov>();
var cuentaDeGrupo = new Dictionary<string, CuentaBanco>();   // cuenta que dice el archivo ("" = sin dato) -> cuenta registrada
bool cargando = false;

var azul = Color.FromArgb(0x1F, 0x2A, 0x3C);
