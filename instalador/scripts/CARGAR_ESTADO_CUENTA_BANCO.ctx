var pie = new Panel { Dock = DockStyle.Bottom, Height = 52, BackColor = Color.FromArgb(0xF0, 0xF2, 0xF5) };
var cuerpo = new Panel { Dock = DockStyle.Fill, Padding = new Padding(12) };
frm.Controls.Add(cuerpo); frm.Controls.Add(pie); frm.Controls.Add(cab);

// 1. Archivo
