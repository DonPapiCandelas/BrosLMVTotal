var btnReleer = new Button { Text = "Volver a leer", Left = 240, Top = 88, Width = 120, Height = 27 };
g2.Controls.Add(chkNegCargo); g2.Controls.Add(btnReleer);

// 3. Resumen y vista previa
var g3 = new GroupBox { Text = "3. Revisa antes de cargar", Dock = DockStyle.Fill };
var lblRes = new Label { Dock = DockStyle.Top, Height = 100, Padding = new Padding(8, 4, 8, 0) };
var dgGrupos = new DataGridView { Dock = DockStyle.Top, Height = 0, AllowUserToAddRows = false, AllowUserToDeleteRows = false, RowHeadersVisible = false, BackgroundColor = Color.White, AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill, Visible = false };
var dg = new DataGridView { Dock = DockStyle.Fill, ReadOnly = true, AllowUserToAddRows = false, RowHeadersVisible = false, BackgroundColor = Color.White, SelectionMode = DataGridViewSelectionMode.FullRowSelect, AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.None };
g3.Controls.Add(dg); g3.Controls.Add(dgGrupos); g3.Controls.Add(lblRes);
cuerpo.Controls.Add(g3); cuerpo.Controls.Add(new Panel { Dock = DockStyle.Top, Height = 8 }); cuerpo.Controls.Add(g2); cuerpo.Controls.Add(new Panel { Dock = DockStyle.Top, Height = 8 }); cuerpo.Controls.Add(g1);

dg.Columns.Add("F", "Fecha"); dg.Columns.Add("D", "Descripción"); dg.Columns.Add("R", "Referencia"); dg.Columns.Add("C", "Cargo"); dg.Columns.Add("A", "Abono"); dg.Columns.Add("S", "Saldo"); dg.Columns.Add("T", "Tipo"); dg.Columns.Add("E", "Estado");
dg.Columns[0].Width = 90; dg.Columns[1].Width = 360; dg.Columns[2].Width = 150; dg.Columns[3].Width = 100; dg.Columns[4].Width = 100; dg.Columns[5].Width = 110; dg.Columns[6].Width = 130; dg.Columns[7].Width = 90;
foreach (int k in new[] { 3, 4, 5 }) dg.Columns[k].DefaultCellStyle.Alignment = DataGridViewContentAlignment.MiddleRight;

// pie
var chkPerfil = new CheckBox { Text = "Recordar este formato de archivo", Left = 14, Top = 16, AutoSize = true, Checked = true };
var btnDeshacer = new Button { Text = "Deshacer mi última carga", Left = 260, Top = 12, Width = 170, Height = 28 };
var btnImportar = new Button { Text = "Cargar movimientos", Width = 170, Height = 30, Enabled = false, BackColor = Color.FromArgb(0x1F, 0x6F, 0x4A), ForeColor = Color.White, FlatStyle = FlatStyle.Flat, Anchor = AnchorStyles.Top | AnchorStyles.Right };
var btnCerrar = new Button { Text = "Cerrar", Width = 90, Height = 30, Anchor = AnchorStyles.Top | AnchorStyles.Right };
btnImportar.Location = new Point(frm.ClientSize.Width - 290, 11); btnCerrar.Location = new Point(frm.ClientSize.Width - 110, 11);
pie.Controls.Add(chkPerfil); pie.Controls.Add(btnDeshacer); pie.Controls.Add(btnImportar); pie.Controls.Add(btnCerrar);

string NombreCol(int i)
{
    if (hoja == null || mapaActual == null) return "Columna " + (i + 1);
    string e = mapaActual.FilaEncabezado >= 0 && mapaActual.FilaEncabezado < hoja.Filas.Count && i < hoja.Filas[mapaActual.FilaEncabezado].Length ? hoja.Filas[mapaActual.FilaEncabezado][i] : "";
    return (i + 1) + " · " + (string.IsNullOrWhiteSpace(e) ? "(sin título)" : e.Trim());
}
void LlenarCombosColumnas()
{
    int ncol = hoja == null ? 0 : hoja.Filas.Take(200).Max(f => f.Length);
    foreach (var cb in cbosCol.Values)
    {
        cb.Items.Clear(); cb.Items.Add("(no viene)");
        for (int i = 0; i < ncol; i++) cb.Items.Add(NombreCol(i));
    }
}
void PonerMapaEnCombos()
{
    var m = mapaActual;
    int[] v = { m.Fecha, m.Descripcion, m.Referencia, m.Cargo, m.Abono, m.Importe, m.Saldo, m.Cuenta };
    for (int i = 0; i < etiquetas.Length; i++) { var cb = cbosCol[etiquetas[i]]; int idx = v[i] + 1; cb.SelectedIndex = idx >= 0 && idx < cb.Items.Count ? idx : 0; }
    chkNegCargo.Checked = m.ImporteNegativoEsCargo;
}
void LeerMapaDeCombos()
{
    var m = mapaActual;
    int Col(string e) => cbosCol[e].SelectedIndex - 1;
    m.Fecha = Col("Fecha"); m.Descripcion = Col("Descripción"); m.Referencia = Col("Referencia"); m.Cargo = Col("Cargo"); m.Abono = Col("Abono");
    m.Importe = Col("Importe"); m.Saldo = Col("Saldo"); m.Cuenta = Col("Cuenta"); m.ImporteNegativoEsCargo = chkNegCargo.Checked;
}

string Dinero(decimal d) => d.ToString("#,##0.00", ci);

void Actualizar()
{
    dg.Rows.Clear(); btnImportar.Enabled = false; cuentaDeGrupo.Clear();
    if (res == null) { lblRes.Text = "Elige un archivo de movimientos o estado de cuenta (CSV, TXT o Excel)."; return; }
    var sb = new StringBuilder();
    if (res.Errores.Count > 0) { sb.AppendLine("NO SE PUEDE CARGAR:"); foreach (var e in res.Errores.Take(4)) sb.AppendLine("  • " + e); }
    else
    {
        sb.AppendLine(res.Movs.Count + " movimientos · " + (res.Desde.HasValue ? res.Desde.Value.ToString("dd/MM/yyyy") + " al " + res.Hasta.Value.ToString("dd/MM/yyyy") : "") + " · cargos $" + Dinero(res.TotalCargos) + " · abonos $" + Dinero(res.TotalAbonos));
        sb.AppendLine("Saldo inicial " + (res.SaldoInicial.HasValue ? "$" + Dinero(res.SaldoInicial.Value) : "—") + " · saldo final " + (res.SaldoFinal.HasValue ? "$" + Dinero(res.SaldoFinal.Value) : "—") +
            (res.SaldoVerificado ? (res.RupturasSaldo == 0 ? " · el saldo corrido cuadra renglón por renglón" : " · " + res.RupturasSaldo + " renglones donde el saldo NO cuadra") : " · sin saldo en el archivo para verificar"));
    }
    foreach (var a in res.Avisos.Take(3)) sb.AppendLine("Aviso: " + a);
    foreach (var n in (deteccion?.Notas ?? new List<string>()).Take(1)) sb.AppendLine(n);
    lblRes.Text = sb.ToString();
    lblRes.ForeColor = res.Errores.Count > 0 ? Color.FromArgb(0xB0, 0x2A, 0x2A) : Color.FromArgb(0x1F, 0x2A, 0x3C);

    // cuentas por grupo del archivo
    var grupos = res.Movs.Select(m => m.CuentaArchivo ?? "").Distinct().ToList();
    string banco = cboBanco.SelectedIndex > 0 ? (string)cboBanco.SelectedItem : "";
    var grupoSinCuenta = new List<string>();
    dgGrupos.Columns.Clear(); dgGrupos.Rows.Clear();
    var elegida = cboCuenta.SelectedItem as CuentaBanco;
    foreach (var g in grupos)
    {
        CuentaBanco c = null;
        if (grupos.Count == 1) c = elegida;
        else { string mo; var movsG = res.Movs.Where(m => (m.CuentaArchivo ?? "") == g).ToList(); c = SugerirCuenta(cuentas, banco, g, movsG.Where(m => m.Saldo.HasValue).Select(m => (decimal?)(m.Saldo.Value + (m.Cargo - m.Abono))).FirstOrDefault(), out mo); }
        if (c != null) cuentaDeGrupo[g] = c;
    }
    bool variasCuentas = grupos.Count > 1;
    dgGrupos.Visible = variasCuentas; dgGrupos.Height = variasCuentas ? Math.Min(40 + grupos.Count * 24, 150) : 0;
    if (variasCuentas)
    {
        dgGrupos.Columns.Add("G", "Cuenta que dice el archivo"); dgGrupos.Columns.Add("N", "Movimientos");
        var col = new DataGridViewComboBoxColumn { HeaderText = "Se carga en la cuenta", Name = "CTA", FlatStyle = FlatStyle.Flat };
        col.Items.Add("(elige)"); foreach (var c in cuentas) col.Items.Add(c.ToString());
        dgGrupos.Columns.Add(col); dgGrupos.Columns[0].ReadOnly = true; dgGrupos.Columns[1].ReadOnly = true;
        foreach (var g in grupos)
        {
            int ix = dgGrupos.Rows.Add(g.Length == 0 ? "(sin cuenta)" : g, res.Movs.Count(m => (m.CuentaArchivo ?? "") == g), cuentaDeGrupo.ContainsKey(g) ? cuentaDeGrupo[g].ToString() : "(elige)");
            dgGrupos.Rows[ix].Tag = g;
        }
    }

    // duplicados por cuenta
    duplicados = new HashSet<BancoMov>();
    foreach (var g in grupos) if (cuentaDeGrupo.ContainsKey(g))
        foreach (var m in YaExisten(cuentaDeGrupo[g].Id, res.Movs.Where(x => (x.CuentaArchivo ?? "") == g).ToList())) duplicados.Add(m);

    foreach (var m in res.Movs.OrderBy(x => x.Orden).Take(2000))
    {
        int ix = dg.Rows.Add(m.Fecha.ToString("dd/MM/yyyy"), m.Descripcion + (m.Detalle.Length > 0 ? " · " + m.Detalle : ""), m.Referencia.Length > 0 ? m.Referencia : m.ClaveRastreo,
            m.Cargo != 0 ? Dinero(m.Cargo) : "", m.Abono != 0 ? Dinero(m.Abono) : "", m.Saldo.HasValue ? Dinero(m.Saldo.Value) : "", m.Tipo, duplicados.Contains(m) ? "Ya existe" : "Nuevo");
        if (duplicados.Contains(m)) dg.Rows[ix].DefaultCellStyle.ForeColor = Color.Gray;
    }
    int nuevos = res.Movs.Count(m => !duplicados.Contains(m));
    bool faltaCuenta = grupos.Any(g => !cuentaDeGrupo.ContainsKey(g));
    if (faltaCuenta) lblRes.Text += "Falta elegir la cuenta donde se cargan los movimientos.";
    else if (nuevos == 0 && res.Errores.Count == 0) lblRes.Text += "Todos esos movimientos ya estaban cargados: no hay nada nuevo.";
    else if (duplicados.Count > 0) lblRes.Text += duplicados.Count + " ya estaban en el estado de cuenta y no se vuelven a cargar.";
    btnImportar.Enabled = res.Errores.Count == 0 && !faltaCuenta && nuevos > 0;
    btnImportar.BackColor = btnImportar.Enabled ? Color.FromArgb(0x1F, 0x6F, 0x4A) : Color.FromArgb(0xB8, 0xBE, 0xC8);
    btnImportar.Text = nuevos > 0 ? "Cargar " + nuevos + " movimientos" : "Cargar movimientos";
}

void Leer(bool reabrirMapa)
{
    if (hoja == null) return;
    cargando = true;
    try
    {
        if (reabrirMapa)
        {
            deteccion = BancoArchivo.Detectar(hoja.Filas, System.IO.Path.GetFileName(rutaArchivo));
            mapaActual = deteccion.Mapa;
            var perfil = BuscarPerfil(mapaActual.Firma);
            if (perfil != null) { var r = BancoArchivo.Reubicar(hoja.Filas, perfil); if (r != null) { mapaActual = r; deteccion.Notas.Insert(0, "Usé el formato que ya habías guardado para este tipo de archivo."); } }
            LlenarCombosColumnas(); PonerMapaEnCombos();
            int ib = deteccion.Banco.Length > 0 ? cboBanco.Items.IndexOf(deteccion.Banco) : 0; cboBanco.SelectedIndex = ib >= 0 ? ib : 0; bancoSeguro = deteccion.Confianza >= 2 && ib > 0;
        }
        else LeerMapaDeCombos();
        res = mapaActual.Completo ? BancoArchivo.Interpretar(hoja.Filas, mapaActual) : new BancoResultado { Errores = { "No pude saber qué columnas son la fecha y los importes. Elígelas arriba y pulsa «Volver a leer»." } };

        // cuenta sugerida si la persona no eligió una
        if (cboCuenta.SelectedIndex <= 0)
        {
            string motivo; string banco = cboBanco.SelectedIndex > 0 ? (string)cboBanco.SelectedItem : "";
            var s = SugerirCuenta(cuentas, banco, deteccion?.CuentasPreambulo.FirstOrDefault() ?? res.Cuentas.FirstOrDefault(), res.SaldoInicial, out motivo);
            if (s != null) { cboCuenta.SelectedItem = s; lblSug.Text = "Cuenta sugerida " + motivo + "."; }
            else if (motivo.Length > 0) lblSug.Text = motivo;
            else lblSug.Text = res.Cuentas.Count() > 1 ? "El archivo trae varias cuentas: asigna cada una abajo." : "No pude saber de qué cuenta es este archivo. Elígela arriba.";
        }
        Actualizar();
    }
    finally { cargando = false; }
}

void AbrirArchivo(string ruta)
{
    hojas = LeerArchivo(ruta); rutaArchivo = ruta; txtRuta.Text = ruta;
    if (hojas.Count == 0) throw new InvalidOperationException("El archivo no trae datos.");
    cargando = true; cboHoja.Items.Clear(); foreach (var h in hojas) cboHoja.Items.Add(h); cboHoja.SelectedIndex = 0; cargando = false;
    cboHoja.Enabled = hojas.Count > 1;
    hoja = hojas[0];
    if (cuentaSeleccionada == 0) cboCuenta.SelectedIndex = 0;
    Leer(true);
}

void Seguro(Action a) { try { a(); } catch (Exception ex) { cargando = false; MessageBox.Show(ex.Message, "Cargar estado de cuenta", MessageBoxButtons.OK, MessageBoxIcon.Warning); } }

btnBuscar.Click += (_, __) => Seguro(() =>
{
    using (var dlg = new OpenFileDialog { Title = "Estado de cuenta o movimientos del banco", Filter = "Movimientos (*.csv;*.txt;*.xlsx;*.xlsm;*.xls)|*.csv;*.txt;*.xlsx;*.xlsm;*.xls|Todos|*.*" })
        if (dlg.ShowDialog(frm) == DialogResult.OK) AbrirArchivo(dlg.FileName);
});
cboHoja.SelectedIndexChanged += (_, __) => { if (cargando || !(cboHoja.SelectedItem is HojaArchivo h)) return; hoja = h; Seguro(() => Leer(true)); };
cboBanco.SelectedIndexChanged += (_, __) => { if (!cargando && res != null) Seguro(() => { bancoSeguro = cboBanco.SelectedIndex > 0; if (cboCuenta.SelectedIndex <= 0) Leer(false); else Actualizar(); }); };
string CuentaDeclarada() => deteccion?.CuentasPreambulo.FirstOrDefault() ?? res?.Cuentas.FirstOrDefault() ?? "";
cboCuenta.SelectedIndexChanged += (_, __) => { if (!cargando && res != null) Seguro(() => { string decl = CuentaDeclarada();
    if (decl.Length > 0 && cboCuenta.SelectedItem is CuentaBanco cc && !BancoArchivo.MismaCuenta(decl, cc.Numero) && !BancoArchivo.MismaCuenta(decl, cc.Clabe)) lblSug.Text = "Cuidado: el archivo dice que es de la cuenta " + decl + " y la cuenta elegida es " + (cc.Numero.Length > 0 ? cc.Numero : "otra") + ".";
    else lblSug.Text = cboCuenta.SelectedItem is CuentaBanco c && res.SaldoInicial.HasValue && c.UltimoSaldo.HasValue && Math.Abs(c.UltimoSaldo.Value - res.SaldoInicial.Value) > 0.005m
        ? "Aviso: el archivo abre con $" + Dinero(res.SaldoInicial.Value) + " y el último saldo cargado de esta cuenta es $" + Dinero(c.UltimoSaldo.Value) + " (" + (c.UltimaFecha.HasValue ? c.UltimaFecha.Value.ToString("dd/MM/yyyy") : "") + "). Puede faltar un periodo." : ""; Actualizar(); }); };
btnReleer.Click += (_, __) => Seguro(() => Leer(false));
dgGrupos.CellValueChanged += (_, e) => { if (cargando || e.RowIndex < 0 || e.ColumnIndex != 2) return; string g = (string)dgGrupos.Rows[e.RowIndex].Tag; string v = S(dgGrupos.Rows[e.RowIndex].Cells[2].Value); var c = cuentas.FirstOrDefault(x => x.ToString() == v); if (c != null) cuentaDeGrupo[g] = c; else cuentaDeGrupo.Remove(g); };
dgGrupos.CurrentCellDirtyStateChanged += (_, __) => { if (dgGrupos.IsCurrentCellDirty) dgGrupos.CommitEdit(DataGridViewDataErrorContexts.Commit); };
dgGrupos.CellEndEdit += (_, __) => { };

btnImportar.Click += (_, __) => Seguro(() =>
{
    if (res == null || res.Errores.Count > 0) return;
    var porCuenta = res.Movs.Where(m => !duplicados.Contains(m)).GroupBy(m => m.CuentaArchivo ?? "").ToList();
    if (porCuenta.Any(g => !cuentaDeGrupo.ContainsKey(g.Key))) { MessageBox.Show("Elige la cuenta de cada grupo antes de cargar.", "Cargar estado de cuenta"); return; }
    var resumen = string.Join("\n", porCuenta.Select(g => "• " + cuentaDeGrupo[g.Key].Nombre + ": " + g.Count() + " movimientos"));
    if (MessageBox.Show("Se van a cargar al estado de cuenta de Comercial:\n\n" + resumen + "\n\n¿Continuar?", "Cargar estado de cuenta", MessageBoxButtons.YesNo, MessageBoxIcon.Question) != DialogResult.Yes) return;
    Cursor.Current = Cursors.WaitCursor;
    int total = 0;
    try { foreach (var g in porCuenta) total += (int)Importar(cuentaDeGrupo[g.Key].Id, g.ToList(), System.IO.Path.GetFileName(rutaArchivo))["n"]; }
    finally { Cursor.Current = Cursors.Default; }
    if (chkPerfil.Checked && mapaActual != null) { try { LeerMapaDeCombos(); GuardarPerfil(mapaActual, cboBanco.SelectedIndex > 0 ? (string)cboBanco.SelectedItem : ""); } catch { } }
    try { ctx.erp.RefreshGrid(); } catch { }
    cuentas = LeerCuentas();
    MessageBox.Show("Listo: se cargaron " + total + " movimientos al estado de cuenta.", "Cargar estado de cuenta", MessageBoxButtons.OK, MessageBoxIcon.Information);
    Leer(false);
});
btnDeshacer.Click += (_, __) => Seguro(() =>
{
    if (MessageBox.Show("¿Deshacer tu última carga de estado de cuenta?", "Cargar estado de cuenta", MessageBoxButtons.YesNo, MessageBoxIcon.Question) != DialogResult.Yes) return;
    string msg = DeshacerUltima(); try { ctx.erp.RefreshGrid(); } catch { } cuentas = LeerCuentas();
    MessageBox.Show(msg, "Cargar estado de cuenta", MessageBoxButtons.OK, MessageBoxIcon.Information); if (res != null) Leer(false);
});
btnCerrar.Click += (_, __) => frm.Close();
frm.KeyDown += (_, ev) => { if (ev.KeyCode == Keys.Escape) { frm.Close(); ev.Handled = true; } };

if (cuentaSeleccionada != 0) cboCuenta.SelectedItem = cuentas.First(c => c.Id == cuentaSeleccionada);
Actualizar();

string archivoPrueba = Environment.GetEnvironmentVariable("BROSLMV_BANCO_ARCHIVO");
if (!string.IsNullOrEmpty(archivoPrueba)) AbrirArchivo(archivoPrueba);
string pruebaCuenta = Environment.GetEnvironmentVariable("BROSLMV_BANCO_CUENTA");
if (!string.IsNullOrEmpty(pruebaCuenta) && res != null)
{
    cboCuenta.SelectedItem = cuentas.First(c => c.Id.ToString() == pruebaCuenta);
    var salida = new StringBuilder("antes: nuevos=" + res.Movs.Count(m => !duplicados.Contains(m)) + " dup=" + duplicados.Count + "; ");
    if (Environment.GetEnvironmentVariable("BROSLMV_BANCO_IMPORTAR") == "1")
    {
        int n = (int)Importar(cuentas.First(c => c.Id.ToString() == pruebaCuenta).Id, res.Movs.Where(m => !duplicados.Contains(m)).ToList(), "prueba.csv")["n"];
        Actualizar(); salida.Append("importados=" + n + "; despues: dup=" + duplicados.Count + " btn=" + btnImportar.Enabled + "; ");
    }
    if (Environment.GetEnvironmentVariable("BROSLMV_BANCO_DESHACER") == "1") salida.Append(DeshacerUltima());
    System.IO.File.WriteAllText(Environment.GetEnvironmentVariable("BROSLMV_BANCO_SALIDA") ?? @"C:\tmp\bancos\salida.txt", salida.ToString());
}
string capturaPrueba = Environment.GetEnvironmentVariable("BROSLMV_BANCO_SHOT");
if (!string.IsNullOrEmpty(capturaPrueba))
{
    frm.Show(); Application.DoEvents(); frm.PerformLayout(); Application.DoEvents();
    using (var bmp = new Bitmap(frm.Width, frm.Height)) { frm.DrawToBitmap(bmp, new Rectangle(0, 0, frm.Width, frm.Height)); bmp.Save(capturaPrueba, System.Drawing.Imaging.ImageFormat.Png); }
    var resumenPrueba = res == null ? "sin archivo" : res.Movs.Count + " movs; errores=" + res.Errores.Count + "; dup=" + duplicados.Count + "; btnImportar=" + btnImportar.Enabled + "; cuenta=" + (cboCuenta.SelectedItem ?? "") + "; " + lblSug.Text;
    frm.Dispose(); return "CAPTURA " + resumenPrueba;
}
frm.Show();
return "Ventana de carga de estado de cuenta abierta.";
