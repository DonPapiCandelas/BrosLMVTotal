<Project Sdk="Microsoft.NET.Sdk">

  <!-- Contraparte de descargas-instalador. Mismo framework (net8.0-windows, self-contained en
       publicacion). -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>BrosLMV-Descargas-Desinstalador</AssemblyName>
    <RootNamespace>BrosLMV.Descargas.Desinstalador</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>CA1416</NoWarn>
    <Version>2.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\logo_blanco.png" />
    <Resource Include="assets\app_icon.png" />
  </ItemGroup>

</Project>
