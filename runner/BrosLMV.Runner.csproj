<Project Sdk="Microsoft.NET.Sdk">

  <!--
    T3.3: Programador headless. Ejecuta scripts SQL/C# (job-safe) sin abrir Comercial,
    vía tarea programada de Windows. Reusa el mismo ScriptContext/ScriptRunner que usa
    BrosLMVClsMain.dll dentro de Comercial (por eso enlaza los mismos .cs en vez de
    reescribir el motor); lo único distinto es cómo se obtiene XEngineLib: aquí se crea un
    XEngine standalone (ver Program.cs) en vez de recibirlo ya vivo de Comercial.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>BrosLMV.Runner</AssemblyName>
    <RootNamespace>BrosLMV.Runner</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- XEngineLib.dll solo está registrado como COM de 32 bits (WOW6432Node): un
         proceso AnyCPU corre en 64 bits en este equipo y no puede crear el CLSID. -->
    <PlatformTarget>x86</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mismo motor que el addon (ScriptContext, Com, Conexion, ScriptRunner) y
         auditoria/rutas, enlazados desde src\ (NO copiados) para que nunca diverjan.
         HostClient.cs + UiPump.cs: mismo cliente del canal v3.0 que usa ClsMain.cs para
         botones Python, necesario para Python headless (T3.3). HostClient.cs referencia
         WebView2 (para ctx.show_html), pero esa ruta nunca se ejecuta en el Runner (scripts
         job-safe no deberian llamarla); se enlaza igual porque es el mismo archivo fuente,
         sin bifurcar el motor. -->
    <Compile Include="..\src\Rutas.cs" Link="Rutas.cs" />
    <Compile Include="..\src\UiPump.cs" Link="UiPump.cs" />
    <Compile Include="..\src\Scripting.cs" Link="Scripting.cs" />
    <Compile Include="..\src\Datos.cs" Link="Datos.cs" />
    <Compile Include="..\src\HostClient.cs" Link="HostClient.cs" />
    <Compile Include="..\src\Recetas.cs" Link="Recetas.cs" />
    <Compile Include="..\src\EstructurasDocumento.cs" Link="EstructurasDocumento.cs" />
    <Compile Include="..\src\ConsolaPasswordHash.cs" Link="ConsolaPasswordHash.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
    <!-- Requeridos por HostClient.cs (mismo archivo que usa el addon) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.68.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- Genera el C# del contrato en cada build (el codigo generado vive en obj, no se versiona). -->
  <ItemGroup>
    <Protobuf Include="..\protocol\broslmv.proto" ProtoRoot="..\protocol" GrpcServices="None" Access="Public" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Security" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
