@@CSS
/* ---- extras: el poder de WebView2 (gráficas, paleta, vista previa, tema) ---- */
.cinta{flex-wrap:wrap;row-gap:8px}.marca{min-width:230px;flex:1 1 230px}.ab{min-width:80px}.ab.s{min-width:60px;padding:6px 6px}.info input,.info select{width:128px}
.ab.s{min-width:64px;padding:6px 8px}.ab.s i{font-size:18px}.ab.s span{font-size:10px}
.ov{position:fixed;inset:0;background:#0b1220a8;z-index:80;display:none;align-items:flex-start;justify-content:center;padding-top:9vh}.ov.on{display:flex}
.palc{width:min(640px,92vw);background:var(--tarjeta);border:1px solid var(--linea);border-radius:14px;box-shadow:0 24px 60px #0008;overflow:hidden}
.palc input{border:0;border-bottom:1px solid var(--linea);border-radius:0;padding:14px 16px;font-size:15px;background:transparent}.palc input:focus{outline:0}
.pall{max-height:52vh;overflow:auto}.pall div{padding:9px 16px;display:flex;justify-content:space-between;gap:14px;cursor:pointer;border-bottom:1px solid var(--zebra)}.pall div.sel,.pall div:hover{background:var(--accsuave)}.pall small{color:var(--suave)}.pall .gr{cursor:default;font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--suave);background:var(--zebra);padding:5px 16px}
.palc .pie2{padding:7px 16px;color:var(--suave);font-size:11px;background:var(--zebra);display:flex;gap:14px}
.caja{width:min(760px,94vw);background:var(--tarjeta);border:1px solid var(--linea);border-radius:14px;box-shadow:0 24px 60px #0008;padding:16px 18px}.caja h3{margin:0 0 8px;font-size:15px}.caja textarea{height:210px;font:12px Consolas,monospace}
.caja .bt{display:flex;gap:8px;justify-content:flex-end;margin-top:10px}.btn{border:1px solid var(--linea);background:var(--tarjeta);border-radius:8px;padding:6px 14px;cursor:pointer}.btn.p{background:var(--acc);border-color:var(--acc);color:#fff}
.hoja{background:#fff;color:#16263A;width:min(860px,96vw);max-height:86vh;overflow:auto;border-radius:6px;box-shadow:0 24px 60px #0009;padding:34px 40px}.hoja h1{margin:0;font-size:22px}.hoja table{margin-top:14px}.hoja th{position:static;background:#F1F5F9;color:#334155}.hoja td,.hoja th{padding:6px 8px;border-bottom:1px solid #E2E8F0}
.hoja .tt{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;border-bottom:2px solid #16263A;padding-bottom:10px}.hoja .bloque{display:grid;grid-template-columns:1fr 1fr;gap:6px 24px;margin-top:12px;font-size:12.5px}.hoja .tot2{margin-left:auto;margin-top:12px;width:280px;font-variant-numeric:tabular-nums}.hoja .tot2 div{display:flex;justify-content:space-between;padding:2px 0}.hoja .tot2 .g{font-size:17px;font-weight:700;border-top:2px solid #16263A;margin-top:4px;padding-top:5px}.hoja .letra{margin-top:10px;font-style:italic;color:#475569;font-size:12px}
.ban{display:none;margin:0 0 12px;border:1px solid #F0D9AD;background:#FFF7E6;color:#7A4B06;border-radius:10px;padding:8px 12px;gap:10px;align-items:center}.ban.on{display:flex}.ban span{flex:1}
.kpi{display:grid;grid-template-columns:repeat(2,1fr);gap:6px 12px;margin:8px 0}.kpi div b{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.07em;color:var(--suave);font-weight:600}.kpi div span{font-size:15px;font-weight:650;font-variant-numeric:tabular-nums}
.top{display:flex;flex-direction:column;gap:2px;margin-top:6px}.top a{display:flex;justify-content:space-between;gap:8px;padding:5px 7px;border-radius:7px;align-items:center}.top a:hover{background:var(--accsuave)}.top small{color:var(--suave);display:block}.top button{border:1px solid var(--linea);background:var(--tarjeta);border-radius:6px;cursor:pointer;width:26px;height:26px;color:var(--acc);font-weight:700}
.rev{display:flex;flex-direction:column;gap:3px;font-size:12px}.rev div{display:flex;gap:7px;align-items:flex-start}.rev i{font-style:normal;font-weight:700;width:14px;text-align:center}.rev .v i{color:var(--verde)}.rev .a i{color:var(--ambar)}.rev .r i{color:var(--rojo)}
.mg{display:flex;align-items:baseline;justify-content:space-between}.mg b{font-size:20px;font-variant-numeric:tabular-nums}
.txsm{color:var(--suave);font-size:11.5px}
body.oscuro{--fondo:#0E1620;--tarjeta:#162231;--texto:#E5ECF5;--suave:#93A5BC;--linea:#2B3C52;--zebra:#1A2A3C;--accsuave:#1E3552;--marino:#0B1626;--marino2:#12263F}
body.oscuro .tipos,body.oscuro .pie,body.oscuro input,body.oscuro select,body.oscuro textarea,body.oscuro .lista,body.oscuro .tipo,body.oscuro .kbd,body.oscuro .res{background:var(--tarjeta);color:var(--texto)}
body.oscuro .res{background:linear-gradient(180deg,#162231,#1A2A3C)}body.oscuro .chip{background:#223349;color:#B8C7DA}body.oscuro .info input,body.oscuro .info select{background:#1B2B3F;border-color:#2B3C52;color:#E5ECF5}
body.oscuro .tipo.on{color:#fff}body.oscuro .aviso.a{background:#3a2c10;color:#f3d08a;border-color:#5b4416}body.oscuro .aviso.r{background:#3d1717;color:#f5b5b5;border-color:#6b2a2a}
@media print{body>*:not(#ovPrev){display:none!important}#ovPrev{display:block!important;position:static;background:#fff;padding:0}.hoja{box-shadow:none;max-height:none;width:100%}.noprint{display:none!important}}
@@BTN
  <div class='sep'></div>
  <button class='ab s' onclick='abrirPaleta()' title='Paleta de comandos (Ctrl+K)'><i>🔎</i><span>Paleta</span><em>Ctrl+K</em></button>
  <button class='ab s' onclick='vistaPrevia()' title='Vista previa imprimible (Ctrl+P)'><i>🖨️</i><span>Vista previa</span><em>Ctrl+P</em></button>
  <button class='ab s' id='bRepetir' onclick='repetirUltimo()' title='Repite las partidas del último documento de esta persona' style='display:none'><i>🔁</i><span>Repetir último</span><em>&nbsp;</em></button>
  <button class='ab s' onclick='abrirPegar()' title='Pega partidas desde Excel (Ctrl+Shift+V)'><i>📋</i><span>Pegar</span><em>Excel</em></button>
  <button class='ab s' onclick='alternarTema()' title='Tema claro u oscuro'><i>🌓</i><span>Tema</span><em>&nbsp;</em></button>
@@DER
  <div class='card' id='cardRev'><h2>Revisión previa <span class='der2' id='revSub'></span></h2><div class='rev' id='revis'></div></div>
  <div class='card' id='cardMgn' style='display:none'><h2>Margen estimado <span class='der2 txsm'>costo del catálogo</span></h2><div id='mgn'></div></div>
  <div class='card' id='cardIntel' style='display:none'><h2><span id='intelTit'>Inteligencia</span><span class='der2' id='intelSub'>últimos 12 meses</span></h2><div id='intel'></div></div>
@@OVERLAYS
<div class='ov' id='ovPal'><div class='palc'><input id='palq' placeholder='Escribe una acción, un cliente, un producto…  (Esc cierra)' autocomplete='off'><div class='pall' id='pall'></div><div class='pie2'><span>↑↓ elegir</span><span>Enter ejecuta</span><span>Esc cierra</span></div></div></div>
<div class='ov' id='ovPeg'><div class='caja'><h3>Pegar partidas desde Excel o un archivo</h3><div class='txsm' style='margin-bottom:6px'>Una partida por renglón: clave o código de barras, cantidad y precio (opcional), separados por tabulador, coma o punto y coma. También puedes arrastrar un CSV o TXT a la ventana.</div><textarea id='pegTxt' placeholder='P29&#9;3&#9;125.50'></textarea><div id='pegRes' class='txsm' style='margin-top:6px'></div><div class='bt'><button class='btn' onclick='cerrarOv("ovPeg")'>Cancelar</button><button class='btn p' onclick='aplicarPegado()'>Agregar partidas</button></div></div></div>
<div class='ov' id='ovPrev' style='padding-top:4vh'><div style='display:flex;flex-direction:column;gap:8px;align-items:center'><div class='noprint' style='display:flex;gap:8px'><button class='btn p' onclick='window.print()'>Imprimir</button><button class='btn' onclick='cerrarOv("ovPrev")'>Cerrar</button></div><div class='hoja' id='hoja'></div></div></div>
@@JS
// =====================================================================================================================================
// EXTRAS: lo que solo una ventana web puede dar y que, a la vez, habla con C# (o Python) y con Comercial en vivo:
//   gráficas SVG, historial de precios del cliente, paleta de comandos (Ctrl+K), margen y revisión previa en vivo, vista previa imprimible, pegar desde Excel,
//   deshacer/rehacer (Ctrl+Z / Ctrl+Y), borrador automático que sobrevive a un cierre inesperado, tema claro/oscuro, arrastrar archivos.
// Va al final y «envuelve» las funciones de arriba (agregar, quita, edita…): si se quita este bloque, el formulario sigue funcionando igual.
// =====================================================================================================================================
var EX={hist:[],fut:[],snapT:0,intel:null,top:{},bT:0,borr:DATOS.borrador||null,pref:DATOS.pref||{}};
var TAB=String.fromCharCode(9),NL=String.fromCharCode(10),CR=String.fromCharCode(13);
// ---------- deshacer / rehacer ----------
function snap(){var s=JSON.stringify(ST.partidas);if(EX.hist.length&&EX.hist[EX.hist.length-1]===s)return;EX.hist.push(s);if(EX.hist.length>80)EX.hist.shift();EX.fut=[];}
function deshacer(){if(EX.hist.length<2){aviso('No hay nada que deshacer.');return;}EX.fut.push(EX.hist.pop());ST.partidas=JSON.parse(EX.hist[EX.hist.length-1]);pintarPartidas();pedirBorrador();aviso('Deshecho · Ctrl+Y lo rehace');}
function rehacer(){if(!EX.fut.length){aviso('No hay nada que rehacer.');return;}var s=EX.fut.pop();EX.hist.push(s);ST.partidas=JSON.parse(s);pintarPartidas();pedirBorrador();aviso('Rehecho');}
var _agregar=agregar;agregar=function(x,precio,desc){_agregar(x);if(precio!=null){var p=ST.partidas.filter(function(q){return q.id===x.id&&!q.orig;})[0];if(p){p.precio=precio;if(desc!=null)p.desc=desc;pintarPartidas();}}snap();pedirBorrador();};
var _quita=quita;quita=function(i){_quita(i);snap();pedirBorrador();};
var _edita=edita;edita=function(i,c,v){_edita(i,c,v);clearTimeout(EX.snapT);EX.snapT=setTimeout(snap,700);pedirBorrador();};
var _limpiar=limpiar;limpiar=function(s){_limpiar(s);EX.hist=[];EX.fut=[];snap();EX.intel=null;EX.top={};$('cardIntel').style.display='none';$('bRepetir').style.display='none';};
var _recon=reconstruirOrigenes;reconstruirOrigenes=function(){_recon();snap();};
var _pintarEnt=pintarEnt;pintarEnt=function(){_pintarEnt();if(!ST.ent){$('cardIntel').style.display='none';$('bRepetir').style.display='none';EX.intel=null;EX.top={};}};
var _ctx=cargarContexto;cargarContexto=function(){_ctx();cargarIntel();};
var _tot=totales;totales=function(){_tot();extrasTotales();};
var _creado=creado;creado=function(i){_creado(i);EX.hist=[];snap();if(VIVO)enviar({accion:'borradorBorrar'});$('bdr').textContent='';};
// ---------- inteligencia del cliente: datos en vivo desde Comercial ----------
var MESES=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
function mesCorto(m){return MESES[+m.slice(5,7)-1];}
function svgBarras(ms){var W=310,H=120,base=16,mx=Math.max.apply(null,ms.map(function(m){return m.total;}).concat([1])),bw=(W-8)/ms.length,prom=ms.reduce(function(a,m){return a+m.total;},0)/ms.length;
  var s='<svg viewBox="0 0 '+W+' '+H+'" width="100%" role="img" aria-label="Facturado por mes">';
  s+='<line x1="4" x2="'+(W-4)+'" y1="'+(H-base)+'" y2="'+(H-base)+'" stroke="var(--linea)"/>';
  ms.forEach(function(m,i){var h=m.total/mx*(H-base-12),x=4+i*bw,y=H-base-h,ult=i===ms.length-1;
    s+='<g><title>'+mesCorto(m.mes)+' '+m.mes.slice(0,4)+': '+f2(m.total)+' · '+m.n+' doc.</title><rect x="'+(x+1.5)+'" y="'+(m.total>0?y:H-base-1)+'" width="'+(bw-3)+'" height="'+(m.total>0?Math.max(h,1.5):1)+'" rx="3" fill="var(--acc)" opacity="'+(ult?1:.55)+'"/>';
    s+='<text x="'+(x+bw/2)+'" y="'+(H-4)+'" font-size="8" text-anchor="middle" fill="var(--suave)">'+mesCorto(m.mes)+'</text></g>';});
  var yp=H-base-prom/mx*(H-base-12);s+='<line x1="4" x2="'+(W-4)+'" y1="'+yp+'" y2="'+yp+'" stroke="var(--ambar)" stroke-dasharray="3 3" opacity=".8"/><text x="'+(W-4)+'" y="'+(yp-3)+'" font-size="8" text-anchor="end" fill="var(--ambar)">promedio '+f2(prom)+'</text></svg>';return s;}
function cargarIntel(){var x=ST.ent;if(!x||!VIVO)return;$('cardIntel').style.display='';$('intelTit').textContent='Inteligencia · '+(tipoAct().lado==='C'?'ventas':'compras');$('intel').innerHTML='<div class=txsm>Calculando con los datos de Comercial…</div>';
  llamar('inteligencia',{id:x.id,tipo:ST.tipo}).then(function(d){if(!ST.ent||ST.ent.id!==x.id)return;EX.intel=d;EX.top={};(d.top||[]).forEach(function(t){EX.top[t.id]=t;});pintarIntel();$('bRepetir').style.display=d.ultimo?'':'none';if(d.ultimo)$('bRepetir').title='Repetir las partidas de '+d.ultimo.folio+' ('+fmtF(d.ultimo.fecha)+')';}).catch(function(){$('intel').innerHTML='<div class=txsm>No se pudo consultar el historial.</div>';});}
function pintarIntel(){var d=EX.intel;if(!d)return;var h=svgBarras(d.meses);
  h+='<div class=kpi><div><b>Total 12 meses</b><span>'+f2(d.total12)+'</span></div><div><b>Documentos</b><span>'+d.docs12+'</span></div><div><b>Ticket promedio</b><span>'+f2(d.ticket)+'</span></div><div><b>'+(tipoAct().lado==='C'?'Días promedio de pago':'Días promedio al pagarle')+'</b><span>'+(d.diasPago==null?'—':f0(Math.round(d.diasPago)))+'</span></div></div>';
  if(d.top&&d.top.length){h+='<div class=txsm style="margin-top:4px">'+(tipoAct().lado==='C'?'Suele comprar':'Suele surtirnos')+' (un clic agrega con el último precio)</div><div class=top>'+d.top.map(function(t){return '<a><span style="min-width:0"><b style="font-weight:600;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:215px">'+esc(t.nombre)+'</b><small>'+t.veces+' vez/veces · últ. '+f2(t.precio)+' · '+fmtF(t.ult)+'</small></span><button title="Agregar con el último precio" onclick="agregarTop('+t.id+')">+</button></a>';}).join('')+'</div>';}
  $('intel').innerHTML=h;}
function agregarTop(id){var x=prodPor(id),t=EX.top[id];if(!x){aviso('Ese producto ya no está en el catálogo.','mal');return;}agregar(x,t?t.precio:null,t?t.desc:null);aviso(x.nombre+' agregado a '+f2(t.precio),'bien');}
function repetirUltimo(){var u=EX.intel&&EX.intel.ultimo;if(!u){aviso('No hay un documento anterior de este tipo para repetir.');return;}
  if(ST.partidas.length&&!confirm('Se reemplazarán las partidas capturadas por las de '+u.folio+'. ¿Continuar?'))return;
  ST.partidas=(u.partidas||[]).filter(function(p){return prodPor(p.id);}).map(function(p){var pr=prodPor(p.id);return {id:p.id,clave:pr.clave,nombre:pr.nombre,unidad:pr.unidad,cant:p.cant,precio:p.precio,desc:p.desc,imp:p.imp||pr.imp,origenItem:0,orig:0};});
  pintarPartidas();snap();pedirBorrador();aviso('Se cargaron '+ST.partidas.length+' partida(s) de '+u.folio+'.','bien');}
// ---------- margen y revisión previa, en vivo ----------
function calc(){var s=0,d=0,im=0,cos=0,bajo=0,sinCosto=0;ST.partidas.forEach(function(p){var pr=prodPor(p.id)||{},bruto=p.cant*p.precio,dd=bruto*p.desc/100,neto=bruto-dd;s+=bruto;d+=dd;im+=neto*(percImp[p.imp]||0);var c=p.cant*(pr.costo||0)/tcPesos();cos+=c;if(!(pr.costo>0))sinCosto++;if(neto<c)bajo++;});return {sub:s,desc:d,imp:im,tot:s-d+im,neto:s-d,costo:cos,bajo:bajo,sinCosto:sinCosto};}
function extrasTotales(){var t=tipoAct(),c=calc(),box=$('cardMgn');
  if(t.precio!=='venta'||!ST.partidas.length)box.style.display='none';
  else{box.style.display='';var ut=c.neto-c.costo,pc=c.neto>0?ut/c.neto*100:0,cls=pc<0?'r':pc<15?'a':'';
    $('mgn').innerHTML=c.costo>0?'<div class=mg><span>Utilidad</span><b style="color:'+(pc<0?'var(--rojo)':'var(--verde)')+'">'+f2(ut)+'</b></div><div class="barra '+cls+'"><i style="width:'+Math.max(0,Math.min(100,pc))+'%"></i></div><div class=txsm>'+f0(Math.round(pc*10)/10)+' % sobre la venta neta · costo '+f2(c.costo)+(c.bajo?' · <span style="color:var(--rojo)">'+c.bajo+' partida(s) bajo costo</span>':'')+(c.sinCosto?' · '+c.sinCosto+' sin costo en el catálogo':'')+'</div>':'<div class=txsm>Los productos de este documento no tienen costo en el catálogo, así que no se puede estimar el margen.</div>';}
  revisar(c);}
function revisar(c){var t=tipoAct(),it=[],x=ST.ent;function ok(s){it.push(['v','✓',s]);}function av(s){it.push(['a','!',s]);}function ma(s){it.push(['r','✕',s]);}
  x?ok((t.lado==='C'?'Cliente':'Proveedor')+': '+x.nombre):ma('Falta elegir el '+(t.lado==='C'?'cliente':'proveedor'));
  ST.partidas.length?ok(ST.partidas.length+' partida(s)'):ma('Falta agregar partidas');
  if(ST.partidas.some(function(p){return !(p.cant>0);}))ma('Hay partidas sin cantidad');
  if(ST.partidas.some(function(p){return p.precio<=0;}))av('Hay partidas con precio en cero');
  if(t.precio==='venta'){var falt=ST.partidas.filter(function(p){var pr=prodPor(p.id)||{};return !pr.servicio&&!p.orig&&p.cant>existDe(p.id);}).length;if(falt)av(falt+' partida(s) superan la existencia');}
  if(t.lado==='C'&&x&&x.credito>0){x.saldo+c.tot>x.credito?av('Excede el límite de crédito'):ok('Dentro del límite de crédito');}
  if(t.clave==='factura_cliente'){var uso=$('uso').value,fo=$('forma').value,me=$('metodo').value;if(!uso||!fo||!me)ma('Faltan datos fiscales del CFDI');else{ok('CFDI: '+uso+' · '+fo+' · '+me);if(me==='PPD'&&fo!=='99')av('Con PPD la forma de pago debe ser 99');if(me==='PUE'&&fo==='99')av('Con PUE la forma de pago no puede ser 99');}
    if(x&&x.rfc&&!/^[A-ZÑ&]{3,4}[0-9]{6}[A-Z0-9]{3}$/.test(String(x.rfc).toUpperCase()))av('El RFC del cliente no tiene formato válido');if(x&&!x.rfc)av('El cliente no tiene RFC capturado');}
  var f=$('fecha').value;if(f&&f>iso(new Date()))av('La fecha es posterior a hoy');
  if(+$('mon').value!==3&&!(+$('tc').value>0))ma('Falta el tipo de cambio');
  var m=it.filter(function(a){return a[0]==='r';}).length,w=it.filter(function(a){return a[0]==='a';}).length;
  $('revSub').innerHTML=m?'<span class="chip r">'+m+' por corregir</span>':w?'<span class="chip a">'+w+' aviso(s)</span>':'<span class="chip v">todo en orden</span>';
  $('revis').innerHTML=it.map(function(a){return '<div class='+a[0]+'><i>'+a[1]+'</i><span>'+esc(a[2])+'</span></div>';}).join('');}
// ---------- paleta de comandos (Ctrl+K) ----------
function cerrarOv(id){$(id).classList.remove('on');}
var PAL={sel:0,vis:[]};
function comandos(){var c=[{g:'Acciones',a:'Guardar y abrir el documento',b:'F5',f:function(){crear(false);}},{g:'Acciones',a:'Guardar y capturar otro',b:'F6',f:function(){crear(true);}},{g:'Acciones',a:'Vista previa imprimible',b:'Ctrl+P',f:vistaPrevia},{g:'Acciones',a:'Pegar partidas desde Excel',b:'Ctrl+Shift+V',f:abrirPegar},{g:'Acciones',a:'Repetir el último documento de esta persona',f:repetirUltimo},{g:'Acciones',a:'Deshacer',b:'Ctrl+Z',f:deshacer},{g:'Acciones',a:'Rehacer',b:'Ctrl+Y',f:rehacer},{g:'Acciones',a:'Limpiar todo',f:function(){limpiar();}},{g:'Acciones',a:'Cambiar entre tema claro y oscuro',f:alternarTema},{g:'Acciones',a:'Cancelar y cerrar',b:'Esc',f:cancelar}];
  TIPOS.forEach(function(t){c.push({g:'Tipo de documento',a:t.nombre,b:t.lado==='C'?'venta':'compra',f:function(){setTipo(t.clave);}});});return c;}
function abrirPaleta(){$('ovPal').classList.add('on');$('palq').value='';pintarPaleta();setTimeout(function(){$('palq').focus();},20);}
function pintarPaleta(){var q=norm($('palq').value).split(/\s+/).filter(Boolean),out=[];
  comandos().forEach(function(c){var h=norm(c.a+' '+c.g);if(q.every(function(w){return h.indexOf(w)>=0;}))out.push(c);});
  if(q.length&&q.join('').length>=2){var n=0;ENT().forEach(function(e){if(n>=6)return;var h=norm(e.nombre+' '+e.rfc);if(q.every(function(w){return h.indexOf(w)>=0;})){n++;out.push({g:tipoAct().lado==='C'?'Clientes':'Proveedores',a:e.nombre,b:(e.rfc||'')+(e.saldo?' · saldo '+f2(e.saldo):''),f:function(){elegirEnt(e);}});}});
    n=0;CAT.productos.forEach(function(p){if(n>=8)return;var h=norm(p.nombre+' '+p.clave+' '+p.barras);if(q.every(function(w){return h.indexOf(w)>=0;})){n++;out.push({g:'Productos (agrega a la partida)',a:p.nombre,b:p.clave+' · '+f2(precioDe(p.id)),f:function(){agregar(p);}});}});}
  PAL.vis=out.slice(0,40);if(PAL.sel>=PAL.vis.length)PAL.sel=0;var g='',h='';PAL.vis.forEach(function(c,i){if(c.g!==g){g=c.g;h+='<div class=gr>'+esc(g)+'</div>';}h+='<div data-i="'+i+'" class="'+(i===PAL.sel?'sel':'')+'"><span>'+esc(c.a)+'</span><small>'+esc(c.b||'')+'</small></div>';});$('pall').innerHTML=h||'<div class=gr>Sin coincidencias</div>';}
function ejecutarPaleta(i){var c=PAL.vis[i];if(!c)return;cerrarOv('ovPal');setTimeout(function(){c.f();},10);}
$('palq').addEventListener('input',function(){PAL.sel=0;pintarPaleta();});
$('palq').addEventListener('keydown',function(e){if(e.key==='ArrowDown'){PAL.sel=Math.min(PAL.vis.length-1,PAL.sel+1);pintarPaleta();var s=document.querySelector('#pall .sel');if(s)s.scrollIntoView({block:'nearest'});e.preventDefault();}else if(e.key==='ArrowUp'){PAL.sel=Math.max(0,PAL.sel-1);pintarPaleta();var s2=document.querySelector('#pall .sel');if(s2)s2.scrollIntoView({block:'nearest'});e.preventDefault();}else if(e.key==='Enter'){ejecutarPaleta(PAL.sel);e.preventDefault();}else if(e.key==='Escape'){cerrarOv('ovPal');e.stopPropagation();}});
$('pall').addEventListener('mousedown',function(e){var d=e.target.closest('div[data-i]');if(d){ejecutarPaleta(+d.getAttribute('data-i'));e.preventDefault();}});
// ---------- pegar desde Excel / arrastrar un archivo ----------
function abrirPegar(texto){$('ovPeg').classList.add('on');if(typeof texto==='string')$('pegTxt').value=texto;$('pegRes').textContent='';setTimeout(function(){$('pegTxt').focus();},20);}
function celdas(l){var c=l.indexOf(TAB)>=0?l.split(TAB):l.indexOf(';')>=0?l.split(';'):l.split(',');return c.map(function(x){return x.trim().split('"').join('');});}
function buscaProd(v){var k=norm(v);if(!k)return null;return CAT.productos.filter(function(p){return (p.barras&&p.barras===v.trim())||norm(p.clave)===k;})[0]||CAT.productos.filter(function(p){return norm(p.nombre)===k;})[0]||null;}
function aplicarPegado(){var ls=$('pegTxt').value.split(CR).join('').split(NL).filter(function(l){return l.trim();}),mal=[],n=0;
  ls.forEach(function(l,i){var c=celdas(l);if(i===0&&/^(clave|codigo|código|sku|producto|articulo|artículo)/i.test(c[0]))return;var p=buscaProd(c[0]);if(!p){mal.push(c[0]);return;}
    var cant=parseFloat(String(c[1]||'1').replace(',','.'));if(!(cant>0))cant=1;var pr=c[2]!==undefined&&c[2]!==''?parseFloat(String(c[2]).replace(',','.')):NaN;
    var ya=ST.partidas.filter(function(q){return q.id===p.id&&!q.orig;})[0];if(ya){ya.cant+=cant;if(!isNaN(pr))ya.precio=pr;}else ST.partidas.push({id:p.id,clave:p.clave,nombre:p.nombre,unidad:p.unidad,cant:cant,precio:isNaN(pr)?precioDe(p.id):pr,desc:(tipoAct().lado==='C'&&ST.ent&&ST.ent.desc)||0,imp:p.imp,origenItem:0,orig:0});n++;});
  pintarPartidas();snap();pedirBorrador();$('pegRes').innerHTML=n+' partida(s) agregada(s).'+(mal.length?' <span style="color:var(--rojo)">No encontré: '+esc(mal.slice(0,12).join(', '))+(mal.length>12?'…':'')+'</span>':'');if(!mal.length){cerrarOv('ovPeg');aviso(n+' partida(s) agregada(s) desde el texto pegado.','bien');}}
document.addEventListener('paste',function(e){var a=document.activeElement,en=a&&(a.tagName==='INPUT'||a.tagName==='TEXTAREA'||a.tagName==='SELECT');if(en)return;var t=(e.clipboardData||window.clipboardData).getData('text');if(t&&(t.indexOf(TAB)>=0||t.indexOf(NL)>=0)){e.preventDefault();abrirPegar(t);}});
document.addEventListener('dragover',function(e){e.preventDefault();});
document.addEventListener('drop',function(e){e.preventDefault();var f=e.dataTransfer&&e.dataTransfer.files&&e.dataTransfer.files[0];if(!f)return;var r=new FileReader();r.onload=function(){abrirPegar(String(r.result));aviso('Archivo leído: '+f.name+'. Revisa y pulsa «Agregar partidas».');};r.readAsText(f);});
// ---------- vista previa imprimible ----------
var U1=['','UNO','DOS','TRES','CUATRO','CINCO','SEIS','SIETE','OCHO','NUEVE','DIEZ','ONCE','DOCE','TRECE','CATORCE','QUINCE','DIECISÉIS','DIECISIETE','DIECIOCHO','DIECINUEVE','VEINTE'],D1=['','','VEINTE','TREINTA','CUARENTA','CINCUENTA','SESENTA','SETENTA','OCHENTA','NOVENTA'],V1=['VEINTIUNO','VEINTIDÓS','VEINTITRÉS','VEINTICUATRO','VEINTICINCO','VEINTISÉIS','VEINTISIETE','VEINTIOCHO','VEINTINUEVE'],C1=['','CIENTO','DOSCIENTOS','TRESCIENTOS','CUATROCIENTOS','QUINIENTOS','SEISCIENTOS','SETECIENTOS','OCHOCIENTOS','NOVECIENTOS'];
function cent(n){if(n===0)return '';if(n===100)return 'CIEN';var r='',c=Math.floor(n/100),d=n%100;if(c>0)r+=C1[c]+' ';if(d>0){if(d<=20)r+=U1[d];else{var a=Math.floor(d/10),u=d%10;if(a===2&&u>0)r+=V1[u-1];else{r+=D1[a];if(u>0)r+=' Y '+U1[u];}}}return r.trim();}
function enLetras(n){if(n===0)return 'CERO';var r='',mi=Math.floor(n/1000000);n%=1000000;var m=Math.floor(n/1000);n%=1000;if(mi>0)r+=mi===1?'UN MILLÓN ':cent(mi)+' MILLONES ';if(m>0)r+=m===1?'MIL ':cent(m)+' MIL ';if(n>0)r+=cent(n);r=r.trim();if(/UNO$/.test(r))r=r.slice(0,-3)+'UN';return r;}
function aLetras(v,mon){v=Math.max(0,v);var e=Math.floor(v),c=Math.round((v-e)*100);if(c===100){e++;c=0;}var m=CAT.monedas.filter(function(x){return x.id===+$('mon').value;})[0]||{simbolo:'MXN',nombre:'Peso mexicano'},pal=/peso/i.test(m.nombre)?'PESOS':/euro/i.test(m.nombre)?'EUROS':/lar/i.test(m.nombre)?'DÓLARES':m.nombre.toUpperCase();return enLetras(e)+' '+pal+' '+('0'+c).slice(-2)+'/100'+(m.simbolo==='MXN'?' M.N.':'');}
function vistaPrevia(){var t=tipoAct(),c=calc(),x=ST.ent,m=CAT.monedas.filter(function(q){return q.id===+$('mon').value;})[0]||{simbolo:'MXN'};
  var f=CAT.folios&&CAT.folios[t.clave];
  var h='<div class=tt><div><h1>'+esc(t.nombre)+'</h1><div style="color:#64748B">'+esc(DATOS.empresa||'')+'</div></div><div style="text-align:right"><div><b>Folio</b> ≈ '+(f||'—')+'</div><div><b>Fecha</b> '+fmtF($('fecha').value)+'</div>'+(t.entrega?'<div><b>Entrega</b> '+fmtF($('entrega').value)+'</div>':'')+'</div></div>';
  h+='<div class=bloque><div><b>'+(t.lado==='C'?'Cliente':'Proveedor')+'</b><br>'+esc(x?x.nombre:'(sin elegir)')+'</div><div><b>RFC</b><br>'+esc(x&&x.rfc||'—')+'</div><div><b>Moneda</b><br>'+esc(m.simbolo)+(+$('mon').value!==3?' · T.C. '+f0(+$('tc').value):'')+'</div><div><b>Condición de pago</b><br>'+esc(t.condicion&&$('cond').selectedOptions[0]?$('cond').selectedOptions[0].textContent:'—')+'</div>';
  if(t.clave==='factura_cliente')h+='<div><b>Uso del CFDI</b><br>'+esc($('uso').value)+'</div><div><b>Forma / método de pago</b><br>'+esc($('forma').value)+' / '+esc($('metodo').value)+'</div>';
  if($('titulo').value)h+='<div style="grid-column:span 2"><b>Referencia</b><br>'+esc($('titulo').value)+'</div>';h+='</div>';
  h+='<table><thead><tr><th class=l>Clave</th><th class=l>Descripción</th><th>Cant.</th><th>Precio</th><th>Desc. %</th><th>Importe</th></tr></thead><tbody>'+(ST.partidas.length?ST.partidas.map(function(p){var imp=p.cant*p.precio*(1-p.desc/100);return '<tr><td class=l>'+esc(p.clave)+'</td><td class=l>'+esc(p.nombre)+'</td><td>'+f0(p.cant)+'</td><td>'+f2(p.precio)+'</td><td>'+f0(p.desc)+'</td><td>'+f2(imp)+'</td></tr>';}).join(''):'<tr><td colspan=6 style="text-align:center;color:#64748B;padding:18px">Sin partidas</td></tr>')+'</tbody></table>';
  h+='<div class=tot2><div><span>Subtotal</span><span>'+f2(c.sub)+'</span></div><div><span>Descuento</span><span>-'+f2(c.desc)+'</span></div><div><span>Impuestos</span><span>'+f2(c.imp)+'</span></div><div class=g><span>Total</span><span>'+f2(c.tot)+'</span></div></div>';
  h+='<div class=letra>SON: '+aLetras(c.tot)+'</div>'+($('coment').value?'<div style="margin-top:10px;font-size:12px"><b>Comentarios:</b> '+esc($('coment').value)+'</div>':'')+'<div style="margin-top:14px;color:#94A3B8;font-size:10.5px">Vista previa generada por BrosLMV. El documento definitivo lo crea y numera Comercial al guardar.</div>';
  $('hoja').innerHTML=h;$('ovPrev').classList.add('on');}
// ---------- borrador automático ----------
function extrasSpec(){var t=tipoAct();return {tipo:ST.tipo,almacen:+$('alm').value,entidad:ST.ent?ST.ent.id:0,condicion:t.condicion?+$('cond').value:0,fecha:$('fecha').value,entrega:$('entrega').value,titulo:$('titulo').value,comentarios:$('coment').value,moneda:+$('mon').value,tc:+$('tc').value||1,centro:+$('cc').value||0,uso:$('uso').value,forma:$('forma').value,metodo:$('metodo').value,origenes:ST.origenes,partidas:ST.partidas.map(function(p){return {id:p.id,nombre:p.nombre,cant:p.cant,precio:p.precio,desc:p.desc,imp:p.imp,origenItem:p.origenItem||0};})};}
function pedirBorrador(){if(!VIVO||ST.guardando)return;clearTimeout(EX.bT);EX.bT=setTimeout(function(){if(!ST.partidas.length&&!ST.ent)return;enviar({accion:'borrador',spec:JSON.stringify(extrasSpec())});var d=new Date();$('bdr').textContent='Borrador guardado '+('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);},1500);}
document.addEventListener('change',pedirBorrador);
function restaurar(sp){setTipo(sp.tipo,true);var en=ENT().filter(function(x){return x.id===sp.entidad;})[0];if(en){ST.ent=en;$('ent').value=en.nombre;pintarEnt();cargarContexto();}
  $('alm').value=sp.almacen;if(sp.condicion)$('cond').value=sp.condicion;$('fecha').value=sp.fecha||$('fecha').value;$('entrega').value=sp.entrega||$('entrega').value;$('titulo').value=sp.titulo||'';$('coment').value=sp.comentarios||'';$('mon').value=sp.moneda||3;cambiaMon();if(sp.tc)$('tc').value=sp.tc;$('cc').value=sp.centro||0;if(sp.uso)$('uso').value=sp.uso;if(sp.forma)$('forma').value=sp.forma;if(sp.metodo)$('metodo').value=sp.metodo;ST.manual=true;
  ST.origenes=sp.origenes||[];ST.partidas=(sp.partidas||[]).map(function(p){var pr=prodPor(p.id)||{};return {id:p.id,clave:pr.clave||'',nombre:p.nombre||pr.nombre||'',unidad:pr.unidad||'',cant:p.cant,precio:p.precio,desc:p.desc,imp:p.imp,origenItem:p.origenItem||0,orig:p.origenItem?(ST.origenes[0]||1):0};});pintarOrigenes();pintarPartidas();snap();}
(function(){var b=document.createElement('div');b.className='ban';b.id='banBorr';var izq=document.querySelector('.izq');izq.insertBefore(b,izq.firstChild);
  if(EX.borr&&EX.borr.spec&&!DATOS.inicial){var sp;try{sp=JSON.parse(EX.borr.spec);}catch(e){sp=null;}
    if(sp&&((sp.partidas||[]).length||sp.entidad)){var cuando=EX.borr.cuando?new Date(EX.borr.cuando):null,min=cuando?Math.max(1,Math.round((Date.now()-cuando.getTime())/60000)):0;
      b.innerHTML='<span>Hay un <b>borrador sin guardar</b>'+(min?' de hace '+(min<90?min+' min':Math.round(min/60)+' h'):'')+' ('+(sp.partidas||[]).length+' partida(s)). ¿Lo recuperas?</span><button class=btn onclick="descartarBorrador()">Descartar</button><button class="btn p" onclick="recuperarBorrador()">Recuperar</button>';b.classList.add('on');EX.borrSpec=sp;}}})();
function recuperarBorrador(){$('banBorr').classList.remove('on');restaurar(EX.borrSpec);aviso('Borrador recuperado.','bien');}
function descartarBorrador(){$('banBorr').classList.remove('on');if(VIVO)enviar({accion:'borradorBorrar'});}
// ---------- tema ----------
function ponerTema(o){document.body.classList.toggle('oscuro',!!o);}
function alternarTema(){var o=!document.body.classList.contains('oscuro');ponerTema(o);if(VIVO)enviar({accion:'pref',tema:o?'oscuro':'claro'});}
if(EX.pref.tema==='oscuro')ponerTema(true);
// ---------- atajos ----------
document.addEventListener('keydown',function(e){var k=e.key.toLowerCase();
  if(e.ctrlKey&&k==='k'){e.preventDefault();abrirPaleta();}
  else if(e.ctrlKey&&k==='p'){e.preventDefault();vistaPrevia();}
  else if(e.ctrlKey&&e.shiftKey&&k==='v'){e.preventDefault();abrirPegar();}
  else if(e.ctrlKey&&k==='z'&&!/INPUT|TEXTAREA/.test(document.activeElement.tagName)){e.preventDefault();deshacer();}
  else if(e.ctrlKey&&k==='y'&&!/INPUT|TEXTAREA/.test(document.activeElement.tagName)){e.preventDefault();rehacer();}
  else if(e.key==='Escape'){var o=document.querySelector('.ov.on');if(o){o.classList.remove('on');e.stopPropagation();}}},true);
// ---------- arranque de los extras ----------
snap();extrasTotales();
if(!VIVO){['bRepetir'].forEach(function(i){$(i).style.display='none';});}
@@END
