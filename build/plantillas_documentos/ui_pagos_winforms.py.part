    info.Paint += pintar_info
    t_info = Label()
    t_info.Text = "Información del movimiento"
    t_info.Font = F_SM
    t_info.ForeColor = C_RIB_MU
    t_info.BackColor = C_RIB
    t_info.Location = Point(10, 0)
    t_info.AutoSize = True
    info.Controls.Add(t_info)

    def et_r(texto, x, y):
