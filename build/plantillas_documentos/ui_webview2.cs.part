// ===================================================================================================================================
// VENTANA (WebView2, NO modal). La página es un formulario completo; esta parte la abre y contesta lo que la página pide:
//   crear      → crea el documento, abre el DOCUMENTO NATIVO de Comercial y (según el botón) cierra o deja la ventana lista para otro documento
//   pendientes → documentos de origen pendientes de esa persona        entidad → sus últimos documentos       abrir → abre un documento en Comercial
// Las respuestas viajan como «__JS__código»: la página recibe datos sin repintarse (conserva lo capturado). Si algo falla, la página muestra el mensaje y no se pierde nada.
// ===================================================================================================================================
string PAGINA = @"__HTML_CS__";

var catalogo = Catalogos(CLAVES);
var origenes = Origenes(seleccion);
string quienSoy = "", nombreEmpresa = "";
try { quienSoy = S(ctx.Scalar("SELECT TOP 1 ISNULL(UserName,'') FROM engUser WHERE UserID = " + ctx.erp.UserId)); } catch { }
try { nombreEmpresa = S(ctx.Scalar("SELECT TOP 1 ISNULL(CommercialName, OfficialName) FROM orgBusinessEntity WHERE BusinessEntityID = " + empresa)); } catch { }
Func<object, string> JsJson = o => ser.Serialize(o).Replace("</", "<\\/");
Func<object> Borrador = () => { string j = LeerBorrador("documento"); return string.IsNullOrEmpty(j) ? null : ser.Deserialize<Dictionary<string, object>>(j); };
Func<object> Pref = () => { string j = LeerBorrador("pref_ui", false); return string.IsNullOrEmpty(j) ? new Dictionary<string, object>() : ser.Deserialize<Dictionary<string, object>>(j); };
Func<Dictionary<string, object>, string> DatosPagina = inicial =>
    PAGINA.Replace("__DATOS__", JsJson(new Dictionary<string, object> { ["tipos"] = TIPOS, ["cat"] = catalogo, ["origenes"] = origenes, ["inicial"] = inicial, ["vivo"] = true, ["usuario"] = quienSoy, ["empresa"] = nombreEmpresa, ["borrador"] = Borrador(), ["pref"] = Pref() }));

string htmlPrueba = Environment.GetEnvironmentVariable("BROSLMV_DOC_HTML");           // pruebas: escribe la página (con sus datos) en un archivo y no abre ventana
if (!string.IsNullOrEmpty(htmlPrueba))
{
    System.IO.File.WriteAllText(htmlPrueba, DatosPagina(null), new System.Text.UTF8Encoding(false));
    return "HTML";
}

Func<Dictionary<string, object>, string> alMensaje = (r) =>
{
    string accion = S(r.ContainsKey("accion") ? r["accion"] : "");
    string req = S(r.ContainsKey("req") ? r["req"] : "0");
    try
    {
        if (accion == "cancelar") return "__CERRAR__";
        if (accion == "pendientes") return "__JS__respuesta(" + req + "," + JsJson(PendientesDe(L(r["entidad"]), S(r["tipo"]))) + ")";
        if (accion == "inteligencia") return "__JS__respuesta(" + req + "," + JsJson(InteligenciaDe(L(r["id"]), S(r["tipo"]))) + ")";
        if (accion == "borrador") { GuardarBorrador("documento", ser.Serialize(new Dictionary<string, object> { ["cuando"] = DateTime.Now.ToString("o"), ["spec"] = S(r["spec"]) })); return null; }
        if (accion == "borradorBorrar") { BorrarBorrador("documento"); return null; }
        if (accion == "pref") { GuardarBorrador("pref_ui", ser.Serialize(new Dictionary<string, object> { ["tema"] = S(r["tema"]) })); return null; }
        if (accion == "entidad") return "__JS__respuesta(" + req + "," + JsJson(UltimosDe(L(r["id"]))) + ")";
        if (accion == "abrirDoc")
        {
            try { ctx.erp.AbrirDocumento((int)L(r["id"]), I(r["modulo"])); } catch (Exception ex) { return "__JS__aviso(" + JsJson("No se pudo abrir el documento: " + ex.Message) + ",'mal')"; }
            return null;
        }
        if (accion != "crear") return null;
        var spec = ser.Deserialize<Dictionary<string, object>>(S(r["spec"]));
        bool otro = r.ContainsKey("nuevo") && Convert.ToBoolean(r["nuevo"]);
        long doc; try { doc = CrearDocumento(spec); }
        catch (Exception ex) { return "__JS__falloCrear(" + JsJson(ex.Message) + ")"; }                      // la ventana sigue con todo lo capturado
        BorrarBorrador("documento");                                                                        // ya se guardó: el borrador no debe volver a ofrecerse
        int modulo = (int)tipoPor[S(spec["tipo"])]["modulo"];
        try { ctx.erp.RefreshGrid(); } catch { }
        string folio = ""; try { folio = S(ctx.Scalar("SELECT ISNULL(FolioPrefix,'') + CAST(ISNULL(Folio,'') AS NVARCHAR(30)) FROM docDocument WHERE DocumentID = " + doc)); } catch { }
        string abrirMal = null;
        try { ctx.erp.AbrirDocumento((int)doc, modulo); } catch (Exception ex) { abrirMal = ex.Message; }          // SIEMPRE se abre el documento nativo del sistema
        if (abrirMal != null) return "__JS__creado(" + JsJson(new Dictionary<string, object> { ["id"] = doc, ["folio"] = folio, ["modulo"] = modulo, ["nuevo"] = otro, ["avisoAbrir"] = "Se creó, pero no se pudo abrir en Comercial (" + abrirMal + "). Búscalo por su folio." }) + ")";
        return otro ? "__JS__creado(" + JsJson(new Dictionary<string, object> { ["id"] = doc, ["folio"] = folio, ["modulo"] = modulo, ["nuevo"] = true }) + ")" : "__CERRAR__";
    }
    catch (Exception ex) { return "__JS__aviso(" + JsJson(ex.Message) + ",'mal')"; }
};
ctx.ShowHtmlModeless(DatosPagina(null), "Crear documento · BrosLMV", 1280, 900, alMensaje);
if (Environment.GetEnvironmentVariable("BROSLMV_DOC_BOMBA") == "1")          // pruebas: mantiene vivo el proceso (el Runner no tiene bucle de ventanas) para manejar la página por depuración remota
{
    var fin = new System.Windows.Forms.Timer { Interval = 150000 }; fin.Tick += (s, e) => System.Windows.Forms.Application.ExitThread(); fin.Start();
    System.Windows.Forms.Application.Run();
}
return "OK";
