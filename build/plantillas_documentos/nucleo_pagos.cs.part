// ===================================================================================================================================
// COBRO A CLIENTE / PAGO A PROVEEDOR.
// ⚠ PLANTILLA AVANZADA, NO NATIVA: Comercial no ofrece ninguna función para aplicar un cobro o un pago (se buscó en el SDK y en el motor, véase MANUAL §10.5).
// Esta plantilla repite, con SQL directo y en UNA sola transacción por documento, lo que hace la pantalla de Tesorería: la operación financiera, la aplicación al
// documento, su espejo, la transferencia bancaria, el reparto proporcional de impuestos y el nuevo saldo. La receta se validó contra cobros reales y contra el laboratorio.
// NO genera la póliza contable del cobro/pago (eso lo hace el Motor de Asientos al contabilizar). Pruébala SIEMPRE primero en una base de pruebas.
// ===================================================================================================================================
// Tipos: clave · nombre · lado (C/P) · módulo de la operación (248 cobro, 247 pago) · DocRecipientID · DocumentTypeID de la operación · prefijo de folio
Dictionary<string, object> TP(string clave, string nombre, string lado, int modOp, int recip, int tipoOp, string prefijo) =>
    new Dictionary<string, object> { ["clave"] = clave, ["nombre"] = nombre, ["lado"] = lado, ["modOp"] = modOp, ["recip"] = recip, ["tipoOp"] = tipoOp, ["prefijo"] = prefijo };
var TIPOS = new List<Dictionary<string, object>>
{
    TP("cobro", "Cobro a cliente",     "C", 248, 1, 31, "COB"),
    TP("pago",  "Pago a proveedor",    "P", 247, 2, 32, "PAG"),
};
var tipoPor = TIPOS.ToDictionary(t => (string)t["clave"]);
string[] CLAVES = TIPOS.Select(t => (string)t["clave"]).ToArray();

// ---------- Qué módulos generan cuentas por cobrar / por pagar ----------
// Se leen de los parámetros del módulo (DocRecipient 1 = cliente, 2 = proveedor; FinancialAffectation ≠ 0) por ModuleIDBase, así los módulos clonados cuentan igual.
// Solo documentos que SUMAN saldo (facturas, notas de cargo, gastos): una nota de crédito no se cobra ni se paga, se aplica.
var modulos = ctx.Query(
    "SELECT m.ModuleID, m.ModuleName, pv.Rec, pv.Af FROM engModule m JOIN (" +
    "  SELECT ModuleID, MAX(CASE WHEN ParameterKey='DocRecipient' THEN TRY_CONVERT(int, Value) END) AS Rec, MAX(CASE WHEN ParameterKey='DocumentTypeID' THEN TRY_CONVERT(int, Value) END) AS Tipo, " +
    "         MAX(CASE WHEN ParameterKey='FinancialAffectation' THEN TRY_CONVERT(int, Value) END) AS Af, MAX(CASE WHEN ParameterKey='TableName' THEN Value END) AS Tabla " +
    "  FROM engModuleParameter WHERE ParameterKey IN ('DocRecipient','DocumentTypeID','FinancialAffectation','TableName') GROUP BY ModuleID" +
    ") pv ON pv.ModuleID = ISNULL(NULLIF(m.ModuleIDBase,0), m.ModuleID) WHERE pv.Tabla = 'docDocument' AND pv.Rec IN (1,2) AND ((pv.Rec = 1 AND pv.Af = 1) OR (pv.Rec = 2 AND pv.Af = -1)) AND ISNULL(pv.Tipo,0) NOT IN (40,44)");
var modulosLado = new Dictionary<string, List<int>> { ["C"] = new List<int>(), ["P"] = new List<int>() };
var nombreMod = new Dictionary<int, string>();
foreach (var r in modulos) { modulosLado[I(r["Rec"]) == 1 ? "C" : "P"].Add(I(r["ModuleID"])); nombreMod[I(r["ModuleID"])] = S(r["ModuleName"]); }

// ---------- Monedas ----------
// La cuenta tiene su moneda y cada documento la suya (0 = sin moneda = pesos). El tipo de cambio de cada moneda sale del catálogo de monedas de Comercial.
var monedas = ctx.Query("SELECT CurrencyID AS id, IntlSymbol AS simbolo, Currency AS nombre, ISNULL(MoneyLetter,'') AS letra, ISNULL(Rate,1) AS tc FROM vwLBSCurrencyList ORDER BY CurrencyID")
    .Select(r => new Dictionary<string, object> { ["id"] = I(r["id"]), ["simbolo"] = S(r["simbolo"]), ["nombre"] = S(r["nombre"]), ["letra"] = S(r["letra"]), ["tc"] = D(r["tc"]) }).ToList();
var monedaPor = monedas.ToDictionary(m => (int)m["id"]);
int MonedaDe(object v) { int m = I(v); return m <= 0 ? 3 : m; }
string SimboloDe(int id) { return monedaPor.ContainsKey(id) ? (string)monedaPor[id]["simbolo"] : "MXN"; }

// ---------- Documentos con saldo pendiente de un lado (C = por cobrar, P = por pagar) ----------
// Tope de seguridad: 30,000 por lado (los más antiguos primero, que son los que se cobran/pagan primero). La ventana los pide otra vez después de aplicar, para ver los saldos nuevos.
// Además del saldo trae lo necesario para decidir: moneda y tipo de cambio del documento, cuántas parcialidades tiene, cuántos cobros/pagos y cuántas notas de crédito ya se le aplicaron.
List<Dictionary<string, object>> DocsConSaldo(string lado)
{
    var mods = modulosLado[lado];
    if (mods.Count == 0) return new List<Dictionary<string, object>>();
    return ctx.Query(
        "SELECT TOP 30000 d.DocumentID AS id, d.ModuleID AS modulo, d.BusinessEntityID AS ent, d.FolioPrefix, d.Folio, d.DateDocument AS fecha, ISNULL(d.Total,0) AS total, ISNULL(d.Balance,0) AS saldo, ISNULL(d.TotalPaid,0) AS pagado, ISNULL(d.Title,'') AS titulo, " +
        "(SELECT MAX(a.DatePayment) FROM docDocumentPaymentAgenda a WHERE a.DocumentID = d.DocumentID AND a.DeletedOn IS NULL) AS vence, ISNULL((SELECT TOP 1 c.MetodoPago FROM docDocumentCFD c WHERE c.DocumentID = d.DocumentID), '') AS metodo, " +
        "ISNULL(d.CurrencyID,0) AS moneda, ISNULL(d.Rate,1) AS tcDoc, " +
        "(SELECT COUNT(DISTINCT a.PartialityNumber) FROM docDocumentPaymentAgenda a WHERE a.DocumentID = d.DocumentID AND a.DeletedOn IS NULL) AS nParc, " +
        "(SELECT COUNT(*) FROM docDocumentPayment p WHERE p.DocumentID = d.DocumentID AND p.DeletedOn IS NULL AND ISNULL(p.PaymentWithDocumentID,0) = 0) AS nAplic, " +
        "(SELECT COUNT(*) FROM docDocumentPayment p WHERE p.DocumentID = d.DocumentID AND p.DeletedOn IS NULL AND ISNULL(p.PaymentWithDocumentID,0) > 0) AS nNotas " +
        "FROM docDocument d WHERE d.ModuleID IN (" + string.Join(",", mods) + ") AND d.OwnedBusinessEntityID = " + empresa + " AND d.DeletedOn IS NULL AND d.CancelledOn IS NULL AND ISNULL(d.Balance,0) > 0.004 ORDER BY d.DateDocument")
        .Select(r => { int mon = MonedaDe(r["moneda"]); double saldo = D(r["saldo"]), tcd = D(r["tcDoc"]) > 0 ? D(r["tcDoc"]) : 1; return new Dictionary<string, object> { ["id"] = L(r["id"]), ["modulo"] = I(r["modulo"]), ["tipo"] = nombreMod[I(r["modulo"])], ["ent"] = I(r["ent"]), ["folio"] = (S(r["FolioPrefix"]) + S(r["Folio"])).Trim(),
            ["fecha"] = Nulo(r["fecha"]) ? "" : Convert.ToDateTime(r["fecha"], ci).ToString("yyyy-MM-dd"), ["vence"] = Nulo(r["vence"]) ? "" : Convert.ToDateTime(r["vence"], ci).ToString("yyyy-MM-dd"),
            ["total"] = D(r["total"]), ["saldo"] = saldo, ["pagado"] = D(r["pagado"]), ["titulo"] = S(r["titulo"]), ["metodo"] = S(r["metodo"]),
            ["moneda"] = mon, ["simbolo"] = SimboloDe(mon), ["tcDoc"] = tcd, ["saldoMx"] = mon == 3 ? saldo : Math.Round(saldo * tcd, 2),
            ["nParc"] = I(r["nParc"]), ["nAplic"] = I(r["nAplic"]), ["nNotas"] = I(r["nNotas"]) }; }).ToList();
}
// Parcialidades de un documento: la agenda de pago (número, vencimiento, importe) menos lo ya aplicado a cada una (los renglones sin número cuentan como la 1).
// Si la suma de lo pendiente no cuadra con el saldo del documento (intereses, redondeo) la diferencia se carga a la última parcialidad con saldo; sin agenda hay una sola parcialidad con todo el saldo.
List<Dictionary<string, object>> ParcialidadesDe(long doc, double saldo)
{
    var agenda = ctx.Query("SELECT PartialityNumber AS n, MIN(DatePayment) AS vence, SUM(ISNULL(Amount,0)) AS importe FROM docDocumentPaymentAgenda WHERE DocumentID = " + doc + " AND DeletedOn IS NULL GROUP BY PartialityNumber ORDER BY PartialityNumber");
    var pagos = new Dictionary<int, double>();
    foreach (var r in ctx.Query("SELECT CASE WHEN ISNULL(PartialityNumber,0) = 0 THEN 1 ELSE PartialityNumber END AS n, SUM(ISNULL(Amount,0)) AS pagado FROM docDocumentPayment WHERE DocumentID = " + doc + " AND DeletedOn IS NULL GROUP BY CASE WHEN ISNULL(PartialityNumber,0) = 0 THEN 1 ELSE PartialityNumber END"))
        pagos[I(r["n"])] = D(r["pagado"]);
    var res = new List<Dictionary<string, object>>();
    if (agenda.Count == 0)
    {
        double pg = pagos.Values.Sum();
        res.Add(new Dictionary<string, object> { ["n"] = 1, ["vence"] = "", ["importe"] = Math.Round(saldo + pg, 2), ["pagado"] = Math.Round(pg, 2), ["saldo"] = Math.Round(saldo, 2) });
        return res;
    }
    foreach (var a in agenda)
    {
        int n = I(a["n"]); double imp = D(a["importe"]), pg; if (!pagos.TryGetValue(n, out pg)) pg = 0;
        res.Add(new Dictionary<string, object> { ["n"] = n, ["vence"] = Nulo(a["vence"]) ? "" : Convert.ToDateTime(a["vence"], ci).ToString("yyyy-MM-dd"), ["importe"] = Math.Round(imp, 2), ["pagado"] = Math.Round(pg, 2), ["saldo"] = Math.Round(Math.Max(0, imp - pg), 2) });
    }
    double pend = res.Sum(x => (double)x["saldo"]), dif = Math.Round(saldo - pend, 2);
    if (Math.Abs(dif) > 0.004)
    {
        if (dif > 0) { var ult = res.Last(); ult["saldo"] = Math.Round((double)ult["saldo"] + dif, 2); ult["importe"] = Math.Round((double)ult["importe"] + dif, 2); }
        else { double sobra = -dif; for (int i = res.Count - 1; i >= 0 && sobra > 0.004; i--) { double s = (double)res[i]["saldo"], q = Math.Min(s, sobra); res[i]["saldo"] = Math.Round(s - q, 2); sobra = Math.Round(sobra - q, 2); } }
    }
    return res;
}
// Todo lo que le ha pasado a un documento: sus parcialidades y cada aplicación (cobro, pago o nota de crédito) con folio, fecha, moneda, tipo de cambio y parcialidad. La ventana lo pide al seleccionar el documento.
Dictionary<string, object> DetalleDoc(long doc)
{
    var res = new Dictionary<string, object>();
    var d = ctx.Query("SELECT d.DocumentID, d.ModuleID, d.FolioPrefix, d.Folio, ISNULL(d.Total,0) AS Total, ISNULL(d.Balance,0) AS Saldo, ISNULL(d.TotalPaid,0) AS Pagado, ISNULL(d.CurrencyID,0) AS Moneda, ISNULL(d.Rate,1) AS TC FROM docDocument d WHERE d.DocumentID = " + doc + " AND d.OwnedBusinessEntityID = " + empresa);
    if (d.Count == 0) return res;
    int mon = MonedaDe(d[0]["Moneda"]); double saldo = D(d[0]["Saldo"]);
    res["id"] = doc; res["folio"] = (S(d[0]["FolioPrefix"]) + S(d[0]["Folio"])).Trim(); res["moneda"] = mon; res["simbolo"] = SimboloDe(mon); res["total"] = D(d[0]["Total"]); res["saldo"] = saldo; res["pagado"] = D(d[0]["Pagado"]); res["tcDoc"] = D(d[0]["TC"]);
    res["parc"] = ParcialidadesDe(doc, saldo);
    var aplic = new List<Dictionary<string, object>>();
    foreach (var r in ctx.Query("SELECT p.DocumentPaymentID AS id, p.DateOperation, ISNULL(p.Amount,0) AS Amount, ISNULL(p.Rate,1) AS Rate, ISNULL(p.PartialityNumber,0) AS Parc, ISNULL(p.FinancialOperationID,0) AS Op, ISNULL(p.PaymentWithDocumentID,0) AS ConDoc, " +
        "o.ModuleID AS OpMod, o.FolioPrefix AS OpPre, o.Folio AS OpFol, ISNULL(o.CurrencyID,0) AS OpMon, ISNULL(o.Amount,0) AS OpAmt, nc.ModuleID AS NcMod, nc.FolioPrefix AS NcPre, nc.Folio AS NcFol, ISNULL(m.ModuleName,'') AS NcNombre " +
        "FROM docDocumentPayment p LEFT JOIN docFinancialOperation o ON o.FinancialOperationID = p.FinancialOperationID LEFT JOIN docDocument nc ON nc.DocumentID = p.PaymentWithDocumentID LEFT JOIN engModule m ON m.ModuleID = nc.ModuleID " +
        "WHERE p.DocumentID = " + doc + " AND p.DeletedOn IS NULL ORDER BY p.DateOperation, p.DocumentPaymentID"))
    {
        bool nota = L(r["ConDoc"]) > 0; int opMod = Nulo(r["OpMod"]) ? 0 : I(r["OpMod"]);
        string tipo = nota ? "nota" : opMod == 248 ? "cobro" : opMod == 247 ? "pago" : "otro";
        string folio = nota ? (S(r["NcNombre"]) + " " + (S(r["NcPre"]) + S(r["NcFol"])).Trim()).Trim() : (S(r["OpPre"]) + "-" + S(r["OpFol"])).Trim('-', ' ');
        aplic.Add(new Dictionary<string, object> { ["fecha"] = Nulo(r["DateOperation"]) ? "" : Convert.ToDateTime(r["DateOperation"], ci).ToString("yyyy-MM-dd"), ["tipo"] = tipo, ["folio"] = folio, ["monto"] = Math.Round(D(r["Amount"]), 2),
            ["tc"] = D(r["Rate"]), ["parc"] = I(r["Parc"]) == 0 ? 1 : I(r["Parc"]), ["monedaOp"] = Nulo(r["OpMod"]) ? mon : MonedaDe(r["OpMon"]), ["montoOp"] = Nulo(r["OpMod"]) ? 0.0 : Math.Round(D(r["OpAmt"]), 2) });
    }
    res["aplic"] = aplic;
    return res;
}
// Los últimos cobros o pagos de esa persona (los 8 más recientes que no estén cancelados), con la cuenta y a cuántos documentos se aplicaron
List<Dictionary<string, object>> MovimientosDe(long entidad, string clave)
{
    if (!tipoPor.ContainsKey(clave) || entidad <= 0) return new List<Dictionary<string, object>>();
    return ctx.Query("SELECT TOP 8 o.FinancialOperationID AS id, o.FolioPrefix, o.Folio, o.DateOperation, ISNULL(o.Amount,0) AS Monto, ISNULL(f.FinancialEntityName,'') AS Cuenta, " +
        "(SELECT COUNT(*) FROM docDocumentPayment p WHERE p.FinancialOperationID = o.FinancialOperationID AND p.DeletedOn IS NULL) AS Docs FROM docFinancialOperation o LEFT JOIN orgFinancialEntity f ON f.FinancialEntityID = o.FinancialEntityID " +
        "WHERE o.BusinessEntityID = " + entidad + " AND o.ModuleID = " + (int)tipoPor[clave]["modOp"] + " AND o.CancelledOn IS NULL AND o.DeletedOn IS NULL ORDER BY o.DateOperation DESC, o.FinancialOperationID DESC")
        .Select(r => new Dictionary<string, object> { ["id"] = L(r["id"]), ["folio"] = (S(r["FolioPrefix"]) + "-" + S(r["Folio"])).Trim(), ["fecha"] = Nulo(r["DateOperation"]) ? "" : Convert.ToDateTime(r["DateOperation"], ci).ToString("yyyy-MM-dd"),
            ["monto"] = D(r["Monto"]), ["cuenta"] = S(r["Cuenta"]), ["docs"] = I(r["Docs"]) }).ToList();
}

// Comportamiento de pago de una persona: lo cobrado (o pagado) por mes en los últimos 12 meses, los días promedio que tarda desde la fecha del documento, el atraso promedio
// frente al vencimiento y el porcentaje de pagos a tiempo. Todo sale de Comercial en ese momento.
Dictionary<string, object> InteligenciaPago(long entidad, string clave)
{
    var res = new Dictionary<string, object>();
    if (!tipoPor.ContainsKey(clave) || entidad <= 0) return res;
    var t = tipoPor[clave]; string lado = (string)t["lado"]; var mods = modulosLado[lado];
    var porMes = new Dictionary<string, double[]>();
    foreach (var r in ctx.Query("SELECT CONVERT(CHAR(7), o.DateOperation, 120) AS mes, SUM(ISNULL(o.Amount,0)) AS total, COUNT(*) AS n FROM docFinancialOperation o WHERE o.BusinessEntityID = " + entidad + " AND o.ModuleID = " + (int)t["modOp"] +
        " AND o.CancelledOn IS NULL AND o.DeletedOn IS NULL AND o.DateOperation >= DATEADD(MONTH, -11, DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1)) GROUP BY CONVERT(CHAR(7), o.DateOperation, 120)"))
        porMes[S(r["mes"])] = new[] { D(r["total"]), D(r["n"]) };
    var meses = new List<Dictionary<string, object>>(); double total12 = 0; int mov12 = 0; var hoy = DateTime.Today;
    for (int i = 11; i >= 0; i--)
    {
        var m = new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-i); string k = m.ToString("yyyy-MM", ci); double[] v; if (!porMes.TryGetValue(k, out v)) v = new double[] { 0, 0 };
        meses.Add(new Dictionary<string, object> { ["mes"] = k, ["total"] = Math.Round(v[0], 2), ["n"] = (int)v[1] }); total12 += v[0]; mov12 += (int)v[1];
    }
    res["meses"] = meses; res["total12"] = Math.Round(total12, 2); res["mov12"] = mov12;
    if (mods.Count > 0)
    {
        var e = ctx.Query("SELECT COUNT(*) AS n, AVG(CAST(DATEDIFF(DAY, d.DateDocument, p.DateOperation) AS float)) AS dias, AVG(CAST(DATEDIFF(DAY, ISNULL(ag.due, d.DateDocument), p.DateOperation) AS float)) AS atraso, " +
            "SUM(CASE WHEN p.DateOperation <= ISNULL(ag.due, d.DateDocument) THEN 1.0 ELSE 0 END) AS aTiempo FROM docDocumentPayment p JOIN docDocument d ON d.DocumentID = p.DocumentID " +
            "OUTER APPLY (SELECT MAX(a.DatePayment) AS due FROM docDocumentPaymentAgenda a WHERE a.DocumentID = d.DocumentID AND a.DeletedOn IS NULL) ag " +
            "WHERE d.BusinessEntityID = " + entidad + " AND d.OwnedBusinessEntityID = " + empresa + " AND d.ModuleID IN (" + string.Join(",", mods) + ") AND p.DeletedOn IS NULL");
        int n = e.Count > 0 ? I(e[0]["n"]) : 0;
        res["pagos"] = n; res["dias"] = n > 0 && !Nulo(e[0]["dias"]) ? (object)Math.Round(D(e[0]["dias"]), 1) : null;
        res["atraso"] = n > 0 && !Nulo(e[0]["atraso"]) ? (object)Math.Round(D(e[0]["atraso"]), 1) : null;
        res["puntual"] = n > 0 ? (object)Math.Round(D(e[0]["aTiempo"]) * 100.0 / n, 0) : null;
    }
    return res;
}

// ---------- Catálogos y documentos con saldo para el formulario ----------
Dictionary<string, object> Catalogos()
{
    var cat = new Dictionary<string, object>();
    // Persona con RFC, límite de crédito y su último cobro o pago (fecha e importe), para dar contexto al capturar
    string ent(string tabla) =>
        "SELECT be.BusinessEntityID AS id, ISNULL(be.CommercialName, be.OfficialName) AS nombre, ISNULL(mi.OfficialNumber,'') AS rfc, ISNULL(x.CreditLimit,0) AS credito, u.DateOperation AS ultFecha, ISNULL(u.Amount,0) AS ultMonto FROM " + tabla + " x " +
        "JOIN orgBusinessEntity be ON be.BusinessEntityID = x.BusinessEntityID LEFT JOIN orgBusinessEntityMainInfo mi ON mi.BusinessEntityID = be.BusinessEntityID " +
        "OUTER APPLY (SELECT TOP 1 o.DateOperation, o.Amount FROM docFinancialOperation o WHERE o.BusinessEntityID = be.BusinessEntityID AND o.ModuleID IN (247,248) AND o.CancelledOn IS NULL AND o.DeletedOn IS NULL ORDER BY o.DateOperation DESC, o.FinancialOperationID DESC) u " +
        "WHERE be.DeletedOn IS NULL AND x.DeletedOn IS NULL ORDER BY nombre";
    Func<string, List<Dictionary<string, object>>> lista = tabla => ctx.Query(ent(tabla))
        .Select(r => new Dictionary<string, object> { ["id"] = I(r["id"]), ["nombre"] = S(r["nombre"]), ["rfc"] = S(r["rfc"]), ["credito"] = D(r["credito"]),
            ["ultFecha"] = Nulo(r["ultFecha"]) ? "" : Convert.ToDateTime(r["ultFecha"], ci).ToString("yyyy-MM-dd"), ["ultMonto"] = D(r["ultMonto"]) }).ToList();
    // Solo el lado de esta plantilla: la persona que lleva cuentas por cobrar no ve nada de las cuentas por pagar (y al revés); ni siquiera se cargan sus datos.
    bool verC = TIPOS.Any(t => (string)t["lado"] == "C"), verP = TIPOS.Any(t => (string)t["lado"] == "P");
    cat["clientes"] = verC ? lista("orgCustomer") : new List<Dictionary<string, object>>();
    cat["proveedores"] = verP ? lista("orgSupplier") : new List<Dictionary<string, object>>();
    cat["cuentas"] = ctx.Query("SELECT FinancialEntityID AS id, FinancialEntityName AS nombre, ISNULL(IsDefault,0) AS def, ISNULL(CurrencyID,0) AS moneda FROM orgFinancialEntity WHERE DeletedOn IS NULL ORDER BY ISNULL(IsDefault,0) DESC, FinancialEntityName")
        .Select(r => new Dictionary<string, object> { ["id"] = I(r["id"]), ["nombre"] = S(r["nombre"]), ["def"] = I(r["def"]) == 1, ["moneda"] = MonedaDe(r["moneda"]) }).ToList();
    cat["monedas"] = monedas;
    cat["formas"] = ctx.Query("SELECT ID AS id, Value AS nombre FROM vwcboCFDPaymentmethod ORDER BY CboOrder")
        .Select(r => new Dictionary<string, object> { ["id"] = I(r["id"]), ["nombre"] = S(r["nombre"]) }).ToList();
    // Folio siguiente de cada tipo (el mismo cálculo que usa Aplicar; con otro cobro simultáneo podría variar)
    var folios = new Dictionary<string, object>();
    foreach (var t in TIPOS)
        folios[(string)t["clave"]] = L(ctx.Scalar("SELECT ISNULL(MAX(TRY_CONVERT(BIGINT, Folio)),0) + 1 FROM docFinancialOperation WHERE ModuleID = " + (int)t["modOp"] + " AND FolioPrefix = N'" + (string)t["prefijo"] + "'"));
    cat["folios"] = folios;
    cat["docsC"] = verC ? DocsConSaldo("C") : new List<Dictionary<string, object>>();
    cat["docsP"] = verP ? DocsConSaldo("P") : new List<Dictionary<string, object>>();
    return cat;
}

// ---------- Importe en letra (el mismo estilo del comprobante mexicano) ----------
string[] LUNI = { "", "UNO", "DOS", "TRES", "CUATRO", "CINCO", "SEIS", "SIETE", "OCHO", "NUEVE", "DIEZ", "ONCE", "DOCE", "TRECE", "CATORCE", "QUINCE", "DIECISÉIS", "DIECISIETE", "DIECIOCHO", "DIECINUEVE", "VEINTE" };
string[] LDEC = { "", "", "VEINTE", "TREINTA", "CUARENTA", "CINCUENTA", "SESENTA", "SETENTA", "OCHENTA", "NOVENTA" };
string[] LVEI = { "VEINTIUNO", "VEINTIDÓS", "VEINTITRÉS", "VEINTICUATRO", "VEINTICINCO", "VEINTISÉIS", "VEINTISIETE", "VEINTIOCHO", "VEINTINUEVE" };
string[] LCEN = { "", "CIENTO", "DOSCIENTOS", "TRESCIENTOS", "CUATROCIENTOS", "QUINIENTOS", "SEISCIENTOS", "SETECIENTOS", "OCHOCIENTOS", "NOVECIENTOS" };
string LetraCentenas(int n)
{
    if (n == 0) return ""; if (n == 100) return "CIEN"; string r = ""; int c = n / 100, d = n % 100;
    if (c > 0) r += LCEN[c] + " ";
    if (d > 0) { if (d <= 20) r += LUNI[d]; else { int a = d / 10, u = d % 10; if (a == 2 && u > 0) r += LVEI[u - 1]; else { r += LDEC[a]; if (u > 0) r += " Y " + LUNI[u]; } } }
    return r.Trim();
}
string LetraEn(long n)
{
    if (n == 0) return "CERO"; string r = ""; long mill = n / 1000000; n %= 1000000; long mil = n / 1000; n %= 1000;
    if (mill > 0) r += mill == 1 ? "UN MILLÓN " : LetraCentenas((int)mill) + " MILLONES ";
    if (mil > 0) r += mil == 1 ? "MIL " : LetraCentenas((int)mil) + " MIL ";
    if (n > 0) r += LetraCentenas((int)n);
    r = r.Trim(); if (r.EndsWith("UNO")) r = r.Substring(0, r.Length - 3) + "UN"; return r;
}
string LetraImporte(double v, int moneda)
{
    v = Math.Max(0, v); long e = (long)Math.Floor(v); int c = (int)Math.Round((v - e) * 100); if (c == 100) { e++; c = 0; }
    string pal = monedaPor.ContainsKey(moneda) && S(monedaPor[moneda]["letra"]) != "" ? S(monedaPor[moneda]["letra"]).ToUpperInvariant() : "PESOS";
    return LetraEn(e) + " " + pal + " " + c.ToString("00") + "/100" + (moneda == 3 ? " M.N." : "");
}

// ---------- Aplicar ----------
// «spec»: tipo, entidad, cuenta, forma (c_FormaPago), fecha (yyyy-MM-dd), referencia, tc (tipo de cambio, solo si hay moneda extranjera), aplicaciones [{doc, monto, parcialidad}].
//   «monto» va SIEMPRE en la moneda de la CUENTA (lo que entra o sale del banco); «parcialidad» 0 = automática (en orden), n = esa parcialidad.
// Igual que Tesorería: UNA operación (un folio) con un renglón por documento (y por parcialidad), todo en una sola transacción: o queda todo o no queda nada.
// Moneda (verificado contra miles de aplicaciones de una empresa con dólares): el renglón se guarda en la moneda del DOCUMENTO, con su tipo de cambio en Rate y AmountPaidCurrency = Amount × Rate (valor en pesos):
//   · cuenta y documento en la misma moneda → importe tal cual (Rate = 1 en pesos, o el tipo de cambio en moneda extranjera);
//   · cuenta en pesos y documento en moneda extranjera → importe del documento = pesos ÷ tipo de cambio (Rate = tipo de cambio);
//   · cuenta en moneda extranjera y documento en pesos → importe del documento = moneda extranjera × tipo de cambio (Rate = 1; la operación guarda el tipo de cambio).
//   Cualquier otra combinación (p. ej. cuenta en euros y documento en dólares) se rechaza: usa la pantalla nativa de Tesorería.
// Regresa un resumen legible con el folio y, por documento, lo aplicado, su equivalente en la moneda del documento y lo que queda.
string Aplicar(Dictionary<string, object> spec)
{
    string clave = S(spec["tipo"]);
    if (!tipoPor.ContainsKey(clave)) throw new Exception("Tipo desconocido: " + clave);
    var t = tipoPor[clave]; string lado = (string)t["lado"];
    int entidad = I(spec["entidad"]), cuenta = I(spec["cuenta"]), forma = I(spec["forma"]);
    if (entidad <= 0) throw new Exception("Elige el " + (lado == "C" ? "cliente" : "proveedor") + ".");
    if (cuenta <= 0) throw new Exception("Elige la cuenta bancaria o caja " + (lado == "C" ? "donde entra" : "de donde sale") + " el dinero.");
    if (forma <= 0) throw new Exception("Elige la forma de pago.");
    var aps = ((System.Collections.IEnumerable)spec["aplicaciones"]).Cast<object>().Select(o => (Dictionary<string, object>)o).Where(a => D(a["monto"]) > 0).ToList();
    if (aps.Count == 0) throw new Exception("Marca al menos un documento y captura cuánto aplicar.");
    if (aps.Select(a => L(a["doc"])).Distinct().Count() != aps.Count) throw new Exception("Un documento no puede aparecer dos veces en el mismo movimiento.");
    string fecha = S(spec.ContainsKey("fecha") ? spec["fecha"] : ""); if (fecha.Length < 10) throw new Exception("Captura la fecha.");
    string f8 = Sq(fecha.Substring(0, 10).Replace("-", ""));
    string tracking = S(spec.ContainsKey("referencia") ? spec["referencia"] : "");
    double tc = spec.ContainsKey("tc") ? D(spec["tc"]) : 0;
    int modOp = (int)t["modOp"], recip = (int)t["recip"], tipoOp = (int)t["tipoOp"]; string pref = (string)t["prefijo"]; int coef = lado == "C" ? 1 : -1;
    var cu = ctx.Query("SELECT ISNULL(CurrencyID,0) AS Moneda FROM orgFinancialEntity WHERE FinancialEntityID = " + cuenta + " AND DeletedOn IS NULL");
    if (cu.Count == 0) throw new Exception("La cuenta elegida no existe.");
    int mCuenta = MonedaDe(cu[0]["Moneda"]);
    string persona = S(ctx.Scalar("SELECT ISNULL(CommercialName, OfficialName) FROM orgBusinessEntity WHERE BusinessEntityID = " + entidad));
    long owned = empresa;

    // 1) Cada documento: validación, conversión a su moneda y reparto por parcialidades (todo en memoria; no se escribe nada todavía)
    var lineas = new List<Dictionary<string, object>>();       // un renglón por (documento, parcialidad)
    var porDoc = new List<Dictionary<string, object>>();
    double totalCuenta = 0; var monedasForaneas = new HashSet<int>();
    foreach (var a in aps)
    {
        long doc = L(a["doc"]); double monto = Math.Round(D(a["monto"]), 2); int parcPedida = a.ContainsKey("parcialidad") ? I(a["parcialidad"]) : 0;
        var d = ctx.Query("SELECT Total, Balance, TotalPaid, BusinessEntityID, ISNULL(CurrencyID,0) AS Moneda, ModuleID, FolioPrefix, Folio FROM docDocument WHERE DocumentID=" + doc + " AND DeletedOn IS NULL AND CancelledOn IS NULL AND OwnedBusinessEntityID = " + empresa);
        string etiqueta = "documento " + doc;
        if (d.Count == 0) throw new Exception("No se pudo aplicar a " + etiqueta + ": el documento no existe o está cancelado.");
        var x = d[0]; etiqueta = nombreMod.ContainsKey(I(x["ModuleID"])) ? nombreMod[I(x["ModuleID"])] + " " + (S(x["FolioPrefix"]) + S(x["Folio"])).Trim() : etiqueta;
        if (!modulosLado[lado].Contains(I(x["ModuleID"]))) throw new Exception("No se pudo aplicar a " + etiqueta + ": no es un documento que se " + (lado == "C" ? "cobre" : "pague") + ".");
        if (I(x["BusinessEntityID"]) != entidad) throw new Exception("No se pudo aplicar a " + etiqueta + ": pertenece a otro " + (lado == "C" ? "cliente" : "proveedor") + ".");
        double total = D(x["Total"]), saldo = D(x["Balance"]), pagado = D(x["TotalPaid"]); int mDoc = MonedaDe(x["Moneda"]);
        if (total <= 0) throw new Exception("No se pudo aplicar a " + etiqueta + ": tiene total cero.");
        string modo;
        if (mCuenta == mDoc) modo = "igual";
        else if (mCuenta == 3) modo = "cuentaPesos";
        else if (mDoc == 3) modo = "cuentaExtranjera";
        else throw new Exception("No se pudo aplicar a " + etiqueta + ": la cuenta está en " + SimboloDe(mCuenta) + " y el documento en " + SimboloDe(mDoc) + ". Esa combinación solo se puede registrar en la pantalla nativa de Tesorería.");
        if (mCuenta != 3) monedasForaneas.Add(mCuenta);
        if (mDoc != 3) monedasForaneas.Add(mDoc);
        // Importe en la moneda del documento y tipo de cambio del renglón
        double docAmt, rateLinea;
        if (modo == "igual") { docAmt = monto; rateLinea = mDoc == 3 ? 1 : tc; }
        else if (modo == "cuentaPesos") { if (!(tc > 0)) throw new Exception("Captura el tipo de cambio: " + etiqueta + " está en " + SimboloDe(mDoc) + " y la cuenta en pesos."); docAmt = monto / tc; rateLinea = tc; }
        else { if (!(tc > 0)) throw new Exception("Captura el tipo de cambio: la cuenta está en " + SimboloDe(mCuenta) + " y " + etiqueta + " en pesos."); docAmt = monto * tc; rateLinea = 1; }
        if (modo == "igual" && mDoc != 3 && !(tc > 0)) throw new Exception("Captura el tipo de cambio de " + SimboloDe(mDoc) + ".");
        docAmt = Math.Round(docAmt, 2);
        if (Math.Abs(docAmt - saldo) <= 0.011) docAmt = saldo;                                          // un residuo de redondeo de la conversión no deja el documento «casi liquidado»
        if (docAmt > saldo + 0.005) throw new Exception("No se pudo aplicar a " + etiqueta + ": el importe (" + docAmt.ToString("N2") + " " + SimboloDe(mDoc) + ") es mayor que su saldo (" + saldo.ToString("N2") + " " + SimboloDe(mDoc) + ").");
        // Reparto por parcialidades: la pedida o, en automático, en orden
        var parc = ParcialidadesDe(doc, saldo); var reparto = new List<KeyValuePair<int, double>>(); double resto = docAmt;
        if (parcPedida > 0)
        {
            var pp = parc.FirstOrDefault(p => (int)p["n"] == parcPedida); if (pp == null) throw new Exception("No se pudo aplicar a " + etiqueta + ": no tiene la parcialidad " + parcPedida + ".");
            if (docAmt > (double)pp["saldo"] + 0.011) throw new Exception("No se pudo aplicar a " + etiqueta + ": la parcialidad " + parcPedida + " solo tiene pendiente " + ((double)pp["saldo"]).ToString("N2") + " " + SimboloDe(mDoc) + ".");
            reparto.Add(new KeyValuePair<int, double>(parcPedida, docAmt));
        }
        else
        {
            foreach (var p in parc) { if (resto <= 0.0049) break; double s = (double)p["saldo"]; if (s <= 0.0049) continue; double q = Math.Min(s, resto); reparto.Add(new KeyValuePair<int, double>((int)p["n"], Math.Round(q, 2))); resto = Math.Round(resto - q, 2); }
            if (resto > 0.0049) { if (reparto.Count > 0) reparto[reparto.Count - 1] = new KeyValuePair<int, double>(reparto.Last().Key, Math.Round(reparto.Last().Value + resto, 2)); else reparto.Add(new KeyValuePair<int, double>(1, resto)); }
        }
        double corriente = saldo;
        foreach (var pr in reparto)
        {
            double sa = corriente, si = Math.Round(corriente - pr.Value, 2); corriente = si;
            lineas.Add(new Dictionary<string, object> { ["doc"] = doc, ["parc"] = pr.Key, ["monto"] = pr.Value, ["rate"] = rateLinea, ["sa"] = sa, ["si"] = si });
        }
        totalCuenta += monto;
        porDoc.Add(new Dictionary<string, object> { ["doc"] = doc, ["etiqueta"] = etiqueta, ["total"] = total, ["saldo"] = saldo, ["pagado"] = pagado, ["docAmt"] = docAmt, ["nuevo"] = Math.Round(saldo - docAmt, 2), ["monto"] = monto, ["mDoc"] = mDoc, ["reparto"] = reparto });
    }
    if (monedasForaneas.Count > 1) throw new Exception("Los documentos están en monedas extranjeras distintas (" + string.Join(", ", monedasForaneas.Select(SimboloDe)) + "): regístralos por separado.");
    double rateOp = mCuenta == 3 ? 1 : tc;
    totalCuenta = Math.Round(totalCuenta, 2);

    // 2) Una sola transacción: la operación, sus renglones, los espejos, la transferencia, el reparto de impuestos y los saldos
    var sb = new StringBuilder();
    sb.Append("DECLARE @out TABLE(FinancialOperationID BIGINT); DECLARE @outPay TABLE(DocumentPaymentID BIGINT);\nBEGIN TRY BEGIN TRAN;\n");
    sb.Append("DECLARE @lk INT; EXEC @lk = sp_getapplock @Resource = 'BrosCobroFolio_" + modOp + "_" + pref + "', @LockMode = 'Exclusive', @LockOwner = 'Transaction', @LockTimeout = 15000;\n");
    sb.Append("IF @lk < 0 THROW 50001, 'No se pudo obtener el candado del folio (otro cobro/pago en curso).', 1;\n");
    foreach (var pd in porDoc)       // el saldo se vuelve a comprobar DENTRO de la transacción: si alguien más aplicó algo mientras tanto, no se aplica de más
        sb.Append("IF (SELECT ISNULL(Balance,0) FROM docDocument WHERE DocumentID=" + (long)pd["doc"] + ") < " + Num((double)pd["docAmt"] - 0.011) + " THROW 50002, 'El saldo de un documento cambió mientras se capturaba.', 1;\n");
    sb.Append("DECLARE @folio BIGINT = ISNULL((SELECT MAX(TRY_CONVERT(BIGINT, Folio)) FROM docFinancialOperation WHERE ModuleID=" + modOp + " AND FolioPrefix=N'" + pref + "'),0)+1;\n");
    sb.Append("DECLARE @f DATETIME = '" + f8 + " 12:00:00'; DECLARE @opId BIGINT, @payId BIGINT;\n");
    sb.Append("INSERT INTO docFinancialOperation (ModuleID, DocRecipientID, DocumentTypeID, OwnedBusinessEntityID, BusinessEntityID, DateOperation, DateAffectation, FinancialEntityID, DebitCreditCoef, Amount, CurrencyID, FinancialEntityAmount, Rate, AmountRate, PaymentMethodID, " +
        "Description, PartialityNumber, PartialityTotal, DocumentID, Reference, TotalLetter, RecipientName, ExportID, VersionComplemento, FolioPrefix, Folio, CreatedOn, CreatedBy) OUTPUT INSERTED.FinancialOperationID INTO @out ");
    sb.Append("VALUES (" + modOp + "," + recip + "," + tipoOp + "," + owned + "," + entidad + ",@f,@f," + cuenta + "," + coef + "," + Num(totalCuenta) + "," + mCuenta + "," + Num(coef * totalCuenta) + "," + Num(rateOp) + "," + Num(totalCuenta * rateOp) + "," + forma + "," +
        "N'" + Sq((lado == "C" ? "Cobro Cliente " : "Pago Proveedor ") + persona) + "',0,0,0," + (tracking == "" ? "NULL" : "N'" + Sq(tracking) + "'") + ",N'" + Sq(LetraImporte(totalCuenta, mCuenta)) + "',N'" + Sq(persona) + "'," + (lado == "C" ? 1 : 0) + ",N'2.0',N'" + pref + "',CONVERT(NVARCHAR(50),@folio),GETDATE()," + ctx.erp.UserId + ");\n");
    sb.Append("SELECT @opId = FinancialOperationID FROM @out;\n");
    foreach (var ln in lineas)
    {
        long doc = (long)ln["doc"]; double m = (double)ln["monto"], r = (double)ln["rate"];
        sb.Append("INSERT INTO docDocumentPayment (DocumentID, FinancialOperationID, DateOperation, Amount, Rate, AmountPaidCurrency, PartialityNumber, SaldoAnterior, SaldoInsoluto) OUTPUT INSERTED.DocumentPaymentID INTO @outPay VALUES (" +
            doc + ",@opId,@f," + Num(m) + "," + Num(r) + "," + Num(m * r) + "," + (int)ln["parc"] + "," + Num((double)ln["sa"]) + "," + Num((double)ln["si"]) + ");\nSELECT @payId = DocumentPaymentID FROM @outPay; DELETE FROM @outPay;\n");
        // docDocumentPaymentEspejo.DocumentPaymentID NO es identity: espeja el mismo id recién generado
        sb.Append("INSERT INTO docDocumentPaymentEspejo (DocumentPaymentID, DocumentID, FinancialOperationID, DateOperation, Amount, Rate, AmountPaidCurrency, PartialityNumber) VALUES (@payId," + doc + ",@opId,@f," + Num(m) + "," + Num(r) + "," + Num(m * r) + "," + (int)ln["parc"] + ");\n");
    }
    if (forma != 1)       // efectivo no lleva transferencia; cualquier otra forma deja su registro bancario
        sb.Append("INSERT INTO docBankTransfer (FinancialOperationID, FinancialEntityID, TrackingNumber, CreatedOn, CreatedBy) VALUES (@opId," + cuenta + "," + (tracking == "" ? "NULL" : "N'" + Sq(tracking) + "'") + ",GETDATE()," + ctx.erp.UserId + ");\n");
    foreach (var pd in porDoc)
    {
        long doc = (long)pd["doc"]; double prop = (double)pd["docAmt"] / (double)pd["total"];
        // Reparto proporcional de impuestos: lo aplicado al documento (en su moneda) entre su total
        foreach (var tx in ctx.Query("SELECT DocumentTaxDetailID, DocumentItemID, TaxTypeID, Amount, TaxBase, TaxPerc, TaxName, TaxTypeName FROM docDocumentTaxDetail WHERE DocumentID=" + doc))
            sb.Append("INSERT INTO docFinancialOperationTaxDetail (DocumentTaxDetailID, FinancialOperationID, DocumentID, DocumentItemID, Proporcion, Amount, TaxTypeID, TaxName, TaxTypeName, TaxBase, TaxPerc) VALUES (" +
                L(tx["DocumentTaxDetailID"]) + ",@opId," + doc + "," + (Nulo(tx["DocumentItemID"]) ? "NULL" : L(tx["DocumentItemID"]).ToString()) + "," + Num(prop) + "," + Num(D(tx["Amount"]) * prop) + "," + I(tx["TaxTypeID"]) +
                ",N'" + Sq(S(tx["TaxName"])) + "',N'" + Sq(S(tx["TaxTypeName"])) + "'," + Num(D(tx["TaxBase"]) * prop) + "," + Num(D(tx["TaxPerc"])) + ");\n");
        sb.Append("UPDATE docDocument SET TotalPaid=" + Num((double)pd["pagado"] + (double)pd["docAmt"]) + ", Balance=" + Num((double)pd["nuevo"]) + ", StatusPaidID=" + ((double)pd["nuevo"] <= 0.0049 ? 1 : 2) + " WHERE DocumentID=" + doc + ";\n");
    }
    sb.Append("COMMIT TRAN;\nSELECT @folio AS Folio;\nEND TRY BEGIN CATCH IF @@TRANCOUNT>0 ROLLBACK TRAN; THROW; END CATCH;");
    var res = ctx.Query(sb.ToString(), soloLectura: false);
    long folio = res.Count > 0 ? L(res[0]["Folio"]) : -1;
    var resumen = new List<string>();
    foreach (var pd in porDoc)
    {
        int mDoc = (int)pd["mDoc"]; double nuevo = (double)pd["nuevo"]; string reparto = string.Join(" + ", ((List<KeyValuePair<int, double>>)pd["reparto"]).Select(k => "parc. " + k.Key));
        string conv = mDoc != mCuenta ? " (" + ((double)pd["docAmt"]).ToString("N2") + " " + SimboloDe(mDoc) + ")" : "";
        resumen.Add(pd["etiqueta"] + " · " + ((double)pd["monto"]).ToString("N2") + " " + SimboloDe(mCuenta) + conv + " · " + reparto + (nuevo <= 0.0049 ? " · liquidado" : " · queda " + nuevo.ToString("N2") + " " + SimboloDe(mDoc)));
    }
    return (string)t["nombre"] + " " + pref + "-" + folio + " registrado: " + totalCuenta.ToString("N2") + " " + SimboloDe(mCuenta) + (monedasForaneas.Count > 0 ? " a tipo de cambio " + tc.ToString("0.####") : "") + "\n" + string.Join("\n", resumen);
}

// ---------- Pruebas automáticas (sin ventanas): BROSLMV_PAGO_TEST = JSON con el «spec»; el resultado va al archivo BROSLMV_PAGO_OUT ----------
string modoPrueba = Environment.GetEnvironmentVariable("BROSLMV_PAGO_TEST");
if (!string.IsNullOrEmpty(modoPrueba))
{
    var spec = ser.Deserialize<Dictionary<string, object>>(modoPrueba);
    string resultado;
    if (spec.ContainsKey("catalogo") && (bool)spec["catalogo"]) resultado = ser.Serialize(Catalogos());
    else if (spec.ContainsKey("movimientos")) resultado = ser.Serialize(MovimientosDe(L(spec["entidad"]), S(spec["tipo"])));
    else if (spec.ContainsKey("docs")) resultado = ser.Serialize(DocsConSaldo(S(spec["lado"])));
    else if (spec.ContainsKey("detalle")) resultado = ser.Serialize(DetalleDoc(L(spec["doc"])));
    else if (spec.ContainsKey("inteligencia")) resultado = ser.Serialize(InteligenciaPago(L(spec["entidad"]), S(spec["tipo"])));
    else { try { resultado = "OK " + Aplicar(spec); } catch (Exception ex) { resultado = "ERROR " + ex.Message; } }
    string salidaPrueba = Environment.GetEnvironmentVariable("BROSLMV_PAGO_OUT");
    if (!string.IsNullOrEmpty(salidaPrueba)) System.IO.File.WriteAllText(salidaPrueba, resultado, new System.Text.UTF8Encoding(false));
    return resultado;
}
