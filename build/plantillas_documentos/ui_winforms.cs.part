pChips.Paint += (s, e) =>
{
    int x = 0; var g = e.Graphics; g.TextRenderingHint = System.Drawing.Text.TextRenderingHint.ClearTypeGridFit;
    foreach (var p in pastillas)
    {
        var sz1 = g.MeasureString(p.Titulo, F_SM); var sz2 = g.MeasureString(p.Valor, F_B); int w = (int)Math.Max(sz1.Width, sz2.Width) + 18;
        using (var b = new SolidBrush(C_HEAD)) g.FillRectangle(b, x, 0, w, 32); using (var pen = new Pen(C_LINE)) g.DrawRectangle(pen, x, 0, w - 1, 31);
        using (var b = new SolidBrush(C_MUTED)) g.DrawString(p.Titulo, F_SM, b, x + 9, 1); using (var b = new SolidBrush(p.Color)) g.DrawString(p.Valor, F_B, b, x + 9, 15);
        x += w + 6;
    }
};
