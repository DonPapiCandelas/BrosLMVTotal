// ===================================================================================================================================
// VENTANA (Windows Forms, NO modal: Show, nunca ShowDialog → se puede minimizar y seguir trabajando en Comercial).
// Diseño de «documento de Comercial»: cinta oscura con las acciones y la información del documento (fecha, serie, folio, entrega), grupos numerados
// con una etiqueta arriba de cada campo (nada se encima ni se corta), y las partidas con captura rápida + tabla editable.
//   1 · Cliente / proveedor (búsqueda por nombre o RFC, saldo, crédito) · 2 · Almacén, centro de costo y moneda con tipo de cambio ·
//   3 · Datos fiscales del CFDI (uso, forma y método de pago; solo la factura de cliente) · 4 · Documento de origen (si el tipo parte de otro) ·
//   Partidas · Comentarios · Totales con importe en letra.
// Los manejadores llevan try/catch porque, en modeless, el script «ya terminó» cuando se hace clic. Al guardar SIEMPRE se abre el documento nativo de Comercial.
// ===================================================================================================================================
class Opcion { public int Id { get; set; } public string Nombre { get; set; } public string Extra { get; set; } public override string ToString() => Nombre; }
class Fila { public int Id; public string Clave = "", Nombre = "", Unidad = ""; public double Cant = 1, Max = 0, Precio, Desc; public int Imp; public long OrigenItem; public long Origen; }
class Pastilla { public string Titulo, Valor; public Color Color; }

var catalogo = Catalogos(CLAVES);
var origenes = Origenes(seleccion);
Func<string, List<Dictionary<string, object>>> cat = k => (List<Dictionary<string, object>>)catalogo[k];
var impuestos = cat("impuestos").Select(i => new Opcion { Id = I(i["id"]), Nombre = S(i["nombre"]), Extra = S(i["perc"]) }).ToList();
var percImp = cat("impuestos").ToDictionary(i => I(i["id"]), i => D(i["perc"]));
var productos = cat("productos");
var monedas = cat("monedas");
var existencias = (Dictionary<string, object>)catalogo["existencias"];
var folios = (Dictionary<string, object>)catalogo["folios"];
var filas = new List<Fila>();
var origenSel = new List<long>();
var pendientes = new List<Dictionary<string, object>>();
var pastillas = new List<Pastilla>();
Dictionary<string, object> entSel = null, prodSel = null;
bool guardando = false, suspender = false, metodoManual = false, verG3 = true, verG4 = false;          // Control.Visible miente hasta que la ventana se muestra: se llevan banderas propias
int tipoIdx = 0;
string quienSoy = "", nombreEmpresa = "";
try { quienSoy = S(ctx.Scalar("SELECT TOP 1 ISNULL(UserName,'') FROM engUser WHERE UserID = " + ctx.erp.UserId)); } catch { }
try { nombreEmpresa = S(ctx.Scalar("SELECT TOP 1 ISNULL(CommercialName, OfficialName) FROM orgBusinessEntity WHERE BusinessEntityID = " + empresa)); } catch { }

// ---------- diseño ----------
var C_BG = Color.FromArgb(241, 245, 249); var C_LINE = Color.FromArgb(203, 213, 225); var C_TXT = Color.FromArgb(30, 41, 59); var C_MUTED = Color.FromArgb(100, 116, 139);
var C_HEAD = Color.FromArgb(248, 250, 252); var C_SEL = Color.FromArgb(238, 242, 255); var C_RIB = Color.FromArgb(51, 65, 85); var C_RIB_TX = Color.FromArgb(226, 232, 240); var C_RIB_MU = Color.FromArgb(148, 163, 184);
var C_VENTA = Color.FromArgb(37, 99, 235); var C_COMPRA = Color.FromArgb(15, 118, 110); var C_ROJO = Color.FromArgb(200, 40, 40); var C_AMBAR = Color.FromArgb(180, 83, 9); var C_VERDE = Color.FromArgb(22, 128, 59);
var F_BASE = new Font("Segoe UI", 9f); var F_B = new Font("Segoe UI", 9f, FontStyle.Bold); var F_H2 = new Font("Segoe UI", 9.5f, FontStyle.Bold); var F_SM = new Font("Segoe UI", 8.5f);
var F_ICON = new Font("Segoe UI Emoji", 20f); var F_TOT = new Font("Segoe UI Semibold", 18f); var F_VAL = new Font("Segoe UI Semibold", 11f); var F_ITAL = new Font("Segoe UI", 9f, FontStyle.Italic);

var frm = new Form { Text = "Crear documento · BrosLMV", ClientSize = new Size(1200, 900), MinimumSize = new Size(1160, 820), StartPosition = FormStartPosition.CenterScreen, BackColor = C_BG, Font = F_BASE, KeyPreview = true };
void Seguro(Action a) { try { a(); } catch (Exception ex) { guardando = false; MessageBox.Show(ex.Message, "Crear documento", MessageBoxButtons.OK, MessageBoxIcon.Warning); } }
Dictionary<string, object> TipoActual() => TIPOS[tipoIdx];
bool EsVenta() => (string)TipoActual()["lado"] == "C";
bool ConCfdi() => LlevaCfdi((string)TipoActual()["clave"]);
Color Acento() => EsVenta() ? C_VENTA : C_COMPRA;

