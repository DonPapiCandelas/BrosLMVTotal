Label lblRibTitulo = null, lblEntregaEt = null, lblOrigenEst = null, lblNumPart = null, lblSub = null, lblDes = null, lblImp = null, lblTot = null, lblTotEt = null, lblLetra = null, lblPie = null, lblAvisos = null, lblToast = null, lblHint = null;
DateTimePicker dtFecha = null, dtEntrega = null;
TextBox txtSerie = null, txtFolio = null, txtEnt = null, txtRfc = null, txtProd = null, txtTitulo = null, txtComent = null;
ComboBox cmbCond = null, cmbAlm = null, cmbCC = null, cmbMon = null, cmbUso = null, cmbForma = null, cmbMetodo = null, cmbImp = null;
NumericUpDown nudTC = null, nudCant = null, nudPrecio = null, nudDesc = null;
CheckedListBox clbOrigen = null; DataGridView grid = null; ListBox lstEnt = null, lstProd = null;
var btnsTipo = new List<Button>(); var botonesCinta = new List<Panel>();

// ---------- piezas de construcción ----------
Panel Grupo(Func<string> titulo)
{
    var p = new Panel { BackColor = Color.White, Size = new Size(600, 120) };
    p.Paint += (s, e) =>
    {
        var g = e.Graphics; using (var pen = new Pen(C_LINE)) g.DrawRectangle(pen, 0, 0, p.Width - 1, p.Height - 1);
        using (var b = new SolidBrush(C_HEAD)) g.FillRectangle(b, 1, 1, p.Width - 2, 27); using (var pen = new Pen(C_LINE)) g.DrawLine(pen, 0, 28, p.Width, 28);
        using (var b = new SolidBrush(Acento())) g.FillRectangle(b, 1, 1, 4, 27);
        using (var b = new SolidBrush(C_TXT)) g.DrawString(titulo(), F_H2, b, 14, 5);
    };
    return p;
}
Label Et(Control padre, string t, int x, int y) { var l = new Label { Text = t, Location = new Point(x, y), AutoSize = true, ForeColor = C_MUTED, Font = F_SM, BackColor = Color.Transparent }; padre.Controls.Add(l); return l; }
TextBox Cuadro(Control padre, string etiqueta, int x, int y, int w, bool soloLectura = false)
{
    // Marco de altura fija que dibuja el borde; el TextBox va adentro SIN borde y centrado. Así la altura no depende de cómo calcule Windows la del TextBox
    // (cambia con el monitor y la escala) y ya no se encima con la etiqueta.
    if (etiqueta != "") Et(padre, etiqueta, x, y);
    var marco = new Panel { Location = new Point(x, y + 18), Size = new Size(w, 26), BackColor = soloLectura ? C_HEAD : Color.White };
    marco.Paint += (s, e) => { using (var pen = new Pen(C_LINE)) e.Graphics.DrawRectangle(pen, 0, 0, marco.Width - 1, marco.Height - 1); };
    var t = new TextBox { BorderStyle = BorderStyle.None, ReadOnly = soloLectura, BackColor = marco.BackColor, ForeColor = soloLectura ? C_MUTED : C_TXT, Width = w - 14 };
    t.Location = new Point(7, Math.Max(0, (26 - t.Height) / 2)); t.Tag = marco;
    marco.Controls.Add(t); padre.Controls.Add(marco); marco.Click += (s, e) => t.Focus();
    return t;
}
Control Caja(TextBox t) { return (t.Tag as Control) ?? t; }
ComboBox Lista(Control padre, string etiqueta, int x, int y, int w, int anchoMenu = 0)
{
    Et(padre, etiqueta, x, y);
    var c = new ComboBox { Width = w, DropDownStyle = ComboBoxStyle.DropDownList, FlatStyle = FlatStyle.Flat }; c.Location = new Point(x, y + 18 + Math.Max(0, (26 - c.Height) / 2)); if (anchoMenu > 0) c.DropDownWidth = anchoMenu; padre.Controls.Add(c); return c;
}
NumericUpDown Numero(Control padre, string etiqueta, int x, int y, int w, int dec, decimal max)
{
    Et(padre, etiqueta, x, y);
    var n = new NumericUpDown { Width = w, DecimalPlaces = dec, Maximum = max, Minimum = 0, ThousandsSeparator = true, TextAlign = HorizontalAlignment.Right }; n.Location = new Point(x, y + 18 + Math.Max(0, (26 - n.Height) / 2)); padre.Controls.Add(n); return n;
}
void PonerPorId(ComboBox c, int id) { for (int i = 0; i < c.Items.Count; i++) if (((Opcion)c.Items[i]).Id == id) { c.SelectedIndex = i; return; } if (c.Items.Count > 0) c.SelectedIndex = 0; }
void PonerPorClave(ComboBox c, string clave) { for (int i = 0; i < c.Items.Count; i++) if (string.Equals(((Opcion)c.Items[i]).Extra, clave, StringComparison.OrdinalIgnoreCase)) { c.SelectedIndex = i; return; } }
string ClaveDe(ComboBox c) { var o = c.SelectedItem as Opcion; return o == null ? "" : o.Extra ?? ""; }
void LlenarSat(ComboBox c, string grupo) { c.Items.Clear(); foreach (var x in cat(grupo)) c.Items.Add(new Opcion { Id = c.Items.Count, Extra = S(x["clave"]), Nombre = S(x["clave"]) + "  ·  " + S(x["nombre"]) }); }

// ---------- cinta superior ----------
ribbon = new Panel { BackColor = C_RIB, Size = new Size(1176, 100) };
lblRibTitulo = new Label { Text = "Nuevo documento", Font = F_H2, ForeColor = C_RIB_TX, BackColor = C_RIB, Location = new Point(12, 5), AutoSize = true }; ribbon.Controls.Add(lblRibTitulo);
int bx = 12;
Panel Boton(string icono, string texto, string tecla, Color? colorIcono, Action alClic)
{
    var p = new Panel { Location = new Point(bx, 26), Size = new Size(84, 68), BackColor = C_RIB, Cursor = Cursors.Hand }; bx += 88;
    var li = new Label { Text = icono, Font = F_ICON, ForeColor = colorIcono ?? C_RIB_TX, BackColor = C_RIB, AutoSize = false, Size = new Size(84, 34), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 0) };
    var lt = new Label { Text = texto, Font = F_SM, ForeColor = C_RIB_TX, BackColor = C_RIB, AutoSize = false, Size = new Size(84, 18), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 35) };
    var lk = new Label { Text = tecla, Font = F_SM, ForeColor = C_RIB_MU, BackColor = C_RIB, AutoSize = false, Size = new Size(84, 15), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 52) };
    p.Controls.AddRange(new Control[] { li, lt, lk });
    Action<bool> hover = on => { var c = on ? Color.FromArgb(71, 85, 105) : C_RIB; p.BackColor = c; li.BackColor = c; lt.BackColor = c; lk.BackColor = c; };
    foreach (Control c in new Control[] { p, li, lt, lk }) { c.MouseEnter += (s, e) => hover(true); c.MouseLeave += (s, e) => hover(false); c.Click += (s, e) => Seguro(alClic); }
    ribbon.Controls.Add(p); botonesCinta.Add(p); return p;
}
void Separador() { ribbon.Controls.Add(new Panel { Location = new Point(bx, 30), Size = new Size(1, 60), BackColor = C_RIB_MU }); bx += 12; }
btnGuardar = Boton("💾", "Guardar y abrir", "F5", Color.FromArgb(96, 165, 250), () => Crear(false));
Boton("➕", "Guardar y nuevo", "F6", null, () => Crear(true));
Boton("❌", "Cancelar", "Esc", Color.FromArgb(248, 113, 113), () => frm.Close());
Separador();
