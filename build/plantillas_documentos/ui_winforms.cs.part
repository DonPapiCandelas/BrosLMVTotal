info = new Panel { Size = new Size(430, 92), BackColor = C_RIB }; ribbon.Controls.Add(info);
info.Paint += (s, e) => { using (var pen = new Pen(C_RIB_MU)) e.Graphics.DrawRectangle(pen, 0, 7, info.Width - 1, info.Height - 11); };
new Label { Text = "Información del documento", Font = F_SM, ForeColor = C_RIB_MU, BackColor = C_RIB, Location = new Point(10, 0), AutoSize = true }.Parent = info;
Label EtR(string t, int x, int y) { var l = new Label { Text = t, Font = F_SM, ForeColor = C_RIB_TX, BackColor = C_RIB, Location = new Point(x, y), AutoSize = true }; info.Controls.Add(l); return l; }
TextBox CajaInfo(int x, int y, int w) { var marco = new Panel { Location = new Point(x, y), Size = new Size(w, 26), BackColor = Color.White }; marco.Paint += (s, e) => { using (var pen = new Pen(C_RIB_MU)) e.Graphics.DrawRectangle(pen, 0, 0, marco.Width - 1, marco.Height - 1); }; var t = new TextBox { BorderStyle = BorderStyle.None, ReadOnly = true, BackColor = Color.White, ForeColor = C_TXT, Width = w - 12 }; t.Location = new Point(6, Math.Max(0, (26 - t.Height) / 2)); marco.Controls.Add(t); info.Controls.Add(marco); return t; }
