// ===================================================================================================================================
// VENTANA (Windows Forms, NO modal: Show, nunca ShowDialog → se puede minimizar y seguir trabajando en Comercial). Diseño de «estación de captura» al estilo de Comercial:
//   cinta de acciones (Guardar y abrir F5 · Guardar y nuevo F6 · Limpiar · Cancelar Esc) + panel de información del documento (fecha, folio, almacén),
//   selector de tipo, persona con búsqueda (RFC, saldo, crédito), documentos de origen pendientes, partidas con existencia, y un resumen con avisos.
// Los manejadores llevan try/catch porque, en modeless, el script «ya terminó» cuando se hace clic. Al guardar SIEMPRE se abre el documento nativo de Comercial.
// ===================================================================================================================================
class Opcion { public int Id { get; set; } public string Nombre { get; set; } public string Extra { get; set; } public override string ToString() => Nombre; }
class Fila { public int Id; public string Clave = "", Nombre = "", Unidad = ""; public double Cant = 1, Max = 0, Precio, Desc; public int Imp; public long OrigenItem; public long Origen; }

var catalogo = Catalogos(CLAVES);
var origenes = Origenes(seleccion);
Func<string, List<Dictionary<string, object>>> cat = k => (List<Dictionary<string, object>>)catalogo[k];
var impuestos = cat("impuestos").Select(i => new Opcion { Id = I(i["id"]), Nombre = S(i["nombre"]), Extra = S(i["perc"]) }).ToList();
var percImp = cat("impuestos").ToDictionary(i => I(i["id"]), i => D(i["perc"]));
var productos = cat("productos");
var existencias = (Dictionary<string, object>)catalogo["existencias"];
var folios = (Dictionary<string, object>)catalogo["folios"];
var filas = new List<Fila>();
var origenSel = new List<long>();
var pendientes = new List<Dictionary<string, object>>();
Dictionary<string, object> entSel = null;
bool guardando = false;
string quienSoy = "", nombreEmpresa = "";
try { quienSoy = S(ctx.Scalar("SELECT TOP 1 ISNULL(UserName,'') FROM engUser WHERE UserID = " + ctx.erp.UserId)); } catch { }
try { nombreEmpresa = S(ctx.Scalar("SELECT TOP 1 ISNULL(CommercialName, OfficialName) FROM orgBusinessEntity WHERE BusinessEntityID = " + empresa)); } catch { }

// ---------- diseño ----------
var C_NAVY = Color.FromArgb(21, 50, 79); var C_NAVY2 = Color.FromArgb(29, 68, 104); var C_BG = Color.FromArgb(238, 242, 247); var C_LINE = Color.FromArgb(216, 224, 235);
var C_TXT = Color.FromArgb(22, 38, 58); var C_MUTED = Color.FromArgb(100, 116, 139); var C_VENTA = Color.FromArgb(45, 111, 224); var C_COMPRA = Color.FromArgb(15, 118, 110);
var C_ROJO = Color.FromArgb(200, 40, 40); var C_AMBAR = Color.FromArgb(180, 83, 9); var C_VERDE = Color.FromArgb(22, 128, 59); var C_ZEBRA = Color.FromArgb(248, 250, 252);
var F_BASE = new Font("Segoe UI", 9f); var F_B = new Font("Segoe UI", 9f, FontStyle.Bold); var F_H = new Font("Segoe UI Semibold", 13f); var F_SM = new Font("Segoe UI", 8f);
var F_EMO = new Font("Segoe UI Emoji", 17f); var F_TOT = new Font("Segoe UI Semibold", 17f); var F_TIT = new Font("Segoe UI Semibold", 8f);

var frm = new Form { Text = "Crear documento · BrosLMV", ClientSize = new Size(1240, 840), MinimumSize = new Size(1100, 700), StartPosition = FormStartPosition.CenterScreen, BackColor = C_BG, Font = F_BASE, KeyPreview = true };
void Seguro(Action a) { try { a(); } catch (Exception ex) { guardando = false; MessageBox.Show(ex.Message, "Crear documento", MessageBoxButtons.OK, MessageBoxIcon.Warning); } }
Dictionary<string, object> TipoActual() => TIPOS[cmbTipoIdx];
bool EsVenta() => (string)TipoActual()["lado"] == "C";
Color Acento() => EsVenta() ? C_VENTA : C_COMPRA;
int cmbTipoIdx = 0;

// ---- cinta superior ----
