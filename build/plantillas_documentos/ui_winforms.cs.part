cinta.Paint += (s, e) => { using (var b = new System.Drawing.Drawing2D.LinearGradientBrush(cinta.ClientRectangle, C_NAVY2, C_NAVY, 90f)) e.Graphics.FillRectangle(b, cinta.ClientRectangle); };
var lblMarca = new Label { Text = "BROSLMV", Font = F_TIT, ForeColor = Color.FromArgb(147, 197, 253), BackColor = Color.Transparent, Location = new Point(18, 14), AutoSize = true }; cinta.Controls.Add(lblMarca);
var lblTitulo = new Label { Text = "Nuevo documento", Font = F_H, ForeColor = Color.White, BackColor = Color.Transparent, Location = new Point(16, 30), AutoSize = true }; cinta.Controls.Add(lblTitulo);
var lblSub = new Label { Text = "", Font = F_SM, ForeColor = Color.FromArgb(182, 199, 218), BackColor = Color.Transparent, Location = new Point(18, 68), AutoSize = true }; cinta.Controls.Add(lblSub);
int bx = 340;
Panel Boton(string icono, string texto, string tecla, bool primario, Action alClic)
{
    var p = new Panel { Location = new Point(bx, 12), Size = new Size(96, 76), Cursor = Cursors.Hand, BackColor = Color.Transparent }; bx += 100;
    var li = new Label { Text = icono, Font = F_EMO, ForeColor = Color.White, BackColor = Color.Transparent, AutoSize = false, Size = new Size(96, 34), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 2) };
    var lt = new Label { Text = texto, Font = F_SM, ForeColor = Color.FromArgb(232, 238, 246), BackColor = Color.Transparent, AutoSize = false, Size = new Size(96, 18), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 38) };
    var lk = new Label { Text = tecla, Font = F_SM, ForeColor = Color.FromArgb(147, 169, 194), BackColor = Color.Transparent, AutoSize = false, Size = new Size(96, 14), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 55) };
    p.Controls.AddRange(new Control[] { li, lt, lk });
    Action<bool> hover = on => { p.BackColor = on ? Color.FromArgb(40, 255, 255, 255) : Color.Transparent; };
    foreach (Control c in new Control[] { p, li, lt, lk }) { c.MouseEnter += (s, e) => hover(true); c.MouseLeave += (s, e) => hover(false); c.Click += (s, e) => Seguro(alClic); }
    p.Paint += (s, e) => { if (primario) using (var b = new SolidBrush(Acento())) e.Graphics.FillRectangle(b, p.ClientRectangle); };
    cinta.Controls.Add(p); return p;
}
