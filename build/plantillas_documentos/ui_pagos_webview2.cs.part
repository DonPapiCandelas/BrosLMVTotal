// ===================================================================================================================================
// VENTANA (WebView2, NO modal). La página es la estación completa de cobros y pagos; esta parte la abre y contesta lo que la página pide:
//   aplicar     → registra el cobro o pago (una sola operación, un renglón por documento y parcialidad) y devuelve el resumen con el folio; los saldos se vuelven a pedir
//   movimientos → los últimos cobros o pagos de la persona        docs → documentos con saldo actualizados (después de aplicar)   detalle → parcialidades y aplicaciones de un documento
// Las respuestas viajan como «__JS__código»: la página recibe datos sin repintarse (conserva lo capturado). Si algo falla, la página muestra el mensaje y no se pierde nada.
// ===================================================================================================================================
string PAGINA = @"__HTML_CS__";

var catalogo = Catalogos();
string quienSoy = "", nombreEmpresa = "";
try { quienSoy = S(ctx.Scalar("SELECT TOP 1 ISNULL(UserName,'') FROM engUser WHERE UserID = " + ctx.erp.UserId)); } catch { }
try { nombreEmpresa = S(ctx.Scalar("SELECT TOP 1 ISNULL(CommercialName, OfficialName) FROM orgBusinessEntity WHERE BusinessEntityID = " + empresa)); } catch { }
Func<object, string> JsJson = o => ser.Serialize(o).Replace("</", "<\\/");
Func<object> Borrador = () => { string j = LeerBorrador("cobropago"); return string.IsNullOrEmpty(j) ? null : ser.Deserialize<Dictionary<string, object>>(j); };
Func<object> Pref = () => { string j = LeerBorrador("pref_ui", false); return string.IsNullOrEmpty(j) ? new Dictionary<string, object>() : ser.Deserialize<Dictionary<string, object>>(j); };
string PaginaCon(Dictionary<string, object> inicial) =>
    PAGINA.Replace("__DATOS__", JsJson(new Dictionary<string, object> { ["tipos"] = TIPOS, ["cat"] = catalogo, ["inicial"] = inicial, ["vivo"] = true, ["usuario"] = quienSoy, ["empresa"] = nombreEmpresa, ["borrador"] = Borrador(), ["pref"] = Pref() }));

string htmlPrueba = Environment.GetEnvironmentVariable("BROSLMV_PAGO_HTML");           // pruebas: escribe la página (con sus datos) en un archivo y no abre ventana
if (!string.IsNullOrEmpty(htmlPrueba))
{
    System.IO.File.WriteAllText(htmlPrueba, PaginaCon(null), new UTF8Encoding(false));
    return "HTML";
}

Func<Dictionary<string, object>, string> alMensaje = (r) =>
{
    string accion = S(r.ContainsKey("accion") ? r["accion"] : "");
    string req = S(r.ContainsKey("req") ? r["req"] : "0");
    try
    {
        if (accion == "cancelar") return "__CERRAR__";
        if (accion == "movimientos") return "__JS__respuesta(" + req + "," + JsJson(MovimientosDe(L(r["entidad"]), S(r["tipo"]))) + ")";
        if (accion == "detalle") return "__JS__respuesta(" + req + "," + JsJson(DetalleDoc(L(r["doc"]))) + ")";
        if (accion == "inteligencia") return "__JS__respuesta(" + req + "," + JsJson(InteligenciaPago(L(r["entidad"]), S(r["tipo"]))) + ")";
        if (accion == "borrador") { GuardarBorrador("cobropago", ser.Serialize(new Dictionary<string, object> { ["cuando"] = DateTime.Now.ToString("o"), ["spec"] = S(r["spec"]) })); return null; }
        if (accion == "borradorBorrar") { BorrarBorrador("cobropago"); return null; }
        if (accion == "pref") { GuardarBorrador("pref_ui", ser.Serialize(new Dictionary<string, object> { ["tema"] = S(r["tema"]) })); return null; }
        if (accion == "docs") return "__JS__respuesta(" + req + "," + JsJson(DocsConSaldo(S(r["lado"]))) + ")";
        if (accion != "aplicar") return null;
        var spec = ser.Deserialize<Dictionary<string, object>>(S(r["spec"]));
        bool otro = r.ContainsKey("nuevo") && Convert.ToBoolean(r["nuevo"]);
        string resumen;
        try { resumen = Aplicar(spec); }
        catch (Exception ex) { return "__JS__falloAplicar(" + JsJson(ex.Message) + ")"; }                          // la ventana sigue con todo lo capturado
        BorrarBorrador("cobropago");                                                                        // ya se registró: el borrador no debe volver a ofrecerse
        try { ctx.erp.RefreshGrid(); } catch { }
        return "__JS__aplicado(" + JsJson(new Dictionary<string, object> { ["resumen"] = resumen, ["nuevo"] = otro }) + ")";
    }
    catch (Exception ex) { return "__JS__aviso(" + JsJson(ex.Message) + ",'mal')"; }
};
ctx.ShowHtmlModeless(PaginaCon(null), "Cobros y pagos · BrosLMV", 1280, 900, alMensaje);
if (Environment.GetEnvironmentVariable("BROSLMV_PAGO_BOMBA") == "1")          // pruebas: mantiene vivo el proceso (el Runner no tiene bucle de ventanas) para manejar la página por depuración remota
{
    var fin = new System.Windows.Forms.Timer { Interval = 150000 }; fin.Tick += (s, e) => System.Windows.Forms.Application.ExitThread(); fin.Start();
    System.Windows.Forms.Application.Run();
}
return "OK";
