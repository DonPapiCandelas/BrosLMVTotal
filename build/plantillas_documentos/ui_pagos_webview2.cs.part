
// ===================================================================================================================================
// VENTANA (WebView2). Al presionar «Registrar» regresa lo capturado y aquí se aplica. Si falla, la ventana se vuelve a abrir con lo capturado.
// ===================================================================================================================================
string PAGINA = @"__HTML_CS__";

var catalogo = Catalogos();
Dictionary<string, object> inicial = null;
string htmlPrueba = Environment.GetEnvironmentVariable("BROSLMV_PAGO_HTML");           // pruebas: escribe la página (con sus datos) en un archivo y no abre ventana
if (!string.IsNullOrEmpty(htmlPrueba))
{
    var d0 = new Dictionary<string, object> { ["tipos"] = TIPOS, ["cat"] = catalogo, ["inicial"] = null };
    System.IO.File.WriteAllText(htmlPrueba, PAGINA.Replace("__DATOS__", ser.Serialize(d0).Replace("</", "<\\/")), new UTF8Encoding(false));
    return "HTML";
}
while (true)
{
    var datos = new Dictionary<string, object> { ["tipos"] = TIPOS, ["cat"] = catalogo, ["inicial"] = inicial };
    string json = ser.Serialize(datos).Replace("</", "<\\/");
    var r = ctx.ShowHtmlFormulario(PAGINA.Replace("__DATOS__", json), "Cobro o pago", 1180, 900, 0);
    if (!r.ContainsKey("submitted") || !(bool)r["submitted"] || S(r.ContainsKey("accion") ? r["accion"] : "") != "aplicar") return "CANCELADO";
    var spec = ser.Deserialize<Dictionary<string, object>>(S(r["spec"]));
    try
    {
        string resumen = Aplicar(spec);
        try { ctx.erp.RefreshGrid(); } catch { }
        ctx.Msg(resumen, "Cobro o pago registrado");
        return resumen;
    }
    catch (Exception ex)
    {
        ctx.Msg(ex.Message, "Cobro o pago");
        inicial = spec;
        catalogo = Catalogos();          // los saldos pudieron cambiar
    }
}
