// ===================================================================================================================================
// VENTANA (Windows Forms, NO modal: Show, nunca ShowDialog → se puede minimizar y seguir trabajando en Comercial). Estación de cobros y pagos al estilo de Comercial:
//   cinta (Registrar F5 · Registrar y nuevo F6 · Limpiar · Cancelar Esc) + información (fecha, folio, cuenta), persona con búsqueda (saldo, vencido, antigüedad),
//   monto con «Distribuir» (más antiguos primero), documentos con saldo marcables y un resumen con avisos y los últimos movimientos de la persona.
// Los manejadores llevan try/catch porque, en modeless, el script «ya terminó» cuando se hace clic.
// ===================================================================================================================================
class Opcion { public int Id { get; set; } public string Nombre { get; set; } public override string ToString() => Nombre; }

