Panel Boton(string icono, string texto, string tecla, bool primario, Action alClic, bool guardar = false)
{
    var p = new Panel { Location = new Point(bx, 12), Size = new Size(104, 76), Cursor = Cursors.Hand, BackColor = Color.Transparent }; bx += 108;
    var li = new Label { Text = icono, Font = F_EMO, ForeColor = Color.White, BackColor = Color.Transparent, AutoSize = false, Size = new Size(104, 34), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 2) };
    var lt = new Label { Text = texto, Font = F_SM, ForeColor = Color.FromArgb(232, 238, 246), BackColor = Color.Transparent, AutoSize = false, Size = new Size(104, 18), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 38) };
    var lk = new Label { Text = tecla, Font = F_SM, ForeColor = Color.FromArgb(147, 169, 194), BackColor = Color.Transparent, AutoSize = false, Size = new Size(104, 14), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 55) };
    if (guardar) lblBtnG = lt;
    p.Controls.AddRange(new Control[] { li, lt, lk });
    foreach (Control c in new Control[] { p, li, lt, lk }) { c.MouseEnter += (s, e) => p.BackColor = Color.FromArgb(40, 255, 255, 255); c.MouseLeave += (s, e) => p.BackColor = Color.Transparent; c.Click += (s, e) => Seguro(alClic); }
    p.Paint += (s, e) => { if (primario) using (var b = new SolidBrush(Acento())) e.Graphics.FillRectangle(b, p.ClientRectangle); };
    cinta.Controls.Add(p); return p;
}
