// ===================================================================================================================================
// VENTANA (Windows Forms, NO modal: Show, nunca ShowDialog → se puede minimizar y seguir trabajando en Comercial).
// Mismo lenguaje visual que «Crear documento»: cinta oscura con las acciones y la información del movimiento (fecha y folio), grupos numerados con una etiqueta
// arriba de cada campo (nada se encima ni se corta):
//   1 · Cliente / proveedor (búsqueda por nombre o RFC; las personas con saldo salen primero) · 2 · Datos del movimiento (cuenta, forma de pago, referencia, monto con «Distribuir») ·
//   3 · Antigüedad de saldos de la persona · 4 · Documentos con saldo (marcables, con lo que se aplica a cada uno) · Resumen con lo que quedaría.
// Los manejadores llevan try/catch porque, en modeless, el script «ya terminó» cuando se hace clic.
// ===================================================================================================================================
class Opcion { public int Id { get; set; } public string Nombre { get; set; } public string Extra { get; set; } public override string ToString() => Nombre; }
class Pastilla { public string Titulo, Valor; public Color Color; }

var catalogo = Catalogos();
Func<string, List<Dictionary<string, object>>> cat = k => (List<Dictionary<string, object>>)catalogo[k];
var folios = (Dictionary<string, object>)catalogo["folios"];
var seleccion = new Dictionary<long, double>();      // documento → monto a aplicar
var pastillas = new List<Pastilla>();
Dictionary<string, object> entSel = null;
bool guardando = false, pintando = false; int tipoIdx = 0;
string quienSoy = "", nombreEmpresa = "";
try { quienSoy = S(ctx.Scalar("SELECT TOP 1 ISNULL(UserName,'') FROM engUser WHERE UserID = " + ctx.erp.UserId)); } catch { }
try { nombreEmpresa = S(ctx.Scalar("SELECT TOP 1 ISNULL(CommercialName, OfficialName) FROM orgBusinessEntity WHERE BusinessEntityID = " + empresa)); } catch { }

// ---------- diseño ----------
var C_BG = Color.FromArgb(241, 245, 249); var C_LINE = Color.FromArgb(203, 213, 225); var C_TXT = Color.FromArgb(30, 41, 59); var C_MUTED = Color.FromArgb(100, 116, 139);
var C_HEAD = Color.FromArgb(248, 250, 252); var C_SEL = Color.FromArgb(238, 242, 255); var C_RIB = Color.FromArgb(51, 65, 85); var C_RIB_TX = Color.FromArgb(226, 232, 240); var C_RIB_MU = Color.FromArgb(148, 163, 184);
var C_COBRO = Color.FromArgb(37, 99, 235); var C_PAGO = Color.FromArgb(15, 118, 110); var C_ROJO = Color.FromArgb(200, 40, 40); var C_AMBAR = Color.FromArgb(180, 83, 9); var C_VERDE = Color.FromArgb(22, 128, 59);
var F_BASE = new Font("Segoe UI", 9f); var F_B = new Font("Segoe UI", 9f, FontStyle.Bold); var F_H2 = new Font("Segoe UI", 9.5f, FontStyle.Bold); var F_SM = new Font("Segoe UI", 8.5f);
var F_ICON = new Font("Segoe UI Emoji", 20f); var F_TOT = new Font("Segoe UI Semibold", 18f); var F_VAL = new Font("Segoe UI Semibold", 11f);

var frm = new Form { Text = "Cobros y pagos · BrosLMV", ClientSize = new Size(1200, 900), MinimumSize = new Size(1160, 820), StartPosition = FormStartPosition.CenterScreen, BackColor = C_BG, Font = F_BASE, KeyPreview = true };
void Seguro(Action a) { try { a(); } catch (Exception ex) { guardando = false; MessageBox.Show(ex.Message, "Cobro o pago", MessageBoxButtons.OK, MessageBoxIcon.Warning); } }
Dictionary<string, object> TipoActual() => TIPOS[tipoIdx];
bool EsCobro() => (string)TipoActual()["lado"] == "C";
Color Acento() => EsCobro() ? C_COBRO : C_PAGO;
List<Dictionary<string, object>> DocsLado() => cat(EsCobro() ? "docsC" : "docsP");
DateTime? Fe(string s) { DateTime v; return DateTime.TryParse(s, ci, DateTimeStyles.None, out v) ? (DateTime?)v : null; }

// controles declarados de antemano (los manejadores de abajo los usan antes de que se construyan)
Panel ribbon = null, info = null, pTipos = null, pPie = null, g1 = null, g2 = null, g3 = null, g4 = null, g5 = null, pChips = null, pEdad = null;
Label lblRibTitulo = null, lblMontoEt = null, lblDocsEst = null, lblN = null, lblSal = null, lblQ = null, lblMon = null, lblTot = null, lblTotEt = null, lblPie = null, lblAvisos = null, lblToast = null, lblBtnReg = null;
DateTimePicker dtFecha = null; TextBox txtFolio = null, txtEnt = null, txtRfc = null, txtRef = null; ComboBox cmbCta = null, cmbForma = null; NumericUpDown nudMonto = null;
DataGridView grid = null; ListBox lstEnt = null; Button btnMov = null;
var btnsTipo = new List<Button>();

// ---------- piezas de construcción ----------
Panel Grupo(Func<string> titulo)
{
    var p = new Panel { BackColor = Color.White, Size = new Size(600, 120) };
    p.Paint += (s, e) =>
    {
        var g = e.Graphics; using (var pen = new Pen(C_LINE)) g.DrawRectangle(pen, 0, 0, p.Width - 1, p.Height - 1);
        using (var b = new SolidBrush(C_HEAD)) g.FillRectangle(b, 1, 1, p.Width - 2, 27); using (var pen = new Pen(C_LINE)) g.DrawLine(pen, 0, 28, p.Width, 28);
        using (var b = new SolidBrush(Acento())) g.FillRectangle(b, 1, 1, 4, 27);
        using (var b = new SolidBrush(C_TXT)) g.DrawString(titulo(), F_H2, b, 14, 5);
    };
    return p;
}
Label Et(Control padre, string t, int x, int y) { var l = new Label { Text = t, Location = new Point(x, y), AutoSize = true, ForeColor = C_MUTED, Font = F_SM, BackColor = Color.Transparent }; padre.Controls.Add(l); return l; }
TextBox Cuadro(Control padre, string etiqueta, int x, int y, int w, bool soloLectura = false)
{
    // Marco de altura fija que dibuja el borde; el TextBox va adentro SIN borde y centrado. Así la altura no depende de cómo calcule Windows la del TextBox
    // (cambia con el monitor y la escala) y ya no se encima con la etiqueta.
    if (etiqueta != "") Et(padre, etiqueta, x, y);
    var marco = new Panel { Location = new Point(x, y + 18), Size = new Size(w, 26), BackColor = soloLectura ? C_HEAD : Color.White };
    marco.Paint += (s, e) => { using (var pen = new Pen(C_LINE)) e.Graphics.DrawRectangle(pen, 0, 0, marco.Width - 1, marco.Height - 1); };
    var t = new TextBox { BorderStyle = BorderStyle.None, ReadOnly = soloLectura, BackColor = marco.BackColor, ForeColor = soloLectura ? C_MUTED : C_TXT, Width = w - 14 };
    t.Location = new Point(7, Math.Max(0, (26 - t.Height) / 2)); t.Tag = marco;
    marco.Controls.Add(t); padre.Controls.Add(marco); marco.Click += (s, e) => t.Focus();
    return t;
}
Control Caja(TextBox t) { return (t.Tag as Control) ?? t; }
ComboBox Lista(Control padre, string etiqueta, int x, int y, int w, int anchoMenu = 0)
{
    Et(padre, etiqueta, x, y);
    var c = new ComboBox { Location = new Point(x, y + 17), Size = new Size(w, 24), DropDownStyle = ComboBoxStyle.DropDownList, FlatStyle = FlatStyle.Flat }; if (anchoMenu > 0) c.DropDownWidth = anchoMenu; padre.Controls.Add(c); return c;
}
Label Dato(Control padre, string etiqueta, int x, int y)
{
    Et(padre, etiqueta, x, y);
    var v = new Label { Text = "0.00", Font = F_VAL, ForeColor = C_TXT, Location = new Point(x, y + 16), Size = new Size(140, 24), TextAlign = ContentAlignment.MiddleLeft, BackColor = Color.Transparent }; padre.Controls.Add(v); return v;
}
void PonerPorId(ComboBox c, int id) { for (int i = 0; i < c.Items.Count; i++) if (((Opcion)c.Items[i]).Id == id) { c.SelectedIndex = i; return; } if (c.Items.Count > 0) c.SelectedIndex = 0; }

// ---------- cinta superior ----------
ribbon = new Panel { BackColor = C_RIB, Size = new Size(1176, 100) };
lblRibTitulo = new Label { Text = "Cobro a cliente", Font = F_H2, ForeColor = C_RIB_TX, BackColor = C_RIB, Location = new Point(12, 5), AutoSize = true }; ribbon.Controls.Add(lblRibTitulo);
int bx = 12;
Panel Boton(string icono, string texto, string tecla, Color? colorIcono, Action alClic, bool registrar = false)
{
    var p = new Panel { Location = new Point(bx, 26), Size = new Size(96, 68), BackColor = C_RIB, Cursor = Cursors.Hand }; bx += 100;
    var li = new Label { Text = icono, Font = F_ICON, ForeColor = colorIcono ?? C_RIB_TX, BackColor = C_RIB, AutoSize = false, Size = new Size(96, 34), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 0) };
    var lt = new Label { Text = texto, Font = F_SM, ForeColor = C_RIB_TX, BackColor = C_RIB, AutoSize = false, Size = new Size(96, 18), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 35) };
    var lk = new Label { Text = tecla, Font = F_SM, ForeColor = C_RIB_MU, BackColor = C_RIB, AutoSize = false, Size = new Size(96, 15), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(0, 52) };
    if (registrar) lblBtnReg = lt;
    p.Controls.AddRange(new Control[] { li, lt, lk });
    Action<bool> hover = on => { var c = on ? Color.FromArgb(71, 85, 105) : C_RIB; p.BackColor = c; li.BackColor = c; lt.BackColor = c; lk.BackColor = c; };
    foreach (Control c in new Control[] { p, li, lt, lk }) { c.MouseEnter += (s, e) => hover(true); c.MouseLeave += (s, e) => hover(false); c.Click += (s, e) => Seguro(alClic); }
    ribbon.Controls.Add(p); return p;
}
