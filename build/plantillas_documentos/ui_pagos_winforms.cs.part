Panel Tarjeta(Func<string> num, Func<string> titulo, Action<Panel> poner, Size? tam = null)
{
    var p = new Panel { Size = tam ?? new Size(890, 128), Dock = DockStyle.Fill, BackColor = Color.White, Margin = new Padding(0, 0, 0, 10), Padding = new Padding(12, 34, 12, 10) };
    p.Paint += (s, e) => { using (var pen = new Pen(C_LINE)) e.Graphics.DrawRectangle(pen, 0, 0, p.Width - 1, p.Height - 1); string n = num(); int x0 = 12;
        if (n != "") { using (var b = new SolidBrush(Acento())) e.Graphics.FillEllipse(b, 12, 9, 18, 18); using (var b2 = new SolidBrush(Color.White)) e.Graphics.DrawString(n, F_TIT, b2, 17, 11); x0 = 36; }
        using (var b3 = new SolidBrush(C_MUTED)) e.Graphics.DrawString(titulo().ToUpperInvariant(), F_TIT, b3, x0, 11); };
    poner(p); return p;
}
Label Et(Control padre, string t, int x, int y, Font f = null, Color? c = null) { var l = new Label { Text = t, Location = new Point(x, y), AutoSize = true, ForeColor = c ?? C_MUTED, Font = f ?? F_SM, BackColor = Color.Transparent }; padre.Controls.Add(l); return l; }
TextBox Cuadro(Control padre, int x, int y, int w) { var t = new TextBox { Location = new Point(x, y), Size = new Size(w, 24), BorderStyle = BorderStyle.FixedSingle }; padre.Controls.Add(t); return t; }

