<Window x:Class="BrosLMV.Empresas.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrosLMV — Instalador" Height="750" Width="720"
        WindowStartupLocation="CenterScreen" Background="#EEF2F7" FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize" Icon="pack://application:,,,/assets/app_icon.png" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button" x:Key="Primary">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="30,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3B82F6" Offset="0"/><GradientStop Color="#2563EB" Offset="1"/></LinearGradientBrush>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1D4ED8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="Ghost">
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="24,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="9" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F1F5F9"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Tarjeta" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,13"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Icono" TargetType="Border">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="#E8EFFD"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Cabecera -->
    <Border Grid.Row="0" Height="190">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#173A5E" Offset="0"/>
          <GradientStop Color="#0A1A2D" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid Margin="44,0">
        <StackPanel VerticalAlignment="Center">
          <Image Source="pack://application:,,,/assets/logo_blanco.png" Height="62" Stretch="Uniform" HorizontalAlignment="Left"/>
          <Border x:Name="chipModo" HorizontalAlignment="Left" CornerRadius="12" Background="#2563EB" Padding="12,3" Margin="0,16,0,0">
            <TextBlock x:Name="lblModo" Text="Nueva instalación" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
        <TextBlock x:Name="lblVersionGrande" Text="3" FontSize="96" FontWeight="Bold" Foreground="#1D4672" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.9"/>
      </Grid>
    </Border>

    <!-- Cuerpo -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="44,26,44,0">
      <TextBlock x:Name="lblTitulo" Text="Bienvenido al instalador de BrosLMV" FontSize="22" FontWeight="Bold" Foreground="#0F2037"/>
      <TextBlock x:Name="lblDescripcion" Foreground="#64748B" Margin="0,6,0,18" TextWrapping="Wrap"
                 Text="Se instala en C:\BrosLMV y registra la consola en CONTPAQi Comercial PRO. Todo viene incluido: no descarga nada de internet."/>

      <Border Style="{StaticResource Tarjeta}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Icono}"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0">
            <TextBlock Text="Consola y addon de BrosLMV" FontWeight="SemiBold" Foreground="#0F2037"/>
            <TextBlock Text="El componente que CONTPAQi Comercial carga al iniciar y el botón de la cinta." Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource Tarjeta}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Icono}"><TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0">
            <TextBlock Text="Motores de scripts propios" FontWeight="SemiBold" Foreground="#0F2037"/>
            <TextBlock Text="Python 3.13 portátil (~21 MB) y motor .NET autocontenido (~82 MB). No tocan tu Python ni el PATH del sistema." Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource Tarjeta}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Icono}"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0">
            <TextBlock Text="Plantillas y herramientas de fábrica" FontWeight="SemiBold" Foreground="#0F2037"/>
            <TextBlock Text="Crear documentos desde XML, estados de cuenta, formatos y más. Tus scripts propios no se tocan." Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource Tarjeta}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Icono}"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0">
            <TextBlock Text="BrosLMV Bancos" FontWeight="SemiBold" Foreground="#0F2037"/>
            <TextBlock Text="Carga estados de cuenta y movimientos de bancos al estado de cuenta de Comercial, con editor de layouts. Se instala en cada equipo." Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
          <CheckBox x:Name="chkBancos" Grid.Column="2" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Instalar BrosLMV Bancos"/>
        </Grid>
      </Border>

      <TextBlock x:Name="lblSiguiente" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" Margin="2,6,0,0"
                 Text="Después, en el SERVIDOR, podrás registrar (provisionar) tus empresas. En una TERMINAL basta con instalar."/>
      <TextBlock Text="Requiere permisos de administrador y .NET Framework 4.8 (incluido en Windows 10/11 y Server). Fuera de C:\BrosLMV solo se registra el componente COM y el icono; se quita todo con el Desinstalador." Foreground="#94A3B8" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    </ScrollViewer>

    <!-- Pie -->
    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="44,16">
      <Grid>
        <TextBlock x:Name="lblVer" Text="BrosLMV" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="btnSalir" Content="Salir" Style="{StaticResource Ghost}" Margin="0,0,10,0" Click="btnSalir_Click"/>
          <Button x:Name="btnInstalar" Content="Instalar" Style="{StaticResource Primary}" Click="btnInstalar_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
