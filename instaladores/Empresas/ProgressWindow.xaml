<Window x:Class="BrosLMV.Empresas.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Width="480" Height="250"
        WindowStartupLocation="CenterScreen" Background="#0A1A2D" FontFamily="Segoe UI"
        Icon="pack://application:,,,/assets/app_icon.png">
  <Border BorderBrush="#24405E" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#173A5E" Offset="0"/><GradientStop Color="#0A1A2D" Offset="1"/></LinearGradientBrush>
    </Border.Background>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
      <Image Source="pack://application:,,,/assets/logo_blanco.png" Height="64" Margin="0,0,0,22" Stretch="Uniform"/>
      <TextBlock Text="Instalando los componentes de BrosLMV" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
      <TextBlock Text="Esto toma unos segundos. No cierres esta ventana." Foreground="#8CA5C3" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,18"/>
      <ProgressBar IsIndeterminate="True" Width="340" Height="5" Foreground="#3B82F6" Background="#24405E" BorderThickness="0"/>
    </StackPanel>
  </Border>
</Window>
