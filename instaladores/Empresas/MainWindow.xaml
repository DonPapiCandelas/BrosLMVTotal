<Window x:Class="BrosLMV.Empresas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrosLMV — Empresas" Height="860" Width="1220" MinHeight="700" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="#EEF2F7" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/assets/app_icon.png" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- ===== Paleta ===== -->
    <SolidColorBrush x:Key="Azul" Color="#2563EB"/>
    <SolidColorBrush x:Key="AzulOscuro" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Tinta" Color="#0F2037"/>
    <SolidColorBrush x:Key="Gris" Color="#64748B"/>
    <SolidColorBrush x:Key="GrisClaro" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Linea" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Verde" Color="#16A34A"/>
    <SolidColorBrush x:Key="Ambar" Color="#D97706"/>
    <SolidColorBrush x:Key="Rojo" Color="#DC2626"/>
    <FontFamily x:Key="Iconos">Segoe MDL2 Assets</FontFamily>

    <!-- ===== Botones ===== -->
    <Style x:Key="BtnBase" TargetType="Button">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#3B82F6" Offset="0"/><GradientStop Color="#2563EB" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1D4ED8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#CBD5E1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Foreground" Value="#1E3A8A"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F1F5F9"/><Setter TargetName="b" Property="BorderBrush" Value="#94A3B8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Texto" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Foreground" Value="#2563EB"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E8EFFD"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Campos ===== -->
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#0F2037"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="8" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#2563EB"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#F1F5F9"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#0F2037"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="b" CornerRadius="8" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#2563EB"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#F1F5F9"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ===== Tarjeta ===== -->
    <Style x:Key="Tarjeta" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.06" Color="#0F2037"/></Setter.Value></Setter>
    </Style>

    <!-- ===== Filtro tipo pestaña ===== -->
    <Style x:Key="Filtro" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="16" Padding="14,6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F1F5F9"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#E8EFFD"/><Setter Property="Foreground" Value="#1D4ED8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Casilla ===== -->
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="20" Height="20" CornerRadius="6" Background="White" BorderBrush="#94A3B8" BorderThickness="1.5">
                <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="#2563EB"/><Setter TargetName="box" Property="BorderBrush" Value="#2563EB"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#2563EB"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Tabla de empresas ===== -->
    <Style x:Key="EncabezadoTabla" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="FilaTabla" TargetType="DataGridRow">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F6F8FC"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CeldaTabla" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="Transparent" Padding="12,0"><ContentPresenter VerticalAlignment="Center"/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="268"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= BARRA LATERAL ================= -->
    <Border Grid.Column="0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
          <GradientStop Color="#13304E" Offset="0"/>
          <GradientStop Color="#0A1A2D" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel LastChildFill="False">
        <Image DockPanel.Dock="Top" Height="86" Margin="28,34,28,6" Stretch="Uniform" HorizontalAlignment="Left"
               Source="pack://application:,,,/assets/logo_blanco.png"/>
        <Border DockPanel.Dock="Top" Margin="28,0,0,0" HorizontalAlignment="Left" CornerRadius="10" Background="#1F4A78" Padding="9,2">
          <TextBlock x:Name="lblVer" Text="v3" Foreground="#BFD7F5" FontSize="11" FontWeight="SemiBold"/>
        </Border>

        <!-- Pasos -->
        <StackPanel DockPanel.Dock="Top" Margin="26,44,20,0">
          <TextBlock Text="PASOS" Foreground="#5E7896" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,12"/>
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="dot1" Width="26" Height="26" CornerRadius="13" Background="#2563EB" VerticalAlignment="Top">
              <TextBlock x:Name="ico1" Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1"><TextBlock Text="Conexión" Foreground="White" FontWeight="SemiBold"/>
              <TextBlock x:Name="lblPaso1" Text="Elige el servidor SQL" Foreground="#8CA5C3" FontSize="11.5" TextWrapping="Wrap"/></StackPanel>
          </Grid>
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="dot2" Width="26" Height="26" CornerRadius="13" Background="#24405E" VerticalAlignment="Top">
              <TextBlock x:Name="ico2" Text="2" Foreground="#8CA5C3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1"><TextBlock Text="Empresas" Foreground="White" FontWeight="SemiBold"/>
              <TextBlock x:Name="lblPaso2" Text="Marca las que quieres" Foreground="#8CA5C3" FontSize="11.5" TextWrapping="Wrap"/></StackPanel>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="dot3" Width="26" Height="26" CornerRadius="13" Background="#24405E" VerticalAlignment="Top">
              <TextBlock x:Name="ico3" Text="3" Foreground="#8CA5C3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1"><TextBlock Text="Aplicar" Foreground="White" FontWeight="SemiBold"/>
              <TextBlock x:Name="lblPaso3" Text="Instala o actualiza" Foreground="#8CA5C3" FontSize="11.5" TextWrapping="Wrap"/></StackPanel>
          </Grid>
        </StackPanel>

        <!-- Estado de conexión -->
        <Border DockPanel.Dock="Bottom" Margin="20,0,20,22" CornerRadius="12" Background="#112A45" Padding="14,12">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="ledConn" Width="9" Height="9" Fill="#64748B" VerticalAlignment="Center"/>
              <TextBlock x:Name="lblConnTitle" Text="Sin conexión" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="lblConnSrv" Text="" Foreground="#8CA5C3" FontSize="11" Margin="17,3,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="lblConnUsr" Text="" Foreground="#8CA5C3" FontSize="11" Margin="17,0,0,0"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- ================= CONTENIDO ================= -->
    <!-- El contenido se desplaza si la ventana es mas chica que el diseno (pantallas pequenas o con escala alta): los botones de abajo siempre se alcanzan. -->
    <ScrollViewer x:Name="svContenido" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <Grid Margin="32,26,32,22" MinHeight="640" MinWidth="700" Height="{Binding ViewportHeight, ElementName=svContenido}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Título -->
      <StackPanel Grid.Row="0">
        <TextBlock x:Name="lblTitulo" Text="Instalar BrosLMV en tus empresas" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Tinta}"/>
        <TextBlock x:Name="lblSubtitulo" Text="Conecta a tu servidor SQL y elige las empresas de CONTPAQi Comercial." Foreground="{StaticResource Gris}" Margin="0,4,0,0" FontSize="13.5"/>
      </StackPanel>

      <!-- Conexión -->
      <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="22,18" Margin="0,20,0,0">
        <Grid>
          <!-- Resumen (ya conectado) -->
          <Grid x:Name="pnlConexionResumen" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="12" Background="#E7F6EC" VerticalAlignment="Center">
              <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Iconos}" FontSize="20" Foreground="{StaticResource Verde}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="lblResumenServidor" Text="" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Tinta}"/>
              <TextBlock x:Name="lblResumenDetalle" Text="" Foreground="{StaticResource Gris}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Cambiar conexión" Style="{StaticResource Ghost}" Click="btnCambiar_Click" VerticalAlignment="Center"/>
          </Grid>

          <!-- Edición -->
          <StackPanel x:Name="pnlConexionEditar">
            <Grid>
              <TextBlock Text="Conexión a SQL Server" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Tinta}"/>
              <TextBlock x:Name="lblRecordada" Text="" Foreground="{StaticResource Verde}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="14"/>
                <ColumnDefinition Width="230"/><ColumnDefinition Width="14"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <Grid>
                  <TextBlock Text="Servidor \ instancia" Foreground="{StaticResource Gris}" FontSize="11.5" FontWeight="SemiBold"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnDetectar" Content="Detectar" Style="{StaticResource Texto}" Height="20" FontSize="11.5" Click="btnDetectar_Click" ToolTip="Vuelve a buscar las instancias de SQL Server de este equipo"/>
                    <Button x:Name="btnBuscarRed" Content="Buscar en la red" Style="{StaticResource Texto}" Height="20" FontSize="11.5" Click="btnBuscarRed_Click" ToolTip="Busca servidores SQL en la red (puede tardar unos segundos)"/>
                  </StackPanel>
                </Grid>
                <ComboBox x:Name="cbServer" IsEditable="True" Margin="0,5,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Usuario" Foreground="{StaticResource Gris}" FontSize="11.5" FontWeight="SemiBold"/>
                <TextBox x:Name="txtUser" Text="SA" Margin="0,5,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Contraseña" Foreground="{StaticResource Gris}" FontSize="11.5" FontWeight="SemiBold"/>
                <Grid Margin="0,5,0,0">
                  <PasswordBox x:Name="pwdBox" KeyDown="pwd_KeyDown"/>
                  <TextBox x:Name="pwdPlain" Visibility="Collapsed" KeyDown="pwd_KeyDown"/>
                  <Button x:Name="btnEye" Content="&#xE7B3;" FontFamily="{StaticResource Iconos}" HorizontalAlignment="Right" Width="34" Height="34" Margin="0,0,2,0"
                          Style="{StaticResource Texto}" Padding="0" Click="btnEye_Click" ToolTip="Mostrar u ocultar la contraseña"/>
                </Grid>
              </StackPanel>
              <Button x:Name="btnConn" Grid.Column="6" Content="Conectar" Style="{StaticResource Primary}" VerticalAlignment="Bottom" MinWidth="120" Click="btnConn_Click"/>
            </Grid>
            <TextBlock x:Name="lblConnError" Text="" Foreground="{StaticResource Rojo}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Resumen numérico -->
      <Grid Grid.Row="2" Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="18,14">
          <StackPanel><TextBlock Text="EMPRESAS" Foreground="{StaticResource GrisClaro}" FontSize="10.5" FontWeight="Bold"/>
            <TextBlock x:Name="cardTotal" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Tinta}"/>
            <TextBlock Text="detectadas en SQL" Foreground="{StaticResource Gris}" FontSize="11.5"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="18,14">
          <StackPanel><TextBlock Text="AL DÍA" Foreground="{StaticResource GrisClaro}" FontSize="10.5" FontWeight="Bold"/>
            <TextBlock x:Name="cardInst" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Verde}"/>
            <TextBlock Text="con la versión actual" Foreground="{StaticResource Gris}" FontSize="11.5"/></StackPanel>
        </Border>
        <Border Grid.Column="4" Style="{StaticResource Tarjeta}" Padding="18,14">
          <StackPanel><TextBlock Text="POR ACTUALIZAR" Foreground="{StaticResource GrisClaro}" FontSize="10.5" FontWeight="Bold"/>
            <TextBlock x:Name="cardAct" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Azul}"/>
            <TextBlock Text="con versión anterior" Foreground="{StaticResource Gris}" FontSize="11.5"/></StackPanel>
        </Border>
        <Border Grid.Column="6" Style="{StaticResource Tarjeta}" Padding="18,14">
          <StackPanel><TextBlock Text="PENDIENTES" Foreground="{StaticResource GrisClaro}" FontSize="10.5" FontWeight="Bold"/>
            <TextBlock x:Name="cardPend" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ambar}"/>
            <TextBlock Text="sin BrosLMV todavía" Foreground="{StaticResource Gris}" FontSize="11.5"/></StackPanel>
        </Border>
      </Grid>

      <!-- Empresas -->
      <Border Grid.Row="3" Style="{StaticResource Tarjeta}" Padding="0" Margin="0,16,0,0" MinHeight="200">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="22,16,22,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="chkTodas" Grid.Column="0" Content="Seleccionar todas" FontWeight="SemiBold" Foreground="{StaticResource Tinta}"
                      Click="chkTodas_Click" VerticalAlignment="Center" ToolTip="Marca todas las empresas que se ven con el filtro actual"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0">
              <RadioButton x:Name="rbTodas" Content="Todas" GroupName="f" Style="{StaticResource Filtro}" IsChecked="True" Checked="filtro_Changed"/>
              <RadioButton x:Name="rbAct" Content="Por actualizar" GroupName="f" Style="{StaticResource Filtro}" Checked="filtro_Changed"/>
              <RadioButton x:Name="rbPend" Content="Pendientes" GroupName="f" Style="{StaticResource Filtro}" Checked="filtro_Changed"/>
              <RadioButton x:Name="rbOk" Content="Al día" GroupName="f" Style="{StaticResource Filtro}" Checked="filtro_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <TextBox x:Name="txtSearch" Width="220" Height="34" TextChanged="txtSearch_TextChanged" ToolTip="Buscar empresa"/>
              <Button x:Name="btnRefresh" Content="&#xE72C;" FontFamily="{StaticResource Iconos}" Style="{StaticResource Ghost}" Width="38" Padding="0" Height="34" Margin="8,0,0,0"
                      Click="btnConn_Click" ToolTip="Volver a leer las empresas"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14">
            <Grid>
              <DataGrid x:Name="grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        HorizontalGridLinesBrush="#EEF2F7" BorderThickness="0" Background="White" RowBackground="White" SelectionMode="Single"
                        ColumnHeaderStyle="{StaticResource EncabezadoTabla}" RowStyle="{StaticResource FilaTabla}" CellStyle="{StaticResource CeldaTabla}"
                        CanUserResizeRows="False" CanUserReorderColumns="False" IsReadOnly="True" Margin="10,0,10,10">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Sel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="EMPRESA (BASE DE DATOS)" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DB}" FontWeight="SemiBold" Foreground="#0F2037" FontSize="13.5" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="VERSIÓN" Width="190">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding VersionTexto}" Foreground="#64748B" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="ESTADO" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border CornerRadius="12" Padding="11,3" HorizontalAlignment="Left" Background="{Binding EstadoFondo}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding EstadoIcon}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding EstadoColor}" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding Estado}" Foreground="{Binding EstadoColor}" FontWeight="SemiBold" FontSize="12"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="lblVacio" Text="Conecta al servidor para ver tus empresas." Foreground="{StaticResource GrisClaro}" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Acciones -->
      <StackPanel Grid.Row="4" Margin="0,14,0,0">
        <Expander x:Name="expConsola" Header="Contraseña de la Consola (opcional)" Foreground="{StaticResource Gris}" FontWeight="SemiBold" Margin="2,0,0,10"
                  Expanded="expConsola_Changed" Collapsed="expConsola_Changed">
          <Border Style="{StaticResource Tarjeta}" Padding="16,12" Margin="0,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <CheckBox Grid.Column="0" x:Name="chkProtegerConsola" Content="Proteger la Consola con contraseña" VerticalAlignment="Center"
                        Checked="chkProtegerConsola_Changed" Unchecked="chkProtegerConsola_Changed"
                        ToolTip="No se guarda en claro. Si se olvida, se resetea en SQL (tabla zzBrosConsolaPass)."/>
              <Grid Grid.Column="1" x:Name="pnlPasswordConsola" IsEnabled="False">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <PasswordBox Grid.Column="0" x:Name="pwdConsolaActual" Width="170" ToolTip="Contraseña actual" Visibility="Collapsed"/>
                <PasswordBox Grid.Column="2" x:Name="pwdConsolaNueva" ToolTip="Nueva contraseña"/>
                <PasswordBox Grid.Column="4" x:Name="pwdConsolaConfirmar" ToolTip="Confirmar contraseña"/>
              </Grid>
            </Grid>
          </Border>
        </Expander>

        <ProgressBar x:Name="barProgreso" Height="6" Margin="0,0,0,10" Visibility="Collapsed" Foreground="{StaticResource Azul}" Background="#DCE4F0" BorderThickness="0"/>

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="lblFooter" Grid.Column="0" Text="Conecta a tu SQL Server para listar las empresas." Foreground="{StaticResource Gris}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnInstall" Content="Aplicar a las seleccionadas (0)" Style="{StaticResource Ghost}" IsEnabled="False" Margin="0,0,10,0" Click="btnInstall_Click"/>
            <Button x:Name="btnInstalarPendientes" Content="Instalar pendientes" Style="{StaticResource Ghost}" Visibility="Collapsed" Margin="0,0,10,0" Click="btnInstalarPendientes_Click"/>
            <Button x:Name="btnActualizarTodas" Content="Actualizar todas" Style="{StaticResource Primary}" Visibility="Collapsed" Click="btnActualizarTodas_Click"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
    </ScrollViewer>
  </Grid>
</Window>
