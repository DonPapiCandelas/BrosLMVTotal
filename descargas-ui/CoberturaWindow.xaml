<Window x:Class="BrosLMV.DescargasUI.CoberturaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobertura por año" Height="720" Width="1120" MinHeight="480" MinWidth="900"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9">
  <Grid Margin="32,24,32,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Cobertura por año" FontSize="26" FontWeight="Bold" Foreground="#16263A"/>
      <TextBlock Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="Para cada mes: cuántos días ya están cubiertos por una solicitud buena al SAT y cuántos CFDI hay en este equipo. Todo sale de la base local; no se consulta al SAT."/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
      <TextBlock Text="Empresa:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#16263A" FontWeight="SemiBold"/>
      <ComboBox x:Name="CmbEmpresa" Width="360" SelectionChanged="CmbEmpresa_SelectionChanged"/>
      <Button Content="Actualizar" Style="{StaticResource Ghost}" Margin="10,0,0,0" Click="BtnActualizar_Click"/>
    </StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <StackPanel x:Name="Contenido"/>
    </ScrollViewer>
    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
      <Border Width="14" Height="14" CornerRadius="3" Background="#16803B" Margin="0,0,6,0"/><TextBlock Text="Completo" Margin="0,0,18,0" Foreground="#475569"/>
      <Border Width="14" Height="14" CornerRadius="3" Background="#D98F0C" Margin="0,0,6,0"/><TextBlock Text="Parcial" Margin="0,0,18,0" Foreground="#475569"/>
      <Border Width="14" Height="14" CornerRadius="3" Background="#C82828" Margin="0,0,6,0"/><TextBlock Text="Sin cubrir" Margin="0,0,18,0" Foreground="#475569"/>
      <Border Width="14" Height="14" CornerRadius="3" Background="#E2E8F0" Margin="0,0,6,0"/><TextBlock Text="Antes del año de inicio configurado" Margin="0,0,18,0" Foreground="#475569"/>
      <Border Width="14" Height="14" CornerRadius="3" Background="#CBD5E1" Margin="0,0,6,0"/><TextBlock Text="Aún no transcurre" Foreground="#475569"/>
    </WrapPanel>
  </Grid>
</Window>
