<Window x:Class="BrosLMV.DescargasUI.BitacoraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bitácora" Height="620" Width="800" MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F4F6F9">
  <!-- Estilos compartidos (Ghost/Tarjeta) en App.xaml. -->
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Bitácora" FontSize="18" FontWeight="Bold" Foreground="#16263A"/>
        <TextBlock x:Name="LblRuta" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <ComboBox x:Name="CmbMes" Grid.Column="1" Width="160" Margin="0,0,10,0" SelectionChanged="CmbMes_SelectionChanged"/>
      <Button Grid.Column="2" Content="Actualizar" Style="{StaticResource Ghost}" Click="BtnActualizar_Click"/>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="14">
      <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas" FontSize="12.5"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0"/>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Abrir carpeta" Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="BtnAbrirCarpeta_Click"/>
      <Button Content="Cerrar" Style="{StaticResource Ghost}" Click="Cerrar_Click"/>
    </StackPanel>
  </Grid>
</Window>
