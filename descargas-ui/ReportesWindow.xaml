<Window x:Class="BrosLMV.DescargasUI.ReportesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reportes" Height="900" Width="1500" MinHeight="650" MinWidth="1040"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F4F6F9">
  <!-- Los estilos compartidos (Ghost/Tarjeta/Celda*/DataGrid moderno) viven en App.xaml.
       TarjetaTitulo/TarjetaValor/TarjetaSub son unicos de esta ventana (tarjetas KPI del
       resumen), no aplican a ninguna otra pantalla. -->
  <Window.Resources>
    <Style x:Key="TarjetaTitulo" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="TarjetaValor" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#16263A"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="TarjetaSub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Fondo" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Fondo" Property="Background" Value="#E8F0FE"/><Setter Property="Foreground" Value="#2D6FE0"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fondo" Property="Background" Value="#F1F5FB"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="34,28,34,30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" CornerRadius="14" Padding="26,20" Margin="0,0,0,20">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#15324F" Offset="0"/><GradientStop Color="#24558A" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Reportes financieros" FontSize="26" FontWeight="Bold" Foreground="White"/>
          <TextBlock x:Name="LblEmpresa" Foreground="#D9E7F9" FontSize="13" Margin="0,5,0,0"/>
          <TextBlock Text="Resumen, cuentas pendientes y validaciones de los CFDI descargados" Foreground="#AFC7E3" FontSize="12" Margin="0,7,0,0"/>
        </StackPanel>
        <ComboBox x:Name="CmbMes" Grid.Column="1" Width="190" Margin="0,5,10,0" SelectionChanged="CmbMes_SelectionChanged"/>
        <Button Grid.Column="2" Content="Actualizar" Style="{StaticResource Ghost}" Margin="0,5,0,0" Click="BtnActualizar_Click"/>
      </Grid>
    </Border>

    <TabControl Grid.Row="1">
      <TabItem Header="Resumen financiero">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
          <StackPanel>
            <WrapPanel>
              <Border Style="{StaticResource Tarjeta}" Width="200" Margin="0,0,12,12" Padding="18">
                <StackPanel>
                  <TextBlock Text="FACTURADO ESTE MES" Style="{StaticResource TarjetaTitulo}"/>
                  <TextBlock x:Name="LblFacturado" Style="{StaticResource TarjetaValor}"/>
                  <TextBlock x:Name="LblFacturadoSub" Style="{StaticResource TarjetaSub}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tarjeta}" Width="200" Margin="0,0,12,12" Padding="18">
                <StackPanel>
                  <TextBlock Text="COMPRADO ESTE MES" Style="{StaticResource TarjetaTitulo}"/>
                  <TextBlock x:Name="LblComprado" Style="{StaticResource TarjetaValor}"/>
                  <TextBlock x:Name="LblCompradoSub" Style="{StaticResource TarjetaSub}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tarjeta}" Width="200" Margin="0,0,12,12" Padding="18">
                <StackPanel>
                  <TextBlock Text="IVA FACTURADO" Style="{StaticResource TarjetaTitulo}"/>
                  <TextBlock x:Name="LblIvaFacturado" Style="{StaticResource TarjetaValor}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tarjeta}" Width="200" Margin="0,0,12,12" Padding="18">
                <StackPanel>
                  <TextBlock Text="IVA COMPRADO" Style="{StaticResource TarjetaTitulo}"/>
                  <TextBlock x:Name="LblIvaComprado" Style="{StaticResource TarjetaValor}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tarjeta}" Width="200" Margin="0,0,12,12" Padding="18">
                <StackPanel>
                  <TextBlock Text="COBRADO DE CONTADO (PUE)" Style="{StaticResource TarjetaTitulo}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="LblPue" Style="{StaticResource TarjetaValor}"/>
                  <TextBlock x:Name="LblPueSub" Style="{StaticResource TarjetaSub}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tarjeta}" Width="200" Margin="0,0,12,12" Padding="18">
                <StackPanel>
                  <TextBlock Text="A CREDITO (PPD)" Style="{StaticResource TarjetaTitulo}"/>
                  <TextBlock x:Name="LblPpd" Style="{StaticResource TarjetaValor}"/>
                  <TextBlock x:Name="LblPpdSub" Style="{StaticResource TarjetaSub}"/>
                </StackPanel>
              </Border>
            </WrapPanel>

            <TextBlock Text="Top proveedores del mes" FontWeight="SemiBold" Foreground="#16263A" Margin="0,16,0,8"/>
            <Border Style="{StaticResource Tarjeta}" Width="Auto" Margin="0,0,0,10">
              <DataGrid x:Name="GridProveedores" Height="260">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="RFC" Binding="{Binding RFC}" Width="140"/>
                  <DataGridTextColumn Header="Proveedor" Binding="{Binding Nombre}" Width="*"/>
                  <DataGridTextColumn Header="Facturas" Binding="{Binding Count}" Width="80"/>
                  <DataGridTextColumn Header="Total" Binding="{Binding TotalTexto}" Width="140"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Errores de coherencia">
        <DockPanel Margin="0,14,0,0">
          <TextBlock DockPanel.Dock="Top" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Facturas donde MetodoPago y FormaPago no son coherentes segun la regla del SAT: PUE nunca debe traer FormaPago=99, PPD siempre debe traer FormaPago=99 (el pago real se declara despues via complemento de pago). Se muestran todas, sin filtrar por mes."/>
          <Border Style="{StaticResource Tarjeta}" Width="Auto" Margin="0">
            <DataGrid x:Name="GridErrores">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="90"/>
                <DataGridTextColumn Header="RFC emisor" Binding="{Binding RFCEmisor}" Width="130"/>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding NombreEmisor}" Width="200"/>
                <DataGridTextColumn Header="Serie/Folio" Binding="{Binding SerieFolio}" Width="100"/>
                <DataGridTextColumn Header="Metodo" Binding="{Binding MetodoPago}" Width="70"/>
                <DataGridTextColumn Header="Forma" Binding="{Binding FormaPago}" Width="60"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalTexto}" Width="110"/>
                <DataGridTemplateColumn Header="Motivo" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Motivo}" Style="{StaticResource CeldaError}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>

      <TabItem Header="Cuentas por pagar">
        <DockPanel Margin="0,14,0,0">
          <TextBlock DockPanel.Dock="Top" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Facturas a credito (PPD) con saldo pendiente segun los complementos de pago recibidos -- incluye las que no tienen ningun complemento y las que ya tienen uno o mas pero quedaron con pago parcial. Se muestran todas, sin filtrar por mes."/>
          <Border Style="{StaticResource Tarjeta}" Width="Auto" Margin="0">
            <DataGrid x:Name="GridCuentasPorPagar">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="90"/>
                <DataGridTextColumn Header="RFC emisor" Binding="{Binding RFCEmisor}" Width="130"/>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding NombreEmisor}" Width="200"/>
                <DataGridTextColumn Header="Serie/Folio" Binding="{Binding SerieFolio}" Width="100"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalTexto}" Width="110"/>
                <DataGridTextColumn Header="Pagado" Binding="{Binding PagadoTexto}" Width="110"/>
                <DataGridTextColumn Header="Nota credito" Binding="{Binding NotaCreditoTexto}" Width="110"/>
                <DataGridTemplateColumn Header="Saldo" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding SaldoTexto}" Style="{StaticResource CeldaError}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                <DataGridTextColumn Header="Dias" Binding="{Binding DiasTexto}" Width="80"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>

      <TabItem Header="Cuentas por cobrar">
        <DockPanel Margin="0,14,0,0">
          <TextBlock DockPanel.Dock="Top" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Facturas emitidas a credito (PPD) con saldo pendiente de cobro segun los complementos de pago recibidos -- incluye las que no tienen ningun complemento y las que ya tienen uno o mas pero quedaron con pago parcial. Se muestran todas, sin filtrar por mes."/>
          <Border Style="{StaticResource Tarjeta}" Width="Auto" Margin="0">
            <DataGrid x:Name="GridCuentasPorCobrar">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="90"/>
                <DataGridTextColumn Header="RFC cliente" Binding="{Binding RFCReceptor}" Width="130"/>
                <DataGridTextColumn Header="Serie/Folio" Binding="{Binding SerieFolio}" Width="100"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalTexto}" Width="110"/>
                <DataGridTextColumn Header="Cobrado" Binding="{Binding PagadoTexto}" Width="110"/>
                <DataGridTextColumn Header="Nota credito" Binding="{Binding NotaCreditoTexto}" Width="110"/>
                <DataGridTemplateColumn Header="Saldo" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding SaldoTexto}" Style="{StaticResource CeldaError}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                <DataGridTextColumn Header="Dias" Binding="{Binding DiasTexto}" Width="80"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>

      <TabItem Header="Notas de credito">
        <DockPanel Margin="0,14,0,0">
          <TextBlock DockPanel.Dock="Top" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Notas de credito (Egreso) y la factura original que ajustan. Se muestran todas, sin filtrar por mes."/>
          <Border Style="{StaticResource Tarjeta}" Width="Auto" Margin="0">
            <DataGrid x:Name="GridNotasCredito">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha NC" Binding="{Binding FechaNcTexto}" Width="90"/>
                <DataGridTextColumn Header="Serie/Folio NC" Binding="{Binding SerieFolioNc}" Width="110"/>
                <DataGridTextColumn Header="Total NC" Binding="{Binding TotalNcTexto}" Width="110"/>
                <DataGridTextColumn Header="Serie/Folio original" Binding="{Binding SerieFolioOriginal}" Width="130"/>
                <DataGridTextColumn Header="Total original" Binding="{Binding TotalOriginalTexto}" Width="110"/>
                <DataGridTemplateColumn Header="Original en BD" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding OriginalEnBdTexto}" Style="{StaticResource CeldaAtenuada}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>

      <TabItem Header="Usos de CFDI">
        <Border Style="{StaticResource Tarjeta}" Width="Auto" Margin="0,14,0,0">
          <DataGrid x:Name="GridUsos">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Uso CFDI" Binding="{Binding UsoCFDI}" Width="140"/>
              <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="*"/>
              <DataGridTextColumn Header="Facturas" Binding="{Binding Count}" Width="90"/>
              <DataGridTextColumn Header="Total" Binding="{Binding TotalTexto}" Width="140"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
