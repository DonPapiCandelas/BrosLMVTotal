<Window x:Class="BrosLMV.DescargasUI.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrosLMV Descargas - Configuración" Height="320" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configuración inicial" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Archivo .cer" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Name="TxtCer" Margin="6,0"/>
            <Button Grid.Column="2" Content="Examinar" Click="ExaminarCer_Click"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Archivo .key" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Name="TxtKey" Margin="6,0"/>
            <Button Grid.Column="2" Content="Examinar" Click="ExaminarKey_Click"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="RFC" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Name="TxtRfc" Margin="6,0"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Conexión SQL" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Name="TxtConn" Margin="6,0"
                     Text="Server=localhost\compac;Database=BrosLMV_SAT;Trusted_Connection=True;TrustServerCertificate=True;"/>
        </Grid>

        <TextBlock Grid.Row="5" Text="La contraseña de la FIEL NUNCA se guarda aquí -- se pide cada vez que abres el programa."
                   Foreground="#64748b" TextWrapping="Wrap" VerticalAlignment="Bottom"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Guardar" Width="100" Click="Guardar_Click" Background="#2563eb" Foreground="White" Padding="6"/>
        </StackPanel>
    </Grid>
</Window>
