<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:BrosLMV.DescargasUI.Controles">
  <!-- Campos de captura: texto, contraseña, lista desplegable, casilla, fecha, pestañas. -->

  <!-- Campos de texto. IMPORTANTE (bug real 2026-08-19): el ScrollViewer PART_ContentHost NO lleva VerticalAlignment=Center;
       el centrado lo da VerticalContentAlignment del propio TextBox. Centrarlo a mano corrompía el texto (doble exposición). -->
  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="BorderBrush" Value="{StaticResource PincelBordeFuerte}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{StaticResource PincelSuperficie}"/>
    <Setter Property="Foreground" Value="{StaticResource PincelTexto}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource PincelAcentoBorde}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Fondo" CornerRadius="{StaticResource RadioControl}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
              <TextBlock x:Name="Marca" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" Visibility="Collapsed"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{StaticResource PincelTexto3}"
                         Text="{Binding (ui:Ui.Marca), RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="Marca" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource PincelTexto3}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource PincelAcento}"/>
              <Setter TargetName="Fondo" Property="BorderThickness" Value="1.5"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Fondo" Property="Background" Value="{StaticResource PincelSuperficie2}"/>
              <Setter Property="Foreground" Value="{StaticResource PincelTextoDeshabilitado}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="BorderBrush" Value="{StaticResource PincelBordeFuerte}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{StaticResource PincelSuperficie}"/>
    <Setter Property="Foreground" Value="{StaticResource PincelTexto}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Fondo" CornerRadius="{StaticResource RadioControl}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource PincelTexto3}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource PincelAcento}"/>
              <Setter TargetName="Fondo" Property="BorderThickness" Value="1.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lista desplegable -->
  <Style TargetType="ComboBox">
    <Setter Property="Padding" Value="10,0,4,0"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Background" Value="{StaticResource PincelSuperficie}"/>
    <Setter Property="Foreground" Value="{StaticResource PincelTexto}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PincelBordeFuerte}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Boton" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Caja" CornerRadius="{StaticResource RadioControl}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource FuenteIconos}" FontSize="10" Foreground="{StaticResource PincelTexto2}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource PincelTexto3}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource PincelAcento}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="Sitio" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{StaticResource PincelSuperficie}" BorderBrush="{StaticResource PincelBorde}" BorderThickness="1" CornerRadius="10" Margin="0,4,14,16"
                      Effect="{StaticResource SombraFlotante}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                <ScrollViewer Margin="4" SnapsToDevicePixels="True"><ItemsPresenter/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Sitio" Property="Opacity" Value="0.5"/>
              <Setter TargetName="Boton" Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Foreground" Value="{StaticResource PincelTexto}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Fondo" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Fondo" Property="Background" Value="{StaticResource PincelSuperficieHover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{StaticResource PincelAcentoSuave}"/>
              <Setter Property="Foreground" Value="{StaticResource PincelAcentoHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Casilla -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource PincelTexto}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Caja" Width="18" Height="18" CornerRadius="5" Background="{StaticResource PincelSuperficie}"
                    BorderBrush="{StaticResource PincelBordeFuerte}" BorderThickness="1.4" VerticalAlignment="Center">
              <TextBlock x:Name="Palomita" Text="&#xE73E;" FontFamily="{StaticResource FuenteIconos}" FontSize="11" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource PincelAcento}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Caja" Property="Background" Value="{StaticResource PincelAcento}"/>
              <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource PincelAcento}"/>
              <Setter TargetName="Palomita" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pestaña de filtro (RadioButton con aspecto de pestaña subrayada). GroupName las hace excluyentes. -->
  <Style x:Key="Pestana" TargetType="RadioButton">
    <Setter Property="Padding" Value="2,8"/>
    <Setter Property="Margin" Value="0,0,22,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource PincelTexto2}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Raya" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2.5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource PincelTexto}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Raya" Property="BorderBrush" Value="{StaticResource PincelAcento}"/>
              <Setter Property="Foreground" Value="{StaticResource PincelAcento}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Selector de fecha: campo con ícono de calendario y texto de ayuda en español. -->
  <Style TargetType="DatePickerTextBox">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePickerTextBox">
          <Grid Background="Transparent">
            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
            <TextBlock x:Name="Ayuda" Text="dd/mm/aaaa" Foreground="{StaticResource PincelTexto3}" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="Ayuda" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DatePicker">
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="MinWidth" Value="140"/>
    <Setter Property="Background" Value="{StaticResource PincelSuperficie}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PincelBordeFuerte}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource PincelTexto}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <Grid x:Name="PART_Root">
            <Border x:Name="Caja" CornerRadius="{StaticResource RadioControl}" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <Grid Margin="10,0,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" Focusable="{TemplateBinding Focusable}" HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Background="Transparent"/>
              <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Width="34" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" CornerRadius="0,6,6,0">
                      <TextBlock Text="&#xE787;" FontFamily="{StaticResource FuenteIconos}" FontSize="14" Foreground="{StaticResource PincelTexto2}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>
            <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
              <Border Background="{StaticResource PincelSuperficie}" BorderBrush="{StaticResource PincelBorde}" BorderThickness="1" CornerRadius="10"
                      Margin="0,4,14,16" Padding="6" Effect="{StaticResource SombraFlotante}">
                <Calendar x:Name="PART_Calendar" BorderThickness="0" Background="Transparent"/>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource PincelTexto3}"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource PincelAcento}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Caja" Property="Background" Value="{StaticResource PincelSuperficie2}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Sugerencias (ToolTip) -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource PincelMarca900}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MaxWidth" Value="380"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" Effect="{StaticResource SombraTarjeta}">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Barras de desplazamiento delgadas -->
  <Style x:Key="BarraPulgar" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="P" Background="#C3CCD9" CornerRadius="4"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="P" Property="Background" Value="#9AA8BB"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="P" Property="Background" Value="#7C8CA3"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BarraBoton" TargetType="RepeatButton">
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource BarraBoton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource BarraPulgar}" Margin="2,2"/></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource BarraBoton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource BarraBoton}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                  <Track.Thumb><Thumb Style="{StaticResource BarraPulgar}" Margin="2,2"/></Track.Thumb>
                  <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource BarraBoton}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
