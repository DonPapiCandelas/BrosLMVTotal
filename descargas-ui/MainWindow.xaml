<Window x:Class="BrosLMV.DescargasUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrosLMV — Descargas de CFDI" Height="900" Width="1680" MinHeight="680" MinWidth="1180"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9"
        Icon="pack://application:,,,/assets/app_icon.png">
  <!-- Estilos compartidos en App.xaml. Estilos propios de navegación lateral y tarjetas ejecutivas -->
  <Window.Resources>
    <Style x:Key="BotonSidebar" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Margin" Value="14,2,14,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1A3A5E"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BotonSidebarActivo" TargetType="Border">
      <Setter Property="Background" Value="#1E3D5C"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Margin" Value="14,2,14,2"/>
      <Setter Property="BorderBrush" Value="#2D6FE0"/>
      <Setter Property="BorderThickness" Value="1.5,0,0,0"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- SIDEBAR EJECUTIVA -->
    <Border Grid.Column="0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#15324F" Offset="0"/>
          <GradientStop Color="#0B1E33" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel LastChildFill="False">
        <Image DockPanel.Dock="Top" Height="88" Margin="24,28,24,20" Stretch="Uniform"
               Source="pack://application:,,,/assets/logo_blanco.png"/>

        <Border DockPanel.Dock="Top" Style="{StaticResource BotonSidebarActivo}">
          <TextBlock Text="🏢   Empresas" Foreground="White" FontWeight="SemiBold" FontSize="13.5" Margin="18,12"/>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource BotonSidebar}" MouseLeftButtonUp="NavDescargas_Click">
          <TextBlock Text="📄   CFDI descargados" Foreground="#B9CCF3" FontWeight="SemiBold" FontSize="13.5" Margin="18,12"/>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource BotonSidebar}" MouseLeftButtonUp="NavReportes_Click">
          <TextBlock Text="📊   Reportes ejecutivos" Foreground="#B9CCF3" FontWeight="SemiBold" FontSize="13.5" Margin="18,12"/>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource BotonSidebar}" MouseLeftButtonUp="NavSalud_Click">
          <TextBlock Text="🩺   Salud del servicio" Foreground="#B9CCF3" FontWeight="SemiBold" FontSize="13.5" Margin="18,12"/>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource BotonSidebar}" MouseLeftButtonUp="NavBitacora_Click">
          <TextBlock Text="📋   Bitácora" Foreground="#B9CCF3" FontWeight="SemiBold" FontSize="13.5" Margin="18,12"/>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource BotonSidebar}" MouseLeftButtonUp="NavActividad_Click">
          <TextBlock Text="🗓   Actividad" Foreground="#B9CCF3" FontWeight="SemiBold" FontSize="13.5" Margin="18,12"/>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource BotonSidebar}" MouseLeftButtonUp="NavAutomatizacion_Click">
          <TextBlock Text="⏱   Automatización" Foreground="#B9CCF3" FontWeight="SemiBold" FontSize="13.5" Margin="18,12"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="24,18">
          <Border Height="1" Background="#22456A" Margin="0,0,0,14"/>
          <TextBlock x:Name="LblConexion" Text="Sin conexión" Foreground="#9FB3C8" FontSize="11.5" TextWrapping="Wrap"/>
          <TextBlock Text="BrosLMV Descargas · v2.4.0" Foreground="#6E8198" FontSize="11.5" Margin="0,8,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== PANEL 1: Lista de empresas (pantalla inicial) ===== -->
    <Grid x:Name="PanelEmpresas" Grid.Column="1" Margin="36,28,36,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <StackPanel>
          <TextBlock Text="Empresas" FontSize="26" FontWeight="Bold" Foreground="#16263A"/>
          <TextBlock Text="Selecciona una empresa para consultar su cola de solicitudes, historial de CFDI y reportes financieros." Foreground="#64748B" FontSize="13" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="Respaldo…" Style="{StaticResource Ghost}" Margin="0,0,10,0" Padding="14,9" Click="BtnRespaldo_Click" ToolTip="Exportar o importar un respaldo cifrado de las empresas (FIEL, contraseñas y carpetas)"/>
          <Button x:Name="BtnEditarEmpresa" Content="Editar" Style="{StaticResource Ghost}" Margin="0,0,10,0" Padding="14,9" Click="BtnEditarEmpresa_Click" IsEnabled="False"/>
          <Button x:Name="BtnEliminarEmpresa" Content="Eliminar" Style="{StaticResource Danger}" Margin="0,0,10,0" Padding="14,9" Click="BtnEliminarEmpresa_Click" IsEnabled="False"/>
          <Button x:Name="BtnAgregarEmpresa" Content="+ Agregar empresa" Style="{StaticResource Primary}" Padding="16,9" Click="BtnAgregarEmpresa_Click"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Background="#FAFBFD" BorderBrush="#E2E8F0" Padding="20">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="54" Height="54" CornerRadius="12" Background="#E8F0FE" VerticalAlignment="Center">
              <TextBlock Text="🏢" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Empresas registradas" Foreground="#64748B" FontSize="12.5" FontWeight="SemiBold"/>
              <TextBlock x:Name="CardEmpresas" Text="0" FontSize="30" FontWeight="Bold" Foreground="#16263A" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Background="#FAFBFD" BorderBrush="#E2E8F0" Padding="20">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="54" Height="54" CornerRadius="12" Background="#E6F6EE" VerticalAlignment="Center">
              <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Total CFDI descargados" Foreground="#64748B" FontSize="12.5" FontWeight="SemiBold"/>
              <TextBlock x:Name="CardCfdi" Text="0" FontSize="30" FontWeight="Bold" Foreground="#16263A" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Margin="0,18,0,0" MinHeight="220" Padding="18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Catálogo de Empresas" FontWeight="SemiBold" FontSize="15" Foreground="#16263A" Margin="0,0,0,14"/>
          <DataGrid x:Name="GridEmpresas" Grid.Row="1"
                    SelectionMode="Single" SelectionUnit="FullRow"
                    SelectionChanged="GridEmpresas_SelectionChanged" MouseDoubleClick="GridEmpresas_MouseDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="NOMBRE DE LA EMPRESA" Binding="{Binding Nombre}" Width="*" MinWidth="220" IsReadOnly="True"/>
              <DataGridTextColumn Header="RFC" Binding="{Binding RFC}" Width="160" IsReadOnly="True" ElementStyle="{StaticResource CeldaAtenuadaMono}"/>
              <DataGridTextColumn Header="CFDI DESCARGADOS" Binding="{Binding TotalCfdi}" Width="180" IsReadOnly="True"/>
              <DataGridTextColumn Header="ÚLTIMA SOLICITUD" Binding="{Binding UltimoEstatus}" Width="200" IsReadOnly="True" ElementStyle="{StaticResource CeldaAtenuada}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== PANEL 2: Detalle de una empresa ===== -->
    <Grid x:Name="PanelDetalle" Grid.Column="1" Margin="36,28,36,26" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <StackPanel>
          <Button Content="← Volver a lista de empresas" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Padding="12,6" Click="BtnVolver_Click"/>
          <TextBlock x:Name="LblEmpresaTitulo" Text="Empresa" FontSize="25" FontWeight="Bold" Foreground="#16263A" Margin="0,10,0,0"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,16,0,0">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BtnNuevaSolicitud" Content="+ Nueva solicitud" Style="{StaticResource Primary}" Margin="0,0,10,0" Padding="16,9" Click="BtnNuevaSolicitud_Click"/>
          <Button x:Name="BtnRevisarPendientes" Content="Revisar pendientes ahora" Style="{StaticResource Ghost}" Margin="0,0,10,0" Padding="14,9" Click="BtnRevisarPendientes_Click"/>
          <Button x:Name="BtnSincronizarComercial" Content="Sincronizar con Comercial" Style="{StaticResource Ghost}" Margin="0,0,10,0" Padding="14,9" Click="BtnSincronizarComercial_Click"/>
          <Button x:Name="BtnActualizarDetalle" Content="Actualizar" Style="{StaticResource Ghost}" Padding="14,9" Click="BtnActualizarDetalle_Click"/>
        </StackPanel>
      </Grid>

      <!-- Resumen operativo refinado -->
      <Grid Grid.Row="2" Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="18,16" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1.2">
          <StackPanel>
            <TextBlock Text="EN PROCESO / PENDIENTES" Foreground="#92400E" FontWeight="Bold" FontSize="11"/>
            <TextBlock x:Name="CardPendientes" Text="0" Foreground="#16263A" FontSize="28" FontWeight="Bold" Margin="0,4,0,2"/>
            <TextBlock Text="Solicitudes en espera de respuesta del SAT" Foreground="#78350F" FontSize="11.5" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="18,16" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.2">
          <StackPanel>
            <TextBlock Text="TERMINADAS RECIENTES" Foreground="#166534" FontWeight="Bold" FontSize="11"/>
            <TextBlock x:Name="CardTerminadas" Text="0" Foreground="#16263A" FontSize="28" FontWeight="Bold" Margin="0,4,0,2"/>
            <TextBlock Text="Paquetes descargados correctamente" Foreground="#14532D" FontSize="11.5" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource Tarjeta}" Padding="18,16" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1.2">
          <StackPanel>
            <TextBlock Text="REQUIEREN REVISIÓN" Foreground="#9F1239" FontWeight="Bold" FontSize="11"/>
            <TextBlock x:Name="CardErrores" Text="0" Foreground="#16263A" FontSize="28" FontWeight="Bold" Margin="0,4,0,2"/>
            <TextBlock x:Name="LblActividad" Text="Sin incidencias visibles" Foreground="#881337" FontSize="11.5" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="3" Style="{StaticResource Tarjeta}" Margin="0,18,0,0" MinHeight="200" Padding="18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Cola de Solicitudes de Descarga" FontWeight="SemiBold" FontSize="15" Foreground="#16263A" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Limpiar historial antiguo" Style="{StaticResource Ghost}" Padding="12,6" Click="BtnLimpiarSolicitudes_Click"/>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="TabSolicitudesPendientes" Content="En proceso" GroupName="TabsSolicitudes" Style="{StaticResource Pestana}" IsChecked="True" Checked="FiltroSolicitud_Changed"/>
            <RadioButton x:Name="TabSolicitudesTerminadas" Content="Terminadas" GroupName="TabsSolicitudes" Style="{StaticResource Pestana}" Checked="FiltroSolicitud_Changed"/>
            <RadioButton x:Name="TabSolicitudesRechazadas" Content="Rechazadas / Error" GroupName="TabsSolicitudes" Style="{StaticResource Pestana}" Checked="FiltroSolicitud_Changed"/>
          </StackPanel>

          <DataGrid x:Name="GridSolicitudes" Grid.Row="2" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="ID SOLICITUD" Width="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding IdSolicitudCorto}" ToolTip="{Binding IdSolicitud}" 
                               Style="{StaticResource CeldaAtenuadaMono}" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="95"/>
              <DataGridTextColumn Header="DESCARGA" Binding="{Binding TipoSolicitud}" Width="95"/>
              <DataGridTextColumn Header="RANGO" Binding="{Binding Rango}" Width="195"/>
              <DataGridTemplateColumn Header="ESTATUS" Width="135">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#F1F5F9"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding EstatusCategoria}" Value="Terminada">
                              <Setter Property="Background" Value="#DCFCE7"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EstatusCategoria}" Value="Pendiente">
                              <Setter Property="Background" Value="#DBEAFE"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EstatusCategoria}" Value="Rechazada">
                              <Setter Property="Background" Value="#FEE2E2"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Estatus}" FontSize="11.5" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#475569"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding EstatusCategoria}" Value="Terminada">
                                <Setter Property="Foreground" Value="#15803D"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding EstatusCategoria}" Value="Pendiente">
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding EstatusCategoria}" Value="Rechazada">
                                <Setter Property="Foreground" Value="#B91C1C"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="ESPERANDO" Binding="{Binding TiempoTranscurrido}" Width="95" ElementStyle="{StaticResource CeldaAtenuada}"/>
              <DataGridTextColumn Header="CFDIS" Binding="{Binding NumeroCFDIs}" Width="75"/>
              <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha}" Width="140" ElementStyle="{StaticResource CeldaAtenuada}"/>
              <DataGridTextColumn Header="DETALLE / INCIDENCIA" Binding="{Binding ErrorDescarga}" Width="*" MinWidth="200" ElementStyle="{StaticResource CeldaError}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

    </Grid>
  </Grid>
</Window>
