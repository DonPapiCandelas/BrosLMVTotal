<Window x:Class="BrosLMV.DescargasUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrosLMV — Descargas de CFDI" Height="900" Width="1680" MinHeight="680" MinWidth="1180"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9"
        Icon="pack://application:,,,/assets/app_icon.png">
  <!-- Los estilos compartidos (Primary/Ghost/Danger/Pestana/Tarjeta/Celda*, y el look moderno
       implicito de DataGrid/TextBox/ComboBox/CheckBox) viven centralizados en App.xaml desde
       2026-08-19 - antes cada ventana traia su propia copia pegada del mismo bloque de estilos,
       lo que hacia tedioso y propenso a error mantenerlas consistentes. -->

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- SIDEBAR -->
    <Border Grid.Column="0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#15324F" Offset="0"/>
          <GradientStop Color="#0B1E33" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel LastChildFill="False">
        <Image DockPanel.Dock="Top" Height="92" Margin="24,30,24,22" Stretch="Uniform"
               Source="pack://application:,,,/assets/logo_blanco.png"/>
        <Border DockPanel.Dock="Top" Background="#1E3D5C" Margin="14,4" CornerRadius="8">
          <TextBlock Text="🏢   Empresas" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="18,13"/>
        </Border>
        <Border DockPanel.Dock="Top" Background="Transparent" Margin="14,0,14,4" CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="NavDescargas_Click">
          <TextBlock Text="📄   CFDI descargados" Foreground="#B9CCF3" FontWeight="SemiBold" FontSize="14" Margin="18,13"/>
        </Border>
        <Border DockPanel.Dock="Top" Background="Transparent" Margin="14,0,14,4" CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="NavBitacora_Click">
          <TextBlock Text="📋   Bitácora" Foreground="#B9CCF3" FontWeight="SemiBold" FontSize="14" Margin="18,13"/>
        </Border>
        <Border DockPanel.Dock="Top" Background="Transparent" Margin="14,0,14,4" CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="NavReportes_Click">
          <TextBlock Text="📊   Reportes" Foreground="#B9CCF3" FontWeight="SemiBold" FontSize="14" Margin="18,13"/>
        </Border>
        <Border DockPanel.Dock="Top" Background="Transparent" Margin="14,0,14,4" CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="NavActividad_Click">
          <TextBlock Text="🗓   Actividad" Foreground="#B9CCF3" FontWeight="SemiBold" FontSize="14" Margin="18,13"/>
        </Border>
        <Border DockPanel.Dock="Top" Background="Transparent" Margin="14,0,14,4" CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="NavAutomatizacion_Click">
          <TextBlock Text="⏱   Automatización" Foreground="#B9CCF3" FontWeight="SemiBold" FontSize="14" Margin="18,13"/>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="24,18">
          <Border Height="1" Background="#22456A" Margin="0,0,0,16"/>
          <TextBlock x:Name="LblConexion" Text="Sin conexión" Foreground="#9FB3C8" FontSize="11.5" TextWrapping="Wrap"/>
          <TextBlock Text="BrosLMV Descargas" Foreground="#6E8198" FontSize="11.5" Margin="0,10,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== PANEL 1: Lista de empresas (pantalla inicial) ===== -->
    <Grid x:Name="PanelEmpresas" Grid.Column="1" Margin="36,30,36,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <StackPanel>
          <TextBlock Text="Empresas" FontSize="26" FontWeight="Bold" Foreground="#16263A"/>
          <TextBlock Text="Selecciona una empresa para ver su cola de solicitudes y sus CFDI descargados." Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button x:Name="BtnEditarEmpresa" Content="Editar" Style="{StaticResource Ghost}" Margin="0,0,10,0" Click="BtnEditarEmpresa_Click" IsEnabled="False"/>
          <Button x:Name="BtnEliminarEmpresa" Content="Eliminar" Style="{StaticResource Danger}" Margin="0,0,10,0" Click="BtnEliminarEmpresa_Click" IsEnabled="False"/>
          <Button x:Name="BtnAgregarEmpresa" Content="+ Agregar empresa" Style="{StaticResource Primary}" Click="BtnAgregarEmpresa_Click"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,22,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="18"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" Background="#E8F0FE" VerticalAlignment="Top">
              <TextBlock Text="🏢" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Empresas dadas de alta" Foreground="#64748B"/>
              <TextBlock x:Name="CardEmpresas" Text="0" FontSize="32" FontWeight="Bold" Foreground="#16263A" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" Background="#E6F6EE" VerticalAlignment="Top">
              <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="CFDI descargados (todas)" Foreground="#64748B"/>
              <TextBlock x:Name="CardCfdi" Text="0" FontSize="32" FontWeight="Bold" Foreground="#16263A" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Margin="0,20,0,0" MinHeight="220">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Empresas" FontWeight="SemiBold" FontSize="15" Foreground="#16263A" Margin="0,0,0,14"/>
          <DataGrid x:Name="GridEmpresas" Grid.Row="1"
                    SelectionMode="Single" SelectionUnit="FullRow"
                    SelectionChanged="GridEmpresas_SelectionChanged" MouseDoubleClick="GridEmpresas_MouseDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="*" MinWidth="200" IsReadOnly="True"/>
              <DataGridTextColumn Header="RFC" Binding="{Binding RFC}" Width="160" IsReadOnly="True" ElementStyle="{StaticResource CeldaAtenuadaMono}"/>
              <DataGridTextColumn Header="CFDI DESCARGADOS" Binding="{Binding TotalCfdi}" Width="180" IsReadOnly="True"/>
              <DataGridTextColumn Header="ÚLTIMA SOLICITUD" Binding="{Binding UltimoEstatus}" Width="200" IsReadOnly="True" ElementStyle="{StaticResource CeldaAtenuada}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== PANEL 2: Detalle de una empresa ===== -->
    <Grid x:Name="PanelDetalle" Grid.Column="1" Margin="36,30,36,26" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <StackPanel>
          <Button Content="← Empresas" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Padding="10,5" Click="BtnVolver_Click"/>
          <TextBlock x:Name="LblEmpresaTitulo" Text="Empresa" FontSize="26" FontWeight="Bold" Foreground="#16263A" Margin="0,12,0,0"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,16,0,0">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BtnNuevaSolicitud" Content="Nueva solicitud" Style="{StaticResource Primary}" Margin="0,0,10,0" Click="BtnNuevaSolicitud_Click"/>
          <Button x:Name="BtnRevisarPendientes" Content="Revisar pendientes ahora" Style="{StaticResource Ghost}" Margin="0,0,10,0" Click="BtnRevisarPendientes_Click"/>
          <Button x:Name="BtnSincronizarComercial" Content="Sincronizar con Comercial" Style="{StaticResource Ghost}" Margin="0,0,10,0" Click="BtnSincronizarComercial_Click"/>
          <Button x:Name="BtnActualizarDetalle" Content="Actualizar" Style="{StaticResource Ghost}" Click="BtnActualizarDetalle_Click"/>
        </StackPanel>
      </Grid>

      <!-- Resumen operativo: la primera lectura deja claro qué necesita atención, sin obligar
           a interpretar una tabla de estados técnicos. -->
      <Grid Grid.Row="2" Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="18" BorderBrush="#F6D365">
          <StackPanel>
            <TextBlock Text="TRABAJÁNDOSE AHORA" Foreground="#A16207" FontWeight="Bold" FontSize="11"/>
            <TextBlock x:Name="CardPendientes" Text="0" Foreground="#16263A" FontSize="30" FontWeight="Bold" Margin="0,5,0,1"/>
            <TextBlock Text="solicitudes esperando respuesta del SAT" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="18" BorderBrush="#A7E3BA">
          <StackPanel>
            <TextBlock Text="TERMINADAS RECIENTES" Foreground="#16803B" FontWeight="Bold" FontSize="11"/>
            <TextBlock x:Name="CardTerminadas" Text="0" Foreground="#16263A" FontSize="30" FontWeight="Bold" Margin="0,5,0,1"/>
            <TextBlock Text="listas y descargadas correctamente" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Style="{StaticResource Tarjeta}" Padding="18" BorderBrush="#F6B1B1">
          <StackPanel>
            <TextBlock Text="REQUIEREN REVISIÓN" Foreground="#C62828" FontWeight="Bold" FontSize="11"/>
            <TextBlock x:Name="CardErrores" Text="0" Foreground="#16263A" FontSize="30" FontWeight="Bold" Margin="0,5,0,1"/>
            <TextBlock x:Name="LblActividad" Text="Sin incidencias visibles" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="3" Style="{StaticResource Tarjeta}" Margin="0,18,0,0" MinHeight="200">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Trabajo de descarga" FontWeight="SemiBold" FontSize="16" Foreground="#16263A"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock Text="Solo lo que requiere atención" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button Content="Limpiar historial" Style="{StaticResource Ghost}" Click="BtnLimpiarSolicitudes_Click"/>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="TabSolicitudesPendientes" Content="En proceso" GroupName="TabsSolicitudes" Style="{StaticResource Pestana}" IsChecked="True" Checked="FiltroSolicitud_Changed"/>
            <RadioButton x:Name="TabSolicitudesTerminadas" Content="Terminadas" GroupName="TabsSolicitudes" Style="{StaticResource Pestana}" Checked="FiltroSolicitud_Changed"/>
            <RadioButton x:Name="TabSolicitudesRechazadas" Content="Rechazadas / Error" GroupName="TabsSolicitudes" Style="{StaticResource Pestana}" Checked="FiltroSolicitud_Changed"/>
          </StackPanel>

          <DataGrid x:Name="GridSolicitudes" Grid.Row="2" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID SOLICITUD" Binding="{Binding IdSolicitud}" Width="260" ElementStyle="{StaticResource CeldaAtenuadaMono}"/>
              <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="100"/>
              <DataGridTextColumn Header="DESCARGA" Binding="{Binding TipoSolicitud}" Width="100"/>
              <DataGridTextColumn Header="RANGO" Binding="{Binding Rango}" Width="220"/>
              <DataGridTextColumn Header="ESTATUS" Binding="{Binding Estatus}" Width="130"/>
              <DataGridTextColumn Header="ESPERANDO" Binding="{Binding TiempoTranscurrido}" Width="100" ElementStyle="{StaticResource CeldaAtenuada}"/>
              <DataGridTextColumn Header="CFDIS" Binding="{Binding NumeroCFDIs}" Width="80"/>
              <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha}" Width="160" ElementStyle="{StaticResource CeldaAtenuada}"/>
              <DataGridTextColumn Header="ERROR DE DESCARGA" Binding="{Binding ErrorDescarga}" Width="*" MinWidth="200" ElementStyle="{StaticResource CeldaError}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

    </Grid>
  </Grid>
</Window>
