<Window x:Class="BrosLMV.DescargasUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BrosLMV.DescargasUI.Controles"
        Title="BrosLMV Descargas" Height="900" Width="1520" MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PincelLienzo}"
        Icon="pack://application:,,,/assets/app_icon.png">
  <!-- Ventana única de la aplicación: menú lateral + página activa. Cada función es una página (carpeta Paginas\). -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="256"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===== Menú lateral ===== -->
    <Border Grid.Column="0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="{StaticResource Marca800}" Offset="0"/>
          <GradientStop Color="{StaticResource Marca950}" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Height="40" Margin="22,22,22,14" Stretch="Uniform" HorizontalAlignment="Left" Source="pack://application:,,,/assets/logo_blanco.png"/>

        <!-- Selector de empresa -->
        <Grid Grid.Row="1" Margin="14,0,14,6">
          <ToggleButton x:Name="BtnEmpresa" Cursor="Hand" Focusable="True" Height="56" IsChecked="False">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Caja" CornerRadius="10" Background="{StaticResource PincelMarca700}" BorderBrush="{StaticResource PincelMarca600}" BorderThickness="1" Padding="10,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource PincelAcento}" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtIniciales" Text="—" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtEmpresaNombre" Text="Sin empresas" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="TxtEmpresaRfc" Text="Agrega una en «Empresas»" Foreground="{StaticResource PincelMarcaTextoTenue}" FontSize="11.5" FontFamily="{StaticResource FuenteMono}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource FuenteIconos}" FontSize="10" Foreground="{StaticResource PincelMarcaTexto}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource PincelMarcaTextoTenue}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="PopEmpresas" PlacementTarget="{Binding ElementName=BtnEmpresa}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                 IsOpen="{Binding IsChecked, ElementName=BtnEmpresa, Mode=TwoWay}">
            <Border Width="228" Margin="0,6,18,18" Background="{StaticResource PincelSuperficie}" BorderBrush="{StaticResource PincelBorde}" BorderThickness="1" CornerRadius="12"
                    Effect="{StaticResource SombraFlotante}" Padding="6">
              <StackPanel>
                <TextBlock Text="EMPRESAS" Style="{StaticResource TextoRotulo}" Margin="10,8,0,6"/>
                <StackPanel x:Name="ListaEmpresas"/>
                <Border Height="1" Background="{StaticResource PincelBorde}" Margin="4,6"/>
                <Button Style="{StaticResource Subtle}" ui:Ui.Glifo="&#xE713;" Content="Administrar empresas" HorizontalContentAlignment="Left" Click="BtnAdministrarEmpresas_Click"/>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>

        <!-- Navegación -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="TRABAJO" Style="{StaticResource NavSeccion}"/>
            <RadioButton x:Name="NavPanel" GroupName="Nav" Tag="panel" Content="Panel" ui:Ui.Glifo="&#xE80F;" Style="{StaticResource NavItem}" IsChecked="True" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavCfdi" GroupName="Nav" Tag="cfdi" Content="CFDI" ui:Ui.Glifo="&#xE8A5;" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavDescargas" GroupName="Nav" Tag="descargas" Content="Descargas del SAT" ui:Ui.Glifo="&#xE896;" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>

            <TextBlock Text="REVISIÓN" Style="{StaticResource NavSeccion}"/>
            <RadioButton x:Name="NavIndicadores" GroupName="Nav" Tag="indicadores" Content="Indicadores fiscales" ui:Ui.Glifo="&#xE7BA;" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavCobertura" GroupName="Nav" Tag="cobertura" Content="Cobertura por año" ui:Ui.Glifo="&#xE787;" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavConciliacion" GroupName="Nav" Tag="conciliacion" Content="Conciliación mensual" ui:Ui.Glifo="&#xE71D;" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavCancelaciones" GroupName="Nav" Tag="cancelaciones" Content="Cancelaciones" ui:Ui.Glifo="&#xE711;" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavVinculos" GroupName="Nav" Tag="vinculos" Content="Vínculos con Comercial" ui:Ui.Glifo="&#xE71B;" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>

            <TextBlock Text="ANÁLISIS" Style="{StaticResource NavSeccion}"/>
            <RadioButton x:Name="NavReportes" GroupName="Nav" Tag="reportes" Content="Reportes ejecutivos" ui:Ui.Glifo="&#xE9F9;" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>

            <TextBlock Text="SISTEMA" Style="{StaticResource NavSeccion}"/>
            <RadioButton x:Name="NavSalud" GroupName="Nav" Tag="salud" Content="Salud del servicio" ui:Ui.Glifo="&#xEB51;" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavAutomatizacion" GroupName="Nav" Tag="automatizacion" Content="Automatización" ui:Ui.Glifo="&#xE895;" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavRegistro" GroupName="Nav" Tag="registro" Content="Actividad y bitácora" ui:Ui.Glifo="&#xE81C;" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavEmpresas" GroupName="Nav" Tag="empresas" Content="Empresas y e.firma" ui:Ui.Glifo="&#xE8D7;" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Pie: conexión y versión -->
        <StackPanel Grid.Row="3" Margin="22,10,22,18">
          <Border Height="1" Background="{StaticResource PincelMarca700}" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="PuntoConexion" Width="8" Height="8" Fill="{StaticResource PincelMarcaTextoTenue}" VerticalAlignment="Center" Margin="0,1,8,0"/>
            <TextBlock x:Name="LblConexion" Text="Sin conexión" Foreground="{StaticResource PincelMarcaTexto}" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
          </StackPanel>
          <TextBlock x:Name="LblVersion" Text="BrosLMV Descargas" Foreground="{StaticResource PincelMarcaTextoTenue}" FontSize="11.5" Margin="16,5,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Página activa ===== -->
    <ContentControl x:Name="Contenido" Grid.Column="1" IsTabStop="False"/>
  </Grid>
</Window>
