<Window x:Class="BrosLMV.DescargasUI.SaludWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salud" Height="800" Width="1060" MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9">
  <Grid Margin="32,24,32,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    
    <!-- Encabezado estructurado en 2 filas para evitar que los botones se empalmen sobre el título -->
    <Grid Grid.Row="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      
      <Grid Grid.Row="0">
        <StackPanel Margin="0,0,240,0">
          <TextBlock Text="Salud de las descargas" FontSize="26" FontWeight="Bold" Foreground="#16263A"/>
          <TextBlock x:Name="LblResumen" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="Todo se calcula con los datos de este equipo; no se envía nada a ningún lado."/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button x:Name="BtnActualizar" Content="Actualizar" Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="BtnActualizar_Click"/>
          <Button Content="Copiar como texto" Style="{StaticResource Ghost}" Click="BtnCopiar_Click"/>
        </StackPanel>
      </Grid>

      <WrapPanel Grid.Row="1" Margin="0,12,0,0">
        <Button Content="Vínculos con Comercial" Style="{StaticResource Ghost}" Margin="0,0,8,6" Click="BtnVinculos_Click"/>
        <Button Content="Cancelaciones con documento" Style="{StaticResource Ghost}" Margin="0,0,8,6" Click="BtnCancelaciones_Click"/>
        <Button Content="Conciliación mensual" Style="{StaticResource Ghost}" Margin="0,0,8,6" Click="BtnConciliacion_Click"/>
      </WrapPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Contenido"/>
    </ScrollViewer>
  </Grid>
</Window>
