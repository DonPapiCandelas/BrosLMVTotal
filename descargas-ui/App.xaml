<Application x:Class="BrosLMV.DescargasUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <!--
    Sistema de diseno compartido de BrosLMV.DescargasUI - centralizado aqui (2026-08-19,
    pedido explicito del usuario: "se ve horrible la aplicacion, todo amontonado") para que
    TODAS las ventanas se beneficien del mismo look moderno sin duplicar el mismo bloque de
    estilos 7 veces (como estaba antes, uno pegado en cada .xaml). Los estilos CON x:Key hay
    que seguir referenciandolos por nombre (Primary/Ghost/Danger/etc); los estilos SIN x:Key
    (TargetType desnudo) aplican automaticamente a TODOS los controles de ese tipo en TODA la
    app - ahi es donde vive la modernizacion real de DataGrid/TextBox/ComboBox/CheckBox.
  -->
  <Application.Resources>
    <ResourceDictionary>

      <!-- ===== Paleta ===== -->
      <SolidColorBrush x:Key="ColorPrimario" Color="#2D6FE0"/>
      <SolidColorBrush x:Key="ColorPrimarioOscuro" Color="#2158C4"/>
      <SolidColorBrush x:Key="ColorTexto" Color="#16263A"/>
      <SolidColorBrush x:Key="ColorTextoAtenuado" Color="#64748B"/>
      <SolidColorBrush x:Key="ColorBorde" Color="#E2E8F0"/>
      <SolidColorBrush x:Key="ColorFondo" Color="#F4F6F9"/>

      <!-- Sin esto, WPF a veces pinta el texto de la fila seleccionada del DataGrid en blanco
           sobre fondo blanco (bug conocido: los SystemColors de Highlight no estan definidos
           explicitamente). Se fija el mismo azul de marca para que SIEMPRE se lea - global,
           una sola vez para toda la app en vez de repetido por ventana. -->
      <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2D6FE0"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#C7D9F9"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#16263A"/>

      <!-- ===== Sombra sutil compartida (tarjetas "elevadas") ===== -->
      <DropShadowEffect x:Key="SombraTarjeta" Color="#0F172A" Opacity="0.06" BlurRadius="18" ShadowDepth="3" Direction="270"/>

      <!-- ===== Tipografia base - todas las ventanas heredan sin tener que declararlo =====
           Deliberadamente SIN forzar TextOptions.TextFormattingMode/TextRenderingMode: la
           primera version los forzaba a Display/ClearType y el texto de los TextBox salio
           distorsionado/borroso en la maquina real del usuario (reportado en vivo, captura de
           pantalla 2026-08-19) - se deja el default de WPF (Ideal), que renderiza bien en
           cualquier escala de DPI/RDP. -->
      <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13.5"/>
      </Style>

      <!-- ===== Botones ===== -->
      <Style TargetType="Button" x:Key="Primary">
        <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Fondo" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Fondo" Property="Background" Value="{StaticResource ColorPrimarioOscuro}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Fondo" Property="Background" Value="#AFC6F0"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="Button" x:Key="Ghost">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Fondo" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Fondo" Property="Background" Value="#F1F5FB"/>
                  <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="#B7C2CE"/>
                  <Setter TargetName="Fondo" Property="BorderBrush" Value="#E2E8F0"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="Button" x:Key="Danger">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#DC2626"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Fondo" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="#FCA5A5" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Fondo" Property="Background" Value="#FEF2F2"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Pestaña de filtro (RadioButton con look de tab): el GroupName hace que sean mutuamente
           excluyentes solas, sin logica manual de "apagar las demas". -->
      <Style TargetType="RadioButton" x:Key="Pestana">
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoAtenuado}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="Fondo" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Fondo" Property="Background" Value="#E8F0FE"/>
                  <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Fondo" Property="Background" Value="#F1F5FB"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ===== Tarjeta (contenedor blanco redondeado con sombra sutil) - reemplaza el
           Border-con-props-repetidas-a-mano que cada ventana traia por separado. ===== -->
      <Style TargetType="Border" x:Key="Tarjeta">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect" Value="{StaticResource SombraTarjeta}"/>
      </Style>

      <!-- ===== Celdas de texto con estados (usadas dentro de DataGridTemplateColumn) ===== -->
      <Style x:Key="CeldaAtenuada" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoAtenuado}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
            <Setter Property="Foreground" Value="White"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="CeldaAtenuadaMono" TargetType="TextBlock" BasedOn="{StaticResource CeldaAtenuada}">
        <Setter Property="FontFamily" Value="Cascadia Mono,Consolas"/>
        <Setter Property="FontSize" Value="12"/>
      </Style>
      <Style x:Key="CeldaError" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#DC2626"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
            <Setter Property="Foreground" Value="White"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <!-- Verde cuando ya se copio a Comercial (FechaSincronizadoComercial con valor), gris
           cuando no - si el DataContext no trae esa propiedad (otras grillas) el trigger
           simplemente no aplica, sin error visible para el usuario. -->
      <Style x:Key="CeldaSincronizado" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#16A34A"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding FechaSincronizadoComercial}" Value="{x:Null}">
            <Setter Property="Foreground" Value="{StaticResource ColorTextoAtenuado}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
            <Setter Property="Foreground" Value="White"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- ===== DataGrid moderno - IMPLICITO (sin x:Key): aplica automaticamente a TODAS las
           grillas de TODAS las ventanas, sin tener que tocar cada .xaml uno por uno. Antes
           cada grilla tenia RowHeight=34/36 y sin padding de celda - se veia amontonado
           (queja explicita del usuario, captura de pantalla 2026-08-19). ===== -->
      <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
        <Setter Property="RowHeight" Value="42"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      </Style>
      <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoAtenuado}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="BorderBrush" Value="#EEF1F5"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
      </Style>
      <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Foreground" Value="White"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="42"/>
      </Style>

      <!-- ===== Campos de captura modernos - redondeados, con borde visible en foco.
           IMPORTANTE: el ScrollViewer/PART_ContentHost NUNCA lleva VerticalAlignment="Center"
           - eso fue justo lo que corrompio el texto (se veia distorsionado/como doble
           exposicion) en la version anterior: forzar el centrado verticial de un ScrollViewer
           de altura variable, combinado con una Border de altura fija, produce redondeos de
           subpixel inconsistentes al medir/organizar el texto. El centrado vertical real ya lo
           da VerticalContentAlignment="Center" (propiedad nativa del TextBox), sin tocar el
           ScrollViewer. ===== -->
      <Style TargetType="TextBox">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Fondo" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsFocused" Value="True">
                  <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Fondo" Property="Background" Value="#F1F5F9"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="PasswordBox">
              <Border x:Name="Fondo" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsFocused" Value="True">
                  <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <ToggleButton x:Name="ToggleBtn" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              ClickMode="Press" Background="Transparent" BorderThickness="0">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                          </Grid.ColumnDefinitions>
                          <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#64748B" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                  Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                  <Border Background="White" BorderBrush="{StaticResource ColorBorde}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Effect="{StaticResource SombraTarjeta}"
                          MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
              <Border x:Name="Fondo" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="Fondo" Property="Background" Value="#E8F0FE"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="Caja" Width="18" Height="18" CornerRadius="5" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.4" VerticalAlignment="Center">
                  <Path x:Name="Check" Data="M2,6 L5,9 L11,2" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Caja" Property="Background" Value="{StaticResource ColorPrimario}"/>
                  <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                  <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
