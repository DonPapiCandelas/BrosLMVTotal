<Application x:Class="BrosLMV.DescargasUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <!--
    Sistema de diseño de BrosLMV Descargas. Todo vive en Estilos\:
      Tokens.xaml       colores, tipografía, medidas (lo único que se toca para cambiar el aspecto)
      Texto.xaml        escala tipográfica
      Botones.xaml      botones (Primary, Ghost, Subtle, Danger, BotonExito)
      Campos.xaml       texto, listas, casillas, fechas, pestañas, barras de desplazamiento
      Tablas.xaml       rejillas de datos
      Contenedores.xaml tarjetas y pastillas de estado
    Los estilos sin x:Key aplican solos a todos los controles de ese tipo; los que llevan x:Key se piden por nombre.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Estilos/Tokens.xaml"/>
        <ResourceDictionary Source="Estilos/Texto.xaml"/>
        <ResourceDictionary Source="Estilos/Botones.xaml"/>
        <ResourceDictionary Source="Estilos/Campos.xaml"/>
        <ResourceDictionary Source="Estilos/Tablas.xaml"/>
        <ResourceDictionary Source="Estilos/Contenedores.xaml"/>
        <ResourceDictionary Source="Estilos/Navegacion.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Nombres anteriores (las ventanas que aún no se migran los usan). Preferir los PincelXxx de Tokens.xaml. -->
      <SolidColorBrush x:Key="ColorPrimario" Color="{StaticResource Acento}"/>
      <SolidColorBrush x:Key="ColorPrimarioOscuro" Color="{StaticResource AcentoHover}"/>
      <SolidColorBrush x:Key="ColorTexto" Color="{StaticResource Texto}"/>
      <SolidColorBrush x:Key="ColorTextoAtenuado" Color="{StaticResource Texto2}"/>
      <SolidColorBrush x:Key="ColorBorde" Color="{StaticResource Borde}"/>
      <SolidColorBrush x:Key="ColorFondo" Color="{StaticResource Lienzo}"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
