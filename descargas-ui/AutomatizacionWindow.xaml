<Window x:Class="BrosLMV.DescargasUI.AutomatizacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrosLMV — Automatización" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F6F9">
  <!-- Estilos Primary/Ghost compartidos en App.xaml. -->
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Automatización de solicitudes" FontSize="20" FontWeight="Bold" Foreground="#16263A"/>
    <TextBlock Grid.Row="1" Foreground="#64748B" Margin="0,6,0,18" TextWrapping="Wrap"
               Text="El Servicio de Windows &quot;BrosLMV Descargas&quot; corre en segundo plano (sin ventanas visibles) y revisa/descarga cada 10 min, verifica estatus una vez al día, y solicita periodos nuevos con el intervalo que definas aquí. Para forzar una descarga de una fecha específica ahora mismo, usa &quot;Nueva solicitud&quot; en la pantalla principal."/>

    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock x:Name="LblServicio" Text="Consultando estado del servicio..." Foreground="#16263A" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock x:Name="LblEstado" Text="Consultando intervalo actual..." Foreground="#64748B" FontSize="12" Margin="0,0,0,10"/>
        <TextBlock Text="Revisar y solicitar cada" Foreground="#64748B" FontSize="11"/>
        <ComboBox x:Name="CmbIntervalo" Margin="0,4,0,0">
          <ComboBoxItem Content="15 minutos" Tag="15"/>
          <ComboBoxItem Content="30 minutos" Tag="30"/>
          <ComboBoxItem Content="1 hora" Tag="60"/>
          <ComboBoxItem Content="2 horas" Tag="120"/>
          <ComboBoxItem Content="3 horas" Tag="180"/>
          <ComboBoxItem Content="4 horas" Tag="240"/>
          <ComboBoxItem Content="6 horas" Tag="360"/>
          <ComboBoxItem Content="8 horas" Tag="480"/>
          <ComboBoxItem Content="12 horas" Tag="720"/>
          <ComboBoxItem Content="24 horas" Tag="1440"/>
        </ComboBox>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Background="#FEF3E2" BorderBrush="#FCD9A0" BorderThickness="1" CornerRadius="8" Padding="12">
      <TextBlock Text="⚠ Un intervalo más corto gasta el cupo diario del SAT más rápido si hay tramos pendientes grandes." Foreground="#B45309" FontWeight="SemiBold" TextWrapping="Wrap"/>
    </Border>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cerrar" Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="Cerrar_Click"/>
      <Button x:Name="BtnGuardar" Content="Guardar" Style="{StaticResource Primary}" Click="Guardar_Click"/>
    </StackPanel>
  </Grid>
</Window>
