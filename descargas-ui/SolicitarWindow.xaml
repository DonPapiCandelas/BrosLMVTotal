<Window x:Class="BrosLMV.DescargasUI.SolicitarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva solicitud de descarga" Height="320" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F6F9">
    <!-- Estilos compartidos (Primary/Ghost) en App.xaml. -->
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FEF3E2" BorderBrush="#FCD9A0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18">
            <TextBlock Text="⚠ Esto manda 2 solicitudes reales (CFDI + Metadata) — gasta el doble de tu cupo diario del SAT."
                       Foreground="#B45309" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Desde" VerticalAlignment="Center" Foreground="#64748B"/>
            <DatePicker Grid.Column="1" Name="FechaDesde"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Hasta" VerticalAlignment="Center" Foreground="#64748B"/>
            <DatePicker Grid.Column="1" Name="FechaHasta"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
            <RadioButton Name="RbRecibidos" Content="Recibidos" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center"/>
            <RadioButton Name="RbEmitidos" Content="Emitidos" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="Cancelar_Click"/>
            <Button Content="Solicitar" Style="{StaticResource Primary}" Click="Solicitar_Click"/>
        </StackPanel>
    </Grid>
</Window>
