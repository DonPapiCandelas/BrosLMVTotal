<UserControl x:Class="BrosLMV.DescargasUI.Paginas.PaginaBancos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BrosLMV.DescargasUI.Controles">
  <Grid Margin="32,26,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:EncabezadoPagina Grid.Row="0" Titulo="Estados de cuenta" Subtitulo="Los movimientos de tus cuentas bancarias, cargados desde el archivo que te da el banco (CSV, TXT o Excel). Es la base para conciliar.">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Ghost}" ui:Ui.Glifo="&#xE81C;" Content="Cargas anteriores" Margin="0,0,8,0" Click="BtnCargas_Click" ToolTip="Historial de archivos cargados; permite deshacer una carga."/>
        <Button Style="{StaticResource Ghost}" ui:Ui.Glifo="&#xE825;" Content="Cuentas bancarias" Margin="0,0,8,0" Click="BtnCuentas_Click" ToolTip="Registra cada cuenta con su número para que cada archivo se asigne a la correcta."/>
        <Button x:Name="BtnImportar" Style="{StaticResource Primary}" ui:Ui.Glifo="&#xE8E5;" Content="Importar estado de cuenta" Click="BtnImportar_Click"/>
      </StackPanel>
    </ui:EncabezadoPagina>

    <Border Grid.Row="1" Style="{StaticResource BandaInfo}" Margin="0,18,0,0">
      <TextBlock x:Name="LblEstado" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>
    </Border>

    <WrapPanel Grid.Row="2" Margin="0,16,0,0">
      <ComboBox x:Name="CmbCuenta" Width="260" Margin="0,0,10,8" SelectionChanged="Filtro_Changed"/>
      <TextBox x:Name="TxtBuscar" Width="260" Margin="0,0,10,8" ui:Ui.Marca="Buscar por texto, RFC, monto o clave de rastreo" TextChanged="Filtro_Changed"/>
      <ComboBox x:Name="CmbTipo" Width="190" Margin="0,0,10,8" SelectionChanged="Filtro_Changed"/>
      <DatePicker x:Name="DpDesde" Width="140" Margin="0,0,10,8" SelectedDateChanged="Filtro_Changed" ToolTip="Desde"/>
      <DatePicker x:Name="DpHasta" Width="140" Margin="0,0,10,8" SelectedDateChanged="Filtro_Changed" ToolTip="Hasta"/>
      <TextBlock x:Name="LblConteo" Style="{StaticResource TextoSecundario}" VerticalAlignment="Center" Margin="4,0,0,8"/>
    </WrapPanel>

    <DataGrid Grid.Row="3" x:Name="Grid" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat=yyyy-MM-dd}" Width="100" ElementStyle="{StaticResource CeldaAtenuada}"/>
        <DataGridTextColumn Header="CUENTA" Binding="{Binding Cuenta}" Width="150" ElementStyle="{StaticResource CeldaAtenuada}"/>
        <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" ElementStyle="{StaticResource CeldaTexto}"/>
        <DataGridTextColumn Header="CARGO" Binding="{Binding Cargo, StringFormat=N2}" Width="110" ElementStyle="{StaticResource CeldaNumero}"/>
        <DataGridTextColumn Header="ABONO" Binding="{Binding Abono, StringFormat=N2}" Width="110" ElementStyle="{StaticResource CeldaNumero}"/>
        <DataGridTextColumn Header="SALDO" Binding="{Binding Saldo, StringFormat=N2}" Width="120" ElementStyle="{StaticResource CeldaNumero}"/>
        <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="140" ElementStyle="{StaticResource CeldaAtenuada}"/>
        <DataGridTextColumn Header="CONTRAPARTE" Binding="{Binding NombreContraparte}" Width="200" ElementStyle="{StaticResource CeldaAtenuada}"/>
        <DataGridTextColumn Header="RFC" Binding="{Binding RfcContraparte}" Width="130" ElementStyle="{StaticResource CeldaAtenuada}"/>
        <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="100" ElementStyle="{StaticResource CeldaAtenuada}"/>
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="4" x:Name="LblTotales" Style="{StaticResource TextoSecundario}" Margin="0,10,0,0"/>
  </Grid>
</UserControl>
