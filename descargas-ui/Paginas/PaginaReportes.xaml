<UserControl x:Class="BrosLMV.DescargasUI.Paginas.PaginaReportes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BrosLMV.DescargasUI.Controles">
  <UserControl.Resources>
    <Style x:Key="TarjetaKpi" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
      <Setter Property="Padding" Value="18,16"/>
      <Setter Property="Margin" Value="0,0,14,14"/>
    </Style>
    <Style x:Key="TarjetaTitulo" TargetType="TextBlock" BasedOn="{StaticResource TextoRotulo}"/>
    <Style x:Key="TarjetaValor" TargetType="TextBlock" BasedOn="{StaticResource TextoCifra}">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="TarjetaSub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource PincelTexto3}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource PincelTexto2}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="2,9"/>
      <Setter Property="Margin" Value="0,0,22,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Raya" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2.5" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}" Cursor="Hand">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource PincelTexto}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Raya" Property="BorderBrush" Value="{StaticResource PincelAcento}"/>
                <Setter Property="Foreground" Value="{StaticResource PincelAcento}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="32,26,32,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ENCABEZADO -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Reportes ejecutivos" Style="{StaticResource TextoDisplay}"/>
        <TextBlock Style="{StaticResource TextoSecundario}" Margin="0,4,0,0" Text="Análisis de los CFDI emitidos y recibidos, estados de cuenta y validación ante el SAT, por periodo."/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
        <TextBlock Text="Periodo" Style="{StaticResource TextoSecundario}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox x:Name="CmbMes" Width="190" Margin="0,0,8,0" SelectionChanged="CmbMes_SelectionChanged"/>
        <Button Style="{StaticResource Ghost}" ui:Ui.Glifo="&#xE72C;" Content="Actualizar" Margin="0,0,8,0" Click="BtnActualizar_Click"/>
        <Button x:Name="BtnExportarEjecutivo" Style="{StaticResource Primary}" ui:Ui.Glifo="&#xE74E;" Content="Informe ejecutivo (.xlsx)" Click="BtnExportarEjecutivo_Click"
                ToolTip="Genera un libro de Excel de varias hojas con KPIs, Cuentas por Cobrar, Cuentas por Pagar, Inconsistencias y Detalle de Comprobantes"/>
      </StackPanel>
    </Grid>

    <!-- PESTAÑAS DE REPORTES -->
    <TabControl Grid.Row="1">
      <!-- 1. RESUMEN FINANCIERO -->
      <TabItem Header="Resumen Financiero">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
          <StackPanel>
            <!-- Cuadrícula de 6 KPIs Ejecutivos -->
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Card 1: Facturación Emitida -->
              <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TarjetaKpi}" BorderBrush="{StaticResource PincelAcento}" BorderThickness="1.5">
                <StackPanel>
                  <TextBlock Text="FACTURACIÓN DEL MES (VENTAS)" Style="{StaticResource TarjetaTitulo}" Foreground="{StaticResource PincelAcento}"/>
                  <TextBlock x:Name="LblFacturado" Style="{StaticResource TarjetaValor}"/>
                  <TextBlock x:Name="LblFacturadoSub" Style="{StaticResource TarjetaSub}"/>
                </StackPanel>
              </Border>

              <!-- Card 2: Compras y Gastos -->
              <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TarjetaKpi}">
                <StackPanel>
                  <TextBlock Text="COMPRAS Y GASTOS (RECIBIDOS)" Style="{StaticResource TarjetaTitulo}"/>
                  <TextBlock x:Name="LblComprado" Style="{StaticResource TarjetaValor}"/>
                  <TextBlock x:Name="LblCompradoSub" Style="{StaticResource TarjetaSub}"/>
                </StackPanel>
              </Border>

              <!-- Card 3: Balance Operativo Neto -->
              <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TarjetaKpi}" x:Name="CardBorderBalance">
                <StackPanel>
                  <TextBlock Text="BALANCE OPERATIVO NETO" Style="{StaticResource TarjetaTitulo}"/>
                  <TextBlock x:Name="LblBalanceNeto" Style="{StaticResource TarjetaValor}"/>
                  <TextBlock x:Name="LblBalanceNetoSub" Style="{StaticResource TarjetaSub}"/>
                </StackPanel>
              </Border>

              <!-- Card 4: IVA Trasladado -->
              <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TarjetaKpi}">
                <StackPanel>
                  <TextBlock Text="IVA TRASLADADO (COBRADO)" Style="{StaticResource TarjetaTitulo}"/>
                  <TextBlock x:Name="LblIvaFacturado" Style="{StaticResource TarjetaValor}"/>
                  <TextBlock Text="Impuesto cobrado en ventas emitidas" Style="{StaticResource TarjetaSub}"/>
                </StackPanel>
              </Border>

              <!-- Card 5: IVA Acreditable -->
              <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TarjetaKpi}">
                <StackPanel>
                  <TextBlock Text="IVA ACREDITABLE (PAGADO)" Style="{StaticResource TarjetaTitulo}"/>
                  <TextBlock x:Name="LblIvaComprado" Style="{StaticResource TarjetaValor}"/>
                  <TextBlock x:Name="LblIvaDiferencial" Text="Impuesto acreditable de compras" Style="{StaticResource TarjetaSub}"/>
                </StackPanel>
              </Border>

              <!-- Card 6: Flujo PUE vs PPD -->
              <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TarjetaKpi}">
                <StackPanel>
                  <TextBlock Text="CONDICIÓN DE PAGO (COMPRAS)" Style="{StaticResource TarjetaTitulo}"/>
                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Contado (PUE)" FontSize="10.5" Foreground="{StaticResource PincelTexto2}"/>
                      <TextBlock x:Name="LblPue" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PincelTexto}"/>
                      <TextBlock x:Name="LblPueSub" FontSize="10.5" Foreground="{StaticResource PincelTexto3}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Crédito (PPD)" FontSize="10.5" Foreground="{StaticResource PincelTexto2}"/>
                      <TextBlock x:Name="LblPpd" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PincelTexto}"/>
                      <TextBlock x:Name="LblPpdSub" FontSize="10.5" Foreground="{StaticResource PincelTexto3}"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Sección de Tablas: Top Proveedores y Top Clientes en 2 columnas -->
            <Grid Margin="0,10,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Columna Izquierda: Top Proveedores -->
              <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="16">
                <StackPanel>
                  <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Top Proveedores del Mes (Compras)" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PincelTexto}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <DataGrid x:Name="GridProveedores" IsReadOnly="True" Height="280">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="RFC" Binding="{Binding RFC}" Width="130" ElementStyle="{StaticResource CeldaAtenuadaMono}"/>
                      <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding Nombre}" Width="*"/>
                      <DataGridTextColumn Header="FACTURAS" Binding="{Binding Count}" Width="80"/>
                      <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalTexto}" Width="130"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>

              <!-- Columna Derecha: Top Clientes -->
              <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="16">
                <StackPanel>
                  <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Top Clientes del Mes (Ventas)" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PincelTexto}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <DataGrid x:Name="GridClientes" IsReadOnly="True" Height="280">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="RFC" Binding="{Binding RFC}" Width="130" ElementStyle="{StaticResource CeldaAtenuadaMono}"/>
                      <DataGridTextColumn Header="CLIENTE" Binding="{Binding Nombre}" Width="*"/>
                      <DataGridTextColumn Header="FACTURAS" Binding="{Binding Count}" Width="80"/>
                      <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalTexto}" Width="130"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 2. AUDITORÍA FISCAL E IVA -->
      <TabItem Header="Auditoría Fiscal &amp; IVA">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
          <StackPanel>
            <!-- 4 KPIs de Auditoría Impositiva -->
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- KPI 1: IVA Trasladado Cobrado (Ventas PUE) -->
              <Border Grid.Column="0" Style="{StaticResource TarjetaKpi}" BorderBrush="{StaticResource PincelAcento}" BorderThickness="1.5">
                <StackPanel>
                  <TextBlock Text="IVA COBRADO EFECTIVO (PUE)" Style="{StaticResource TarjetaTitulo}" Foreground="{StaticResource PincelAcento}"/>
                  <TextBlock x:Name="LblAuditIvaCobrado" Style="{StaticResource TarjetaValor}"/>
                  <TextBlock x:Name="LblAuditVentasPueSub" Style="{StaticResource TarjetaSub}" Text="Ventas efectivamente liquidadas"/>
                </StackPanel>
              </Border>

              <!-- KPI 2: IVA Acreditable Pagado (Compras PUE) -->
              <Border Grid.Column="1" Style="{StaticResource TarjetaKpi}">
                <StackPanel>
                  <TextBlock Text="IVA ACREDITABLE PAGADO (PUE)" Style="{StaticResource TarjetaTitulo}"/>
                  <TextBlock x:Name="LblAuditIvaPagado" Style="{StaticResource TarjetaValor}"/>
                  <TextBlock x:Name="LblAuditComprasPueSub" Style="{StaticResource TarjetaSub}" Text="Compras efectivamente liquidadas"/>
                </StackPanel>
              </Border>

              <!-- KPI 3: Estimación Neta de IVA (A cargo / A favor) -->
              <Border Grid.Column="2" Style="{StaticResource TarjetaKpi}" x:Name="CardBorderAuditIva">
                <StackPanel>
                  <TextBlock Text="IVA ESTIMADO DEL PERIODO" Style="{StaticResource TarjetaTitulo}"/>
                  <TextBlock x:Name="LblAuditIvaNeto" Style="{StaticResource TarjetaValor}"/>
                  <TextBlock x:Name="LblAuditIvaNetoSub" Style="{StaticResource TarjetaSub}"/>
                </StackPanel>
              </Border>

              <!-- KPI 4: Facturas PPD > 60d sin REP -->
              <Border Grid.Column="3" Style="{StaticResource TarjetaKpi}" BorderBrush="{StaticResource PincelCriticoBorde}">
                <StackPanel>
                  <TextBlock Text="PPD SIN REP (>60 DÍAS)" Style="{StaticResource TarjetaTitulo}" Foreground="{StaticResource PincelCritico}"/>
                  <TextBlock x:Name="LblAuditPpdRiesgo" Style="{StaticResource TarjetaValor}" Foreground="{StaticResource PincelCritico}"/>
                  <TextBlock x:Name="LblAuditPpdRiesgoSub" Style="{StaticResource TarjetaSub}" Text="Riesgo de pérdida de acreditamiento"/>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Sección: Papel de Trabajo de Conciliación Impositiva -->
            <Border Style="{StaticResource Tarjeta}" Padding="18,16" Margin="0,4,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="📋 Papel de Trabajo: Conciliación de Flujo Fiscal e Impuestos" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource PincelTexto}" VerticalAlignment="Center"/>
                  <TextBlock Text="Fundamento Art. 5 LIVA y Art. 27 Fracc. III LISR (Efectivamente erogado)" Foreground="{StaticResource PincelTexto2}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Cuadrícula comparativa Ventas vs Compras -->
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- Lado Izquierdo: Flujo de Ventas (Emitidos) -->
                  <Border Grid.Column="0" Background="{StaticResource PincelSuperficie2}" BorderBrush="{StaticResource PincelBorde}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                      <TextBlock Text="VENTAS Y FACTURACIÓN (INGRESOS)" FontWeight="Bold" FontSize="12.5" Foreground="#24558A" Margin="0,0,0,8"/>
                      <Grid Margin="0,3">
                        <TextBlock Text="Subtotal Contado (PUE):" Foreground="{StaticResource PincelTexto2}" FontSize="12"/>
                        <TextBlock x:Name="LblAuditVentasSubtotalPue" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="12"/>
                      </Grid>
                      <Grid Margin="0,3">
                        <TextBlock Text="IVA Trasladado Cobrado (16% PUE):" Foreground="{StaticResource PincelTexto2}" FontSize="12"/>
                        <TextBlock x:Name="LblAuditVentasIvaPue" FontWeight="Bold" Foreground="{StaticResource PincelAcento}" HorizontalAlignment="Right" FontSize="12"/>
                      </Grid>
                      <Separator Margin="0,6"/>
                      <Grid Margin="0,3">
                        <TextBlock Text="Subtotal Crédito (PPD pendiente):" Foreground="{StaticResource PincelTexto2}" FontSize="12"/>
                        <TextBlock x:Name="LblAuditVentasSubtotalPpd" HorizontalAlignment="Right" FontSize="12"/>
                      </Grid>
                      <Grid Margin="0,3">
                        <TextBlock Text="IVA Trasladado Diferido (PPD):" Foreground="{StaticResource PincelTexto2}" FontSize="12"/>
                        <TextBlock x:Name="LblAuditVentasIvaPpd" HorizontalAlignment="Right" FontSize="12"/>
                      </Grid>
                      <Separator Margin="0,6"/>
                      <Grid Margin="0,3">
                        <TextBlock Text="Total Facturado Emitido:" FontWeight="Bold" FontSize="12.5"/>
                        <TextBlock x:Name="LblAuditVentasTotal" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12.5"/>
                      </Grid>
                      <Grid Margin="0,3">
                        <TextBlock Text="Retenciones de clientes (ISR/IVA):" Foreground="{StaticResource PincelTexto2}" FontSize="12"/>
                        <TextBlock x:Name="LblAuditRetencionesEmitidas" HorizontalAlignment="Right" FontSize="12"/>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- Lado Derecho: Flujo de Compras y Gastos (Recibidos) -->
                  <Border Grid.Column="2" Background="{StaticResource PincelSuperficie2}" BorderBrush="{StaticResource PincelBorde}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                      <TextBlock Text="COMPRAS Y GASTOS (DEDUCCIONES)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PincelOk}" Margin="0,0,0,8"/>
                      <Grid Margin="0,3">
                        <TextBlock Text="Subtotal Contado (PUE pagado):" Foreground="{StaticResource PincelTexto2}" FontSize="12"/>
                        <TextBlock x:Name="LblAuditComprasSubtotalPue" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="12"/>
                      </Grid>
                      <Grid Margin="0,3">
                        <TextBlock Text="IVA Acreditable Pagado (16% PUE):" Foreground="{StaticResource PincelTexto2}" FontSize="12"/>
                        <TextBlock x:Name="LblAuditComprasIvaPue" FontWeight="Bold" Foreground="{StaticResource PincelOk}" HorizontalAlignment="Right" FontSize="12"/>
                      </Grid>
                      <Separator Margin="0,6"/>
                      <Grid Margin="0,3">
                        <TextBlock Text="Subtotal Crédito (PPD pendiente):" Foreground="{StaticResource PincelTexto2}" FontSize="12"/>
                        <TextBlock x:Name="LblAuditComprasSubtotalPpd" HorizontalAlignment="Right" FontSize="12"/>
                      </Grid>
                      <Grid Margin="0,3">
                        <TextBlock Text="IVA Pendiente de Acreditar (PPD):" Foreground="{StaticResource PincelTexto2}" FontSize="12"/>
                        <TextBlock x:Name="LblAuditComprasIvaPpd" HorizontalAlignment="Right" FontSize="12"/>
                      </Grid>
                      <Separator Margin="0,6"/>
                      <Grid Margin="0,3">
                        <TextBlock Text="Total Compras Recibidas:" FontWeight="Bold" FontSize="12.5"/>
                        <TextBlock x:Name="LblAuditComprasTotal" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12.5"/>
                      </Grid>
                      <Grid Margin="0,3">
                        <TextBlock Text="Retenciones efectuadas a terceros:" Foreground="{StaticResource PincelTexto2}" FontSize="12"/>
                        <TextBlock x:Name="LblAuditRetencionesRecibidas" HorizontalAlignment="Right" FontSize="12"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Sección: Facturas a Crédito en Riesgo de Acreditamiento (PPD sin REP > 60 días) -->
            <Border Style="{StaticResource Tarjeta}" Padding="18,16" Margin="0,4,0,10">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="⚠️ Facturas Recibidas a Crédito sin Complemento de Pago (REP Pendiente)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PincelTexto}"/>
                    <TextBlock Text="Facturas PPD con más de 60 días sin recibo electrónico de pago. Riesgo de no deducibilidad y rechazo de IVA por el SAT." Foreground="{StaticResource PincelTexto2}" FontSize="11.5" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button Content="Exportar riesgo REP (.xlsx)" Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnExportarRiesgoRep_Click"/>
                </DockPanel>

                <DataGrid x:Name="GridRiesgoRep" IsReadOnly="True" MaxHeight="300">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding FechaTexto}" Width="95"/>
                    <DataGridTextColumn Header="RFC PROVEEDOR" Binding="{Binding RFCEmisor}" Width="135" ElementStyle="{StaticResource CeldaAtenuadaMono}"/>
                    <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding NombreEmisor}" Width="*"/>
                    <DataGridTextColumn Header="SERIE / FOLIO" Binding="{Binding SerieFolio}" Width="110"/>
                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalTexto}" Width="120"/>
                    <DataGridTextColumn Header="IVA EN RIESGO" Binding="{Binding IvaTexto}" Width="120"/>
                    <DataGridTextColumn Header="ANTIGÜEDAD" Binding="{Binding DiasTexto}" Width="100"/>
                    <DataGridTemplateColumn Header="NIVEL DE RIESGO" Width="170">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Border CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Background="{StaticResource PincelCriticoFondo}">
                            <TextBlock Text="{Binding Riesgo}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource PincelCritico}"/>
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 3. ERRORES DE COHERENCIA -->
      <TabItem Header="Inconsistencias Fiscales">
        <DockPanel Margin="0,14,0,0">
          <Border DockPanel.Dock="Top" Style="{StaticResource Tarjeta}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Auditoría Preventiva Anexo 20 (SAT)" FontWeight="SemiBold" Foreground="{StaticResource PincelTexto}" FontSize="13.5"/>
                <TextBlock Foreground="{StaticResource PincelTexto2}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Regla SAT: Comprobantes PUE nunca deben tener Forma 99 (Por definir). Comprobantes PPD deben tener Forma 99. La clave P01 de Uso CFDI está derogada en 4.0."/>
              </StackPanel>
              <Button Grid.Column="1" Content="Exportar inconsistencias (.xlsx)" Style="{StaticResource Ghost}" Click="BtnExportarErrores_Click" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource Tarjeta}" Padding="0">
            <DataGrid x:Name="GridErrores" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="FECHA" Binding="{Binding FechaTexto}" Width="95"/>
                <DataGridTextColumn Header="RFC EMISOR" Binding="{Binding RFCEmisor}" Width="135" ElementStyle="{StaticResource CeldaAtenuadaMono}"/>
                <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding NombreEmisor}" Width="220"/>
                <DataGridTextColumn Header="SERIE / FOLIO" Binding="{Binding SerieFolio}" Width="110"/>
                <DataGridTextColumn Header="MÉTODO" Binding="{Binding MetodoPago}" Width="75"/>
                <DataGridTextColumn Header="FORMA" Binding="{Binding FormaPago}" Width="70"/>
                <DataGridTextColumn Header="USO CFDI" Binding="{Binding UsoCFDI}" Width="85"/>
                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalTexto}" Width="120"/>
                <DataGridTemplateColumn Header="MOTIVO DE INCONSISTENCIA" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Motivo}" Style="{StaticResource CeldaError}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>

      <!-- 3. CUENTAS POR PAGAR -->
      <TabItem Header="Cuentas por Pagar (CxP)">
        <DockPanel Margin="0,14,0,0">
          <Border DockPanel.Dock="Top" Style="{StaticResource Tarjeta}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Facturas recibidas a crédito (PPD) con saldo pendiente" FontWeight="SemiBold" Foreground="{StaticResource PincelTexto}" FontSize="13.5"/>
                <TextBlock Foreground="{StaticResource PincelTexto2}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Calcula el saldo pendiente deduciendo complementos de pago recibidos y notas de crédito de egreso relacionadas."/>
              </StackPanel>
              <TextBlock x:Name="LblTotalCxP" Grid.Column="1" Text="Total Saldo: $0.00" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PincelCritico}" VerticalAlignment="Center" Margin="0,0,16,0"/>
              <Button Grid.Column="2" Content="Exportar CxP (.xlsx)" Style="{StaticResource Ghost}" Click="BtnExportarCxP_Click" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource Tarjeta}" Padding="0">
            <DataGrid x:Name="GridCuentasPorPagar" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="FECHA" Binding="{Binding FechaTexto}" Width="95"/>
                <DataGridTextColumn Header="RFC EMISOR" Binding="{Binding RFCEmisor}" Width="135" ElementStyle="{StaticResource CeldaAtenuadaMono}"/>
                <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding NombreEmisor}" Width="210"/>
                <DataGridTextColumn Header="SERIE / FOLIO" Binding="{Binding SerieFolio}" Width="110"/>
                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalTexto}" Width="120"/>
                <DataGridTextColumn Header="PAGADO" Binding="{Binding PagadoTexto}" Width="115"/>
                <DataGridTextColumn Header="NOTA CRÉDITO" Binding="{Binding NotaCreditoTexto}" Width="115"/>
                <DataGridTemplateColumn Header="SALDO PENDIENTE" Width="135">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding SaldoTexto}" Style="{StaticResource CeldaError}" FontWeight="Bold"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="120"/>
                <DataGridTextColumn Header="DÍAS" Binding="{Binding DiasTexto}" Width="85"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>

      <!-- 4. CUENTAS POR COBRAR -->
      <TabItem Header="Cuentas por Cobrar (CxC)">
        <DockPanel Margin="0,14,0,0">
          <Border DockPanel.Dock="Top" Style="{StaticResource Tarjeta}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Facturas emitidas a crédito (PPD) con saldo pendiente de cobro" FontWeight="SemiBold" Foreground="{StaticResource PincelTexto}" FontSize="13.5"/>
                <TextBlock Foreground="{StaticResource PincelTexto2}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Cartera pendiente calculada cruzando los complementos de pago emitidos y notas de crédito aplicadas a cada documento."/>
              </StackPanel>
              <TextBlock x:Name="LblTotalCxC" Grid.Column="1" Text="Total Cartera: $0.00" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PincelOk}" VerticalAlignment="Center" Margin="0,0,16,0"/>
              <Button Grid.Column="2" Content="Exportar CxC (.xlsx)" Style="{StaticResource Ghost}" Click="BtnExportarCxC_Click" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource Tarjeta}" Padding="0">
            <DataGrid x:Name="GridCuentasPorCobrar" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="FECHA" Binding="{Binding FechaTexto}" Width="95"/>
                <DataGridTextColumn Header="RFC CLIENTE" Binding="{Binding RFCReceptor}" Width="135" ElementStyle="{StaticResource CeldaAtenuadaMono}"/>
                <DataGridTextColumn Header="SERIE / FOLIO" Binding="{Binding SerieFolio}" Width="110"/>
                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalTexto}" Width="120"/>
                <DataGridTextColumn Header="COBRADO" Binding="{Binding PagadoTexto}" Width="115"/>
                <DataGridTextColumn Header="NOTA CRÉDITO" Binding="{Binding NotaCreditoTexto}" Width="115"/>
                <DataGridTemplateColumn Header="SALDO POR COBRAR" Width="145">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding SaldoTexto}" FontWeight="Bold" Foreground="{StaticResource PincelOk}" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="120"/>
                <DataGridTextColumn Header="DÍAS" Binding="{Binding DiasTexto}" Width="85"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>

      <!-- 5. NOTAS DE CRÉDITO -->
      <TabItem Header="Notas de Crédito">
        <DockPanel Margin="0,14,0,0">
          <Border DockPanel.Dock="Top" Style="{StaticResource Tarjeta}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Notas de Crédito (Tipo E) y comprobantes originales vinculados" FontWeight="SemiBold" Foreground="{StaticResource PincelTexto}" FontSize="13.5"/>
                <TextBlock Foreground="{StaticResource PincelTexto2}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Relación oficial TipoRelacion 01 según nodo CfdiRelacionados del CFDI."/>
              </StackPanel>
              <Button Grid.Column="1" Content="Exportar notas (.xlsx)" Style="{StaticResource Ghost}" Click="BtnExportarNC_Click" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource Tarjeta}" Padding="0">
            <DataGrid x:Name="GridNotasCredito" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="FECHA NC" Binding="{Binding FechaNcTexto}" Width="95"/>
                <DataGridTextColumn Header="SERIE / FOLIO NC" Binding="{Binding SerieFolioNc}" Width="120"/>
                <DataGridTextColumn Header="TOTAL NC" Binding="{Binding TotalNcTexto}" Width="125"/>
                <DataGridTextColumn Header="FACTURA ORIGINAL" Binding="{Binding SerieFolioOriginal}" Width="140"/>
                <DataGridTextColumn Header="TOTAL ORIGINAL" Binding="{Binding TotalOriginalTexto}" Width="125"/>
                <DataGridTemplateColumn Header="ORIGINAL EN BD" Width="120">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding OriginalEnBdTexto}" Style="{StaticResource CeldaAtenuada}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>

      <!-- 6. USOS DE CFDI -->
      <TabItem Header="Usos de CFDI">
        <DockPanel Margin="0,14,0,0">
          <Border DockPanel.Dock="Top" Style="{StaticResource Tarjeta}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Distribución de compras por Uso de CFDI (SAT)" FontWeight="SemiBold" Foreground="{StaticResource PincelTexto}" FontSize="13.5"/>
                <TextBlock Foreground="{StaticResource PincelTexto2}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Agrupación de facturas recibidas de tipo Ingreso según la clave de uso declarada por el proveedor."/>
              </StackPanel>
              <Button Grid.Column="1" Content="Exportar usos (.xlsx)" Style="{StaticResource Ghost}" Click="BtnExportarUsos_Click" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource Tarjeta}" Padding="0">
            <DataGrid x:Name="GridUsos" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="CLAVE" Binding="{Binding UsoCFDI}" Width="110"/>
                <DataGridTextColumn Header="DESCRIPCIÓN DE USO (SAT)" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridTextColumn Header="FACTURAS" Binding="{Binding Count}" Width="100"/>
                <DataGridTextColumn Header="TOTAL COMPRAS" Binding="{Binding TotalTexto}" Width="150"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
