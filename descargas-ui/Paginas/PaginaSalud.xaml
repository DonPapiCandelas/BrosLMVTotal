<UserControl x:Class="BrosLMV.DescargasUI.Paginas.PaginaSalud"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BrosLMV.DescargasUI.Controles">
  <Grid Margin="32,26,32,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ui:EncabezadoPagina Grid.Row="0" Titulo="Salud del servicio" Subtitulo="Todo lo que podría estar mal en las descargas: servicio detenido, huecos, XML faltantes, e.firma por vencer… Se calcula con los datos de este equipo; no se envía nada a ningún lado.">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Ghost}" ui:Ui.Glifo="&#xE8C8;" Content="Copiar como texto" Margin="0,0,8,0" Click="BtnCopiar_Click"/>
        <Button Style="{StaticResource Primary}" ui:Ui.Glifo="&#xE72C;" Content="Actualizar" Click="BtnActualizar_Click"/>
      </StackPanel>
    </ui:EncabezadoPagina>
    <Border Grid.Row="1" x:Name="Resumen" Style="{StaticResource BandaOk}" Margin="0,18,0,0">
      <TextBlock x:Name="LblResumen" TextWrapping="Wrap" FontSize="13"/>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
      <StackPanel x:Name="Contenido"/>
    </ScrollViewer>
  </Grid>
</UserControl>
