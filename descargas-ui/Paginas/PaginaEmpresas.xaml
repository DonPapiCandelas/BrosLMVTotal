<UserControl x:Class="BrosLMV.DescargasUI.Paginas.PaginaEmpresas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BrosLMV.DescargasUI.Controles">
  <Grid Margin="32,26,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <ui:EncabezadoPagina Grid.Row="0" Titulo="Empresas y e.firma" Subtitulo="Cada empresa guarda su e.firma, sus carpetas y su conexión con Comercial. La contraseña se cifra en este equipo y nunca se envía a ningún lado.">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Ghost}" ui:Ui.Glifo="&#xE74E;" Content="Respaldo" Margin="0,0,8,0" Click="BtnRespaldo_Click"
                ToolTip="Exportar o importar un respaldo cifrado de las empresas (e.firma, contraseñas y carpetas)"/>
        <Button Style="{StaticResource Primary}" ui:Ui.Glifo="&#xE710;" Content="Agregar empresa" Click="BtnAgregarEmpresa_Click"/>
      </StackPanel>
    </ui:EncabezadoPagina>

    <Grid Grid.Row="1" Margin="0,22,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="20,16">
        <StackPanel Orientation="Horizontal">
          <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource PincelAcentoSuave}">
            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource FuenteIconos}" FontSize="19" Foreground="{StaticResource PincelAcento}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="EMPRESAS REGISTRADAS" Style="{StaticResource TextoRotulo}"/>
            <TextBlock x:Name="CardEmpresas" Style="{StaticResource TextoCifra}" Text="0" FontSize="24"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="20,16">
        <StackPanel Orientation="Horizontal">
          <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource PincelOkFondo}">
            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource FuenteIconos}" FontSize="19" Foreground="{StaticResource PincelOk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="CFDI EN ESTE EQUIPO" Style="{StaticResource TextoRotulo}"/>
            <TextBlock x:Name="CardCfdi" Style="{StaticResource TextoCifra}" Text="0" FontSize="24"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Margin="0,18,0,0" Padding="0">
      <Grid>
        <DataGrid x:Name="GridEmpresas" SelectionMode="Single" IsReadOnly="True" MouseDoubleClick="GridEmpresas_MouseDoubleClick" RowHeight="56">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="EMPRESA" Width="*" MinWidth="260">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Fila.Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <Border Style="{StaticResource PastillaInfo}" Margin="10,0,0,0" Padding="8,1" Visibility="{Binding VisibleActiva}"><TextBlock Text="Activa"/></Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Fila.RFC}" Style="{StaticResource TextoMono}" Margin="0,2,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="E.FIRMA" Width="190">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border VerticalAlignment="Center" Style="{Binding EstiloFirma}"><TextBlock Text="{Binding TextoFirma}"/></Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="COMERCIAL" Binding="{Binding TextoComercial}" Width="190" ElementStyle="{StaticResource CeldaAtenuada}"/>
            <DataGridTextColumn Header="CFDI" Binding="{Binding TextoCfdi}" Width="90" ElementStyle="{StaticResource CeldaNumero}"/>
            <DataGridTextColumn Header="ÚLTIMA SOLICITUD" Binding="{Binding Fila.UltimoEstatus}" Width="160" ElementStyle="{StaticResource CeldaAtenuada}"/>
            <DataGridTemplateColumn Header="" Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Subtle}" Content="Usar" Padding="10,4" MinHeight="30" Click="BtnUsar_Click" Tag="{Binding Fila}" ToolTip="Trabajar con esta empresa"/>
                    <Button Style="{StaticResource Subtle}" ui:Ui.Glifo="&#xE70F;" Padding="8,4" MinHeight="30" Click="BtnEditar_Click" Tag="{Binding Fila}" ToolTip="Editar"/>
                    <Button Style="{StaticResource Subtle}" ui:Ui.Glifo="&#xE74D;" Padding="8,4" MinHeight="30" Click="BtnEliminar_Click" Tag="{Binding Fila}" ToolTip="Eliminar del catálogo" Foreground="{StaticResource PincelCritico}"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="Vacio" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource FuenteIconos}" FontSize="34" Foreground="{StaticResource PincelBordeFuerte}" HorizontalAlignment="Center"/>
          <TextBlock Text="Todavía no hay empresas" Style="{StaticResource TextoSubtitulo}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          <TextBlock Text="Agrega una con su e.firma (archivos .cer y .key) para descargar sus CFDI del SAT." Style="{StaticResource TextoSecundario}" TextAlignment="Center" MaxWidth="360" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
