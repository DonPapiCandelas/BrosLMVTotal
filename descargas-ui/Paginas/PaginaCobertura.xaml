<UserControl x:Class="BrosLMV.DescargasUI.Paginas.PaginaCobertura"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BrosLMV.DescargasUI.Controles">
  <Grid Margin="32,26,32,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ui:EncabezadoPagina Grid.Row="0" Titulo="Cobertura por año" Subtitulo="Para cada mes: cuántos días ya cubre una solicitud buena al SAT y cuántos CFDI hay en este equipo. Sale de la base local; no se consulta al SAT.">
      <Button Style="{StaticResource Ghost}" ui:Ui.Glifo="&#xE72C;" Content="Actualizar" Click="BtnActualizar_Click"/>
    </ui:EncabezadoPagina>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
      <StackPanel x:Name="Contenido"/>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
      <Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource PincelOk}" Margin="0,0,6,0"/><TextBlock Text="Completo" Margin="0,0,18,0" Style="{StaticResource TextoSecundario}"/>
      <Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource PincelAviso}" Margin="0,0,6,0"/><TextBlock Text="Parcial" Margin="0,0,18,0" Style="{StaticResource TextoSecundario}"/>
      <Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource PincelCritico}" Margin="0,0,6,0"/><TextBlock Text="Sin cubrir" Margin="0,0,18,0" Style="{StaticResource TextoSecundario}"/>
      <Border Width="14" Height="14" CornerRadius="3" Background="#E2E8F0" Margin="0,0,6,0"/><TextBlock Text="Antes del año de inicio configurado" Margin="0,0,18,0" Style="{StaticResource TextoSecundario}"/>
      <Border Width="14" Height="14" CornerRadius="3" Background="#CBD5E1" Margin="0,0,6,0"/><TextBlock Text="Aún no transcurre" Style="{StaticResource TextoSecundario}"/>
    </WrapPanel>
  </Grid>
</UserControl>
