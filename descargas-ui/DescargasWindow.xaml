<Window x:Class="BrosLMV.DescargasUI.DescargasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CFDI descargados" Height="900" Width="1580" MinHeight="650" MinWidth="1120"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9">
  <Grid Margin="32,26,32,28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <StackPanel>
        <TextBlock Text="CFDI descargados" FontSize="27" FontWeight="Bold" Foreground="#16263A"/>
        <TextBlock x:Name="LblSubtitulo" Foreground="#64748B" Margin="0,6,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Content="Archivar" Style="{StaticResource Ghost}" Margin="0,0,10,0" Click="BtnArchivar_Click"/>
        <Button Content="Descargar XML" Style="{StaticResource Ghost}" Margin="0,0,10,0" Click="BtnDescargarXml_Click"/>
        <Button Content="Actualizar" Style="{StaticResource Ghost}" Margin="0,0,10,0" Click="BtnActualizar_Click"/>
        <Button Content="Exportar a Excel" Style="{StaticResource Primary}" Click="BtnExportarExcel_Click"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0,22,0,18" Padding="16">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="TabRecibidos" Content="Recibidos" GroupName="Tipo" Style="{StaticResource Pestana}" IsChecked="True" Checked="Filtro_Changed"/>
          <RadioButton x:Name="TabEmitidos" Content="Emitidos" GroupName="Tipo" Style="{StaticResource Pestana}" Checked="Filtro_Changed"/>
          <TextBlock x:Name="LblConteo" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#64748B" Margin="18,0,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,14,0,0">
          <TextBox x:Name="TxtBuscar" Width="280" Margin="0,0,10,0" ToolTip="Busca por UUID, RFC, nombre, fecha, folio o importe" TextChanged="Filtro_Changed"/>
          <ComboBox x:Name="CmbEstatus" Width="150" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="Filtro_Changed">
            <ComboBoxItem Content="Todos los estatus" Tag=""/>
            <ComboBoxItem Content="Vigente" Tag="Vigente"/>
            <ComboBoxItem Content="Cancelado" Tag="Cancelado"/>
          </ComboBox>
          <ComboBox x:Name="CmbTipo" Width="145" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="Filtro_Changed">
            <ComboBoxItem Content="Todos los tipos" Tag=""/>
            <ComboBoxItem Content="Ingreso" Tag="I"/><ComboBoxItem Content="Egreso" Tag="E"/>
            <ComboBoxItem Content="Nómina" Tag="N"/><ComboBoxItem Content="Traslado" Tag="T"/><ComboBoxItem Content="Pago" Tag="P"/>
          </ComboBox>
          <CheckBox x:Name="ChkArchivados" Content="Incluir archivados" VerticalAlignment="Center" Margin="4,0,14,0" Checked="Filtro_Changed" Unchecked="Filtro_Changed"/>
          <Button Content="Ver detalle" Style="{StaticResource Ghost}" Click="BtnDetalle_Click"/>
        </WrapPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0">
      <DataGrid x:Name="GridCfdi" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="GridCfdi_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="" Binding="{Binding Seleccionado, UpdateSourceTrigger=PropertyChanged}" Width="42" IsReadOnly="False"/>
          <DataGridTextColumn Header="UUID" Binding="{Binding UUID}" Width="250" ElementStyle="{StaticResource CeldaAtenuadaMono}"/>
          <DataGridTextColumn Header="CONTRAPARTE" Binding="{Binding NombreContraparte}" Width="*" MinWidth="220"/>
          <DataGridTextColumn Header="RFC" Binding="{Binding Contraparte}" Width="145" ElementStyle="{StaticResource CeldaAtenuadaMono}"/>
          <DataGridTextColumn Header="TIPO" Binding="{Binding TipoComprobante}" Width="75"/>
          <DataGridTextColumn Header="EMISIÓN" Binding="{Binding FechaEmision}" Width="145" ElementStyle="{StaticResource CeldaAtenuada}"/>
          <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal}" Width="120"/>
          <DataGridTextColumn Header="IVA" Binding="{Binding IVA}" Width="105"/>
          <DataGridTextColumn Header="RETENCIONES" Binding="{Binding Retenciones}" Width="125"/>
          <DataGridTextColumn Header="TOTAL" Binding="{Binding Total}" Width="125"/>
          <DataGridTextColumn Header="MONEDA" Binding="{Binding Moneda}" Width="90"/>
          <DataGridTextColumn Header="FORMA" Binding="{Binding FormaPago}" Width="90"/>
          <DataGridTextColumn Header="MÉTODO" Binding="{Binding MetodoPago}" Width="95"/>
          <DataGridTextColumn Header="ESTATUS SAT" Binding="{Binding EstatusSat}" Width="120"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Window>
