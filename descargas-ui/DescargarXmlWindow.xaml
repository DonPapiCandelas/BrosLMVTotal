<Window x:Class="BrosLMV.DescargasUI.DescargarXmlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Descargar XML" Height="300" Width="440" MinHeight="280" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F4F6F9">
  <!-- Estilos compartidos (Primary/Ghost) en App.xaml. -->
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="LblTitulo" Grid.Row="0" Text="Descargar CFDI" FontSize="18" FontWeight="Bold" Foreground="#16263A" Margin="0,0,0,4"/>
    <TextBlock x:Name="LblSubtitulo" Grid.Row="1" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"/>

    <StackPanel Grid.Row="2">
      <TextBlock Text="Formato" Foreground="#64748B" FontSize="11" Margin="0,0,0,6"/>
      <RadioButton x:Name="RbCarpeta" Content="Archivos XML sueltos en una carpeta" GroupName="Formato" IsChecked="True" Margin="0,0,0,8"/>
      <RadioButton x:Name="RbZip" Content="Un solo archivo ZIP" GroupName="Formato"/>
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancelar" Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="Cancelar_Click"/>
      <Button Content="Descargar" Style="{StaticResource Primary}" Click="Descargar_Click"/>
    </StackPanel>
  </Grid>
</Window>
