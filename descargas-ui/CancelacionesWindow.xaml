<Window x:Class="BrosLMV.DescargasUI.CancelacionesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cancelaciones con documento" Height="620" Width="1060" MinHeight="460" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9">
  <Grid Margin="34,28,34,30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel>
        <TextBlock Text="Cancelaciones con documento" FontSize="27" FontWeight="Bold" Foreground="#16263A"/>
        <TextBlock Foreground="#64748B" Margin="0,6,60,0" TextWrapping="Wrap"
                   Text="CFDI que el SAT canceló y que ya estaban vinculados a un documento de Comercial. BrosLMV no toca esos documentos (tienen efectos contables y de inventario): revisa cada uno y márcalo cuando lo hayas atendido."/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <CheckBox x:Name="ChkRevisadas" Content="Mostrar revisadas" Margin="0,8,14,0" Checked="Filtro_Changed" Unchecked="Filtro_Changed"/>
        <Button Content="Marcar como revisada" Style="{StaticResource Ghost}" Click="BtnRevisada_Click"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="8" Margin="0,20,0,0">
      <DataGrid x:Name="GridCancelaciones" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Detectada" Binding="{Binding FechaTexto}" Width="130"/>
          <DataGridTextColumn Header="Empresa" Binding="{Binding Empresa}" Width="150"/>
          <DataGridTextColumn Header="UUID" Binding="{Binding UUID}" Width="300"/>
          <DataGridTextColumn Header="Documento en Comercial" Binding="{Binding Descripcion}" Width="*"/>
          <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Window>
