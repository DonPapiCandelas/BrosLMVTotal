<Window x:Class="BrosLMV.DescargasUI.EmpresaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva empresa" Height="680" Width="540" MinHeight="440" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" SizeToContent="Manual"
        Background="#F4F6F9">
  <!-- Titulo fijo arriba, botones fijos abajo, contenido con scroll en medio: pedido explicito
       del usuario (2026-08-14, "cuando le das editar no tenia ningun boton"). Con los 3 campos
       nuevos el dialogo crecio y en pantallas mas chicas los botones de Guardar/Cancelar se
       salian del area visible sin forma de hacer scroll para llegar a ellos. -->
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="LblTitulo" Grid.Row="0" Text="Nueva empresa" FontSize="18" FontWeight="Bold" Foreground="#16263A" Margin="0,0,0,16"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
      <StackPanel>
        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="Nombre" Foreground="#64748B" FontSize="11"/>
          <TextBox x:Name="TxtNombre" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="RFC" Foreground="#64748B" FontSize="11"/>
          <TextBox x:Name="TxtRfc" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Archivo .cer (FIEL)" Foreground="#64748B" FontSize="11"/>
            <TextBox x:Name="TxtCer" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0" IsReadOnly="True"/>
          </StackPanel>
          <Button Grid.Column="2" Content="Examinar" Style="{StaticResource Ghost}" VerticalAlignment="Bottom" Click="ExaminarCer_Click"/>
        </Grid>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Archivo .key (FIEL)" Foreground="#64748B" FontSize="11"/>
            <TextBox x:Name="TxtKey" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0" IsReadOnly="True"/>
          </StackPanel>
          <Button Grid.Column="2" Content="Examinar" Style="{StaticResource Ghost}" VerticalAlignment="Bottom" Click="ExaminarKey_Click"/>
        </Grid>

        <StackPanel Margin="0,0,0,12">
          <TextBlock x:Name="LblPassword" Text="Contraseña de la FIEL" Foreground="#64748B" FontSize="11"/>
          <PasswordBox x:Name="PwdFiel" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
          <TextBlock x:Name="LblPasswordAyuda" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="Se guarda cifrada (DPAPI, atada a este equipo) para que la descarga automática no la pida cada vez."/>
        </StackPanel>

        <Border x:Name="PanelAnioInicio" Style="{StaticResource Tarjeta}" Padding="16" Margin="0,4,0,4" Background="#F0F6FF" BorderBrush="#C7DBFA">
          <StackPanel>
            <TextBlock Text="DESCARGA HISTÓRICA INICIAL" Foreground="#2D6FE0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="¿Desde qué año quieres empezar a descargar? En cuanto guardes, se dispara la primera descarga (Recibidos y Emitidos) y el resto sigue solo, un mes a la vez, cada día." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <ComboBox x:Name="CmbAnioInicio"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Tarjeta}" Padding="16" Margin="0,4,0,4">
          <StackPanel>
            <TextBlock Text="DÓNDE Y CÓMO SE GUARDAN LOS XML DE ESTA EMPRESA" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Carpeta base" Foreground="#64748B" FontSize="11"/>
                <TextBox x:Name="TxtCarpetaXml" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0" IsReadOnly="True"/>
              </StackPanel>
              <Button Grid.Column="2" Content="Examinar" Style="{StaticResource Ghost}" VerticalAlignment="Bottom" Click="ExaminarCarpeta_Click"/>
            </Grid>
            <TextBlock Foreground="#94A3B8" FontSize="11" Margin="0,-6,0,10" TextWrapping="Wrap"
                       Text="Si se deja en blanco, se usa una carpeta &quot;xml&quot; junto al programa."/>

            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="Estructura de carpetas" Foreground="#64748B" FontSize="11"/>
              <ComboBox x:Name="CmbEstructura" Margin="0,3,0,0" SelectedIndex="3">
                <ComboBoxItem Content="Todo en una sola carpeta" Tag="Plana"/>
                <ComboBoxItem Content="Por año" Tag="Anio"/>
                <ComboBoxItem Content="Por año y mes" Tag="AnioMes"/>
                <ComboBoxItem Content="Por año, tipo (Recibidos/Emitidos) y mes" Tag="AnioTipoMes"/>
              </ComboBox>
            </StackPanel>

            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Nombre de archivo" Foreground="#64748B" FontSize="11"/>
                <TextBlock Grid.Column="1" x:Name="BtnRestaurarPlantilla" Text="Restaurar por defecto" Foreground="#2D6FE0" FontSize="11"
                           Cursor="Hand" MouseLeftButtonUp="BtnRestaurarPlantilla_Click"/>
              </Grid>
              <TextBox x:Name="TxtPlantilla" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
              <TextBlock Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="Placeholders disponibles: {UUID} {Folio} {Serie} {RFCEmisor} {RFCReceptor} {NombreEmisor} {Fecha} {Total} {TipoComprobante}. Si dos CFDI generan el mismo nombre, se le agrega un sufijo automático para no sobreescribir nada."/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Tarjeta}" Padding="16" Margin="0,14,0,4">
          <StackPanel>
            <TextBlock Text="INTEGRACIÓN CON CONTPAQi COMERCIAL PRO (OPCIONAL)" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Foreground="#94A3B8" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"
                       Text="Si se configuran, además de guardar su propia copia (arriba), BrosLMV.Descargas deja una copia plana de cada XML en la carpeta que Comercial Pro usa para su botón nativo &quot;Importar&quot; (Opciones &gt; CFDI &gt; Comprobante Fiscal Digital). Deja vacío si esta empresa no usa Comercial Pro."/>

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Ruta XML Recibidos de Comercial" Foreground="#64748B" FontSize="11"/>
                <TextBox x:Name="TxtComercialRecibidos" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0" IsReadOnly="True"/>
              </StackPanel>
              <Button Grid.Column="2" Content="Examinar" Style="{StaticResource Ghost}" VerticalAlignment="Bottom" Click="ExaminarComercialRecibidos_Click"/>
            </Grid>

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Ruta XML Emitidos de Comercial" Foreground="#64748B" FontSize="11"/>
                <TextBox x:Name="TxtComercialEmitidos" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0" IsReadOnly="True"/>
              </StackPanel>
              <Button Grid.Column="2" Content="Examinar" Style="{StaticResource Ghost}" VerticalAlignment="Bottom" Click="ExaminarComercialEmitidos_Click"/>
            </Grid>

            <StackPanel>
              <TextBlock Text="Conexión a la base de datos de Comercial (opcional)" Foreground="#64748B" FontSize="11" Margin="0,0,0,4"/>
              <TextBlock Foreground="#94A3B8" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"
                         Text="Si se llena, además de copiar el XML se hace lo mismo que el botón nativo Importar de Comercial (escribe directo en su base de staging) -- ya no hace falta darle Importar a mano."/>

              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Servidor / instancia SQL" Foreground="#64748B" FontSize="11"/>
                  <TextBox x:Name="TxtComercialServidor" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Base de datos" Foreground="#64748B" FontSize="11"/>
                  <TextBox x:Name="TxtComercialBaseDatos" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
              </Grid>

              <CheckBox x:Name="ChkComercialWindowsAuth" Content="Usar autenticación de Windows (sin usuario/contraseña)" Margin="0,0,0,8" Checked="ChkComercialWindowsAuth_Changed" Unchecked="ChkComercialWindowsAuth_Changed"/>

              <Grid x:Name="PanelComercialSqlAuth">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Usuario SQL" Foreground="#64748B" FontSize="11"/>
                  <TextBox x:Name="TxtComercialUsuario" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Contraseña SQL" Foreground="#64748B" FontSize="11"/>
                  <PasswordBox x:Name="PwdComercialContrasena" Padding="6,5" VerticalContentAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
              </Grid>
              <TextBlock Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                         Text="Se guarda cifrada (DPAPI, atada a este equipo), igual que la contraseña de la FIEL. Deja el servidor en blanco si esta empresa no usa Comercial Pro."/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Tarjeta}" Padding="16" Margin="0,4,0,4">
          <StackPanel>
            <TextBlock Text="FILTRADO DE COMPROBANTES FISCALES" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <CheckBox x:Name="ChkOcultarNominas" Content="Ocultar comprobantes de Nómina (Tipo N) en el historial y reportes" IsChecked="True"/>
            <TextBlock Foreground="#94A3B8" FontSize="11" Margin="26,4,0,0" TextWrapping="Wrap"
                       Text="Recomendado si la empresa emite nómina a empleados para evitar saturar el historial comercial con recibos individuales de sueldo."/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancelar" Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="Cancelar_Click"/>
      <Button x:Name="BtnGuardar" Content="Guardar empresa" Style="{StaticResource Primary}" Click="Guardar_Click"/>
    </StackPanel>
  </Grid>
</Window>
